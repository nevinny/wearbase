# Cache and logs (Symfony2)
/app/cache/*
/app/logs/*
!app/cache/.gitkeep
!app/logs/.gitkeep

# Email spool folder
/app/spool/*

# Cache, session files and logs (Symfony3)
/var/cache/*
/var/logs/*
/var/sessions/*
!var/cache/.gitkeep
!var/logs/.gitkeep
!var/sessions/.gitkeep

# Logs (Symfony4)
/var/log/*
!var/log/.gitkeep

# Parameters
/app/config/parameters.yml
/app/config/parameters.ini

# Managed by Composer
/app/bootstrap.php.cache
/var/bootstrap.php.cache
/bin/*
!bin/console
!bin/symfony_requirements
/vendor/

# Assets and user uploads
/web/bundles/
/web/uploads/

# PHPUnit
/app/phpunit.xml
/phpunit.xml

# Build data
/build/

# Composer PHAR
/composer.phar

# Backup entities generated with doctrine:generate:entities command
**/Entity/*~

# Embedded web-server pid file
/.web-server-pid

###> phpunit/phpunit ###
/.phpunit.cache/
###< phpunit/phpunit ###

###> symfony/asset-mapper ###
/public/assets/
/public_html/assets/
/assets/vendor/
###< symfony/asset-mapper ###

/public_html/bundles
/.idea
.env
.env.dev
.env.local

###> symfony/framework-bundle ###
/.env.local
/.env.local.php
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php
/public_html/bundles/
/var/
/public_html/images/brands
/public_html/images/logos
/public_html/images/wardrobe
/public_html/images/wardrobe_drafts
###< symfony/framework-bundle ###

# Секреты (Google OAuth/GSC service-account и пр.) — только локально
/config/secrets/

# Node / e2e артефакты
/node_modules/
/playwright-report/
/test-results/

# Локальные дампы БД и рабочие выгрузки
/_sql/

# Архив SEO-методологии (16M, zip/pdf) — рабочая копия тулкита живёт в tools/
/_seo/

# Локальный инструментарий ассистентов
/.opencode/
/.superpowers/

# Случайные локальные загрузки
/public/downloads/

# Бэкапы .env (СОДЕРЖАТ СЕКРЕТЫ — никогда не коммитить)
.env.local.bak*
# Obsidian / scratch-заметки в docs
docs/.obsidian/
docs/*.scratch.md
# Авто-генерёные картинки соц-постов (бинарники, ~8М)
/public_html/images/social/
# Лид-выгрузки/кандидаты (рабочие данные, возможны контакты/PII) — не в git
/docs/*.csv
/docs/*.tsv
# Черновики тёплой рассылки — реальные email лидов + прод-токены, никогда не в git
/docs/warm-outreach-*.md
/public_html/images/products
