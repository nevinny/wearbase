# Скопируй этот файл в .env.local и заполни.
# .env.local в .gitignore — секреты не коммитим.
#
# Примечание: .env.dev (в git) содержит только APP_SECRET — этого мало для запуска.
# Symfony Dotenv грузит .env.dev → .env.local (второй перекрывает/дополняет первый).

###############################################################################
# ОБЯЗАТЕЛЬНО для локального запуска
###############################################################################

APP_ENV=dev
APP_DEBUG=1

# Локальный MySQL (8.x/9.x — НЕ SQLite, см. docs/onboarding.md почему)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=wearbase
DATABASE_PASSWORD=change_me
DATABASE_NAME=wearbase
DATABASE_URL="mysql://%env(DATABASE_USER)%:%env(DATABASE_PASSWORD)%@%env(DATABASE_HOST)%:%env(DATABASE_PORT)%/%env(DATABASE_NAME)%?serverVersion=9.1"

###############################################################################
# ОПЦИОНАЛЬНО — фичи деградируют мягко, если пусто/не заполнено
###############################################################################

# Облачный LLM (OpenRouter) — замена LAN-серверу для генерации контента/RAG.
# Без него команды генерации контента просто не будут работать, остальное приложение не пострадает.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Почта — null-транспорт по умолчанию, письма никуда не уходят, но код не падает
MAILER_DSN=null://null

# Telegram-уведомления — no-op без токена/chat_id
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (капча на формах) — без ключей виджет не проверяется
TURNSTILE_KEY=
TURNSTILE_SECRET=

# Шифрование реквизитов платёжных счетов продавцов (libsodium)
PAYMENT_SECRET_KEY=

###############################################################################
# LAN-ONLY — только в локальной сети владельца, тебе не нужно
###############################################################################

# LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=
# LOCAL_EMBED_URL=
# LOCAL_EMBED_MODEL=
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=
# SEARXNG_URL=
# SEARX_ENGINES=
# TRAFILATURA_BIN=
# WARDROBE_VISION_LOCAL=

###############################################################################
# Прод / интеграции владельца — для локальной разработки не требуются
###############################################################################

