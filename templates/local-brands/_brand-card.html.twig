<div class="card brand-card h-100" data-category="{{ brand.category }}"
     {% if brand.isSustainable %}data-sustainable="true"{% endif %}>
    <div class="card-body text-center p-3">
        <!-- Бейдж локального бренда -->
        <div class="position-absolute top-0 start-0 m-2">
            <span class="badge local-badge">
                <i class="fas fa-map-marker-alt me-1"></i>Локальный
            </span>
        </div>

        {% if brand.isSustainable %}
            <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-success">
                <i class="fas fa-leaf me-1"></i>Эко
            </span>
            </div>
        {% endif %}

        <!-- Логотип бренда -->
        <div class="mb-3">
            <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="brand-logo img-fluid">
        </div>

        <!-- Название бренда -->
        <h5 class="card-title mb-2">{{ brand.name }}</h5>

        <!-- Описание -->
        <p class="card-text small text-muted mb-3">
            {{ brand.description|slice(0, 80) }}{% if brand.description|length > 80 %}...{% endif %}
        </p>

        <!-- Категории -->
        <div class="mb-3">
            {% for category in brand.categories %}
                <span class="category-tag d-inline-block">{{ category }}</span>
            {% endfor %}
        </div>

        <!-- Рейтинг -->
        <div class="mb-3">
            <div class="d-flex justify-content-center align-items-center small">
                <div class="text-warning me-2">
                    {% for i in 1..5 %}
                        {% if i <= brand.rating %}
                            <i class="fas fa-star"></i>
                        {% else %}
                            <i class="far fa-star"></i>
                        {% endif %}
                    {% endfor %}
                </div>
                <span class="text-muted">({{ brand.reviewCount }})</span>
            </div>
        </div>

        <!-- Кнопка -->
        <a href="{{ brand.url }}" class="btn btn-outline-dark w-100">
            Смотреть коллекцию
        </a>
    </div>
</div>
