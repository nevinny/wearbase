<div class="brand-card-compact relative h-full rounded-2xl bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="p-3 text-center">
        <!-- Бейджи -->
        <div class="absolute top-0 left-0 m-1">
            {% if brand.isLocal is defined and brand.isLocal %}
                <span class="inline-flex items-center rounded-lg bg-red-600 px-1.5 py-0.5 text-xs text-white">
                    <i class="fas fa-map-marker-alt"></i>
                </span>
            {% endif %}
        </div>

        <div class="absolute top-0 right-0 m-1">
            {% if brand.isSustainable is defined and brand.isSustainable %}
                <span class="inline-flex items-center rounded-lg bg-green-600 px-1.5 py-0.5 text-xs text-white">
                    <i class="fas fa-leaf"></i>
                </span>
            {% endif %}
        </div>

        <!-- Логотип -->
        <div class="mb-3">
            <img src="{{ brand.logo|default('/images/brand-placeholder.png') }}"
                 alt="{{ brand.title|default('Бренд') }}"
                 class="brand-logo-compact mx-auto h-20 max-w-full rounded object-contain p-3"
                 onerror="this.src='/images/brand-placeholder.png'">
        </div>

        <!-- Название -->
        <h6 class="mb-2 truncate text-sm font-bold" title="{{ brand.title|default('Бренд') }}">
            {{ brand.title|default('Бренд') }}
        </h6>

        <!-- Количество товаров -->
        {% if brand.productCount is defined %}
            <p class="mb-2 text-sm text-gray-500">
                {{ brand.productCount }} товаров
            </p>
        {% endif %}

        <!-- Кнопка -->
        {% if brand.slug is defined %}
{#            <a href="{{ path('brand_detail', {'slug': brand.slug}) }}"#}
{#               class="block w-full rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">#}
                Смотреть
{#            </a>#}
        {% else %}
            <button class="w-full rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition disabled:opacity-50" disabled>
                Смотреть
            </button>
        {% endif %}
    </div>
</div>
