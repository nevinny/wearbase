{% extends 'tailwind/base.html.twig' %}

{% block title %}Алфавитный указатель брендов | ASOS{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-6">
        <!-- Хлебные крошки -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                <li><a href="/" class="hover:text-gray-900 transition">Главная</a></li>
                <li aria-hidden="true">/</li>
                <li><a href="/brands" class="hover:text-gray-900 transition">Бренды</a></li>
                <li aria-hidden="true">/</li>
                <li class="text-gray-900">Алфавитный указатель</li>
            </ol>
        </nav>

        <!-- Заголовок -->
        <div class="mb-6">
            <div class="mb-3 flex items-center justify-between">
                <h1 class="text-2xl font-bold">Алфавитный указатель брендов</h1>
                <span class="text-gray-500">{{ totalBrands }} брендов</span>
            </div>
            <p class="text-lg text-gray-500">
                Найдите любимые бренды по алфавиту или воспользуйтесь поиском
            </p>
        </div>

        <!-- Поиск -->
        <div class="mb-6">
            <div class="rounded-2xl bg-white shadow-sm">
                <div class="p-4 md:p-6">
                    <form method="get" class="grid items-center gap-3 md:grid-cols-12">
                        <div class="md:col-span-8">
                            <div class="flex items-center rounded-lg border border-gray-300 bg-white focus-within:border-gray-900">
                                <span class="flex items-center bg-gray-50 px-3 py-2.5 rounded-l-lg">
                                    <i class="fas fa-search text-gray-500"></i>
                                </span>
                                <input type="text"
                                       name="search"
                                       class="w-full rounded-r-lg border-0 px-3 py-2.5 text-sm focus:outline-none"
                                       placeholder="Поиск брендов..."
                                       value="{{ searchQuery }}"
                                       aria-label="Поиск брендов">
                            </div>
                        </div>
                        <div class="md:col-span-2">
                            <button type="submit" class="w-full rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">
                                Найти
                            </button>
                        </div>
                        <div class="md:col-span-2">
                            <a href="{{ path('brands_az') }}" class="block w-full text-center rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">
                                Сбросить
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {% if searchQuery %}
            <!-- Результаты поиска -->
            <div class="mb-6">
                <div class="mb-3 flex items-center justify-between">
                    <h2 class="text-lg font-bold">Результаты поиска "{{ searchQuery }}"</h2>
                    <span class="text-gray-500">Найдено {{ brands|length }} брендов</span>
                </div>

                {% if brands is empty %}
                    <div class="py-12 text-center">
                        <i class="fas fa-search fa-3x text-gray-500 mb-3"></i>
                        <h3 class="text-lg font-bold">Бренды не найдены</h3>
                        <p class="text-gray-500">Попробуйте изменить поисковый запрос или посмотрите все бренды по алфавиту</p>
                        <a href="{{ path('brands_az') }}" class="inline-block mt-3 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Показать все бренды</a>
                    </div>
                {% else %}
                    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
                        {% for brand in brands %}
                            <div>
                                {% include 'local-brands/_brand-card-compact.html.twig' with {brand: brand} %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% else %}
            <!-- Алфавитный указатель -->
            <div>
                <!-- Навигация по буквам -->
                <div class="mb-6">
                    <div class="rounded-2xl bg-white shadow-sm">
                        <div class="p-4 md:p-6">
                            <h3 class="text-lg font-bold mb-3">Быстрая навигация</h3>
                            <div class="alphabet-nav flex flex-wrap justify-center gap-1">
                                {% for letter in alphabet %}
                                    <a href="{{ path('brands_az', {'letter': letter}) }}"
                                       class="alphabet-letter min-w-[45px] text-center font-semibold rounded-lg px-2.5 py-1 text-sm transition {% if currentLetter == letter %}bg-gray-900 text-white{% else %}text-gray-600 hover:bg-gray-100{% endif %}">
                                        {{ letter }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Список брендов по буквам -->
                <div>
                    {% if currentLetter %}
                        <!-- Текущая выбранная буква -->
                        <div class="mb-6">
                            <div class="mb-3 flex items-center justify-between">
                                <h2 class="text-lg font-bold">Бренды на букву "{{ currentLetter }}"</h2>
                                <span class="text-gray-500">{% if brandsByLetter is defined and currentLetter is defined and brandsByLetter[currentLetter] is defined %}
                                        {{ brandsByLetter[currentLetter]|length }}
                                    {% endif %} брендов</span>
                            </div>

                            {% if brandsByLetter[currentLetter] is defined and brandsByLetter[currentLetter] is not empty %}
                                <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
                                    {% for brand in brandsByLetter[currentLetter] %}
                                        <div>
                                            {% include 'local-brands/_brand-card-compact.html.twig' with {brand: brand} %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="rounded-2xl bg-gray-50 py-12 text-center">
                                    <i class="fas fa-font fa-3x text-gray-500 mb-3"></i>
                                    <h3 class="text-lg font-bold">Нет брендов на букву "{{ currentLetter }}"</h3>
                                    <p class="text-gray-500">Выберите другую букву для просмотра брендов</p>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <!-- Полный алфавитный список -->
                        <div class="az-index-full">
                            {% for letter, letterBrands in brandsByLetter %}
                                <div class="az-letter-section mb-10 scroll-mt-5" id="letter-{{ letter }}">
                                    <div class="mb-3 flex items-center">
                                        <h2 class="text-xl font-bold mr-3">{{ letter }}</h2>
                                        <span class="rounded-lg bg-gray-100 px-2.5 py-0.5 text-sm text-gray-600">{{ letterBrands|length }}</span>
                                    </div>

                                    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
                                        {% for brand in letterBrands %}
                                            <div>
                                                {% include 'local-brands/_brand-card-compact.html.twig' with {brand: brand} %}
                                            </div>
                                        {% endfor %}
                                    </div>

                                    {% if loop.last == false %}
                                        <hr class="my-6 border-gray-200">
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="py-12 text-center">
                                    <i class="fas fa-store fa-3x text-gray-500 mb-3"></i>
                                    <h3 class="text-lg font-bold">Бренды не найдены</h3>
                                    <p class="text-gray-500">В каталоге пока нет брендов</p>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <!-- Дополнительная информация -->
        <div class="mt-10">
            <div class="rounded-2xl bg-gray-50 p-6">
                <div class="grid gap-4 md:grid-cols-3">
                    <div class="text-center">
                        <i class="fas fa-globe fa-2x text-blue-600 mb-2"></i>
                        <h5 class="text-lg font-bold">Международные бренды</h5>
                        <p class="text-sm text-gray-500">Более 800 брендов со всего мира</p>
                    </div>
                    <div class="text-center">
                        <i class="fas fa-map-marker-alt fa-2x text-green-600 mb-2"></i>
                        <h5 class="text-lg font-bold">Локальные бренды</h5>
                        <p class="text-sm text-gray-500">Поддержите местных дизайнеров</p>
                    </div>
                    <div class="text-center">
                        <i class="fas fa-leaf fa-2x text-cyan-600 mb-2"></i>
                        <h5 class="text-lg font-bold">Устойчивая мода</h5>
                        <p class="text-sm text-gray-500">Эко-дружественные бренды</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Плавная прокрутка к буквам
        document.addEventListener('DOMContentLoaded', function() {
            const alphabetLinks = document.querySelectorAll('a[href^="#letter-"]');

            alphabetLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    const targetElement = document.querySelector(targetId);

                    if (targetElement) {
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Подсветка текущей буквы в полном списке
            const urlParams = new URLSearchParams(window.location.search);
            const currentLetter = urlParams.get('letter');

            if (currentLetter) {
                const targetSection = document.getElementById('letter-' + currentLetter);
                if (targetSection) {
                    targetSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });

                    // Временная подсветка
                    targetSection.style.backgroundColor = 'rgba(0,0,0,0.02)';
                    targetSection.style.transition = 'background-color 0.3s ease';

                    setTimeout(() => {
                        targetSection.style.backgroundColor = '';
                    }, 2000);
                }
            }
        });
    </script>
{% endblock %}
