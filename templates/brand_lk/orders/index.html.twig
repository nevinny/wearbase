{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Заказы — {{ brand.title }}{% endblock %}

{% block brand_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 fw-bold mb-0">Заказы</h2>
</div>

{# Фильтр по статусу #}
<div class="mb-3 d-flex gap-2 flex-wrap">
    <a href="{{ path('brand_orders') }}"
       class="btn btn-sm {{ not current_status ? 'btn-dark' : 'btn-outline-secondary' }}">Все</a>
    {% for key, label in status_labels %}
    <a href="{{ path('brand_orders', {status: key}) }}"
       class="btn btn-sm {{ current_status == key ? 'btn-dark' : 'btn-outline-secondary' }}">
        {{ label }}
    </a>
    {% endfor %}
</div>

{% if orders|length == 0 %}
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">Заказов нет</div>
    </div>
{% else %}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Номер</th>
                    <th>Покупатель</th>
                    <th>Товары</th>
                    <th>Сумма</th>
                    <th>Оплата</th>
                    <th>Статус</th>
                    <th>Дата</th>
                </tr>
            </thead>
            <tbody>
            {% for order in orders %}
            <tr>
                <td>
                    <a href="{{ path('brand_order_show', {id: order.id}) }}" class="fw-semibold text-dark">
                        #{{ order.orderNumber }}
                    </a>
                </td>
                <td>{{ order.customer.fullName }}</td>
                <td class="text-muted small">{{ order.orderItems|length }} поз.</td>
                <td class="fw-semibold">{{ price(order.totalAmount) }}</td>
                <td>
                    <span class="badge bg-{{ order.paid ? 'success' : 'warning text-dark' }}">
                        {{ order.paid ? 'Оплачен' : 'Не оплачен' }}
                    </span>
                </td>
                <td>
                    <span class="badge bg-{{ order.status == 'new' ? 'danger' : (order.status == 'shipped' ? 'info' : (order.status == 'completed' ? 'success' : 'secondary')) }}">
                        {{ status_labels[order.status] ?? order.status }}
                    </span>
                </td>
                <td class="text-muted small">{{ order.createdAt|date('d.m.Y H:i') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
