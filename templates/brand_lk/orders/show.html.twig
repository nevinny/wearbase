{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Заказ #{{ order.orderNumber }}{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set status_badge = 'rounded px-2 py-0.5 text-xs font-semibold ' ~ (order.status == 'new' ? 'bg-red-100 text-red-800' : (order.status == 'shipped' ? 'bg-sky-100 text-sky-800' : (order.status == 'completed' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-700'))) %}

<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('brand_orders') }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">
        ← Заказы
    </a>
    <h1 class="text-lg font-bold">#{{ order.orderNumber }}</h1>
    <span class="{{ status_badge }}">
        {{ status_labels[order.status] ?? order.status }}
    </span>
</div>

<div class="grid items-start gap-6 lg:grid-cols-3">

    {# ── Основная информация ── #}
    <div class="lg:col-span-2">

        {# Товары #}
        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Состав заказа</div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                        <tr>
                            <th class="px-5 py-3">Товар</th>
                            <th class="px-5 py-3">Вариант</th>
                            <th class="px-5 py-3">Арт.</th>
                            <th class="px-5 py-3 text-center">Кол-во</th>
                            <th class="px-5 py-3 text-right">Сумма</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    {% for item in order.orderItems %}
                    <tr>
                        <td class="px-5 py-3 font-semibold">{{ item.productTitle }}</td>
                        <td class="px-5 py-3 text-xs text-gray-500">{{ item.variantTitle }}</td>
                        <td class="px-5 py-3 text-xs text-gray-500">{{ item.sku }}</td>
                        <td class="px-5 py-3 text-center">{{ item.qty }}</td>
                        <td class="px-5 py-3 text-right font-semibold">{{ price(item.total) }}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot class="bg-gray-50">
                        <tr>
                            <td colspan="4" class="px-5 py-2 text-right text-xs text-gray-500">Товары</td>
                            <td class="px-5 py-2 text-right font-semibold">{{ price(order.subtotal) }}</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="px-5 py-2 text-right text-xs text-gray-500">Доставка</td>
                            <td class="px-5 py-2 text-right font-semibold">{{ price(order.shippingCost) }}</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="px-5 py-3 text-right font-bold">Итого</td>
                            <td class="px-5 py-3 text-right text-base font-bold">{{ price(order.totalAmount) }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        {# Покупатель #}
        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Покупатель</div>
            <div class="p-5">
                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        <span class="{{ label_class }}">Имя</span>
                        <div class="text-sm">{{ order.shippingAddress.fullName ?? order.customer.fullName }}</div>
                    </div>
                    <div>
                        <span class="{{ label_class }}">Телефон</span>
                        <div class="text-sm">{{ order.shippingAddress.phone ?? order.customer.phone ?? '—' }}</div>
                    </div>
                    <div class="md:col-span-2">
                        <span class="{{ label_class }}">Адрес доставки</span>
                        <div class="text-sm">
                            {% set a = order.shippingAddress %}
                            {{ [a.zip, a.city, a.street, a.building ? 'д.' ~ a.building : '', a.apartment ? 'кв.' ~ a.apartment : '']|filter(v => v)|join(', ') }}
                        </div>
                    </div>
                    {% if order.customerNote %}
                    <div class="md:col-span-2">
                        <span class="{{ label_class }}">Комментарий покупателя</span>
                        <div class="text-sm italic text-gray-500">{{ order.customerNote }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# История статусов #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">История статусов</div>
            <ul class="divide-y divide-gray-100">
                {% for h in order.statusHistory %}
                <li class="flex items-start justify-between px-5 py-3">
                    <div class="text-sm">
                        {% if h.fromStatus %}
                            <span class="text-gray-500">{{ status_labels[h.fromStatus] ?? h.fromStatus }}</span>
                            <span class="mx-1 text-gray-400">→</span>
                        {% endif %}
                        <span class="font-semibold">{{ status_labels[h.toStatus] ?? h.toStatus }}</span>
                        {% if h.comment %}
                            <div class="mt-1 text-gray-500">{{ h.comment }}</div>
                        {% endif %}
                    </div>
                    <div class="ml-3 whitespace-nowrap text-right text-xs text-gray-500">
                        {{ h.createdAt|date('d.m H:i') }}
                        {% if h.createdBy %}<br>{{ h.createdBy.fullName }}{% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>

    </div>

    {# ── Боковая панель ── #}
    <div class="flex flex-col gap-4">

        {# Статус и оплата #}
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-5">
                <div class="mb-4">
                    <span class="{{ label_class }}">Статус заказа</span>
                    <span class="{{ status_badge }}">
                        {{ status_labels[order.status] ?? order.status }}
                    </span>
                </div>
                <div class="mb-4">
                    <span class="{{ label_class }}">Оплата</span>
                    <div class="text-sm font-semibold {{ order.paid ? 'text-green-600' : 'text-amber-600' }}">
                        {{ order.paid ? '✅ Оплачен' : '🕐 Ожидает оплаты' }}
                    </div>
                </div>
                <div>
                    <span class="{{ label_class }}">Доставка</span>
                    <div class="text-sm">{{ order.deliveryMethod ?? '—' }}</div>
                </div>
            </div>
        </div>

        {# Изменить статус #}
        {% if allowed_statuses|length > 0 %}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Изменить статус</div>
            <div class="p-5">
                <form method="post" action="{{ path('brand_order_status', {id: order.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('order_status') }}">
                    <div class="mb-4">
                        <label class="{{ label_class }}">Новый статус</label>
                        <select name="status" class="{{ input_class }}">
                            {% for s in allowed_statuses %}
                                <option value="{{ s }}">{{ status_labels[s] ?? s }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="{{ label_class }}">Комментарий</label>
                        <textarea name="comment" class="{{ input_class }}" rows="2"
                                  placeholder="Необязательно"></textarea>
                    </div>
                    <button type="submit" class="w-full rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Обновить статус</button>
                </form>
            </div>
        </div>
        {% endif %}

        {# Трекинг #}
        {% if order.status in ['confirmed', 'processing'] or (order.status == 'shipped' and not order.trackingNumber) %}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Отправить заказ</div>
            <div class="p-5">
                <form method="post" action="{{ path('brand_order_ship', {id: order.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('ship_order') }}">
                    <div class="mb-4">
                        <label class="{{ label_class }}">Трекинг-номер</label>
                        <input type="text" name="tracking_number" class="{{ input_class }}"
                               value="{{ order.trackingNumber }}"
                               placeholder="CD123456789RU">
                    </div>
                    <button type="submit" class="w-full rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 transition">
                        🚚 Отметить как отправлен
                    </button>
                </form>
            </div>
        </div>
        {% elseif order.trackingNumber %}
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-5">
                <span class="{{ label_class }}">Трекинг-номер</span>
                <code class="mt-1 block text-sm">{{ order.trackingNumber }}</code>
            </div>
        </div>
        {% endif %}

        {# Продавец и приём оплаты (снимок на момент заказа) #}
        {% if order.sellerLegalEntity or order.sellerPaymentAccount %}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Продавец и оплата</div>
            <div class="p-5">
                {% if order.sellerLegalEntity %}
                <div class="mb-3">
                    <span class="{{ label_class }}">Продавец (на момент заказа)</span>
                    <div class="text-sm">{{ order.sellerLegalEntity.legalName }}
                        <span class="text-gray-500">{{ order.sellerLegalEntity.legalForm|upper }}</span></div>
                    {% if order.sellerLegalEntity.inn %}<div class="text-xs text-gray-500">ИНН {{ order.sellerLegalEntity.inn }}</div>{% endif %}
                </div>
                {% endif %}
                {% if order.sellerPaymentAccount %}
                <div>
                    <span class="{{ label_class }}">Деньги получены через</span>
                    <div class="text-sm">{{ order.sellerPaymentAccount.provider.name }}
                        · {{ order.sellerPaymentAccount.mode == 'direct' ? 'прямой' : 'сплит' }}</div>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {# Получение товара (ЗоЗПП) — статусная машина не идёт дальше «отправлен» #}
        {% if order.paid %}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Получение товара</div>
            <div class="p-5">
                {% if order.sellerDeliveryConfirmedAt %}
                    <div class="text-sm text-green-600">
                        ✅ Покупатель получил товар · {{ order.sellerDeliveryConfirmedAt|date('d.m.Y') }}
                    </div>
                {% else %}
                    <div class="mb-3 text-xs text-gray-500">Отметьте, когда покупатель получил товар — фиксирует исполнение по ЗоЗПП.</div>
                    <form method="post" action="{{ path('brand_order_confirm_delivery', {id: order.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('confirm_delivery') }}">
                        <button class="w-full rounded-lg border border-green-300 px-3 py-1.5 text-sm text-green-700 hover:bg-green-50 transition">
                            📦 Покупатель получил товар
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {# Возврат предоплаты (ЗоЗПП, 10 дней) #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Возврат предоплаты</div>
            <div class="p-5">
                {% if order.prepaymentRefundRequestedAt is null %}
                    <div class="mb-3 text-xs text-gray-500">Если покупатель потребовал возврат предоплаты — зафиксируйте дату получения требования (пойдёт отсчёт 10 дней).</div>
                    <form method="post" action="{{ path('brand_order_refund_request', {id: order.id}) }}" class="flex gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('refund_request') }}">
                        <input type="date" name="requested_at" class="{{ input_class }}" value="{{ 'now'|date('Y-m-d') }}">
                        <button class="whitespace-nowrap rounded-lg border border-red-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition">Зафиксировать</button>
                    </form>
                {% else %}
                    <div class="mb-1 text-sm">Требование от {{ order.prepaymentRefundRequestedAt|date('d.m.Y') }}</div>
                    {% set deadline = order.refundConfirmationDeadline %}
                    {% if order.refundConfirmationSentAt %}
                        <div class="text-sm text-green-600">
                            ✅ Подтверждение направлено покупателю · {{ order.refundConfirmationSentAt|date('d.m.Y') }}
                        </div>
                    {% else %}
                        {% set overdue = deadline and date() > deadline %}
                        <div class="text-sm {{ overdue ? 'font-semibold text-red-600' : 'text-amber-600' }}">
                            🕐 Срок направить подтверждение: {{ deadline|date('d.m.Y') }}{{ overdue ? ' — просрочено' : '' }}
                        </div>
                        <form method="post" action="{{ path('brand_order_refund_confirmation_sent', {id: order.id}) }}" class="mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('refund_confirmation_sent') }}">
                            <button class="w-full rounded-lg border border-gray-900 px-3 py-1.5 text-sm text-gray-900 hover:bg-gray-900 hover:text-white transition">Подтверждение направлено покупателю</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {# Заметка #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Внутренняя заметка</div>
            <div class="p-5">
                <div class="mb-3 text-xs text-gray-500">Не видна покупателю</div>
                <form method="post" action="{{ path('brand_order_note', {id: order.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('order_note') }}">
                    <textarea class="{{ input_class }}" rows="3" name="admin_note">{{ order.adminNote }}</textarea>
                    <button class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Сохранить</button>
                </form>
            </div>
        </div>

    </div>
</div>
{% endblock %}
