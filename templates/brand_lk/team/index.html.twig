{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Команда — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}

<h1 class="mb-5 text-lg font-bold">Команда</h1>

<div class="grid items-start gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">

        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                Участники
                <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">{{ members|length }}</span>
            </div>
            <div class="divide-y divide-gray-100">
                {% for member in members %}
                <div class="px-5 py-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            {% if member.user.avatar %}
                                <img src="{{ vich_uploader_asset(member.user, 'avatarFile') }}"
                                     class="h-[38px] w-[38px] shrink-0 rounded-full object-cover" width="38" height="38"
                                     alt="">
                            {% else %}
                                <div class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full bg-gray-400 text-sm text-white">
                                    {{ (member.user.firstName ?: member.user.email)|first|upper }}
                                </div>
                            {% endif %}
                            <div>
                                <div class="text-sm font-semibold">{{ member.user.fullName }}</div>
                                <div class="text-xs text-gray-500">{{ member.user.email }}</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="rounded px-2 py-0.5 text-xs font-semibold {{ member.role == 'owner' ? 'bg-gray-900 text-white' : 'border border-gray-200 bg-gray-100 text-gray-700' }}">
                                {{ member.role == 'owner' ? 'Владелец' : 'Менеджер' }}
                            </span>
                            {% if member.user != app.user and member.role != 'owner' %}
                            <form method="post"
                                  action="{{ path('brand_team_member_remove', {id: member.id}) }}"
                                  onsubmit="return confirm('Удалить участника из команды?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove_member') }}">
                                <button type="submit" class="rounded-lg border border-red-300 px-2.5 py-1 text-sm text-red-600 hover:bg-red-50 transition" title="Удалить">
                                    ✕
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="py-14 text-center text-gray-500">
                    <div class="mb-4 text-5xl opacity-30">👥</div>
                    Нет участников
                </div>
                {% endfor %}
            </div>
        </div>

    </div>

    <div class="flex flex-col gap-4">

        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Пригласить участника</div>
            <div class="p-5">
                <form method="post" action="{{ path('brand_team_invite') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('invite_team') }}">
                    <div class="mb-4">
                        <label class="{{ label_class }}">Email</label>
                        <input type="email" name="email" class="{{ input_class }}"
                               placeholder="user@example.com" required>
                    </div>
                    <div class="mb-5">
                        <label class="{{ label_class }}">Роль</label>
                        <select name="role" class="{{ input_class }}">
                            <option value="manager">Менеджер</option>
                            <option value="owner">Владелец</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">
                        Отправить приглашение
                    </button>
                </form>
            </div>
        </div>

        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-4">
                <div class="flex gap-2 text-xs text-gray-500">
                    <span class="mt-0.5 shrink-0">ℹ️</span>
                    <span>Приглашение действует 7 дней. Пользователь получит ссылку на email и сможет присоединиться к команде бренда.</span>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
