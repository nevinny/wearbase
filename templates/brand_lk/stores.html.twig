{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Магазины — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}

<div class="mb-5 flex items-center justify-between">
    <h1 class="text-lg font-bold">Офлайн-магазины</h1>
</div>

{# Форма добавления/редактирования #}
<div class="mb-6 rounded-2xl bg-white shadow-sm">
    <div class="p-5">
        <h2 class="mb-3 text-sm font-semibold">{{ editStore ? 'Редактировать магазин' : 'Добавить магазин' }}</h2>
        <form method="post" action="{{ path('brand_stores_save') }}" class="grid gap-4 md:grid-cols-2">
            <input type="hidden" name="_token" value="{{ csrf_token('brand_stores') }}">
            {% if editStore %}<input type="hidden" name="id" value="{{ editStore.id }}">{% endif %}
            <div>
                <label class="{{ label_class }}">Адрес <span class="text-red-600">*</span></label>
                <input type="text" name="address" class="{{ input_class }}" required maxlength="500"
                       placeholder="г. Москва, ул. Примерная, 1" value="{{ editStore ? editStore.address : '' }}">
            </div>
            <div>
                <label class="{{ label_class }}">Город</label>
                <input type="text" name="city" class="{{ input_class }}" maxlength="255"
                       value="{{ editStore ? editStore.city : '' }}">
            </div>
            <div>
                <label class="{{ label_class }}">Телефон</label>
                <input type="text" name="phone" class="{{ input_class }}" maxlength="255"
                       placeholder="+7 ..." value="{{ editStore ? editStore.phone : '' }}">
            </div>
            <div>
                <label class="{{ label_class }}">Часы работы</label>
                <input type="text" name="work_hours" class="{{ input_class }}" maxlength="255"
                       placeholder="пн–вс 10:00–22:00" value="{{ editStore ? editStore.workHours : '' }}">
            </div>
            <div class="flex items-center gap-2 md:col-span-2">
                <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">{{ editStore ? 'Сохранить' : 'Добавить' }}</button>
                {% if editStore %}
                    <a href="{{ path('brand_stores') }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Отмена</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{# Список магазинов #}
<div class="overflow-hidden rounded-2xl bg-white shadow-sm">
    {% if stores|length == 0 %}
        <div class="p-5">
            <p class="text-sm text-gray-500">Магазины не добавлены. Точки показываются на публичной странице бренда.</p>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                    <tr>
                        <th class="px-5 py-3">Адрес</th>
                        <th class="px-5 py-3">Город</th>
                        <th class="px-5 py-3">Часы</th>
                        <th class="px-5 py-3">Телефон</th>
                        <th class="px-5 py-3">Источник</th>
                        <th class="px-5 py-3 text-right"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for store in stores %}
                        <tr>
                            <td class="px-5 py-3">{{ store.address }}</td>
                            <td class="px-5 py-3">{{ store.city }}</td>
                            <td class="px-5 py-3">{{ store.workHours }}</td>
                            <td class="px-5 py-3">{{ store.phone }}</td>
                            <td class="px-5 py-3">
                                {% if store.source == 'owner' %}
                                    <span class="rounded bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">владелец</span>
                                {% else %}
                                    <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700" title="Найдено автоматически — проверьте и сохраните, чтобы закрепить">авто</span>
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap px-5 py-3 text-right">
                                <a href="{{ path('brand_stores', {edit: store.id}) }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Изменить</a>
                                <form method="post" action="{{ path('brand_stores_delete', {id: store.id}) }}" class="inline"
                                      onsubmit="return confirm('Удалить магазин?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('brand_stores') }}">
                                    <button type="submit" class="rounded-lg border border-red-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="px-5 py-4 text-xs text-gray-500">
            «Авто» — точки, найденные автоматическим обогащением. Нажмите «Изменить» и сохраните,
            чтобы подтвердить данные как владелец — тогда они не будут перезаписаны и скрыты голосами посетителей.
        </p>
    {% endif %}
</div>
{% endblock %}
