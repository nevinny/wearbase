{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Медиа — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
<div class="mb-5 flex items-center justify-between">
    <h1 class="text-lg font-bold">Медиа</h1>
</div>

<div class="mb-6 rounded-2xl bg-white shadow-sm">
    <div class="p-5">
        <h2 class="mb-3 text-sm font-semibold">Загрузить изображения</h2>
        <div id="upload-area"
             class="cursor-pointer rounded-xl border-2 border-dashed border-gray-300 px-3 py-12 text-center text-gray-500">
            <div class="mb-2 text-3xl">☁️</div>
            <div>Перетащите файлы или <span class="font-semibold text-gray-900">выберите</span></div>
            <div class="text-xs">JPG, PNG, WebP — до 5 МБ каждый</div>
            <input type="file" id="file-input" multiple accept="image/*" class="hidden">
        </div>
        <div id="upload-progress" class="mt-3 hidden">
            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100">
                <div id="progress-bar" class="h-full bg-gray-900 transition-all" style="width:0%"></div>
            </div>
        </div>
    </div>
</div>

<div class="overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
        Галерея ({{ images|length }})
    </div>
    <div class="p-5">
        {% if images|length == 0 %}
            <div class="py-14 text-center text-gray-500">Изображений пока нет</div>
        {% else %}
            <div id="gallery" class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
                {% for image in images %}
                <div data-id="{{ image.id }}">
                    <div class="group relative overflow-hidden rounded-lg border border-gray-200">
                        {% if image.preview %}
                            <img src="{{ vich_uploader_asset(image, 'previewFile') }}"
                                 class="h-40 w-full object-cover"
                                 alt="">
                        {% elseif image.image %}
                            <img src="{{ vich_uploader_asset(image, 'imageFile') }}"
                                 class="h-40 w-full object-cover"
                                 alt="">
                        {% endif %}
                        <button class="delete-btn absolute right-1 top-1 rounded-md bg-red-600 px-2 py-1 text-xs font-semibold text-white hover:bg-red-700 transition"
                                data-id="{{ image.id }}"
                                title="Удалить">
                            ✕
                        </button>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
<script>
const uploadUrl  = '{{ path('brand_media_upload') }}';
const deleteBase = '{{ path('brand_media_delete', {id: 0}) }}'.replace('/0', '/');
const sortUrl    = '{{ path('brand_media_sort') }}';
const csrfToken  = '{{ csrf_token('brand_media') }}';

// Drag & drop
const area = document.getElementById('upload-area');
const fileInput = document.getElementById('file-input');

area.addEventListener('click', () => fileInput.click());
area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('bg-gray-100'); });
area.addEventListener('dragleave', () => area.classList.remove('bg-gray-100'));
area.addEventListener('drop', e => {
    e.preventDefault();
    area.classList.remove('bg-gray-100');
    uploadFiles(e.dataTransfer.files);
});
fileInput.addEventListener('change', () => uploadFiles(fileInput.files));

function uploadFiles(files) {
    const formData = new FormData();
    [...files].forEach(f => formData.append('images[]', f));

    const progress = document.getElementById('upload-progress');
    const bar = document.getElementById('progress-bar');
    progress.classList.remove('hidden');
    bar.style.width = '0%';

    const xhr = new XMLHttpRequest();
    xhr.upload.onprogress = e => {
        if (e.lengthComputable) bar.style.width = Math.round(e.loaded / e.total * 100) + '%';
    };
    xhr.onload = () => {
        if (xhr.status === 200) {
            let data = {};
            try { data = JSON.parse(xhr.responseText); } catch (e) {}
            if (data.limit_reached) {
                alert('Часть файлов не загружена — достигнут лимит изображений тарифа.');
            }
            window.location.reload();
        } else {
            let msg = 'Ошибка загрузки';
            try { msg = JSON.parse(xhr.responseText).error || msg; } catch (e) {}
            alert(msg);
            progress.classList.add('hidden');
        }
    };
    xhr.onerror = () => { alert('Сеть недоступна, загрузка не выполнена'); progress.classList.add('hidden'); };
    xhr.open('POST', uploadUrl);
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    xhr.setRequestHeader('X-CSRF-Token', csrfToken);
    xhr.send(formData);
}

// Удаление
document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('Удалить изображение?')) return;
        try {
            const resp = await fetch(deleteBase + btn.dataset.id, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken }
            });
            if (resp.ok) {
                btn.closest('[data-id]').remove();
            } else {
                alert('Не удалось удалить изображение');
            }
        } catch (err) {
            alert('Сеть недоступна');
        }
    });
});

// Сортировка (drag & drop)
const gallery = document.getElementById('gallery');
if (gallery) {
    Sortable.create(gallery, {
        animation: 150,
        onEnd: async () => {
            const order = [...gallery.querySelectorAll('[data-id]')].map(el => +el.dataset.id);
            await fetch(sortUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ order })
            });
        }
    });
}
</script>
{% endblock %}
