{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Дашборд — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
<div class="mb-5 flex items-center justify-between">
    <h1 class="text-lg font-bold">Дашборд</h1>
    <span class="text-sm text-gray-500">{{ 'now'|date('d.m.Y') }}</span>
</div>

{# ── Готовность приёма оплаты ── #}
{% if not payment_ready %}
<div class="mb-5 flex items-center justify-between rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
    <div>
        ⚠️
        <strong>Онлайн-оплата заказов отключена.</strong>
        Пока не настроен основной счёт приёма, покупатели не смогут оплатить заказ картой.
    </div>
    <a href="{{ path('brand_payment_index') }}" class="ml-3 whitespace-nowrap rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-black transition">Настроить</a>
</div>
{% endif %}

{# ── Подписка (триал) ── #}
{% if subscription is not null and subscription.isOnTrial %}
<div class="mb-5 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-800">
    ℹ️
    Пробный период до {{ subscription.trialEndsAt|date('d.m.Y') }} · тариф «{{ subscription.tariff.name }}».
    <a href="{{ path('brand_setting') }}" class="font-semibold underline hover:no-underline">Тарифы</a>
</div>
{% endif %}

{# ── Метрики ── #}
<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-2xl bg-white p-5 shadow-sm">
        <div class="mb-1 text-sm text-gray-500">Выручка (оплачено)</div>
        <div class="text-2xl font-bold">{{ price(revenue) }}</div>
    </div>
    <a href="{{ path('brand_orders') }}" class="block rounded-2xl bg-white p-5 shadow-sm hover:shadow transition">
        <div class="mb-1 text-sm text-gray-500">Всего заказов</div>
        <div class="text-2xl font-bold">{{ orders_total }}</div>
    </a>
    <a href="{{ path('brand_orders') }}?status=new" class="block rounded-2xl bg-white p-5 shadow-sm hover:shadow transition">
        <div class="mb-1 text-sm text-gray-500">Новые заказы</div>
        <div class="text-2xl font-bold text-red-600">{{ new_orders|length }}</div>
    </a>
    <a href="{{ path('brand_products') }}?filter=low_stock" class="block rounded-2xl bg-white p-5 shadow-sm hover:shadow transition">
        <div class="mb-1 text-sm text-gray-500">Товары без остатка</div>
        <div class="text-2xl font-bold text-amber-500">{{ low_stock|length }}</div>
    </a>
    <a href="{{ path('brand_products') }}" class="block rounded-2xl bg-white p-5 shadow-sm hover:shadow transition">
        <div class="mb-1 text-sm text-gray-500">Опубликовано товаров</div>
        <div class="text-2xl font-bold">{{ products_published }}</div>
    </a>
</div>

{# ── Новые заказы ── #}
{% if new_orders|length > 0 %}
<div class="mb-6 overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
        🔴 Новые заказы ({{ new_orders|length }})
    </div>
    <div class="divide-y divide-gray-100">
        {% for order in new_orders %}
        <a href="{{ path('brand_order_show', {id: order.id}) }}"
           class="flex items-center justify-between px-5 py-3 text-sm hover:bg-gray-50 transition">
            <div>
                <span class="font-semibold">#{{ order.orderNumber }}</span>
                <span class="ml-2 text-xs text-gray-500">{{ order.createdAt|date('d.m H:i') }}</span>
            </div>
            <span class="font-semibold">{{ price(order.totalAmount) }}</span>
        </a>
        {% endfor %}
    </div>
</div>
{% endif %}

{# ── Последние заказы ── #}
<div class="overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3 text-sm font-semibold">
        Последние заказы
        <a href="{{ path('brand_orders') }}" class="text-xs font-medium text-gray-600 hover:text-gray-900">Все →</a>
    </div>
    {% if recent_orders|length > 0 %}
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                <tr>
                    <th class="px-5 py-3">Номер</th>
                    <th class="px-5 py-3">Покупатель</th>
                    <th class="px-5 py-3">Сумма</th>
                    <th class="px-5 py-3">Статус</th>
                    <th class="px-5 py-3">Дата</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
            {% for order in recent_orders %}
            <tr class="hover:bg-gray-50">
                <td class="px-5 py-3"><a href="{{ path('brand_order_show', {id: order.id}) }}" class="font-semibold hover:underline">#{{ order.orderNumber }}</a></td>
                <td class="px-5 py-3">{{ order.customer.fullName }}</td>
                <td class="px-5 py-3">{{ price(order.totalAmount) }}</td>
                <td class="px-5 py-3">
                    <span class="rounded px-2 py-0.5 text-xs font-semibold {{ order.status == 'new' ? 'bg-red-100 text-red-800' : (order.status == 'shipped' ? 'bg-sky-100 text-sky-800' : 'bg-gray-100 text-gray-700') }}">
                        {{ order.statusLabel }}
                    </span>
                </td>
                <td class="px-5 py-3 text-xs text-gray-500">{{ order.createdAt|date('d.m.Y') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
        <div class="py-14 text-center text-gray-500">Заказов пока нет</div>
    {% endif %}
</div>
{% endblock %}
