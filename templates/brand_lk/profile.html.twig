{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Профиль — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set section_class = 'block text-xs font-bold uppercase tracking-wider text-gray-400 mb-3' %}

<h1 class="mb-5 text-lg font-bold">Профиль бренда</h1>

<div class="grid items-start gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-6">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

                {# Основное #}
                <span class="{{ section_class }}">Основное</span>
                <div class="mb-6 grid gap-4">
                    <div>
                        <label class="{{ label_class }}">Название бренда</label>
                        {{ form_widget(form.title, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.title) }}
                    </div>
                    <div>
                        <label class="{{ label_class }}">Короткое описание</label>
                        {{ form_widget(form.anons, {'attr': {'class': input_class, 'rows': 2}}) }}
                        <div class="mt-1 text-xs text-gray-500">Отображается в карточке бренда в каталоге</div>
                        {{ form_errors(form.anons) }}
                    </div>
                    <div>
                        <label class="{{ label_class }}">Полное описание</label>
                        {{ form_widget(form.description, {'attr': {'class': input_class, 'rows': 4}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    <div class="md:w-1/2">
                        <label class="{{ label_class }}">Город</label>
                        {{ form_widget(form.city, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.city) }}
                    </div>
                </div>

                {# Логотип #}
                <span class="{{ section_class }} border-t border-gray-100 pt-5">Логотип</span>
                <div class="mb-6 text-sm">
                    {{ form_widget(form.logoFile) }}
                    <div class="form-error mt-1 text-sm text-red-600">{{ form_errors(form.logoFile) }}</div>
                </div>

                {# Контакты #}
                <span class="{{ section_class }} border-t border-gray-100 pt-5">Контакты</span>
                <div class="mb-6 grid gap-4 md:grid-cols-2">
                    <div>
                        <label class="{{ label_class }}">Email</label>
                        {{ form_widget(form.email, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div>
                        <label class="{{ label_class }}">Телефон</label>
                        {{ form_widget(form.phone, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.phone) }}
                    </div>
                    <div class="md:col-span-2">
                        <label class="{{ label_class }}">Адрес</label>
                        {{ form_widget(form.address, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.address) }}
                    </div>
                </div>

                {# Стили #}
                <span class="{{ section_class }} border-t border-gray-100 pt-5">Стили</span>
                <div class="mb-6 flex flex-wrap gap-2">
                    {% for choice in form.styles %}
                        <div class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2">
                            {{ form_widget(choice, {'attr': {'class': 'h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}
                            {{ form_label(choice, null, {'label_attr': {'class': 'mb-0 text-sm'}}) }}
                        </div>
                    {% endfor %}
                </div>

                {# Аудитория #}
                <span class="{{ section_class }} border-t border-gray-100 pt-5">Аудитория</span>
                <div class="mb-6 flex flex-wrap gap-2">
                    {% for choice in form.audiences %}
                        <div class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2">
                            {{ form_widget(choice, {'attr': {'class': 'h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}
                            {{ form_label(choice, null, {'label_attr': {'class': 'mb-0 text-sm'}}) }}
                        </div>
                    {% endfor %}
                </div>

                <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить</button>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-4">
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-6">
                <span class="{{ section_class }}">Публичная страница</span>
                <div class="mb-3 text-sm text-gray-500">
                    <code class="rounded bg-gray-100 px-2 py-1 text-xs">wearbase.ru/brands/{{ brand.slug }}</code>
                </div>
                <a href="{{ path('brand_show', {slug: brand.slug}) }}" target="_blank"
                   class="block w-full rounded-lg border border-gray-300 px-3 py-1.5 text-center text-sm text-gray-600 hover:bg-gray-50 transition">
                    Посмотреть страницу ↗
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
