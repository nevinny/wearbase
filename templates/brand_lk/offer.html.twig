{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Оферта продавца — {{ brand.title }}{% endblock %}

{% block brand_content %}
<h4 class="mb-3">Оферта продавца</h4>

{% if offer is null %}
    <div class="alert alert-secondary">Действующая редакция оферты продавца пока не опубликована.</div>
{% else %}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">{{ offer.title }}</span>
            <span class="text-muted small">ред. {{ offer.version }} · с {{ offer.effectiveFrom|date('d.m.Y') }}</span>
        </div>
        <div class="card-body">
            {% if accepted %}
                <div class="alert alert-success py-2">
                    <i class="fas fa-check-circle me-1"></i>Вы приняли эту редакцию оферты.
                </div>
            {% endif %}

            <div class="border rounded p-3 mb-3 bg-light" style="white-space:pre-line; max-height:50vh; overflow:auto">{{ offer.content }}</div>

            {% if not accepted %}
                {% if is_owner %}
                    <form method="post" action="{{ path('brand_offer_accept') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('accept_offer') }}">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="agree" required>
                            <label class="form-check-label" for="agree">Я прочитал(а) и принимаю условия оферты от имени бренда</label>
                        </div>
                        <button type="submit" class="btn btn-dark">Принять оферту</button>
                    </form>
                {% else %}
                    <div class="alert alert-warning py-2 mb-0">
                        <i class="fas fa-triangle-exclamation me-1"></i>Принять оферту может только владелец бренда.
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endif %}
{% endblock %}
