{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Оферта продавца — {{ brand.title }}{% endblock %}

{% block brand_content %}
<h1 class="mb-5 text-lg font-bold">Оферта продавца</h1>

{% if offer is null %}
    <div class="rounded-xl bg-gray-100 px-4 py-3 text-sm text-gray-700">Действующая редакция оферты продавца пока не опубликована.</div>
{% else %}
    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3">
            <span class="text-sm font-semibold">{{ offer.title }}</span>
            <span class="text-xs text-gray-500">ред. {{ offer.version }} · с {{ offer.effectiveFrom|date('d.m.Y') }}</span>
        </div>
        <div class="p-5">
            {% if accepted %}
                <div class="mb-4 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800">
                    ✅ Вы приняли эту редакцию оферты.
                </div>
            {% endif %}

            <div class="mb-4 rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm" style="white-space:pre-line; max-height:50vh; overflow:auto">{{ offer.content }}</div>

            {% if not accepted %}
                {% if is_owner %}
                    <form method="post" action="{{ path('brand_offer_accept') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('accept_offer') }}">
                        <div class="mb-4 flex items-start gap-2">
                            <input class="mt-0.5 h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900" type="checkbox" id="agree" required>
                            <label class="text-sm" for="agree">Я прочитал(а) и принимаю условия оферты от имени бренда</label>
                        </div>
                        <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Принять оферту</button>
                    </form>
                {% else %}
                    <div class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                        ⚠️ Принять оферту может только владелец бренда.
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endif %}
{% endblock %}
