{% extends 'tailwind/app.html.twig' %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="flex min-h-screen">

    {# ── Sidebar ── #}
    {% set route = app.request.attributes.get('_route') %}
    {% set lk_item = 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/10 hover:text-white transition' %}
    {% set lk_active = 'flex items-center gap-2 rounded-lg bg-white/15 px-3 py-2 text-sm font-semibold text-white' %}
    <nav class="hidden w-60 shrink-0 flex-col bg-gray-900 py-6 md:flex">
        <div class="mb-6 px-4">
            {% if brand.logo %}
                <img src="{{ vich_uploader_asset(brand, 'logoFile') }}"
                     alt="{{ brand.title }}" class="mb-2 max-h-[50px] rounded" >
            {% endif %}
            <div class="font-bold text-white">{{ brand.title }}</div>
            <a href="{{ path('brand_show', {slug: brand.slug, _locale: 'ru'}) }}" target="_blank"
               class="text-xs text-white/50 hover:text-white/80">wearbase.ru/brands/{{ brand.slug }} ↗</a>
        </div>

        <ul class="flex flex-col gap-1 px-3">
            <li><a class="{{ route starts with 'brand_dashboard' ? lk_active : lk_item }}" href="{{ path('brand_dashboard') }}">Дашборд</a></li>
            <li><a class="{{ route starts with 'brand_profile' ? lk_active : lk_item }}" href="{{ path('brand_profile') }}">Профиль бренда</a></li>
            <li><a class="{{ route starts with 'brand_media' ? lk_active : lk_item }}" href="{{ path('brand_media') }}">Медиа</a></li>
            <li><a class="{{ route starts with 'brand_product' ? lk_active : lk_item }}" href="{{ path('brand_products') }}">Товары</a></li>
            <li><a class="{{ route starts with 'brand_stores' ? lk_active : lk_item }}" href="{{ path('brand_stores') }}">Магазины</a></li>
            <li>
                <a class="{{ route starts with 'brand_order' ? lk_active : lk_item }}" href="{{ path('brand_orders') }}">
                    Заказы
                    {% set new_orders_count = brand_new_orders_count() %}
                    {% if new_orders_count > 0 %}
                        <span class="ml-auto rounded-full bg-red-600 px-1.5 text-[10px] font-semibold text-white">{{ new_orders_count }}</span>
                    {% endif %}
                </a>
            </li>
            <li><a class="{{ route starts with 'brand_team' ? lk_active : lk_item }}" href="{{ path('brand_team') }}">Команда</a></li>
            <li>
                <a class="{{ route == 'brand_notification' ? lk_active : lk_item }}" href="{{ path('brand_notification') }}">
                    Уведомления
                    {% set unread_count = brand_unread_notifications_count() %}
                    {% if unread_count > 0 %}
                        <span class="ml-auto rounded-full bg-red-600 px-1.5 text-[10px] font-semibold text-white">{{ unread_count }}</span>
                    {% endif %}
                </a>
            </li>
            <li><a class="{{ route starts with 'brand_payment_' ? lk_active : lk_item }}" href="{{ path('brand_payment_index') }}">Реквизиты и оплата</a></li>
            <li>
                <a class="{{ route == 'brand_offer' ? lk_active : lk_item }}" href="{{ path('brand_offer') }}">
                    Оферта
                    {% if brand_seller_offer_pending() %}<span class="ml-auto rounded bg-amber-400 px-1.5 text-[10px] font-bold text-gray-900">!</span>{% endif %}
                </a>
            </li>
            <li><a class="{{ route == 'brand_setting' ? lk_active : lk_item }}" href="{{ path('brand_setting') }}">Настройки</a></li>

            <li class="mt-4 px-2"><hr class="border-white/15"></li>
            <li><a class="{{ lk_item }} text-white/50" href="{{ path('app_logout') }}">Выйти</a></li>
        </ul>
    </nav>

    {# ── Main content ── #}
    <main class="min-w-0 flex-1 bg-gray-50 px-4 py-6 md:px-8">

        {# Флеши показываются глобально в tailwind/app.html.twig #}

        {% if app.request.attributes.get('_route') != 'brand_offer' and brand_seller_offer_pending() %}
            <div class="mb-5 flex items-center justify-between rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                <div>📝 Примите оферту продавца, чтобы продолжить работу с площадкой.</div>
                <a href="{{ path('brand_offer') }}"
                   class="ml-3 whitespace-nowrap rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-black transition">Открыть оферту</a>
            </div>
        {% endif %}

        {% block brand_content %}{% endblock %}

    </main>
</div>
{% endblock %}
