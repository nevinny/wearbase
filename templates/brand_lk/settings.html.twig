{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Настройки — {{ brand.title }}{% endblock %}

{% block brand_content %}
<h1 class="mb-5 text-lg font-bold">Настройки бренда</h1>

<div class="grid items-start gap-6 md:grid-cols-2">

    {# ── Тариф и подписка ── #}
    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
            💳 Тариф и подписка
        </div>
        <div class="p-5">
            {% if subscription %}
                <div class="mb-4">
                    <span class="mb-2 mr-1 inline-block rounded bg-gray-900 px-2 py-0.5 text-xs font-semibold text-white">{{ subscription.tariff.name }}</span>
                    {% if subscription.isOnTrial %}
                        <span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Пробный период</span>
                    {% elseif subscription.status == 'active' %}
                        <span class="rounded bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Активен</span>
                    {% endif %}
                    <p class="mt-2 text-xs text-gray-500">
                        Действует до: {{ subscription.currentPeriodEnd|date('d.m.Y') }}
                    </p>
                </div>
            {% else %}
                <div class="py-3 text-center">
                    <p class="mb-3 text-sm text-gray-500">У бренда нет активной подписки</p>
                </div>
            {% endif %}

            <hr class="my-4 border-gray-100">

            <h2 class="mb-3 text-sm font-semibold">Доступные тарифы</h2>
            {% for tariff in tariffs %}
                <div class="mb-2 flex items-center justify-between rounded-lg border border-gray-200 p-4">
                    <div>
                        <strong class="text-sm">{{ tariff.name }}</strong>
                        <span class="block text-xs text-gray-500">{{ tariff.description }}</span>
                        {% if tariff.maxProducts %}
                            <small class="text-xs text-gray-500">до {{ tariff.maxProducts }} товаров</small>
                        {% else %}
                            <small class="text-xs text-gray-500">безлимит товаров</small>
                        {% endif %}
                    </div>
                    <div class="text-right">
                        <div class="text-sm font-bold">
                            {% if tariff.priceRub > 0 %}
                                {{ tariff.priceRub|number_format(0, '.', ' ') }} ₽/мес
                            {% else %}
                                Бесплатно
                            {% endif %}
                        </div>
                        {% if subscription and subscription.tariff.id == tariff.id %}
                            <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">Текущий</span>
                        {% elseif tariff.priceRub > 0 and subscription and subscription.tariff.code == 'free' %}
                            <form method="post" action="{{ path('payment_subscribe', {subscriptionId: subscription.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('subscribe') }}">
                                <input type="hidden" name="tariff_id" value="{{ tariff.id }}">
                                <button class="mt-1 rounded-lg bg-gray-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-black transition">Перейти</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# ── Внешний вид ── #}
    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
            🎨 Внешний вид
        </div>
        <div class="p-5 py-14 text-center">
            <p class="mb-3 text-sm text-gray-500">Настройка витрины и отображения бренда</p>
            <button class="cursor-not-allowed rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-400" disabled>Скоро</button>
        </div>
    </div>

</div>
{% endblock %}
