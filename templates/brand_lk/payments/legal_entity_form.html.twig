{% extends 'brand_lk/layout.html.twig' %}

{% block title %}{{ entity.id ? 'Юр.лицо' : 'Новое юр.лицо' }} — {{ brand.title }}{% endblock %}

{% block brand_content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">{{ entity.id ? 'Редактирование юр.лица' : 'Новое юр.лицо' }}</h4>
    <a href="{{ path('brand_payment_index') }}" class="btn btn-outline-secondary btn-sm">Назад</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.legalForm, {'attr': {'class': 'form-select'}}) }}</div>
                    <div class="col-md-8">{{ form_row(form.legalName, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.inn, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.kpp, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.ogrn, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-12">{{ form_row(form.legalAddress, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.effectiveFrom, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.effectiveTo, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-4">{{ form_row(form.status, {'attr': {'class': 'form-select'}}) }}</div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-dark">Сохранить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
