{% extends 'brand_lk/layout.html.twig' %}

{% block title %}Реквизиты и оплата — {{ brand.title }}{% endblock %}

{% block brand_content %}
<div class="mb-4 flex items-center justify-between">
    <h1 class="text-lg font-bold">Реквизиты и оплата</h1>
    <a href="{{ path('brand_payment_le_new') }}" class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-black transition">
        + Юр.лицо
    </a>
</div>

<p class="mb-4 text-sm text-gray-500">
    Деньги за заказы уходят напрямую вашему юр.лицу через выбранную платёжку — площадка их не удерживает.
    Отметьте один счёт как <strong>основной</strong> — через него и принимается оплата.
</p>

{% if not cipher_ready %}
    <div class="mb-5 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
        ⚠️
        Шифрование секретов не настроено на сервере (<code>PAYMENT_SECRET_KEY</code>) — сохранить секретный ключ платёжки нельзя. Обратитесь в поддержку.
    </div>
{% endif %}

{% if legal_entities is empty %}
    <div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
        Пока нет ни одного юр.лица. Добавьте его, чтобы принимать оплату.
    </div>
{% endif %}

{% for entity in legal_entities %}
    <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3">
            <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-sm font-semibold">{{ entity.legalName }}</span>
                <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">{{ entity.legalForm|upper }}</span>
                {% if entity.status == 'active' %}
                    <span class="rounded bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">Активно</span>
                {% else %}
                    <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">В архиве</span>
                {% endif %}
                {% if entity.isIdentified %}<span class="rounded bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-800">Идентифицировано</span>{% endif %}
            </div>
            <div class="flex gap-1">
                <a href="{{ path('brand_payment_le_edit', {id: entity.id}) }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition" title="Изменить">
                    ✏️
                </a>
                <form method="post" action="{{ path('brand_payment_le_delete', {id: entity.id}) }}"
                      onsubmit="return confirm('Удалить юр.лицо и все его счета?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('le_delete_' ~ entity.id) }}">
                    <button class="rounded-lg border border-red-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition" title="Удалить">🗑</button>
                </form>
            </div>
        </div>
        <div class="p-5">
            <div class="mb-4 text-xs text-gray-500">
                {% if entity.inn %}ИНН {{ entity.inn }}{% endif %}
                {% if entity.ogrn %} · ОГРН {{ entity.ogrn }}{% endif %}
                {% if entity.legalAddress %}<br>{{ entity.legalAddress }}{% endif %}
            </div>

            <div class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-500">Счета приёма оплаты</div>

            {# Подключение платёжек: активные провайдеры, ещё не подключённые к этому юр.лицу #}
            {% set connected_codes = entity.paymentAccounts|map(a => a.provider.code) %}
            <div class="mb-4 flex flex-wrap gap-2">
                {% for p in available_providers %}
                    {% if p.code not in connected_codes %}
                        <a href="{{ path('brand_payment_acc_new', {entityId: entity.id, provider: p.code}) }}"
                           class="rounded-lg border border-gray-900 px-3 py-1.5 text-sm text-gray-900 hover:bg-gray-900 hover:text-white transition">
                            🔌 Подключить {{ p.name }}
                        </a>
                    {% endif %}
                {% endfor %}
                {% if available_providers is empty %}
                    <span class="text-xs text-gray-500">Нет доступных платёжек — обратитесь в поддержку.</span>
                {% endif %}
            </div>

            {% if entity.paymentAccounts is empty %}
                <div class="text-xs text-gray-500">Счетов нет — оплата заказов через это юр.лицо невозможна.</div>
            {% else %}
                <div class="overflow-x-auto rounded-lg border border-gray-100">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                            <tr>
                                <th class="px-4 py-2">Платёжка</th><th class="px-4 py-2">Схема</th><th class="px-4 py-2">Идентификатор</th><th class="px-4 py-2">Ключ</th><th class="px-4 py-2"></th><th class="px-4 py-2"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                        {% for acc in entity.paymentAccounts %}
                            <tr>
                                <td class="px-4 py-2">{{ acc.provider.name }}</td>
                                <td class="px-4 py-2 text-xs">{{ acc.mode == 'direct' ? 'Прямой' : 'Сплит' }}</td>
                                <td class="px-4 py-2 text-xs">{{ acc.accountRef ?: '—' }}</td>
                                <td class="px-4 py-2 text-xs">{{ acc.secretEncrypted ? '••• задан' : '— не задан' }}</td>
                                <td class="px-4 py-2">
                                    {% if acc.primary %}<span class="rounded bg-gray-900 px-2 py-0.5 text-xs font-semibold text-white">основной</span>{% endif %}
                                    {% if acc.status == 'disabled' %}<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">отключён</span>{% endif %}
                                </td>
                                <td class="whitespace-nowrap px-4 py-2 text-right">
                                    <a href="{{ path('brand_payment_acc_edit', {id: acc.id}) }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition" title="Изменить">
                                        ✏️
                                    </a>
                                    <form method="post" action="{{ path('brand_payment_acc_delete', {id: acc.id}) }}"
                                          onsubmit="return confirm('Удалить счёт?');" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('acc_delete_' ~ acc.id) }}">
                                        <button class="rounded-lg border border-red-300 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition" title="Удалить">🗑</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endfor %}
{% endblock %}
