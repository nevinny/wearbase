{% extends 'brand_lk/layout.html.twig' %}

{% block title %}{{ account.id ? 'Счёт приёма' : 'Новый счёт' }} — {{ brand.title }}{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}

<div class="mb-4 flex items-center justify-between">
    <h1 class="text-lg font-bold">{{ account.id ? 'Редактирование счёта' : 'Новый счёт приёма' }}</h1>
    <a href="{{ path('brand_payment_index') }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Назад</a>
</div>

<p class="mb-4 text-sm text-gray-500">Юр.лицо: <strong>{{ legal_entity.legalName }}</strong></p>

<div class="grid items-start gap-6 lg:grid-cols-12">
    <div class="lg:col-span-7">
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-6">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="grid gap-4 md:grid-cols-2">
                    <div>{{ form_row(form.provider, {'attr': {'class': input_class}}) }}</div>
                    <div>{{ form_row(form.mode, {'attr': {'class': input_class}}) }}</div>
                    <div class="md:col-span-2">{{ form_row(form.accountRef, {'attr': {'class': input_class}}) }}</div>
                    <div class="md:col-span-2">{{ form_row(form.secret, {'attr': {'class': input_class}}) }}</div>
                    <div class="flex items-center">{{ form_row(form.isPrimary, {'attr': {'class': 'h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}</div>
                    <div>{{ form_row(form.status, {'attr': {'class': input_class}}) }}</div>
                </div>
                <div class="mt-5">
                    <button class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# Подсказки по реквизитам провайдера #}
    <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Что вводить в реквизиты</div>
            <div class="p-5">
                {% set sel = account.provider.code|default(null) %}
                {% if sel and provider_hints[sel] is defined %}
                    {% set h = provider_hints[sel] %}
                    <p class="mb-2 text-sm"><strong>{{ account.provider.name }}</strong></p>
                    <ul class="mb-2 list-disc pl-5 text-xs">
                        <li><span class="text-gray-500">Идентификатор</span> — {{ h.ref }}</li>
                        <li><span class="text-gray-500">Секретный ключ</span> — {{ h.secret }}</li>
                    </ul>
                    {% if h.note %}<div class="rounded-xl bg-sky-50 px-4 py-3 text-xs text-sky-800">{{ h.note }}</div>{% endif %}
                {% else %}
                    <p class="mb-2 text-xs text-gray-500">Выберите платёжку — покажем, что вписать.</p>
                {% endif %}

                <details class="mt-3">
                    <summary class="cursor-pointer text-xs text-gray-500">Все платёжки</summary>
                    <ul class="mt-2 list-disc pl-5 text-xs">
                        {% for code, h in provider_hints %}
                            <li class="mb-1"><code>{{ code }}</code>: идентификатор — {{ h.ref }}; ключ — {{ h.secret }}</li>
                        {% endfor %}
                    </ul>
                </details>
            </div>
        </div>
    </div>
</div>
{% endblock %}
