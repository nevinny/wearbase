{% extends 'brand_lk/layout.html.twig' %}

{% block title %}{{ account.id ? 'Счёт приёма' : 'Новый счёт' }} — {{ brand.title }}{% endblock %}

{% block brand_content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">{{ account.id ? 'Редактирование счёта' : 'Новый счёт приёма' }}</h4>
    <a href="{{ path('brand_payment_index') }}" class="btn btn-outline-secondary btn-sm">Назад</a>
</div>

<p class="text-muted small">Юр.лицо: <strong>{{ legal_entity.legalName }}</strong></p>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.provider, {'attr': {'class': 'form-select'}}) }}</div>
                    <div class="col-md-6">{{ form_row(form.mode, {'attr': {'class': 'form-select'}}) }}</div>
                    <div class="col-12">{{ form_row(form.accountRef, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-12">{{ form_row(form.secret, {'attr': {'class': 'form-control'}}) }}</div>
                    <div class="col-md-6 d-flex align-items-center">{{ form_row(form.isPrimary, {'attr': {'class': 'form-check-input'}}) }}</div>
                    <div class="col-md-6">{{ form_row(form.status, {'attr': {'class': 'form-select'}}) }}</div>
                </div>
                <div class="mt-4">
                    <button class="btn btn-dark">Сохранить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# Подсказки по реквизитам провайдера #}
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Что вводить в реквизиты</div>
            <div class="card-body">
                {% set sel = account.provider.code|default(null) %}
                {% if sel and provider_hints[sel] is defined %}
                    {% set h = provider_hints[sel] %}
                    <p class="mb-2"><strong>{{ account.provider.name }}</strong></p>
                    <ul class="small mb-2">
                        <li><span class="text-muted">Идентификатор</span> — {{ h.ref }}</li>
                        <li><span class="text-muted">Секретный ключ</span> — {{ h.secret }}</li>
                    </ul>
                    {% if h.note %}<div class="alert alert-info py-2 small mb-0">{{ h.note }}</div>{% endif %}
                {% else %}
                    <p class="small text-muted mb-2">Выберите платёжку — покажем, что вписать.</p>
                {% endif %}

                <details class="mt-3">
                    <summary class="small text-muted" style="cursor:pointer">Все платёжки</summary>
                    <ul class="small mt-2 mb-0">
                        {% for code, h in provider_hints %}
                            <li class="mb-1"><code>{{ code }}</code>: идентификатор — {{ h.ref }}; ключ — {{ h.secret }}</li>
                        {% endfor %}
                    </ul>
                </details>
            </div>
        </div>
    </div>
</div>
{% endblock %}
