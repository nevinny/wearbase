{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Переводы — {{ product.title }}{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500">
        <li><a href="{{ path('brand_products') }}" class="hover:text-gray-900 hover:underline">Товары</a></li>
        <li class="text-gray-400">/</li>
        <li><a href="{{ path('brand_product_edit', {id: product.id}) }}" class="hover:text-gray-900 hover:underline">{{ product.title }}</a></li>
        <li class="text-gray-400">/</li>
        <li class="font-semibold text-gray-900">Переводы</li>
    </ol>
</nav>

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('product_translations') }}">
    {% for lang in locales %}
        {% if lang.code != 'ru' %}
            {% set t = existing[lang.code] ?? null %}
            <div class="mb-6 overflow-hidden rounded-2xl bg-white shadow-sm">
                <div class="flex items-center gap-2 border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                    <span class="flag">{{ lang.code == 'en' ? '🇬🇧' : (lang.code == 'zh' ? '🇨🇳' : (lang.code == 'ar' ? '🇸🇦' : (lang.code == 'de' ? '🇩🇪' : (lang.code == 'fr' ? '🇫🇷' : (lang.code == 'es' ? '🇪🇸' : (lang.code == 'tr' ? '🇹🇷' : (lang.code == 'ko' ? '🇰🇷' : '🌐'))))))) }}</span>
                    {{ lang.nativeName }} ({{ lang.code }})
                </div>
                <div class="p-6">
                    <div class="mb-4">
                        <label class="{{ label_class }}">Название</label>
                        <input type="text" name="trans_{{ lang.code }}[title]"
                               class="{{ input_class }}" value="{{ t ? t.title : '' }}">
                    </div>
                    <div class="mb-4">
                        <label class="{{ label_class }}">Анонс</label>
                        <input type="text" name="trans_{{ lang.code }}[anons]"
                               class="{{ input_class }}" value="{{ t ? t.anons : '' }}">
                    </div>
                    <div class="mb-4">
                        <label class="{{ label_class }}">Описание</label>
                        <textarea name="trans_{{ lang.code }}[description]"
                                  class="{{ input_class }}" rows="4">{{ t ? t.description : '' }}</textarea>
                    </div>
                    <div class="mb-4">
                        <label class="{{ label_class }}">Meta Title</label>
                        <input type="text" name="trans_{{ lang.code }}[metaTitle]"
                               class="{{ input_class }}" value="{{ t ? t.metaTitle : '' }}">
                    </div>
                    <div>
                        <label class="{{ label_class }}">Meta Description</label>
                        <textarea name="trans_{{ lang.code }}[metaDescription]"
                                  class="{{ input_class }}" rows="2">{{ t ? t.metaDescription : '' }}</textarea>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    <div class="flex items-center gap-2">
        <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">
            💾 Сохранить переводы
        </button>
        <a href="{{ path('brand_product_edit', {id: product.id}) }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Назад к товару</a>
    </div>
</form>
{% endblock %}
