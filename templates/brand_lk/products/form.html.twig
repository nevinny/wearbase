{% extends 'brand_lk/layout.html.twig' %}
{% block title %}{{ title }} — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}

<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('brand_products') }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">
        ← К товарам
    </a>
    <h1 class="text-lg font-bold">{{ title }}</h1>
</div>

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="grid items-start gap-6 lg:grid-cols-3">

    {# Левая колонка — основные данные #}
    <div class="lg:col-span-2">

        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Основная информация</div>
            <div class="p-6">

                <div class="mb-4">
                    {{ form_label(form.title, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.title, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.anons, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.anons, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.anons) }}
                    <div class="mt-1 text-xs text-gray-500">Отображается в карточке товара в каталоге</div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.description, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.description, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.description) }}
                </div>

            </div>
        </div>

        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">SEO</div>
            <div class="p-6">
                <div class="mb-4">
                    {{ form_label(form.metaTitle, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.metaTitle, {'attr': {'class': input_class, 'placeholder': 'По умолчанию — название товара'}}) }}
                    {{ form_errors(form.metaTitle) }}
                </div>
                <div>
                    {{ form_label(form.metaDescription, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.metaDescription, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.metaDescription) }}
                </div>
            </div>
        </div>

    </div>

    {# Правая колонка — атрибуты #}
    <div>

        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Классификация</div>
            <div class="p-6">

                <div class="mb-4">
                    {{ form_label(form.category, null, {'label_attr': {'class': label_class}}) }}
                    {{ form_widget(form.category, {'attr': {'class': input_class}}) }}
                    {{ form_errors(form.category) }}
                </div>

                <div>
                    <div class="{{ label_class }} mb-2">Аудитория</div>
                    {% for child in form.gender %}
                    <div class="mb-1 flex items-center gap-2">
                        {{ form_widget(child, {'attr': {'class': 'h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'text-sm'}}) }}
                    </div>
                    {% endfor %}
                    {{ form_errors(form.gender) }}
                </div>

            </div>
        </div>

        <div class="mb-4 overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Стили</div>
            <div class="p-6">
                {% if form.styles|length > 0 %}
                    <div class="flex flex-wrap gap-2">
                    {% for child in form.styles %}
                        <div class="flex items-center gap-2 rounded-lg border border-gray-200 px-2 py-1">
                            {{ form_widget(child, {'attr': {'class': 'h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}
                            {{ form_label(child, null, {'label_attr': {'class': 'text-sm'}}) }}
                        </div>
                    {% endfor %}
                    </div>
                {% else %}
                    <p class="text-xs text-gray-500">Стили не добавлены в справочник</p>
                {% endif %}
                {{ form_errors(form.styles) }}
            </div>
        </div>

        <div class="grid gap-2">
            <button type="submit" class="rounded-xl bg-gray-900 px-5 py-3 text-sm font-semibold text-white hover:bg-black transition">
                💾 {{ product.id ? 'Сохранить изменения' : 'Создать товар' }}
            </button>
            {% if product.id %}
            <a href="{{ path('brand_product_variants', {id: product.id}) }}" class="rounded-lg border border-gray-300 px-3 py-2 text-center text-sm text-gray-600 hover:bg-gray-50 transition">
                Варианты
            </a>
            <a href="{{ path('brand_product_images', {id: product.id}) }}" class="rounded-lg border border-gray-300 px-3 py-2 text-center text-sm text-gray-600 hover:bg-gray-50 transition">
                Фотографии
            </a>
            <a href="{{ path('brand_product_translations', {id: product.id}) }}" class="rounded-lg border border-gray-300 px-3 py-2 text-center text-sm text-gray-600 hover:bg-gray-50 transition">
                Переводы
            </a>
            {% endif %}
            <a href="{{ path('brand_products') }}" class="py-1 text-center text-sm text-gray-500 hover:text-gray-700 hover:underline">Отмена</a>
        </div>

    </div>
</div>

{{ form_end(form) }}
{% endblock %}
