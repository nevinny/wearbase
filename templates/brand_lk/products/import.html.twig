{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Импорт товаров — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('brand_products') }}" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Товары
    </a>
    <h1 class="h5 fw-bold mb-0">Импорт товаров</h1>
</div>

<div class="row g-4">

    {# ── Загрузка файла ── #}
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="fas fa-file-upload me-2 text-muted"></i>Загрузить файл
            </div>
            <div class="card-body p-4">

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show border-0 small" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" enctype="multipart/form-data" id="import-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('product_import') }}">

                    {# Drag-and-drop zone #}
                    <div id="drop-zone"
                         class="border rounded-3 text-center p-5 mb-3"
                         style="border-style:dashed!important;border-color:#ddd!important;cursor:pointer;transition:background .15s">
                        <div id="drop-icon">
                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3 d-block opacity-50"></i>
                            <p class="mb-1 fw-semibold">Перетащите файл сюда</p>
                            <p class="text-muted small mb-3">или нажмите для выбора</p>
                            <span class="badge bg-light text-dark border">.xlsx</span>
                            <span class="badge bg-light text-dark border ms-1">.csv</span>
                        </div>
                        <div id="drop-selected" class="d-none">
                            <i class="fas fa-file-excel fa-2x text-success mb-2 d-block"></i>
                            <p class="fw-semibold mb-0" id="drop-filename"></p>
                            <p class="text-muted small" id="drop-filesize"></p>
                        </div>
                        <input type="file" id="import_file" name="import_file"
                               accept=".xlsx,.xls,.csv"
                               class="d-none" required>
                    </div>

                    <button type="submit" id="submit-btn"
                            class="btn btn-dark w-100 fw-semibold" disabled>
                        <i class="fas fa-upload me-2"></i>Загрузить и импортировать
                    </button>

                </form>

                <div id="progress-wrap" class="d-none mt-3">
                    <div class="progress" style="height:4px">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-dark w-100"></div>
                    </div>
                    <p class="text-muted small text-center mt-2 mb-0">Импортируем товары...</p>
                </div>

            </div>
        </div>

        {# Ограничения #}
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body p-3">
                <div class="d-flex gap-3 text-muted small">
                    <i class="fas fa-info-circle mt-1 flex-shrink-0"></i>
                    <div>
                        <div class="mb-1">Максимум <strong>1 000 строк</strong> (вариантов) за одну загрузку.</div>
                        <div class="mb-1">При повторном импорте: если артикул (SKU) уже есть — вариант <strong>обновляется</strong>, не дублируется.</div>
                        <div>Фотографии добавляются отдельно через страницу товара.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Правая колонка: справка ── #}
    <div class="col-lg-5 d-flex flex-column gap-3">

        {# Скачать шаблон #}
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-dark d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px">
                        <i class="fas fa-file-excel text-white"></i>
                    </div>
                    <div>
                        <div class="fw-semibold mb-1">Шаблон импорта</div>
                        <p class="text-muted small mb-3">
                            Готовый Excel-файл с нужными колонками, примерами и инструкцией.
                        </p>
                        <a href="{{ path('brand_product_import_template') }}"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-download me-1"></i>Скачать шаблон .xlsx
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Колонки #}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold small">Колонки файла</div>
            <div class="list-group list-group-flush" style="font-size:.82rem">
                {% set cols = [
                    ['Название товара',  true,  'Строки с одинаковым названием → один товар'],
                    ['Категория',        false, 'Слаг: tshirts, hoodies, pants...'],
                    ['Пол',              false, 'women / men / unisex'],
                    ['Краткое описание', false, 'До 500 символов'],
                    ['Описание',         false, 'Полное описание'],
                    ['Артикул (SKU)',     true,  'По нему обновляются варианты'],
                    ['Размер',           false, 'XS / S / M / L / 42 / 44...'],
                    ['Цвет',             false, 'Название: Чёрный'],
                    ['Цвет HEX',         false, '#000000'],
                    ['Цена (₽)',         true,  'Цена продажи'],
                    ['Старая цена (₽)',  false, 'Зачёркнутая цена'],
                    ['Остаток',          false, 'Количество на складе'],
                    ['Вес (г)',          false, 'В граммах'],
                ] %}
                {% for col in cols %}
                <div class="list-group-item py-2 px-3 d-flex align-items-start gap-2">
                    <span class="badge {{ col[1] ? 'bg-dark' : 'bg-light text-dark border' }} flex-shrink-0 mt-1"
                          style="font-size:.65rem">{{ col[1] ? 'REQ' : 'opt' }}</span>
                    <div>
                        <div class="fw-semibold">{{ col[0] }}</div>
                        <div class="text-muted" style="font-size:.78rem">{{ col[2] }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# WB-совместимость #}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold small">
                <i class="fas fa-exchange-alt me-1 text-muted"></i>Совместимость с Wildberries
            </div>
            <div class="card-body p-3">
                <p class="text-muted small mb-2">Если у вас выгрузка из WB — переименуйте колонки:</p>
                <table class="table table-sm mb-0" style="font-size:.8rem">
                    <thead>
                        <tr>
                            <th class="text-muted fw-normal">WB</th>
                            <th class="text-muted fw-normal">WEARBASE</th>
                        </tr>
                    </thead>
                    <tbody class="text-muted">
                        <tr><td>Наименование</td><td class="fw-semibold text-dark">Название товара</td></tr>
                        <tr><td>Артикул продавца</td><td class="fw-semibold text-dark">Артикул (SKU)</td></tr>
                        <tr><td>Размер</td><td class="fw-semibold text-dark">Размер</td></tr>
                        <tr><td>Цвет</td><td class="fw-semibold text-dark">Цвет</td></tr>
                        <tr><td>Цена</td><td class="fw-semibold text-dark">Цена (₽)</td></tr>
                        <tr><td>Описание</td><td class="fw-semibold text-dark">Описание</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function () {
    const zone    = document.getElementById('drop-zone');
    const input   = document.getElementById('import_file');
    const btn     = document.getElementById('submit-btn');
    const icon    = document.getElementById('drop-icon');
    const sel     = document.getElementById('drop-selected');
    const fname   = document.getElementById('drop-filename');
    const fsize   = document.getElementById('drop-filesize');
    const form    = document.getElementById('import-form');
    const progress = document.getElementById('progress-wrap');

    function formatBytes(b) {
        if (b < 1024) return b + ' Б';
        if (b < 1048576) return (b / 1024).toFixed(1) + ' КБ';
        return (b / 1048576).toFixed(1) + ' МБ';
    }

    function showFile(file) {
        fname.textContent = file.name;
        fsize.textContent = formatBytes(file.size);
        icon.classList.add('d-none');
        sel.classList.remove('d-none');
        btn.disabled = false;
        zone.style.background = '#f0fdf4';
        zone.style.borderColor = '#22c55e';
    }

    zone.addEventListener('click', () => input.click());

    input.addEventListener('change', () => {
        if (input.files[0]) showFile(input.files[0]);
    });

    zone.addEventListener('dragover', e => {
        e.preventDefault();
        zone.style.background = '#f4f4f5';
    });

    zone.addEventListener('dragleave', () => {
        zone.style.background = '';
    });

    zone.addEventListener('drop', e => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file) {
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            showFile(file);
        }
        zone.style.background = '';
    });

    form.addEventListener('submit', () => {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Загружаем...';
        progress.classList.remove('d-none');
    });
})();
</script>
{% endblock %}
