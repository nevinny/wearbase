{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Импорт товаров — {{ brand.title }} — WEARBASE{% endblock %}

{% block brand_content %}
<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('brand_products') }}" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">
        ← Товары
    </a>
    <h1 class="text-lg font-bold">Импорт товаров</h1>
</div>

<div class="grid items-start gap-6 lg:grid-cols-12">

    {# ── Загрузка файла ── #}
    <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                Загрузить файл
            </div>
            <div class="p-6">

                <form method="post" enctype="multipart/form-data" id="import-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('product_import') }}">

                    {# Drag-and-drop zone #}
                    <div id="drop-zone"
                         class="mb-4 cursor-pointer rounded-xl border-2 border-dashed border-gray-200 p-10 text-center transition-colors">
                        <div id="drop-icon">
                            <div class="mb-3 text-4xl opacity-50">☁️</div>
                            <p class="mb-1 text-sm font-semibold">Перетащите файл сюда</p>
                            <p class="mb-3 text-xs text-gray-500">или нажмите для выбора</p>
                            <span class="rounded border border-gray-200 bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">.xlsx</span>
                            <span class="ml-1 rounded border border-gray-200 bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">.csv</span>
                        </div>
                        <div id="drop-selected" class="hidden">
                            <div class="mb-2 text-3xl">📄</div>
                            <p class="text-sm font-semibold" id="drop-filename"></p>
                            <p class="text-xs text-gray-500" id="drop-filesize"></p>
                        </div>
                        <input type="file" id="import_file" name="import_file"
                               accept=".xlsx,.xls,.csv"
                               class="hidden" required>
                    </div>

                    <button type="submit" id="submit-btn"
                            class="w-full rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition disabled:cursor-not-allowed disabled:opacity-50" disabled>
                        Загрузить и импортировать
                    </button>

                </form>

                <div id="progress-wrap" class="hidden mt-3">
                    <div class="h-1 w-full overflow-hidden rounded-full bg-gray-100">
                        <div class="h-full w-full animate-pulse bg-gray-900"></div>
                    </div>
                    <p class="mt-2 text-center text-xs text-gray-500">Импортируем товары...</p>
                </div>

            </div>
        </div>

        {# Ограничения #}
        <div class="mt-4 rounded-2xl bg-white shadow-sm">
            <div class="p-5">
                <div class="flex gap-3 text-xs text-gray-500">
                    <span class="mt-0.5 shrink-0">ℹ️</span>
                    <div>
                        <div class="mb-1">Максимум <strong>1 000 строк</strong> (вариантов) за одну загрузку.</div>
                        <div class="mb-1">При повторном импорте: если артикул (SKU) уже есть — вариант <strong>обновляется</strong>, не дублируется.</div>
                        <div>Фотографии добавляются отдельно через страницу товара.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Правая колонка: справка ── #}
    <div class="flex flex-col gap-4 lg:col-span-5">

        {# Скачать шаблон #}
        <div class="rounded-2xl bg-white shadow-sm">
            <div class="p-6">
                <div class="flex items-start gap-3">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gray-900 text-lg">
                        📊
                    </div>
                    <div>
                        <div class="mb-1 text-sm font-semibold">Шаблон импорта</div>
                        <p class="mb-3 text-xs text-gray-500">
                            Готовый Excel-файл с нужными колонками, примерами и инструкцией.
                        </p>
                        <a href="{{ path('brand_product_import_template') }}"
                           class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">
                            ⬇ Скачать шаблон .xlsx
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Колонки #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Колонки файла</div>
            <div class="divide-y divide-gray-100 text-[13px]">
                {% set cols = [
                    ['Название товара',  true,  'Строки с одинаковым названием → один товар'],
                    ['Категория',        false, 'Слаг: tshirts, hoodies, pants...'],
                    ['Пол',              false, 'women / men / unisex'],
                    ['Краткое описание', false, 'До 500 символов'],
                    ['Описание',         false, 'Полное описание'],
                    ['Артикул (SKU)',     true,  'По нему обновляются варианты'],
                    ['Размер',           false, 'XS / S / M / L / 42 / 44...'],
                    ['Цвет',             false, 'Название: Чёрный'],
                    ['Цвет HEX',         false, '#000000'],
                    ['Цена (₽)',         true,  'Цена продажи'],
                    ['Старая цена (₽)',  false, 'Зачёркнутая цена'],
                    ['Остаток',          false, 'Количество на складе'],
                    ['Вес (г)',          false, 'В граммах'],
                ] %}
                {% for col in cols %}
                <div class="flex items-start gap-2 px-4 py-2">
                    <span class="mt-0.5 shrink-0 rounded px-1.5 py-0.5 text-[10px] font-semibold {{ col[1] ? 'bg-gray-900 text-white' : 'border border-gray-200 bg-gray-100 text-gray-700' }}">{{ col[1] ? 'REQ' : 'opt' }}</span>
                    <div>
                        <div class="font-semibold">{{ col[0] }}</div>
                        <div class="text-xs text-gray-500">{{ col[2] }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# WB-совместимость #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                Совместимость с Wildberries
            </div>
            <div class="p-5">
                <p class="mb-2 text-xs text-gray-500">Если у вас выгрузка из WB — переименуйте колонки:</p>
                <table class="w-full text-[13px]">
                    <thead>
                        <tr class="text-left">
                            <th class="py-1 font-normal text-gray-500">WB</th>
                            <th class="py-1 font-normal text-gray-500">WEARBASE</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-500">
                        <tr><td class="py-1">Наименование</td><td class="py-1 font-semibold text-gray-900">Название товара</td></tr>
                        <tr><td class="py-1">Артикул продавца</td><td class="py-1 font-semibold text-gray-900">Артикул (SKU)</td></tr>
                        <tr><td class="py-1">Размер</td><td class="py-1 font-semibold text-gray-900">Размер</td></tr>
                        <tr><td class="py-1">Цвет</td><td class="py-1 font-semibold text-gray-900">Цвет</td></tr>
                        <tr><td class="py-1">Цена</td><td class="py-1 font-semibold text-gray-900">Цена (₽)</td></tr>
                        <tr><td class="py-1">Описание</td><td class="py-1 font-semibold text-gray-900">Описание</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
(function () {
    const zone    = document.getElementById('drop-zone');
    const input   = document.getElementById('import_file');
    const btn     = document.getElementById('submit-btn');
    const icon    = document.getElementById('drop-icon');
    const sel     = document.getElementById('drop-selected');
    const fname   = document.getElementById('drop-filename');
    const fsize   = document.getElementById('drop-filesize');
    const form    = document.getElementById('import-form');
    const progress = document.getElementById('progress-wrap');

    function formatBytes(b) {
        if (b < 1024) return b + ' Б';
        if (b < 1048576) return (b / 1024).toFixed(1) + ' КБ';
        return (b / 1048576).toFixed(1) + ' МБ';
    }

    function showFile(file) {
        fname.textContent = file.name;
        fsize.textContent = formatBytes(file.size);
        icon.classList.add('hidden');
        sel.classList.remove('hidden');
        btn.disabled = false;
        zone.style.background = '#f0fdf4';
        zone.style.borderColor = '#22c55e';
    }

    zone.addEventListener('click', () => input.click());

    input.addEventListener('change', () => {
        if (input.files[0]) showFile(input.files[0]);
    });

    zone.addEventListener('dragover', e => {
        e.preventDefault();
        zone.style.background = '#f4f4f5';
    });

    zone.addEventListener('dragleave', () => {
        zone.style.background = '';
    });

    zone.addEventListener('drop', e => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file) {
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            showFile(file);
        }
        zone.style.background = '';
    });

    form.addEventListener('submit', () => {
        btn.disabled = true;
        btn.innerHTML = 'Загружаем...';
        progress.classList.remove('hidden');
    });
})();
</script>
{% endblock %}
