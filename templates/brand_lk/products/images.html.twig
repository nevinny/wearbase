{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Фотографии — {{ product.title }}{% endblock %}

{% block brand_content %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500">
        <li><a href="{{ path('brand_products') }}" class="hover:text-gray-900 hover:underline">Товары</a></li>
        <li class="text-gray-400">/</li>
        <li><a href="{{ path('brand_product_edit', {id: product.id}) }}" class="hover:text-gray-900 hover:underline">{{ product.title }}</a></li>
        <li class="text-gray-400">/</li>
        <li class="font-semibold text-gray-900">Фотографии</li>
    </ol>
</nav>

<div class="mb-6 rounded-2xl bg-white shadow-sm">
    <div class="p-5">
        <div id="upload-area"
             class="cursor-pointer rounded-xl border-2 border-dashed border-gray-300 px-3 py-12 text-center text-gray-500">
            <div class="mb-2 text-3xl">☁️</div>
            <div>Перетащите фото или <span class="font-semibold text-gray-900">выберите</span></div>
            <div class="mt-1 text-xs">Первое фото станет главным. JPG, PNG, WebP — до 5 МБ</div>
            <input type="file" id="file-input" multiple accept="image/*" class="hidden">
        </div>
        <div id="upload-progress" class="mt-3 hidden">
            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100"><div id="progress-bar" class="h-full bg-gray-900 transition-all" style="width:0%"></div></div>
        </div>
    </div>
</div>

<div class="overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3">
        <span class="text-sm font-semibold">Фотографии ({{ product.productImages|length }})</span>
        <span class="text-xs text-gray-500">Перетащите для изменения порядка</span>
    </div>
    <div class="p-5">
        {% if product.productImages|length == 0 %}
            <div class="py-14 text-center text-gray-500">Фотографий пока нет</div>
        {% else %}
        <div id="gallery" class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {% for image in product.productImages|sort((a,b) => a.sort <=> b.sort) %}
            <div data-id="{{ image.id }}">
                <div class="relative cursor-grab overflow-hidden rounded-lg border border-gray-200">
                    {% if image.preview %}
                        <img src="{{ vich_uploader_asset(image, 'previewFile') }}"
                             class="h-40 w-full object-cover" alt="">
                    {% elseif image.image %}
                        <img src="{{ vich_uploader_asset(image, 'imageFile') }}"
                             class="h-40 w-full object-cover" alt="">
                    {% endif %}

                    {% if image.isMain %}
                        <span class="absolute left-1 top-1 rounded bg-gray-900 px-2 py-0.5 text-xs font-semibold text-white">Главное</span>
                    {% endif %}

                    <button class="delete-btn absolute right-1 top-1 rounded-md bg-red-600 px-2 py-1 text-xs font-semibold text-white hover:bg-red-700 transition"
                            data-id="{{ image.id }}">
                        ✕
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
<script>
const uploadUrl  = '{{ path('brand_product_images_upload', {id: product.id}) }}';
const deleteBase = '{{ path('brand_product_image_delete', {id: product.id, imageId: 0}) }}'.replace('/0', '/');
const sortUrl    = '{{ path('brand_product_images_sort', {id: product.id}) }}';
const csrfToken  = '{{ csrf_token('brand_product_images') }}';

// Drag & drop upload
const area = document.getElementById('upload-area');
const fileInput = document.getElementById('file-input');
area.addEventListener('click', () => fileInput.click());
area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('bg-gray-100'); });
area.addEventListener('dragleave', () => area.classList.remove('bg-gray-100'));
area.addEventListener('drop', e => { e.preventDefault(); area.classList.remove('bg-gray-100'); uploadFiles(e.dataTransfer.files); });
fileInput.addEventListener('change', () => uploadFiles(fileInput.files));

function uploadFiles(files) {
    const fd = new FormData();
    [...files].forEach(f => fd.append('images[]', f));
    const prog = document.getElementById('upload-progress');
    const bar  = document.getElementById('progress-bar');
    prog.classList.remove('hidden');
    const xhr = new XMLHttpRequest();
    xhr.upload.onprogress = e => { if (e.lengthComputable) bar.style.width = Math.round(e.loaded/e.total*100)+'%'; };
    xhr.onload = () => xhr.status === 200 ? location.reload() : alert('Ошибка загрузки');
    xhr.open('POST', uploadUrl);
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    xhr.setRequestHeader('X-CSRF-Token', csrfToken);
    xhr.send(fd);
}

// Delete
document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async e => {
        e.stopPropagation();
        if (!confirm('Удалить фото?')) return;
        const r = await fetch(deleteBase + btn.dataset.id, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest', 'X-CSRF-Token': csrfToken} });
        if (r.ok) btn.closest('[data-id]').remove();
    });
});

// Sortable reorder
const gallery = document.getElementById('gallery');
if (gallery) {
    Sortable.create(gallery, {
        animation: 150,
        onEnd: async () => {
            const order = [...gallery.querySelectorAll('[data-id]')].map(el => +el.dataset.id);
            await fetch(sortUrl, {
                method: 'POST',
                headers: { 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ order })
            });
        }
    });
}
</script>
{% endblock %}
