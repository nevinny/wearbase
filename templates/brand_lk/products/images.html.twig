{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Фотографии — {{ product.title }}{% endblock %}

{% block brand_content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('brand_products') }}">Товары</a></li>
        <li class="breadcrumb-item"><a href="{{ path('brand_product_edit', {id: product.id}) }}">{{ product.title }}</a></li>
        <li class="breadcrumb-item active">Фотографии</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div id="upload-area"
             class="border border-2 rounded text-center py-5 px-3 text-muted"
             style="cursor:pointer; border-style:dashed !important">
            <i class="fas fa-cloud-upload-alt fa-2x mb-2"></i>
            <div>Перетащите фото или <span class="text-dark fw-semibold">выберите</span></div>
            <div class="small mt-1">Первое фото станет главным. JPG, PNG, WebP — до 5 МБ</div>
            <input type="file" id="file-input" multiple accept="image/*" class="d-none">
        </div>
        <div id="upload-progress" class="mt-3 d-none">
            <div class="progress"><div id="progress-bar" class="progress-bar bg-dark" style="width:0%"></div></div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span>Фотографии ({{ product.productImages|length }})</span>
        <span class="text-muted small">Перетащите для изменения порядка</span>
    </div>
    <div class="card-body">
        {% if product.productImages|length == 0 %}
            <div class="text-center text-muted py-5">Фотографий пока нет</div>
        {% else %}
        <div id="gallery" class="row g-3">
            {% for image in product.productImages|sort((a,b) => a.sort <=> b.sort) %}
            <div class="col-6 col-md-4 col-lg-3" data-id="{{ image.id }}">
                <div class="position-relative border rounded overflow-hidden" style="cursor:grab">
                    {% if image.preview %}
                        <img src="{{ vich_uploader_asset(image, 'previewFile') }}"
                             class="w-100" style="height:160px;object-fit:cover" alt="">
                    {% elseif image.image %}
                        <img src="{{ vich_uploader_asset(image, 'imageFile') }}"
                             class="w-100" style="height:160px;object-fit:cover" alt="">
                    {% endif %}

                    {% if image.isMain %}
                        <span class="badge bg-dark position-absolute top-0 start-0 m-1">Главное</span>
                    {% endif %}

                    <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-btn"
                            data-id="{{ image.id }}">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
<script>
const uploadUrl  = '{{ path('brand_product_images_upload', {id: product.id}) }}';
const deleteBase = '{{ path('brand_product_image_delete', {id: product.id, imageId: 0}) }}'.replace('/0', '/');
const sortUrl    = '{{ path('brand_product_images_sort', {id: product.id}) }}';
const csrfToken  = '{{ csrf_token('brand_product_images') }}';

// Drag & drop upload
const area = document.getElementById('upload-area');
const fileInput = document.getElementById('file-input');
area.addEventListener('click', () => fileInput.click());
area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('bg-light'); });
area.addEventListener('dragleave', () => area.classList.remove('bg-light'));
area.addEventListener('drop', e => { e.preventDefault(); area.classList.remove('bg-light'); uploadFiles(e.dataTransfer.files); });
fileInput.addEventListener('change', () => uploadFiles(fileInput.files));

function uploadFiles(files) {
    const fd = new FormData();
    [...files].forEach(f => fd.append('images[]', f));
    const prog = document.getElementById('upload-progress');
    const bar  = document.getElementById('progress-bar');
    prog.classList.remove('d-none');
    const xhr = new XMLHttpRequest();
    xhr.upload.onprogress = e => { if (e.lengthComputable) bar.style.width = Math.round(e.loaded/e.total*100)+'%'; };
    xhr.onload = () => xhr.status === 200 ? location.reload() : alert('Ошибка загрузки');
    xhr.open('POST', uploadUrl);
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    xhr.setRequestHeader('X-CSRF-Token', csrfToken);
    xhr.send(fd);
}

// Delete
document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async e => {
        e.stopPropagation();
        if (!confirm('Удалить фото?')) return;
        const r = await fetch(deleteBase + btn.dataset.id, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest', 'X-CSRF-Token': csrfToken} });
        if (r.ok) btn.closest('[data-id]').remove();
    });
});

// Sortable reorder
const gallery = document.getElementById('gallery');
if (gallery) {
    Sortable.create(gallery, {
        animation: 150,
        onEnd: async () => {
            const order = [...gallery.querySelectorAll('[data-id]')].map(el => +el.dataset.id);
            await fetch(sortUrl, {
                method: 'POST',
                headers: { 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ order })
            });
        }
    });
}
</script>
{% endblock %}
