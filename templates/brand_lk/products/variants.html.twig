{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Варианты — {{ product.title }}{% endblock %}

{% block brand_content %}
{% set input_class = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set label_class = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500">
        <li><a href="{{ path('brand_products') }}" class="hover:text-gray-900 hover:underline">Товары</a></li>
        <li class="text-gray-400">/</li>
        <li><a href="{{ path('brand_product_edit', {id: product.id}) }}" class="hover:text-gray-900 hover:underline">{{ product.title }}</a></li>
        <li class="text-gray-400">/</li>
        <li class="font-semibold text-gray-900">Варианты</li>
    </ol>
</nav>

<div class="grid items-start gap-6 lg:grid-cols-12">
    {# ── Существующие варианты ── #}
    <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                Варианты ({{ product.variants|length }})
            </div>
            {% if product.variants|length == 0 %}
                <div class="py-10 text-center text-gray-500">Вариантов пока нет</div>
            {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                        <tr>
                            <th class="px-4 py-3">Размер</th>
                            <th class="px-4 py-3">Цвет</th>
                            <th class="px-4 py-3">Цена</th>
                            <th class="px-4 py-3">Старая</th>
                            <th class="px-4 py-3">Остаток</th>
                            <th class="px-4 py-3">SKU</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    {% for variant in product.variants %}
                    <tr class="{{ not variant.inStock ? 'bg-amber-50' : 'hover:bg-gray-50' }}">
                        <td class="px-4 py-3">{{ variant.size ?: '—' }}</td>
                        <td class="px-4 py-3">
                            {% if variant.colorHex %}
                                <span class="mr-1 inline-block h-3.5 w-3.5 rounded border border-gray-200 align-middle"
                                      style="background:{{ variant.colorHex }}"></span>
                            {% endif %}
                            {{ variant.color ?: '—' }}
                        </td>
                        <td class="px-4 py-3 font-semibold">{{ price(variant.price) }}</td>
                        <td class="px-4 py-3 text-gray-500 line-through">
                            {{ variant.comparePrice ? price(variant.comparePrice) : '' }}
                        </td>
                        <td class="px-4 py-3 {{ variant.stockQty == 0 ? 'font-semibold text-red-600' : '' }}">
                            {{ variant.stockQty }}
                        </td>
                        <td class="px-4 py-3 text-gray-500">{{ variant.sku ?: '—' }}</td>
                        <td class="px-4 py-3">
                            <form method="post"
                                  action="{{ path('brand_product_variant_delete', {id: product.id, variantId: variant.id}) }}"
                                  onsubmit="return confirm('Удалить вариант?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('brand_product') }}">
                                <button class="rounded-lg border border-red-300 px-2.5 py-1 text-sm text-red-600 hover:bg-red-50 transition" title="Удалить">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    {# ── Добавить вариант ── #}
    <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Добавить вариант</div>
            <div class="p-5">
                {{ form_start(form) }}

                <div class="mb-3 grid grid-cols-12 gap-2">
                    <div class="col-span-6">
                        {{ form_label(form.size, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.size, {'attr': {'class': input_class}}) }}
                    </div>
                    <div class="col-span-4">
                        {{ form_label(form.color, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.color, {'attr': {'class': input_class}}) }}
                    </div>
                    <div class="col-span-2">
                        {{ form_label(form.colorHex, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.colorHex) }}
                    </div>
                </div>

                <div class="mb-3 grid grid-cols-2 gap-2">
                    <div>
                        {{ form_label(form.price, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.price, {'attr': {'class': input_class}}) }}
                        {{ form_errors(form.price) }}
                    </div>
                    <div>
                        {{ form_label(form.comparePrice, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.comparePrice, {'attr': {'class': input_class}}) }}
                    </div>
                </div>

                <div class="mb-4 grid grid-cols-12 gap-2">
                    <div class="col-span-4">
                        {{ form_label(form.stockQty, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.stockQty, {'attr': {'class': input_class}}) }}
                    </div>
                    <div class="col-span-5">
                        {{ form_label(form.sku, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.sku, {'attr': {'class': input_class}}) }}
                    </div>
                    <div class="col-span-3">
                        {{ form_label(form.weight, null, {'label_attr': {'class': label_class}}) }}
                        {{ form_widget(form.weight, {'attr': {'class': input_class}}) }}
                    </div>
                </div>

                <button type="submit" class="w-full rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Добавить</button>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-4">
            <a href="{{ path('brand_product_images', {id: product.id}) }}" class="block w-full rounded-lg border border-gray-900 px-3 py-2 text-center text-sm text-gray-900 hover:bg-gray-900 hover:text-white transition">
                Перейти к фотографиям →
            </a>
        </div>
    </div>
</div>
{% endblock %}
