{% extends 'brand_lk/layout.html.twig' %}
{% block title %}Варианты — {{ product.title }}{% endblock %}

{% block brand_content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('brand_products') }}">Товары</a></li>
        <li class="breadcrumb-item"><a href="{{ path('brand_product_edit', {id: product.id}) }}">{{ product.title }}</a></li>
        <li class="breadcrumb-item active">Варианты</li>
    </ol>
</nav>

<div class="row g-4">
    {# ── Существующие варианты ── #}
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                Варианты ({{ product.variants|length }})
            </div>
            {% if product.variants|length == 0 %}
                <div class="card-body text-muted text-center py-4">Вариантов пока нет</div>
            {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Размер</th>
                            <th>Цвет</th>
                            <th>Цена</th>
                            <th>Старая</th>
                            <th>Остаток</th>
                            <th>SKU</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for variant in product.variants %}
                    <tr class="{{ not variant.inStock ? 'table-warning' : '' }}">
                        <td>{{ variant.size ?: '—' }}</td>
                        <td>
                            {% if variant.colorHex %}
                                <span class="d-inline-block rounded me-1"
                                      style="width:14px;height:14px;background:{{ variant.colorHex }};border:1px solid #ddd"></span>
                            {% endif %}
                            {{ variant.color ?: '—' }}
                        </td>
                        <td class="fw-semibold">{{ price(variant.price) }}</td>
                        <td class="text-decoration-line-through text-muted">
                            {{ variant.comparePrice ? price(variant.comparePrice) : '' }}
                        </td>
                        <td class="{{ variant.stockQty == 0 ? 'text-danger fw-semibold' : '' }}">
                            {{ variant.stockQty }}
                        </td>
                        <td class="text-muted">{{ variant.sku ?: '—' }}</td>
                        <td>
                            <form method="post"
                                  action="{{ path('brand_product_variant_delete', {id: product.id, variantId: variant.id}) }}"
                                  onsubmit="return confirm('Удалить вариант?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('brand_product') }}">
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>

    {# ── Добавить вариант ── #}
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Добавить вариант</div>
            <div class="card-body">
                {{ form_start(form) }}

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        {{ form_label(form.size, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.size, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                    <div class="col-4">
                        {{ form_label(form.color, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.color, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                    <div class="col-2">
                        {{ form_label(form.colorHex, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.colorHex) }}
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        {{ form_label(form.price, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.price, {'attr': {'class': 'form-control form-control-sm'}}) }}
                        {{ form_errors(form.price) }}
                    </div>
                    <div class="col-6">
                        {{ form_label(form.comparePrice, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.comparePrice, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-4">
                        {{ form_label(form.stockQty, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.stockQty, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                    <div class="col-5">
                        {{ form_label(form.sku, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.sku, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                    <div class="col-3">
                        {{ form_label(form.weight, null, {'label_attr': {'class': 'form-label small'}}) }}
                        {{ form_widget(form.weight, {'attr': {'class': 'form-control form-control-sm'}}) }}
                    </div>
                </div>

                <button type="submit" class="btn btn-dark btn-sm w-100">Добавить</button>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-3">
            <a href="{{ path('brand_product_images', {id: product.id}) }}" class="btn btn-outline-dark w-100">
                <i class="fas fa-images me-1"></i> Перейти к фотографиям →
            </a>
        </div>
    </div>
</div>
{% endblock %}
