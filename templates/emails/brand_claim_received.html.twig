{% block email_content %}
<h2 style="margin-top:0;font-size:18px;">📝 Заявка на управление брендом «{{ claim.brand.title }}» принята</h2>
<p style="color:#555;line-height:1.6;">
    Мы получили вашу заявку на управление брендом <strong>{{ claim.brand.title }}</strong>.
