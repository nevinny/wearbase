{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Клики по брендам{% endblock %}

{% block main %}
{% set maxDay = byDay|reduce((m, r) => max(m, r.clicks), 1) %}
<style>
    .clk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin: 16px 0 24px; }
    .clk-kpi { background: var(--content-bg, var(--bs-body-bg, #fff)); border: 1px solid var(--border-color, #444); border-radius: 8px; padding: 14px 16px; }
    .clk-kpi .n { font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
    .clk-kpi .l { font-size: 12px; text-transform: uppercase; opacity: .6; margin-top: 8px; }
    .clk-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
    @media (max-width: 900px) { .clk-cols { grid-template-columns: 1fr; } }
    .clk-card h3 { font-size: 13px; text-transform: uppercase; opacity: .65; margin: 0 0 12px; }
    table.clk { width: 100%; font-size: 14px; border-collapse: collapse; }
    table.clk th, table.clk td { padding: 7px 10px; border-bottom: 1px solid var(--border-color, #333); text-align: left; }
    table.clk th { font-size: 12px; text-transform: uppercase; opacity: .6; }
    table.clk td.num, table.clk th.num { text-align: right; font-variant-numeric: tabular-nums; }
    .clk-days { display: flex; align-items: flex-end; gap: 3px; height: 90px; margin: 8px 0 4px; }
    .clk-days .bar { flex: 1; background: #0d6efd; border-radius: 2px 2px 0 0; min-height: 2px; }
    .clk-days .bar:hover { background: #0b5ed7; }
    .clk-filter { margin: 0 0 8px; font-size: 13px; }
    .clk-filter a { padding: 3px 10px; border: 1px solid var(--border-color, #444); border-radius: 12px; text-decoration: none; }
    .clk-filter a.on { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .clk-empty { opacity: .55; font-size: 14px; padding: 20px 0; }
</style>

<h1 class="title" style="margin-bottom:6px">Клики по брендам <span style="font-size:14px;opacity:.6">исходящие переходы /go/{id}</span></h1>

<div class="clk-filter">
    Окно:
    {% for d in [7, 30, 90, 365] %}
        <a href="{{ path('admin_clicks', {days: d}) }}" class="{{ days == d ? 'on' : '' }}">{{ d }} дн.</a>
    {% endfor %}
</div>

<div class="clk-grid">
    <div class="clk-kpi"><div class="n">{{ totals.win|number_format(0, '.', ' ') }}</div><div class="l">кликов за {{ days }} дн.</div></div>
    <div class="clk-kpi"><div class="n">{{ totals.visitors|number_format(0, '.', ' ') }}</div><div class="l">уник. посетителей</div></div>
    <div class="clk-kpi"><div class="n">{{ totals.brands|number_format(0, '.', ' ') }}</div><div class="l">брендов с кликами</div></div>
    <div class="clk-kpi"><div class="n">{{ totals.d7|number_format(0, '.', ' ') }}</div><div class="l">за 7 дней</div></div>
    <div class="clk-kpi"><div class="n">{{ totals.today|number_format(0, '.', ' ') }}</div><div class="l">сегодня</div></div>
    <div class="clk-kpi"><div class="n">{{ totals.all|number_format(0, '.', ' ') }}</div><div class="l">всего за всё время</div></div>
</div>

{% if totals.all == 0 %}
    <p class="clk-empty">Кликов пока нет. Данные копятся на проде (редирект <code>/go/&#123;id&#125;</code>); на dev таблица обычно пуста.</p>
{% endif %}

<div class="clk-card" style="margin-bottom:24px">
    <h3>Клики по дням</h3>
    <div class="clk-days">
        {% for r in byDay %}
            <div class="bar" style="height: {{ (r.clicks / maxDay * 100)|round }}%" title="{{ r.day }}: {{ r.clicks }}"></div>
        {% endfor %}
    </div>
</div>

<div class="clk-cols">
    <div class="clk-card">
        <h3>Топ брендов ({{ days }} дн.)</h3>
        <table class="clk">
            <thead><tr><th>#</th><th>Бренд</th><th class="num">Клики</th></tr></thead>
            <tbody>
                {% for b in topBrands %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td><a href="{{ path('brand_show', {_locale: 'ru', slug: b.slug}) }}" target="_blank" rel="noopener">{{ b.title }}</a></td>
                        <td class="num">{{ b.clicks|number_format(0, '.', ' ') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="clk-empty">нет данных</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div>
        <div class="clk-card" style="margin-bottom:24px">
            <h3>По типу ссылки</h3>
            <table class="clk">
                <thead><tr><th>Тип</th><th class="num">Клики</th></tr></thead>
                <tbody>
                    {% for r in byType %}
                        <tr><td>{{ r.link_type }}</td><td class="num">{{ r.clicks|number_format(0, '.', ' ') }}</td></tr>
                    {% else %}
                        <tr><td colspan="2" class="clk-empty">нет данных</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="clk-card">
            <h3>Топ хостов назначения</h3>
            <table class="clk">
                <thead><tr><th>Хост</th><th class="num">Клики</th></tr></thead>
                <tbody>
                    {% for r in topHosts %}
                        <tr><td>{{ r.host }}</td><td class="num">{{ r.clicks|number_format(0, '.', ' ') }}</td></tr>
                    {% else %}
                        <tr><td colspan="2" class="clk-empty">нет данных</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
