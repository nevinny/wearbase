{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}RAG-конвейер{% endblock %}

{% block head_custom %}
    <meta http-equiv="refresh" content="30">
{% endblock %}

{% block main %}
<style>
    /* Цвета только через переменные EasyAdmin/Bootstrap — работает в обеих темах */
    .rag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0; }
    .rag-card { background: var(--content-bg, var(--bs-body-bg, #fff)); border: 1px solid var(--border-color, #444); border-radius: 8px; padding: 14px 16px; }
    .rag-card h3 { font-size: 13px; text-transform: uppercase; opacity: .65; margin: 0 0 10px; }
    .rag-card table { width: 100%; font-size: 14px; }
    .rag-card td { padding: 3px 0; }
    .rag-card td:last-child { text-align: right; font-weight: 600; }
    .rag-stages { width: 100%; font-size: 14px; border-collapse: collapse; }
    .rag-stages th, .rag-stages td { padding: 9px 12px; border-bottom: 1px solid var(--border-color, #444); text-align: left; }
    .rag-stages th { font-size: 12px; text-transform: uppercase; opacity: .65; }
    .rag-stages td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .rag-row-stalled { background: rgba(220, 53, 69, .18); }
    .rag-row-ok      { background: rgba(25, 135, 84, .10); }
    .rag-badge { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .rag-badge-ok      { background: #198754; color: #fff; }
    .rag-badge-stalled { background: #dc3545; color: #fff; }
    .rag-badge-idle    { background: var(--border-color, #6c757d); color: var(--bs-body-color, #fff); opacity: .8; }
    .rag-badge-wait    { background: #6c757d; color: #fff; }
    .rag-note { opacity: .6; font-size: 12px; margin-top: 12px; }
</style>

<h1 class="title" style="margin-bottom:16px">RAG-конвейер <span style="font-size:14px;opacity:.6">(автообновление 30 сек)</span></h1>

<table class="rag-stages">
    <thead>
        <tr>
            <th>Стадия (где)</th>
            <th>Статус</th>
            <th class="num">Сделано</th>
            <th class="num">За час</th>
            <th class="num">Осталось</th>
            <th>Последняя активность</th>
        </tr>
    </thead>
    <tbody>
        {% for name, s in stages %}
            {# Статус: работает (есть активность за час) / СТОИТ (работа есть, активности нет) /
               очередь пуста / ждёт прод (стадии деплоя) #}
            {% if s.waitsProd is defined and s.waitsProd %}
                {% set state, badge, cls = 'ждёт прод', 'rag-badge-wait', '' %}
            {% elseif s.lastHour > 0 %}
                {% set state, badge, cls = 'работает', 'rag-badge-ok', 'rag-row-ok' %}
            {% elseif s.left > 0 %}
                {% set state, badge, cls = 'СТОИТ', 'rag-badge-stalled', 'rag-row-stalled' %}
            {% else %}
                {% set state, badge, cls = 'очередь пуста', 'rag-badge-idle', '' %}
            {% endif %}
            <tr class="{{ cls }}">
                <td>{{ name }}</td>
                <td><span class="rag-badge {{ badge }}">{{ state }}</span></td>
                <td class="num">{{ s.done }}</td>
                <td class="num">{{ s.lastHour > 0 ? '+' ~ s.lastHour : '·' }}</td>
                <td class="num">{{ s.left }}</td>
                <td style="opacity:{{ s.lastAt == '—' ? '.4' : '.8' }}">{{ s.lastAt }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<div class="rag-grid">
    <div class="rag-card">
        <h3>Бренды</h3>
        <table>
            {% for status, cnt in brandStatuses %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Пайплайн (brand_rag_pipeline)</h3>
        <table>
            {% for status, cnt in pipeline %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Очередь URL (fetch)</h3>
        <table>
            {% for status, cnt in urlQueue %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% else %}
                <tr><td colspan="2" style="opacity:.5">пусто</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Готовность контента</h3>
        <table>
            {% for k, v in readiness %}
                <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Google Search Console</h3>
        <table>
            {% for k, v in gsc %}
                <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
            {% endfor %}
        </table>
    </div>
</div>

<p class="rag-note">
    «За час» — от последней записи самой стадии (TZ-независимо); для строки publish-tick это «опубликовано сегодня» (данные с прода по API). «СТОИТ» = есть очередь, но нет активности за час —
    проверь демоны: сервер 192.168.2.43 (discover/fetch/embed/generate/faq), Mac (keywords).

</p>
{% endblock %}
