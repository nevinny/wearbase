{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}RAG-конвейер{% endblock %}

{% block head_custom %}
    <meta http-equiv="refresh" content="30">
{% endblock %}

{% block main %}
<style>
    .rag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 20px; }
    .rag-card { background: #fff; border: 1px solid #e3e7ee; border-radius: 8px; padding: 14px 16px; }
    .rag-card h3 { font-size: 14px; text-transform: uppercase; color: #6c757d; margin: 0 0 10px; }
    .rag-card table { width: 100%; font-size: 14px; }
    .rag-card td { padding: 3px 0; }
    .rag-card td:last-child { text-align: right; font-weight: 600; }
    .rag-stages { width: 100%; background: #fff; border: 1px solid #e3e7ee; border-radius: 8px; font-size: 14px; border-collapse: separate; border-spacing: 0; }
    .rag-stages th, .rag-stages td { padding: 8px 12px; border-bottom: 1px solid #eef1f5; text-align: left; }
    .rag-stages th { background: #f8f9fb; font-size: 12px; text-transform: uppercase; color: #6c757d; }
    .rag-stages td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .rag-hot { color: #198754; font-weight: 700; }
    .rag-muted { color: #adb5bd; }
    .rag-note { color: #6c757d; font-size: 12px; margin-top: 10px; }
</style>

<h1 class="title" style="margin-bottom:16px">RAG-конвейер <span class="rag-muted" style="font-size:14px">(обновляется каждые 30 сек)</span></h1>

<table class="rag-stages" style="margin-bottom:20px">
    <thead>
        <tr>
            <th>Стадия (где)</th>
            <th class="num">Сделано</th>
            <th class="num">За последний час</th>
            <th class="num">Осталось</th>
            <th>Последняя активность</th>
        </tr>
    </thead>
    <tbody>
        {% for name, s in stages %}
            <tr>
                <td>{{ name }}</td>
                <td class="num">{{ s.done }}</td>
                <td class="num {{ s.lastHour > 0 ? 'rag-hot' : 'rag-muted' }}">{{ s.lastHour > 0 ? '+' ~ s.lastHour : '·' }}</td>
                <td class="num">{{ s.left }}</td>
                <td class="{{ s.lastAt == '—' ? 'rag-muted' : '' }}">{{ s.lastAt }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<div class="rag-grid">
    <div class="rag-card">
        <h3>Бренды</h3>
        <table>
            {% for status, cnt in brandStatuses %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Пайплайн (brand_rag_pipeline)</h3>
        <table>
            {% for status, cnt in pipeline %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Очередь URL (fetch)</h3>
        <table>
            {% for status, cnt in urlQueue %}
                <tr><td>{{ status }}</td><td>{{ cnt }}</td></tr>
            {% else %}
                <tr><td colspan="2" class="rag-muted">пусто</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Готовность контента</h3>
        <table>
            {% for k, v in readiness %}
                <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="rag-card">
        <h3>Google Search Console</h3>
        <table>
            {% for k, v in gsc %}
                <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
            {% endfor %}
        </table>
    </div>
</div>

<p class="rag-note">
    «За последний час» считается от последней записи самой стадии (TZ-независимо: демоны на сервере пишут UTC).
    Discover/fetch/embed/generate/faq крутятся демонами на LLM-сервере 192.168.2.43; keywords — отдельный процесс на Mac (квота Wordstat);
    push и publish-tick включаются после деплоя прода.
</p>
{% endblock %}
