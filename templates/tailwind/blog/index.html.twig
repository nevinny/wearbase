{% extends 'tailwind/base.html.twig' %}

{% set page_locale = app.request.locale|default('ru') %}

{% block title %}Блог о российских брендах одежды | WEARBASE{% endblock %}

{% block meta_description %}Статьи о российских брендах одежды: подборки брендов, гайды для покупателей, комиссии маркетплейсов, продажи без посредников.{% endblock %}

{% block meta_keywords %}блог о моде, российские бренды одежды, статьи о брендах, альтернативы маркетплейсам{% endblock %}

{% block og_title %}Блог о российских брендах одежды | WEARBASE{% endblock %}

{% block og_description %}Статьи о российских брендах одежды: подборки, гайды, аналитика рынка.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block meta_robots %}{% if page > 1 %}<meta name="robots" content="noindex, follow">{% endif %}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "{{ url('blog_index', {_locale: page_locale}) }}#webpage",
                "url": "{{ url('blog_index', {_locale: page_locale}) }}",
                "name": "Блог о российских брендах одежды | WEARBASE",
                "breadcrumb": {"@id": "{{ url('blog_index', {_locale: page_locale}) }}#breadcrumb"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('blog_index', {_locale: page_locale}) }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Блог", "item": "{{ url('blog_index', {_locale: page_locale}) }}"}
                ]
            }
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Блог</span>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold mb-2">Блог</h1>
        <p class="text-gray-600 mb-10">Статьи о российских брендах одежды, рынке и продажах без посредников</p>

        {% if articles is empty %}
            <p class="text-gray-500 py-20 text-center">Статей пока нет — скоро появятся.</p>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for article in articles %}
                    <a href="{{ path('blog_show', {_locale: page_locale, slug: article.slug}) }}"
                       class="block bg-white rounded-xl shadow-sm hover:shadow-md transition p-6">
                        <time datetime="{{ article.publishedAt|date('Y-m-d') }}" class="text-xs text-gray-400">
                            {{ article.publishedAt|date('d.m.Y') }}
                        </time>
                        <h2 class="text-lg font-semibold mt-2 mb-3">{{ article.title }}</h2>
                        {% if article.excerpt %}
                            <p class="text-sm text-gray-600">{{ article.excerpt|slice(0, 180) }}{% if article.excerpt|length > 180 %}…{% endif %}</p>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                <nav class="flex justify-center gap-2 mt-10" aria-label="Пагинация">
                    {% for p in 1..totalPages %}
                        {% if p == page %}
                            <span class="px-3 py-1.5 rounded-lg bg-gray-900 text-white text-sm">{{ p }}</span>
                        {% else %}
                            <a href="{{ path('blog_index', {_locale: page_locale, page: p}) }}"
                               class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm">{{ p }}</a>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
