{% extends 'tailwind/base.html.twig' %}

{% set page_locale = app.request.locale|default('ru') %}

{% block title %}{{ article.title }} | WEARBASE{% endblock %}

{% block meta_description %}{{ article.excerpt ? article.excerpt|slice(0, 155) : article.title }}{% endblock %}

{% block og_title %}{{ article.title }} | WEARBASE{% endblock %}

{% block og_description %}{{ article.excerpt ? article.excerpt|slice(0, 155) : article.title }}{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block canonical_url %}{{ url('blog_show', {_locale: page_locale, slug: article.slug}) }}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Article",
                "@id": "{{ url('blog_show', {_locale: page_locale, slug: article.slug}) }}#article",
                "headline": {{ article.title|json_encode|raw }},
                "description": {{ (article.excerpt ?: article.title)|json_encode|raw }},
                "datePublished": "{{ article.publishedAt|date('c') }}",
                "dateModified": "{{ article.updatedAt|date('c') }}",
                "inLanguage": "{{ article.locale }}",
                "mainEntityOfPage": "{{ url('blog_show', {_locale: page_locale, slug: article.slug}) }}",
                "author": {"@type": "Organization", "name": "WEARBASE", "url": "https://wearbase.ru"},
                "publisher": {"@type": "Organization", "name": "WEARBASE", "url": "https://wearbase.ru"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('blog_show', {_locale: page_locale, slug: article.slug}) }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Блог", "item": "{{ url('blog_index', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 3, "name": {{ article.title|json_encode|raw }}, "item": "{{ url('blog_show', {_locale: page_locale, slug: article.slug}) }}"}
                ]
            }
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10 max-w-3xl">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <a href="{{ path('blog_index', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Блог</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">{{ article.title|slice(0, 60) }}</span>
        </nav>

        <article>
            <header class="mb-8">
                <time datetime="{{ article.publishedAt|date('Y-m-d') }}" class="text-sm text-gray-400">
                    {{ article.publishedAt|date('d.m.Y') }}
                </time>
                <h1 class="text-3xl md:text-4xl font-bold mt-2">{{ article.title }}</h1>
                {% if article.excerpt %}
                    <p class="text-lg text-gray-600 mt-4">{{ article.excerpt }}</p>
                {% endif %}
            </header>

            <div class="prose prose-lg max-w-none
                        [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-4
                        [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-3
                        [&_p]:my-4 [&_p]:leading-relaxed [&_p]:text-gray-700
                        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-4
                        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:my-4
                        [&_li]:my-1 [&_li]:text-gray-700
                        [&_a]:text-indigo-600 [&_a]:underline hover:[&_a]:text-indigo-800
                        [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-600
                        [&_table]:w-full [&_table]:my-6 [&_table]:text-sm
                        [&_th]:text-left [&_th]:py-2 [&_th]:pr-4 [&_th]:border-b-2 [&_th]:border-gray-900 [&_th]:font-semibold
                        [&_td]:py-2 [&_td]:pr-4 [&_td]:border-b [&_td]:border-gray-100 [&_td]:text-gray-700 [&_td]:align-top">
                {{ article.content|raw }}
            </div>
        </article>

        <div class="mt-12 p-6 bg-gray-50 rounded-xl text-center">
            <p class="font-semibold mb-2">Ищете российские бренды одежды?</p>
            <p class="text-sm text-gray-600 mb-4">В каталоге WEARBASE — сотни брендов с прямыми контактами, без комиссий маркетплейсов.</p>
            <a href="{{ path('brand_index', {_locale: page_locale}) }}"
               class="inline-block px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
                Открыть каталог брендов
            </a>
        </div>

        <div class="mt-8">
            <a href="{{ path('blog_index', {_locale: page_locale}) }}" class="text-sm text-gray-500 hover:text-gray-900">← Все статьи</a>
        </div>
    </div>
{% endblock %}
