{% extends 'tailwind/base.html.twig' %}

{% block title %}Каталог брендов{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">

        {# --- Алфавитный указатель --- #}
        <section class="mb-10">
            <h1 class="text-2xl font-bold mb-4">Каталог брендов</h1>
            <div class="flex flex-wrap gap-2">
                {% for letter in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'|split('') %}
                    {% set active = app.request.get('letter') == letter %}
                    <a href="{{ path('home_tailwind', {letter: letter}) }}"
                       class="px-3 py-1 rounded-md border text-sm font-medium
                  {{ active ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }}">
                        {{ letter }}
                    </a>
                {% endfor %}
                <a href="{{ path('home_tailwind') }}"
                   class="px-3 py-1 rounded-md border text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">
                    Все
                </a>
            </div>
        </section>

        {# --- Сетка карточек (грид) --- #}
        {% if listings|length > 0 %}
            <section>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
                    {% for item in listings %}
                        <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                            <a href="{{ path('listing_show', { slug: item.slug }) }}" class="block">
                                <div class="aspect-w-4 aspect-h-5 bg-gray-100 overflow-hidden">
                                    <img
                                        src="{{ asset(item.thumbnail ?? 'images/placeholder.webp') }}"
                                        alt="{{ item.title }}"
                                        loading="lazy"
                                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300"
                                    >
                                </div>

                                <div class="p-3">
                                    <h3 class="text-sm font-semibold truncate mb-1">{{ item.title }}</h3>
                                    {% if item.city %}
                                        <p class="text-xs text-gray-500 mb-1">{{ item.city }}</p>
                                    {% endif %}
                                    {% if item.price %}
                                        <p class="text-sm font-medium text-gray-900">{{ item.price|number_format(0, '.', ' ') }} {{ item.currency ?? '₽' }}</p>
                                    {% endif %}
                                </div>
                            </a>
                        </article>
                    {% endfor %}
                </div>

                <div class="mt-8">
{#                    {{ pagerfanta(listings) }}#}
                </div>
            </section>
        {% else %}
            <div class="text-center py-20 text-gray-500">
                Нет результатов для выбранной буквы.
            </div>
        {% endif %}

    </div>
{% endblock %}
