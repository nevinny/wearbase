{# --- ГАЛЕРЕЯ ИЗОБРАЖЕНИЙ БРЕНДА --- #}
        {% if brand.images is defined and brand.images|length > 0 %}
            <section class="mb-12">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for image in brand.images %}
                        <div class="relative aspect-square overflow-hidden rounded-lg bg-gray-100 group">
                            <img
                                src="{{ asset('images/brands/' ~ image.preview) }}"
                                alt="{{ brand.title }} - фото {{ loop.index }}"
                                loading="lazy"
                                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                            >
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
