{% extends 'tailwind/base.html.twig' %}

{% block title %}Каталог российских брендов одежды | WEARBASE{% endblock %}

{% block meta_description %}Каталог российских брендов одежды: {{ publishedCount }} местных марок из Москвы, Санкт-Петербурга, Екатеринбурга и других городов России — с сайтами, соцсетями и контактами. Streetwear, casual, минимализм, спорт.{% endblock %}

{% block meta_keywords %}российские бренды одежды, каталог брендов, streetwear, уличная мода, российские марки{% endblock %}

{% block meta_robots %}
{% if app.request.query.has('letter') or app.request.query.has('page') or app.request.query.has('search') or app.request.query.has('city') or app.request.query.has('style') %}
<meta name="robots" content="noindex, follow">
{% endif %}
{% endblock %}

{% block og_title %}Каталог российских брендов одежды | WEARBASE{% endblock %}

{% block og_description %}{{ publishedCount }} российских брендов одежды с контактами. Streetwear, casual, минимализм из Москвы, Петербурга и других городов.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebPage",
                "@id": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}#webpage",
                "url": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}",
                "name": "Каталог российских брендов одежды | WEARBASE",
                "description": "Каталог российских брендов одежды: {{ publishedCount }} местных марок из Москвы, Санкт-Петербурга и других городов России.",
                "isPartOf": {"@id": "#website"},
                "breadcrumb": {"@id": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}#breadcrumb"}
            },
            {
                "@type": "CollectionPage",
                "@id": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}#collection",
                "name": "Каталог российских брендов одежды",
                "description": "Каталог российских брендов одежды: {{ publishedCount }} местных марок из Москвы, Санкт-Петербурга и других городов России.",
                "isPartOf": {"@id": "#website"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}#breadcrumb",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Главная",
                        "item": "{{ url('home_hub', {_locale: app.request.locale|default('ru')}) }}"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Бренды",
                        "item": "{{ url('brand_index', {_locale: app.request.locale|default('ru')}) }}"
                    }
                ]
            }
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: app.request.locale|default('ru')}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Бренды</span>
        </nav>

        {# --- Hero Section --- #}
        <section class="text-center mb-10">
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Российские бренды одежды</h1>
            <p class="text-gray-600 text-base md:text-lg">
                {{ publishedCount }} отечественных марок с сайтами, соцсетями и контактами — streetwear, casual,
                минимализм, спорт и другие направления. Покупайте напрямую у производителя.
            </p>
            {# Ссылка на гид: статья под тот же головной запрос («российские бренды одежды»,
               20 273 показа/мес) висела почти без входящих ссылок и не ранжировалась вовсе.
               Каталог и гид закрывают разные интенты — витрину и «как выбрать», — и должны
               ссылаться друг на друга, а не конкурировать вслепую. #}
            <p class="mt-3 text-sm text-gray-500">
                Впервые выбираете локальный бренд?
                <a href="{{ path('blog_show', {_locale: page_locale|default('ru'), slug: 'rossiyskie-brendy-odezhdy-gid'}) }}"
                   class="text-gray-900 underline underline-offset-2 hover:no-underline">Гид по российским брендам одежды</a>
                — как отличить производителя от перепродавца и где покупать напрямую.
            </p>
            {# Ссылки на фасетные страницы аудитории (docs/geo_city_demand_2026_09.md §11):
               «российские бренды женской/мужской/детской одежды» — неотработанный спрос
               ≈4400 показов/мес до появления /audience/{slug}. #}
            <div class="flex flex-wrap justify-center gap-3 mt-4 text-sm">
                <a href="{{ path('brand_audience_show', {_locale: app.request.locale, slug: 'female'}) }}" class="text-indigo-600 hover:text-indigo-800">Женская одежда</a>
                <a href="{{ path('brand_audience_show', {_locale: app.request.locale, slug: 'male'}) }}" class="text-indigo-600 hover:text-indigo-800">Мужская одежда</a>
                <a href="{{ path('brand_audience_show', {_locale: app.request.locale, slug: 'kids'}) }}" class="text-indigo-600 hover:text-indigo-800">Детская одежда</a>
                <a href="{{ path('brand_audience_show', {_locale: app.request.locale, slug: 'unisex'}) }}" class="text-indigo-600 hover:text-indigo-800">Унисекс</a>
            </div>
        </section>

        {# --- Алфавитный указатель --- #}
        <section class="mb-10">
            <div class="flex flex-col items-center gap-4">
                <div class="flex flex-wrap justify-center gap-2">
{#                {% for letter,cnt in foundLetters %}#}
{#                    {% set active = app.request.get('letter') == letter %}#}
{#                    <a href="{{ path('brand_index', {letter: letter}) }}"#}
{#                       class="px-3 py-1 rounded-md border text-sm font-medium transition#}
{#                  {{ active ? 'bg-black text-white border-black' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-200' }}">#}
{#                            {{ letter }}#}
{#                    </a>#}
{#                {% endfor %}#}
{#                </div>#}

                {% for lang, letters in alphabets %}
                    <div class="flex flex-wrap justify-center gap-2">
                        {% for letter in letters %}
                            {% set active = currentFirstLetter == letter %}
                            <a href="{{ path('brand_index', {letter: letter}) }}"
                               class="px-3 py-1 rounded-md border text-sm font-medium transition
                      {{ active ? 'bg-black text-white border-black' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-200' }}">
                                {{ letter }}
                            </a>
                        {% endfor %}
                    </div>
                {% endfor %}

                {# Второй уровень: валидные двухбуквенные префиксы выбранной буквы #}
                {% if subLetters is not empty %}
                    <div class="flex flex-wrap justify-center gap-2 pt-2 border-t border-gray-100">
                        {% for prefix, cnt in subLetters %}
                            {% set active = currentLetter|upper == prefix %}
                            <a href="{{ path('brand_index', {letter: prefix}) }}"
                               title="{{ cnt }} брендов"
                               class="px-2.5 py-1 rounded-md border text-xs font-medium transition
                      {{ active ? 'bg-black text-white border-black' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-200' }}">
                                {{ prefix }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="flex justify-center">
                    <a href="{{ path('brand_index') }}"
                       class="px-3 py-1 rounded-md border text-sm font-medium bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-200">
                        Все
                    </a>
                </div>
            </div>
        </section>

        {# --- Сетка брендов --- #}
        {% if brands|length > 0 %}
            <section>
                <p class="text-sm text-gray-500 mb-4">
                    {% if currentLetter %}Буква «{{ currentLetter }}»: {% endif %}
                    {% if currentCity %}Город «{{ currentCity }}»: {% endif %}
                    {% if currentStyle %}Стиль: {% endif %}
                    {{ totalItems }} брендов
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
                    {% for brand in brands %}
                        <article class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                            <a href="{{ path('brand_show', { _locale: app.request.locale, slug: brand.slug }) }}" class="flex flex-col items-center p-4 text-center">
                                <div class="w-24 h-24 flex items-center justify-center mb-3">
                                    {% if brand.logo %}
                                        <img src="{{ asset('images/logos/' ~ brand.logo) }}" alt="{{ brand.title }}" loading="lazy" width="96" height="96"
                                              class="object-contain w-full h-full transition-transform group-hover:scale-105 duration-300">
                                    {% else %}
                                        <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-400 text-sm">
                                            {{ brand.title|slice(0,1) }}
                                        </div>
                                    {% endif %}
                                </div>

                                <h3 class="text-sm font-semibold mb-1 truncate">{{ brand.title }} <br><small>{{ brand.city }}</small> </h3>

{#                                {% if brand.country %}#}
{#                                    <p class="text-xs text-gray-500">{{ brand.country }}</p>#}
{#                                {% endif %}#}
                            </a>
                        </article>
                    {% endfor %}
                </div>

                <div class="mt-8 flex justify-center">
                    {% if totalPages > 1 %}
                    <nav class="flex items-center gap-1" aria-label="Пагинация">
                        {% if page > 1 %}
                        <a href="{{ path('brand_index', {_locale: app.request.locale, letter: currentLetter, city: currentCity, style: currentStyle, page: page - 1}) }}"
                           class="px-3 py-2 rounded-md border text-sm font-medium bg-white text-gray-700 border-gray-200 hover:bg-gray-50 transition">
                            ←
                        </a>
                        {% endif %}

                        {% for p in 1..totalPages %}
                            {% if p == page %}
                                <span class="px-3 py-2 rounded-md border text-sm font-medium bg-black text-white border-black">{{ p }}</span>
                            {% elseif p == 1 or p == totalPages or (p >= page - 2 and p <= page + 2) %}
                                <a href="{{ path('brand_index', {_locale: app.request.locale, letter: currentLetter, city: currentCity, style: currentStyle, page: p}) }}"
                                   class="px-3 py-2 rounded-md border text-sm font-medium bg-white text-gray-700 border-gray-200 hover:bg-gray-50 transition">
                                    {{ p }}
                                </a>
                            {% elseif p == page - 3 or p == page + 3 %}
                                <span class="px-2 py-2 text-gray-400">…</span>
                            {% endif %}
                        {% endfor %}

                        {% if page < totalPages %}
                        <a href="{{ path('brand_index', {_locale: app.request.locale, letter: currentLetter, city: currentCity, style: currentStyle, page: page + 1}) }}"
                           class="px-3 py-2 rounded-md border text-sm font-medium bg-white text-gray-700 border-gray-200 hover:bg-gray-50 transition">
                            →
                        </a>
                        {% endif %}
                    </nav>
                    {% endif %}
                </div>
            </section>

        {% else %}
            <section class="text-center py-20 text-gray-500">
                {% if app.request.get('letter') %}
                    Нет брендов на букву «{{ app.request.get('letter') }}».
                {% elseif app.request.get('city') %}
                    Нет брендов из города «{{ app.request.get('city') }}».
                {% elseif app.request.get('style') %}
                    Нет брендов в данном стиле.
                {% else %}
                    <p class="text-lg mb-2 font-medium">Популярные бренды:</p>
                    <div class="flex flex-wrap justify-center gap-4 text-gray-700 text-sm">
                        {% for b in featuredBrands %}
                            <a href="{{ path('brand_show', { slug: b.slug }) }}" class="hover:text-black font-semibold">
                                {{ b.name }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        {% endif %}

    </div>
{% endblock %}
