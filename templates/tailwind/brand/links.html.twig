{# Разбор ссылок по интенту: коммерческие (сайт+маркетплейсы) под запрос «где купить {бренд}»,
   соцсети — отдельно. Соцсеть определяем по хосту одной регуляркой (чтобы не дублировать проверки). #}
{% set _social_rx = '/instagram\\.com|vk\\.com|vkontakte|t\\.me\\/|telegram\\.|youtu|tiktok\\.com|pinterest\\.|dzen\\.ru|zen\\.yandex|facebook\\.com|fb\\.com/' %}
{% set _commercial = brand.uniqueLinks|filter(l => not ((l.linkUrl|lower) matches _social_rx)) %}
{% set _social = brand.uniqueLinks|filter(l => (l.linkUrl|lower) matches _social_rx) %}

{% if _commercial|length > 0 %}
    <section class="bg-white rounded-xl shadow-sm p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Где купить {{ brand_t(brand, 'title') }}</h3>
        <div class="space-y-3">
            {% for link in _commercial %}
                {% set _h = link.linkUrl|lower %}
                {% set _label = 'Официальный сайт' %}
                {% set _isMp = false %}
                {% if 'wildberries.' in _h %}{% set _label = 'Wildberries' %}{% set _isMp = true %}
                {% elseif 'ozon.' in _h %}{% set _label = 'Ozon' %}{% set _isMp = true %}
                {% elseif 'lamoda.' in _h %}{% set _label = 'Lamoda' %}{% set _isMp = true %}
                {% elseif 'aliexpress.' in _h %}{% set _label = 'AliExpress' %}{% set _isMp = true %}
                {% elseif 'yandex.' in _h and 'market' in _h %}{% set _label = 'Яндекс Маркет' %}{% set _isMp = true %}
                {% elseif 'wa.me' in _h or 'whatsapp.com' in _h %}{% set _label = 'WhatsApp' %}
                {% endif %}
                <a href="{{ path('brand_outbound_click', {id: link.id}) }}" target="_blank" rel="nofollow noopener"
                   class="flex items-center gap-3 px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-900 hover:text-white transition group">
                    {% if _isMp %}
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M3 3a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
                    {% else %}
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"/></svg>
                    {% endif %}
                    <span>{{ _label }}{% if _label == 'Официальный сайт' %} · {{ link.linkUrl|replace({'https://': '', 'http://': '', 'www.': ''})|trim('/') }}{% endif %}</span>
                </a>
            {% endfor %}
        </div>
    </section>
{% endif %}

{% if _social|length > 0 %}
    <section class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-xl font-semibold mb-4">{{ brand_t(brand, 'title') }} в соцсетях</h3>
        <div class="space-y-3">
            {% for link in _social %}
                {% set _h = link.linkUrl|lower %}
                {% set _key = link.title %}
                {% if 'instagram.com' in _h %}{% set _key = 'Instagram' %}
                {% elseif 'vk.com' in _h or 'vkontakte' in _h %}{% set _key = 'VK' %}
                {% elseif 't.me/' in _h or 'telegram.' in _h %}{% set _key = 'Telegram' %}
                {% elseif 'youtube.com' in _h or 'youtu.be' in _h %}{% set _key = 'YouTube' %}
                {% elseif 'tiktok.com' in _h %}{% set _key = 'Tiktok' %}
                {% elseif 'pinterest.' in _h %}{% set _key = 'Pinterest' %}
                {% elseif 'dzen.ru' in _h or 'zen.yandex' in _h %}{% set _key = 'Dzen' %}
                {% elseif 'facebook.com' in _h or 'fb.com' in _h %}{% set _key = 'Facebook' %}
                {% endif %}
                {% if socialIcons[_key] is defined %}
                    {% set social = socialIcons[_key] %}
                    <a href="{{ path('brand_outbound_click', {id: link.id}) }}" target="_blank" rel="nofollow noopener"
                       class="flex items-center gap-3 px-4 py-1 rounded-lg bg-gray-100 {{ social.hover }} hover:text-white transition group">
                        {% if social.viewbox is defined %}
                        {{ social.viewbox|raw }}
                        {% else %}
                        <svg width="24" height="24" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            {% endif %}
                            {{ social.icon|raw }}
                        </svg>
                        <span>{{ social.title }}</span>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </section>
{% endif %}
