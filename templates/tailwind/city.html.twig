{% extends 'tailwind/base.html.twig' %}

{# Русское согласование числительного: 1 бренд / 2-4 бренда / 5+ брендов.
   Шаблон умел только «1 / много», из-за чего extractable-предложение,
   которое мы отдаём в сниппет, звучало как «опубликовано 94 брендов». #}
{% macro plural(n, one, few, many) %}{{ n % 10 == 1 and n % 100 != 11 ? one : (n % 10 >= 2 and n % 10 <= 4 and (n % 100 < 12 or n % 100 > 14) ? few : many) }}{% endmacro %}

{% set page_locale = app.request.locale|default('ru') %}

{% block title %}{% if hub and hub.metaTitle %}{{ hub.metaTitle }}{% else %}Бренды одежды {{ city }} — {{ brands|length }} {{ _self.plural(brands|length, 'местная марка', 'местные марки', 'местных марок') }} с сайтами и контактами | WEARBASE{% endif %}{% endblock %}

{% block meta_description %}{% if hub and hub.metaDescription %}{{ hub.metaDescription }}{% else %}Местные бренды одежды из города {{ city }}: {{ brands|length }} {{ _self.plural(brands|length, 'марка', 'марки', 'марок') }} с сайтами, соцсетями и контактами. Покупайте у производителей города {{ city }} напрямую, без наценки маркетплейсов.{% endif %}{% endblock %}

{% block meta_keywords %}бренды одежды {{ city|lower }}, бренд одежды {{ city|lower }}, местные бренды одежды {{ city|lower }}, локальные бренды {{ city|lower }}, российские бренды одежды{% endblock %}

{# Гейт индексации тонких гео-хабов (docs/seo_sitewide_backlog.md HIGH-1): < MIN_INDEXABLE_BRANDS
   без кураторского CityHub → noindex,follow, чтобы не плодить шаблонные «[бренды]+[город]» страницы. #}
{% block meta_robots %}{% if not indexable %}<meta name="robots" content="noindex, follow">{% endif %}{% endblock %}

{% block og_title %}Бренды одежды {{ city }} | WEARBASE{% endblock %}

{% block og_description %}{{ brands|length }} {{ _self.plural(brands|length, 'местный бренд', 'местных бренда', 'местных брендов') }} одежды из города {{ city }} — с сайтами и контактами.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#webpage",
                "url": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}",
                "name": "Бренды одежды {{ city }} | WEARBASE",
                "breadcrumb": {"@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#breadcrumb"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Города", "item": "{{ url('brand_cities', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 3, "name": {{ city|json_encode|raw }}, "item": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}"}
                ]
            },
            {
                "@type": "ItemList",
                "itemListElement": [
                    {% for brand in brands|slice(0, 30) %}
                    {"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ url('brand_show', {_locale: page_locale, slug: brand.slug}) }}", "name": {{ brand.title|json_encode|raw }}}{{ loop.last ? '' : ',' }}
                    {% endfor %}
                ]
            }
            {% if hub and hub.faq|length > 0 %},
            {
                "@type": "FAQPage",
                "mainEntity": [
                    {% for faq in hub.faq %}
                    {
                        "@type": "Question",
                        "name": "{{ faq.question|escape('js') }}",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "{{ faq.answer|escape('js') }}"
                        }
                    }{% if not loop.last %},{% endif %}
                    {% endfor %}
                ]
            }
            {% endif %}
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <a href="{{ path('brand_cities', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Города</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">{{ city }}</span>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold mb-3">{% if hub and hub.h1 %}{{ hub.h1 }}{% else %}Бренды одежды — {{ city }}{% endif %}</h1>
        {% if hub and hub.intro %}
            <div class="prose prose-sm text-gray-600 max-w-2xl mb-10">{{ hub.intro|raw }}</div>
        {% else %}
            <p class="text-gray-600 max-w-2xl mb-10">{{ brands|length }} {{ _self.plural(brands|length, 'местный бренд', 'местных бренда', 'местных брендов') }} одежды из города {{ city }} в каталоге WEARBASE — с сайтами, соцсетями и контактами. Покупайте у производителей своего города напрямую: без комиссии маркетплейсов цена честнее, а в шоуруме можно примерить.</p>
        {% endif %}

        {# Extractable-блок (docs/drmax_seo_2026_digest.md §1/§9): H2-вопрос + самодостаточный
           ответ первым предложением, только grounded-данные из контроллера. Только для
           индексируемых хабов — на noindex-страницах это лишний шаблонный текст. #}
        {% if indexable %}
            <section class="max-w-2xl mb-10">
                <h2 class="text-lg font-semibold mb-2">Какие бренды одежды представлены в городе {{ city }}?</h2>
                <p class="text-gray-700 text-sm leading-relaxed">
                    В городе {{ city }} в каталоге WEARBASE опубликовано {{ brands|length }} {{ _self.plural(brands|length, 'бренд', 'бренда', 'брендов') }} одежды местного производства{% if topStyles|length %}, преобладающие стили — {% for s in topStyles %}{{ s.title }} ({{ s.cnt }}){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}. Каждый бренд представлен на сайте с контактами и соцсетями, а купить вещи можно напрямую у производителя — без комиссии маркетплейсов и с более честной ценой, чем в масс-маркете.
                </p>
            </section>
        {% endif %}

        {# FAQ городского хаба: кураторский, независим от indexable — наличие hub.faq
           само по себе означает, что хаб курируется и должен индексироваться. #}
        {% if hub and hub.faq|length > 0 %}
            <section class="max-w-2xl mb-10">
                <h2 class="text-lg font-semibold mb-2">Вопросы и ответы о брендах города {{ city }}</h2>
                <div class="rounded-2xl bg-white shadow-sm divide-y divide-gray-100">
                    {% for faq in hub.faq %}
                        <details class="group p-4">
                            <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-gray-900 hover:text-gray-600">
                                <h3 class="text-base font-semibold">{{ faq.question }}</h3>
                                <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </summary>
                            <p class="mt-2 text-gray-700 leading-relaxed">{{ faq.answer }}</p>
                        </details>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            {% for brand in brands %}
                <article class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <a href="{{ path('brand_show', {_locale: page_locale, slug: brand.slug}) }}" class="flex flex-col items-center p-4 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mb-3">
                            {% if brand.logo %}
                                <img src="{{ asset('images/logos/' ~ brand.logo) }}" alt="{{ brand.title }} — бренд одежды, {{ city }}" loading="lazy" width="96" height="96"
                                     class="object-contain w-full h-full transition-transform group-hover:scale-105 duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-400 text-sm">
                                    {{ brand.title|slice(0, 1) }}
                                </div>
                            {% endif %}
                        </div>
                        <h3 class="text-sm font-semibold mb-1 truncate w-full">{{ brand.title }}</h3>
                        {# Текст карточки: anons, а при его отсутствии — начало description.
                           На СПб 45 карточек из 98 не имеют anons, но у 83 брендов есть описание
                           длиннее 200 символов (на Москве 125 пустых из 388 при 357 с описанием) —
                           то есть текст в базе есть, он просто не выводился. Обрезок в 80 символов
                           поднят до 160: подборки, которые обходят нас в выдаче, дают на бренд
                           3–5 предложений, а мы показывали логотип и имя. #}
                        {% set card_text = brand.anons ?: brand.description %}
                        {% if card_text %}
                            <p class="text-xs text-gray-500 line-clamp-3">{{ card_text|striptags|slice(0, 160)|trim }}{% if card_text|striptags|length > 160 %}…{% endif %}</p>
                        {% endif %}
                    </a>
                </article>
            {% endfor %}
        </div>

        <div class="mt-12 p-6 bg-gray-50 rounded-xl text-center">
            <p class="font-semibold mb-2">Знаете бренд из города {{ city }}, которого здесь нет?</p>
            <p class="text-sm text-gray-600 mb-4">Размещение в каталоге — без комиссии с продаж, деньги за заказы идут напрямую бренду.</p>
            <a href="{{ path('landing_for_brands', {_locale: page_locale}) }}"
               class="inline-block px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
                Добавить бренд
            </a>
        </div>

        <div class="mt-8 flex gap-4 text-sm">
            <a href="{{ path('brand_cities', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">← Все города</a>
            <a href="{{ path('brand_index', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Все бренды</a>
        </div>
    </div>
{% endblock %}
