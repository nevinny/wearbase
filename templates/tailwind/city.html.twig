{% extends 'tailwind/base.html.twig' %}

{% set page_locale = app.request.locale|default('ru') %}

{% block title %}{% if hub and hub.metaTitle %}{{ hub.metaTitle }}{% else %}Бренды одежды {{ city }} — {{ brands|length }} местных марок с сайтами и контактами | WEARBASE{% endif %}{% endblock %}

{% block meta_description %}{% if hub and hub.metaDescription %}{{ hub.metaDescription }}{% else %}Местные бренды одежды из города {{ city }}: {{ brands|length }} марок с сайтами, соцсетями и контактами. Покупайте у производителей города {{ city }} напрямую, без наценки маркетплейсов.{% endif %}{% endblock %}

{% block meta_keywords %}бренды одежды {{ city|lower }}, бренд одежды {{ city|lower }}, местные бренды одежды {{ city|lower }}, локальные бренды {{ city|lower }}, российские бренды одежды{% endblock %}

{# Гейт индексации тонких гео-хабов (docs/seo_sitewide_backlog.md HIGH-1): < MIN_INDEXABLE_BRANDS
   без кураторского CityHub → noindex,follow, чтобы не плодить шаблонные «[бренды]+[город]» страницы. #}
{% block meta_robots %}{% if not indexable %}<meta name="robots" content="noindex, follow">{% endif %}{% endblock %}

{% block og_title %}Бренды одежды {{ city }} | WEARBASE{% endblock %}

{% block og_description %}{{ brands|length }} местных брендов одежды из города {{ city }} — с сайтами и контактами.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#webpage",
                "url": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}",
                "name": "Бренды одежды {{ city }} | WEARBASE",
                "breadcrumb": {"@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#breadcrumb"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Города", "item": "{{ url('brand_cities', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 3, "name": {{ city|json_encode|raw }}, "item": "{{ url('brand_city', {_locale: page_locale, slug: slug}) }}"}
                ]
            },
            {
                "@type": "ItemList",
                "itemListElement": [
                    {% for brand in brands|slice(0, 30) %}
                    {"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ url('brand_show', {_locale: page_locale, slug: brand.slug}) }}", "name": {{ brand.title|json_encode|raw }}}{{ loop.last ? '' : ',' }}
                    {% endfor %}
                ]
            }
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <a href="{{ path('brand_cities', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Города</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">{{ city }}</span>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold mb-3">{% if hub and hub.h1 %}{{ hub.h1 }}{% else %}Бренды одежды — {{ city }}{% endif %}</h1>
        {% if hub and hub.intro %}
            <div class="prose prose-sm text-gray-600 max-w-2xl mb-10">{{ hub.intro|raw }}</div>
        {% else %}
            <p class="text-gray-600 max-w-2xl mb-10">{{ brands|length }} {{ brands|length == 1 ? 'местный бренд' : 'местных брендов' }} одежды из города {{ city }} в каталоге WEARBASE — с сайтами, соцсетями и контактами. Покупайте у производителей своего города напрямую: без комиссии маркетплейсов цена честнее, а в шоуруме можно примерить.</p>
        {% endif %}

        {# Extractable-блок (docs/drmax_seo_2026_digest.md §1/§9): H2-вопрос + самодостаточный
           ответ первым предложением, только grounded-данные из контроллера. Только для
           индексируемых хабов — на noindex-страницах это лишний шаблонный текст. #}
        {% if indexable %}
            <section class="max-w-2xl mb-10">
                <h2 class="text-lg font-semibold mb-2">Какие бренды одежды представлены в городе {{ city }}?</h2>
                <p class="text-gray-700 text-sm leading-relaxed">
                    В городе {{ city }} в каталоге WEARBASE опубликовано {{ brands|length }} {{ brands|length == 1 ? 'бренд' : 'брендов' }} одежды местного производства{% if topStyles|length %}, преобладающие стили — {% for s in topStyles %}{{ s.title }} ({{ s.cnt }}){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}. Каждый бренд представлен на сайте с контактами и соцсетями, а купить вещи можно напрямую у производителя — без комиссии маркетплейсов и с более честной ценой, чем в масс-маркете.
                </p>
            </section>
        {% endif %}

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            {% for brand in brands %}
                <article class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <a href="{{ path('brand_show', {_locale: page_locale, slug: brand.slug}) }}" class="flex flex-col items-center p-4 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mb-3">
                            {% if brand.logo %}
                                <img src="{{ asset('images/logos/' ~ brand.logo) }}" alt="{{ brand.title }} — бренд одежды, {{ city }}" loading="lazy" width="96" height="96"
                                     class="object-contain w-full h-full transition-transform group-hover:scale-105 duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-400 text-sm">
                                    {{ brand.title|slice(0, 1) }}
                                </div>
                            {% endif %}
                        </div>
                        <h2 class="text-sm font-semibold mb-1 truncate w-full">{{ brand.title }}</h2>
                        {% if brand.anons %}
                            <p class="text-xs text-gray-500 line-clamp-2">{{ brand.anons|slice(0, 80) }}</p>
                        {% endif %}
                    </a>
                </article>
            {% endfor %}
        </div>

        <div class="mt-12 p-6 bg-gray-50 rounded-xl text-center">
            <p class="font-semibold mb-2">Знаете бренд из города {{ city }}, которого здесь нет?</p>
            <p class="text-sm text-gray-600 mb-4">Размещение в каталоге — без комиссии с продаж, деньги за заказы идут напрямую бренду.</p>
            <a href="{{ path('landing_for_brands', {_locale: page_locale}) }}"
               class="inline-block px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
                Добавить бренд
            </a>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 text-sm">
            <a href="{{ path('brand_cities', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">← Все города</a>
            {% if region is defined and region %}
                <a href="{{ path('brand_region', {_locale: page_locale, slug: regionSlug}) }}" class="text-gray-500 hover:text-gray-900">Все бренды — {{ region }}</a>
            {% endif %}
            <a href="{{ path('brand_index', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Все бренды</a>
        </div>
    </div>
{% endblock %}
