{% extends 'tailwind/base.html.twig' %}

{% set page_locale = app.request.locale|default('ru') %}

{% block title %}Российские бренды одежды в стиле {{ style.title }} — {{ brands|length }} марок | WEARBASE{% endblock %}

{% block meta_description %}Российские бренды одежды в стиле «{{ style.title }}»: {{ brands|length }} марок с сайтами, соцсетями и контактами. Покупайте напрямую у производителей, без наценки маркетплейсов.{% endblock %}

{% block meta_keywords %}{{ style.title|lower }} бренды, {{ style.title|lower }} одежда россия, российские бренды {{ style.title|lower }}, бренды одежды в стиле {{ style.title|lower }}{% endblock %}

{% block og_title %}Бренды одежды в стиле {{ style.title }} | WEARBASE{% endblock %}

{% block og_description %}{{ brands|length }} российских брендов одежды в стиле «{{ style.title }}» — с сайтами и контактами.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block body %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "{{ url('brand_style', {_locale: page_locale, slug: slug}) }}#webpage",
                "url": "{{ url('brand_style', {_locale: page_locale, slug: slug}) }}",
                "name": "Бренды одежды в стиле {{ style.title }} | WEARBASE",
                "breadcrumb": {"@id": "{{ url('brand_style', {_locale: page_locale, slug: slug}) }}#breadcrumb"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('brand_style', {_locale: page_locale, slug: slug}) }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Стили", "item": "{{ url('brand_styles', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 3, "name": {{ style.title|json_encode|raw }}, "item": "{{ url('brand_style', {_locale: page_locale, slug: slug}) }}"}
                ]
            },
            {
                "@type": "ItemList",
                "itemListElement": [
                    {% for brand in brands|slice(0, 30) %}
                    {"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ url('brand_show', {_locale: page_locale, slug: brand.slug}) }}", "name": {{ brand.title|json_encode|raw }}}{{ loop.last ? '' : ',' }}
                    {% endfor %}
                ]
            }
        ]
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <a href="{{ path('brand_styles', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Стили</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">{{ style.title }}</span>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold mb-3">Бренды одежды в стиле {{ style.title }}</h1>
        <p class="text-gray-600 max-w-2xl mb-10">{% if style.description %}{{ style.description }}{% else %}{{ brands|length }} {{ brands|length == 1 ? 'российский бренд' : 'российских брендов' }} одежды в стиле «{{ style.title }}» в каталоге WEARBASE — с сайтами, соцсетями и контактами. Покупайте у производителей напрямую: без комиссии маркетплейсов цена честнее.{% endif %}</p>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
            {% for brand in brands %}
                <article class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <a href="{{ path('brand_show', {_locale: page_locale, slug: brand.slug}) }}" class="flex flex-col items-center p-4 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mb-3">
                            {% if brand.logo %}
                                <img src="{{ asset('images/logos/' ~ brand.logo) }}" alt="{{ brand.title }} — бренд одежды в стиле {{ style.title }}" loading="lazy" width="96" height="96"
                                     class="object-contain w-full h-full transition-transform group-hover:scale-105 duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-400 text-sm">
                                    {{ brand.title|slice(0, 1) }}
                                </div>
                            {% endif %}
                        </div>
                        <h2 class="text-sm font-semibold mb-1 truncate w-full">{{ brand.title }}</h2>
                        {% if brand.anons %}
                            <p class="text-xs text-gray-500 line-clamp-2">{{ brand.anons|slice(0, 80) }}</p>
                        {% endif %}
                    </a>
                </article>
            {% endfor %}
        </div>

        <div class="mt-12 p-6 bg-gray-50 rounded-xl text-center">
            <p class="font-semibold mb-2">Знаете бренд в стиле «{{ style.title }}», которого здесь нет?</p>
            <p class="text-sm text-gray-600 mb-4">Размещение в каталоге — без комиссии с продаж, деньги за заказы идут напрямую бренду.</p>
            <a href="{{ path('landing_for_brands', {_locale: page_locale}) }}"
               class="inline-block px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
                Добавить бренд
            </a>
        </div>

        <div class="mt-8 flex gap-4 text-sm">
            <a href="{{ path('brand_styles', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">← Все стили</a>
            <a href="{{ path('brand_index', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Все бренды</a>
        </div>
    </div>
{% endblock %}
