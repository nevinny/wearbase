{% extends 'tailwind/base.html.twig' %}

{% block title %}WEARBASE — каталог российских брендов одежды{% endblock %}

{% block meta_description %}Каталог российских брендов одежды. {{ totalBrands }}+ брендов из Москвы, Санкт-Петербурга и других городов России. Streetwear, минимализм, casual.{% endblock %}

{% block meta_keywords %}российские бренды одежды, каталог брендов, streetwear, уличная мода, российский стиль{% endblock %}

{% block og_title %}WEARBASE — каталог российских брендов одежды{% endblock %}

{% block og_description %}Более {{ totalBrands }} российских брендов одежды. Streetwear, минимализм, casual из Москвы, Питера и других городов.{% endblock %}

{% block og_image %}{{ absolute_url('/og-image.svg') }}{% endblock %}

{% block body %}
    {% set page_locale = locale|default(app.request.locale|default('ru')) %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebPage",
                "@id": "{{ url('home_hub', {_locale: page_locale}) }}#webpage",
                "url": "{{ url('home_hub', {_locale: page_locale}) }}",
                "name": "WEARBASE — каталог российских брендов одежды",
                "description": "Каталог российских брендов одежды. Более {{ totalBrands }} брендов из российских городов.",
                "isPartOf": {"@id": "#website"},
                "breadcrumb": {"@id": "{{ url('home_hub', {_locale: page_locale}) }}#breadcrumb"}
            },
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('home_hub', {_locale: page_locale}) }}#breadcrumb",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Главная",
                        "item": "{{ url('home_hub', {_locale: page_locale}) }}"
                    }
                ]
            }
        ]
    }
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "WEARBASE",
        "url": "https://wearbase.ru",
        "logo": "{{ absolute_url(asset('images/logo.svg')) }}",
        "description": "Каталог российских брендов одежды. Более {{ totalBrands }} брендов из российских городов.",
        "sameAs": []
    }
    </script>

    <div class="container mx-auto px-4 py-10">
        <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
            <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Каталог брендов</span>
        </nav>

        <section class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Каталог российских брендов одежды</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Более {{ totalBrands }} брендов из российских городов. Streetwear, минимализм, casual и другие направления.
            </p>
        </section>

        {% if featuredBrands|length > 0 %}
            <section class="mb-12">
                <h2 class="text-2xl font-bold mb-6">Популярные бренды</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    {% for brand in featuredBrands %}
                        <a href="{{ path('brand_show', {slug: brand.slug}) }}"
                           class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition border">
                            <div class="aspect-w-1 aspect-h-1 bg-gray-100">
                                {% if brand.logo %}
                                    <img src="{{ asset('images/logos/' ~ brand.logo) }}"
                                         alt="{{ brand.title }}"
                                         class="w-full h-32 object-contain p-4 group-hover:scale-105 transition">
                                {% else %}
                                    <div class="w-full h-32 flex items-center justify-center bg-gray-100">
                                        <span class="text-gray-400 text-sm">{{ brand.title }}</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="p-3 text-center">
                                <div class="font-medium text-sm truncate">{{ brand.title }}</div>
                                {% if brand.city %}
                                    <div class="text-xs text-gray-500">{{ brand.city }}</div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
            <section id="cities" class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-semibold mb-4">Города</h2>
                <div class="space-y-2">
                    {% for city in topCities %}
                        <a href="{{ path('brand_city', {_locale: locale, slug: city.slug}) }}"
                           class="flex justify-between items-center p-2 rounded-lg hover:bg-gray-50 transition">
                            <span>{{ city.city }}</span>
                            <span class="text-sm text-gray-500">{{ city.cnt }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>

            <section id="styles" class="bg-white rounded-xl shadow-sm p-6">
                <div class="flex items-baseline justify-between mb-4">
                    <h2 class="text-xl font-semibold">Стили</h2>
                    <a href="{{ path('brand_styles', {_locale: locale}) }}" class="text-sm text-indigo-600 hover:text-indigo-800">Все стили →</a>
                </div>
                <div class="space-y-2">
                    {% for style in topStyles %}
                        <a href="{{ path('brand_style', {_locale: locale, slug: style.slug}) }}"
                           class="flex justify-between items-center p-2 rounded-lg hover:bg-gray-50 transition">
                            <span>{{ style.title }}</span>
                            <span class="text-sm text-gray-500">{{ style.cnt }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-xl font-semibold mb-4">Последние добавленные</h2>
                <div class="space-y-2">
                    {% for brand in recentBrands %}
                        <a href="{{ path('brand_show', {slug: brand.slug}) }}"
                           class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 transition">
                            {% if brand.logo %}
                                <img src="{{ asset('images/logos/' ~ brand.logo) }}"
                                     alt="{{ brand.title }}"
                                     class="w-10 h-10 object-contain rounded bg-gray-100 p-1">
                            {% else %}
                                <div class="w-10 h-10 rounded bg-gray-200 flex items-center justify-center">
                                    <span class="text-gray-400 text-xs">{{ brand.title|slice(0,1) }}</span>
                                </div>
                            {% endif %}
                            <div class="flex-1 min-w-0">
                                <div class="font-medium text-sm truncate">{{ brand.title }}</div>
                                {% if brand.city %}
                                    <div class="text-xs text-gray-500">{{ brand.city }}</div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="mb-10">
            {% include 'tailwind/_yandex_rsa_block.html.twig' with {block_id: 'R-A-19612178-1'} %}
        </div>

        <section class="text-center">
            <a href="{{ path('brand_index', {_locale: locale}) }}"
               class="inline-flex items-center gap-2 px-8 py-4 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition text-lg font-medium">
                Все бренды ({{ totalBrands }})
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </section>
    </div>
{% endblock %}