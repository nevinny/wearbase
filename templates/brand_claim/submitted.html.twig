{% extends 'base.html.twig' %}
{% block title %}Заявка отправлена — {{ brand.title }}{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="max-width:520px">

    <div class="mb-4">
        {% if emailMatch %}
            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:64px;height:64px;font-size:28px">
                <i class="fas fa-check"></i>
            </div>
            <h1 class="h4 fw-bold mb-2">Заявка верифицирована!</h1>
            <p class="text-muted">
                Домен вашего email совпал с доменом бренда —
                заявка отмечена как верифицированная и будет рассмотрена в первую очередь.
            </p>
        {% else %}
            <div class="rounded-circle bg-dark text-white d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:64px;height:64px;font-size:28px">
                <i class="fas fa-paper-plane"></i>
            </div>
            <h1 class="h4 fw-bold mb-2">Заявка отправлена</h1>
            <p class="text-muted">
                Администрация WEARBASE проверит вашу заявку.
                Обычно это занимает 1–2 рабочих дня.
            </p>
        {% endif %}
    </div>

    <div class="card border-0 shadow-sm mb-4 text-start">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between small mb-2">
                <span class="text-muted">Бренд</span>
                <span class="fw-semibold">{{ brand.title }}</span>
            </div>
            <div class="d-flex justify-content-between small mb-2">
                <span class="text-muted">Статус</span>
                <span class="badge {{ emailMatch ? 'bg-success' : 'bg-secondary' }}">
                    {{ claim.statusLabel }}
                </span>
            </div>
            <div class="d-flex justify-content-between small">
                <span class="text-muted">Результат</span>
                <span class="text-muted">На email придёт уведомление</span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-center">
        <a href="{{ path('brand_show', {slug: brand.slug, _locale: 'ru'}) }}"
           class="btn btn-outline-secondary">← К бренду</a>
        <a href="{{ path('account_dashboard') }}" class="btn btn-dark">Мой кабинет</a>
    </div>

</div>
{% endblock %}
