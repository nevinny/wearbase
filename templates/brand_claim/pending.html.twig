{% extends 'base.html.twig' %}
{% block title %}Заявка на рассмотрении — {{ brand.title }}{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="max-width:480px">

    <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-3"
         style="width:64px;height:64px;font-size:28px">
        <i class="fas fa-hourglass-half"></i>
    </div>

    <h1 class="h4 fw-bold mb-2">Заявка уже подана</h1>
    <p class="text-muted mb-4">
        Ваша заявка на владение брендом <strong>{{ brand.title }}</strong>
        находится на рассмотрении. Мы пришлём email когда будет решение.
    </p>

    <div class="card border-0 shadow-sm mb-4 text-start">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between small mb-2">
                <span class="text-muted">Подана</span>
                <span>{{ claim.createdAt|date('d.m.Y') }}</span>
            </div>
            <div class="d-flex justify-content-between small">
                <span class="text-muted">Статус</span>
                <span class="badge {{ claim.emailDomainMatch ? 'bg-success' : 'bg-secondary' }}">
                    {{ claim.statusLabel }}
                </span>
            </div>
        </div>
    </div>

    <a href="{{ path('account_dashboard') }}" class="btn btn-dark">В мой кабинет</a>

</div>
{% endblock %}
