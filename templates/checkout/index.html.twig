{% extends 'tailwind/app.html.twig' %}
{% block title %}Оформление заказа — WEARBASE{% endblock %}
{# Checkout: без навигации в шапке — ничего не должно уводить из оформления #}
{% block header %}
<header class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-3">
        {% set nav_locale = app.request.locale|default('ru') %}
        <a href="{{ path('home_hub', {_locale: nav_locale}) }}" class="text-lg font-bold tracking-tight">
            <span class="text-gray-900">WEARBASE</span><span class="text-indigo-600">.{{ nav_locale == 'ru' ? 'ru' : 'com' }}</span>
        </a>
    </div>
</header>
{% endblock %}

{% block body %}
{% set card  = 'rounded-2xl bg-white shadow-sm overflow-hidden' %}
{% set chead = 'border-b border-gray-100 px-5 py-3 text-sm font-semibold flex items-center gap-2' %}
{% set badge = 'inline-flex h-5 w-5 items-center justify-center rounded bg-gray-900 text-[11px] font-semibold text-white' %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set opt_box  = 'rounded-xl border border-gray-200 p-4 has-[:checked]:border-gray-900 has-[:checked]:ring-1 has-[:checked]:ring-gray-900' %}

<div class="container mx-auto max-w-[1000px] px-4 py-8">
    <h1 class="mb-6 text-xl font-bold">Оформление заказа</h1>

    <form method="post" action="{{ path('checkout_confirm') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('checkout_confirm') }}">
        <div class="grid gap-6 lg:grid-cols-12">
            <div class="space-y-4 lg:col-span-7">

                {# 1. Адрес доставки #}
                <div class="{{ card }}">
                    <div class="{{ chead }}"><span class="{{ badge }}">1</span>Адрес доставки</div>
                    <div class="p-5">

                        {% if addresses|length > 0 %}
                        <div class="mb-4 flex flex-col gap-2">
                            {% for address in addresses %}
                            <label class="{{ opt_box }} flex cursor-pointer items-start gap-3">
                                <input class="mt-1" type="radio"
                                       name="address_id" id="addr_{{ address.id }}"
                                       value="{{ address.id }}"
                                       {{ (default and default.id == address.id) or (not default and loop.first) ? 'checked' : '' }}>
                                <span>
                                    <span class="block text-sm font-semibold">{{ address.label ?: address.fullName }}</span>
                                    <span class="block text-xs text-gray-500">{{ address.fullAddress }}</span>
                                </span>
                            </label>
                            {% endfor %}
                            <label class="{{ opt_box }} flex cursor-pointer items-center gap-3 text-sm">
                                <input type="radio" name="address_id" id="addr_new" value="">
                                + Другой адрес
                            </label>
                        </div>
                        {% endif %}

                        {# Поля нового адреса #}
                        <div id="new-address-fields" class="{{ addresses|length > 0 ? 'hidden' : '' }}">
                            <div class="grid grid-cols-12 gap-3">
                                <div class="col-span-12 md:col-span-6">
                                    <label class="{{ tw_label }}">Получатель</label>
                                    <input name="full_name" class="{{ tw_input }}" placeholder="Имя Фамилия"
                                           value="{{ app.user.fullName ?? app.user.email ?? '' }}" required>
                                </div>
                                <div class="col-span-12 md:col-span-6">
                                    <label class="{{ tw_label }}">Телефон</label>
                                    <input name="phone" type="tel" class="{{ tw_input }}" placeholder="+7 999 000 00 00" required>
                                </div>
                                <div class="col-span-8">
                                    <label class="{{ tw_label }}">Город</label>
                                    <input name="city" class="{{ tw_input }}" placeholder="Москва" required>
                                </div>
                                <div class="col-span-4">
                                    <label class="{{ tw_label }}">Индекс</label>
                                    <input name="zip" class="{{ tw_input }}" placeholder="123456">
                                </div>
                                <div class="col-span-12">
                                    <label class="{{ tw_label }}">Email</label>
                                    <input name="email" type="email" class="{{ tw_input }}"
                                           value="{{ app.user.email ?? '' }}" placeholder="example@mail.ru" required>
                                </div>
                                <div class="col-span-12">
                                    <label class="{{ tw_label }}">Улица</label>
                                    <input name="street" class="{{ tw_input }}" placeholder="ул. Ленина" required>
                                </div>
                                <div class="col-span-4">
                                    <label class="{{ tw_label }}">Дом</label>
                                    <input name="building" class="{{ tw_input }}" placeholder="42">
                                </div>
                                <div class="col-span-4">
                                    <label class="{{ tw_label }}">Квартира</label>
                                    <input name="apartment" class="{{ tw_input }}" placeholder="15">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# 2. Доставка #}
                <div class="{{ card }}">
                    <div class="{{ chead }} justify-between">
                        <span class="flex items-center gap-2"><span class="{{ badge }}">2</span>Способ доставки</span>
                        {# Выбор страны доставки #}
                        <select id="shipping-country" name="country"
                                class="max-w-[180px] rounded-lg border border-gray-200 px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-gray-900">
                            {% for country in countries %}
                                <option value="{{ country.code }}" {{ country.code == 'RU' ? 'selected' : '' }}>
                                    {{ country.flagEmoji }} {{ country.nameRu }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="p-5">
                        <input type="hidden" name="shipping_rule_id" id="shipping-rule-id" value="">
                        <input type="hidden" id="cart-weight" value="{{ cartWeight is defined ? cartWeight : 0.5 }}">
                        <div id="shipping-options" class="flex flex-col gap-2">
                        {% for rule in shippingRules %}
                        <label class="{{ opt_box }} flex cursor-pointer items-start gap-3" for="del_{{ rule.id }}">
                            <input class="shipping-radio mt-1" type="radio" name="delivery_method"
                                   id="del_{{ rule.id }}" value="{{ rule.carrier }}"
                                   data-price="{{ rule.priceRub }}"
                                   data-rule-id="{{ rule.id }}"
                                   data-free-from="{{ rule.freeFromRub }}"
                                   {{ loop.first ? 'checked' : '' }}>
                            <span class="flex w-full justify-between">
                                <span>
                                    <span class="block text-sm font-semibold">{{ rule.name }}</span>
                                    <span class="block text-xs text-gray-500">{{ rule.deliveryLabel }}
                                        {% if rule.freeFromRub %}
                                            · <span class="text-green-600">Бесплатно от {{ price(rule.freeFromRub) }}</span>
                                        {% endif %}
                                    </span>
                                </span>
                                <span class="shipping-price-label text-sm font-semibold">
                                    {{ rule.priceRub == '0.00' ? 'Бесплатно' : price(rule.priceRub) }}
                                </span>
                            </span>
                        </label>
                        {% else %}
                        <div class="text-sm text-gray-500">Доставка в эту страну пока недоступна</div>
                        {% endfor %}
                        </div>
                    </div>
                </div>

                {# 3. Оплата #}
                <div class="{{ card }}">
                    <div class="{{ chead }}"><span class="{{ badge }}">3</span>Способ оплаты</div>
                    <div class="p-5">
                        <div class="flex flex-col gap-2">
                            <label class="{{ opt_box }} flex cursor-pointer items-center gap-3 text-sm">
                                <input type="radio" name="payment_method" id="pay_card" value="card_online" checked>
                                💳 <span class="font-semibold">Карта онлайн</span>
                            </label>
                            <label class="{{ opt_box }} flex cursor-pointer items-center gap-3 text-sm">
                                <input type="radio" name="payment_method" id="pay_sbp" value="sbp">
                                📱 <span class="font-semibold">СБП</span>
                                <span class="text-gray-500">— Система быстрых платежей</span>
                            </label>
                            <label class="{{ opt_box }} flex cursor-pointer items-center gap-3 text-sm">
                                <input type="radio" name="payment_method" id="pay_receipt" value="upon_receipt">
                                💵 <span class="font-semibold">При получении</span>
                            </label>
                        </div>
                    </div>
                </div>

                {# Комментарий #}
                <div>
                    <label class="{{ tw_label }}">Комментарий к заказу</label>
                    <textarea name="note" class="{{ tw_input }}" rows="2" placeholder="Необязательно"></textarea>
                </div>

            </div>

            {# Итог #}
            <div class="lg:col-span-5">
                <div class="{{ card }} sticky top-4">
                    <div class="{{ chead }}">Ваш заказ</div>
                    <div class="p-5">
                        {% for group in groups %}
                            <div class="mb-1 text-[11px] font-semibold uppercase tracking-wider text-gray-500">{{ group.brand.title }}</div>
                            {% for item in group.items %}
                            <div class="mb-1 flex justify-between text-sm">
                                <span class="text-gray-500">{{ item.variant.product.title }} × {{ item.qty }}</span>
                                <span>{{ price(item.subtotal) }}</span>
                            </div>
                            {% endfor %}
                            {% if not loop.last %}<hr class="my-3 border-gray-100">{% endif %}
                        {% endfor %}

                        {% set firstRule = shippingRules|first %}
                        {% if firstRule %}
                            {% set isFree = firstRule.priceRub == '0.00' or (firstRule.freeFromRub and cart.total >= firstRule.freeFromRub) %}
                            {% set initShipCost = isFree ? 0 : (firstRule.priceRub + 0) %}
                        {% else %}
                            {% set initShipCost = 350 %}
                        {% endif %}

                        <hr class="my-4 border-gray-100">
                        <div class="mb-1 flex justify-between text-sm">
                            <span class="text-gray-500">Товары</span>
                            <span id="cart-subtotal">{{ price(cart.total) }}</span>
                        </div>
                        <div class="mb-4 flex justify-between text-sm">
                            <span class="text-gray-500">Доставка</span>
                            <span id="shipping-price">{{ initShipCost == 0 ? 'Бесплатно' : price(initShipCost) }}</span>
                        </div>
                        <div class="mb-5 flex justify-between text-base font-bold">
                            <span>Итого</span>
                            <span id="order-total">{{ price(cart.total + initShipCost) }}</span>
                        </div>

                        <button type="submit"
                                class="w-full rounded-xl bg-gray-900 py-3.5 text-sm font-semibold text-white hover:bg-black transition">
                            Подтвердить заказ
                        </button>
                        <p class="mb-0 mt-3 text-center text-xs text-gray-400">
                            Нажимая кнопку, вы соглашаетесь с условиями оферты и даёте
                            <a href="{{ path('personal_data_consent', {_locale: 'ru'}) }}" target="_blank" class="underline">согласие на обработку персональных данных</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
// ── Адрес: показать/скрыть поля нового адреса ───────────────────────────────
document.querySelectorAll('[name="address_id"]').forEach(r => {
    r.addEventListener('change', () => {
        document.getElementById('new-address-fields').classList.toggle('hidden', r.value !== '');
    });
});

// ── Конфигурация ────────────────────────────────────────────────────────────
const cartTotalRub = {{ cart.total }};
const currencyCode = '{{ app_currency.code }}';

async function formatPrice(amountRub) {
    if (currencyCode === 'RUB') {
        return new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽';
    }
    try {
        const r = await fetch(`/currency/api/convert?amount=${amountRub}&from=RUB&to=${currencyCode}`);
        const d = await r.json();
        return d.formatted ?? (new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽');
    } catch {
        return new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽';
    }
}

// ── Обновить итог при выборе доставки ────────────────────────────────────────
async function updateTotals() {
    const checked = document.querySelector('.shipping-radio:checked');
    if (!checked) return;

    const priceRub    = parseFloat(checked.dataset.price || '0');
    const ruleId      = checked.dataset.ruleId || '';
    const freeFrom    = parseFloat(checked.dataset.freeFrom || '0');
    const effectiveCost = (freeFrom > 0 && cartTotalRub >= freeFrom) ? 0 : priceRub;

    document.getElementById('shipping-rule-id').value = ruleId;

    const shipLabel   = effectiveCost === 0 ? 'Бесплатно' : await formatPrice(effectiveCost);
    const totalFormatted = await formatPrice(cartTotalRub + effectiveCost);

    document.getElementById('shipping-price').textContent = shipLabel;
    document.getElementById('order-total').textContent    = totalFormatted;
}

document.querySelectorAll('.shipping-radio').forEach(r => {
    r.addEventListener('change', updateTotals);
});

// ── Смена страны → загрузить правила доставки ────────────────────────────────
document.getElementById('shipping-country')?.addEventListener('change', async function() {
    const countryCode  = this.value;
    const container    = document.getElementById('shipping-options');
    container.innerHTML = '<div class="py-2 text-sm text-gray-500">⏳ Загрузка вариантов доставки…</div>';

    const optBox = 'rounded-xl border border-gray-200 p-4 has-[:checked]:border-gray-900 has-[:checked]:ring-1 has-[:checked]:ring-gray-900 flex cursor-pointer items-start gap-3';

    try {
        const city   = document.querySelector('[name="city"]')?.value || 'Москва';
        const weight = document.getElementById('cart-weight')?.value || '0.5';
        const r = await fetch(`/checkout/shipping-rules?country=${countryCode}&city=${encodeURIComponent(city)}&weight=${weight}`);
        const d = await r.json();
        const rules = d.rules || [];

        if (rules.length === 0) {
            container.innerHTML = '<div class="text-sm text-gray-500">Доставка в эту страну пока недоступна</div>';
            document.getElementById('shipping-price').textContent = '—';
            document.getElementById('order-total').textContent = await formatPrice(cartTotalRub);
            return;
        }

        container.innerHTML = rules.map((rule, i) => `
            <label class="${optBox}" for="del_dyn_${rule.id}">
                <input class="shipping-radio mt-1" type="radio"
                       name="delivery_method" id="del_dyn_${rule.id}"
                       value="${rule.carrier}"
                       data-price="${rule.priceRub}"
                       data-rule-id="${rule.id}"
                       data-free-from="${rule.freeFromRub ?? 0}"
                       ${i === 0 ? 'checked' : ''}>
                <span class="flex w-full justify-between">
                    <span>
                        <span class="block text-sm font-semibold">${rule.name}${rule.is_live ? ' <span class="rounded bg-sky-100 px-1 text-[10px] font-medium text-sky-800">LIVE</span>' : ''}</span>
                        <span class="block text-xs text-gray-500">${rule.label}
                            ${rule.freeFromRub ? `· <span class="text-green-600">Бесплатно от ${new Intl.NumberFormat('ru-RU').format(rule.freeFromRub)} ₽</span>` : ''}
                        </span>
                    </span>
                    <span class="text-sm font-semibold">
                        ${rule.priceRub === 0 ? 'Бесплатно' : new Intl.NumberFormat('ru-RU').format(Math.round(rule.priceRub)) + ' ₽'}
                    </span>
                </span>
            </label>
        `).join('');

        // Переподвешиваем обработчики
        document.querySelectorAll('.shipping-radio').forEach(r => {
            r.addEventListener('change', updateTotals);
        });
        await updateTotals();
    } catch (e) {
        container.innerHTML = '<div class="text-sm text-red-600">Ошибка загрузки доставки</div>';
    }
});

// Инициализация при загрузке
updateTotals();
</script>
{% endblock %}
