{% extends 'base.html.twig' %}
{% block title %}Оформление заказа — WEARBASE{% endblock %}

{% block content %}
<div class="container py-4" style="max-width:1000px">
    <h1 class="h4 fw-bold mb-4">Оформление заказа</h1>

    <form method="post" action="{{ path('checkout_confirm') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('checkout_confirm') }}">
        <div class="row g-4">
            <div class="col-lg-7">

                {# 1. Адрес доставки #}
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">
                        <span class="badge bg-dark me-2" style="font-size:.7rem;border-radius:.3rem">1</span>Адрес доставки
                    </div>
                    <div class="card-body p-4">

                        {% if addresses|length > 0 %}
                        <div class="d-flex flex-column gap-2 mb-3">
                            {% for address in addresses %}
                            <div class="form-check border p-3">
                                <input class="form-check-input" type="radio"
                                       name="address_id" id="addr_{{ address.id }}"
                                       value="{{ address.id }}"
                                       {{ (default and default.id == address.id) or (not default and loop.first) ? 'checked' : '' }}>
                                <label class="form-check-label w-100" for="addr_{{ address.id }}">
                                    <div class="fw-semibold small">{{ address.label ?: address.fullName }}</div>
                                    <div class="text-muted" style="font-size:.78rem">{{ address.fullAddress }}</div>
                                </label>
                            </div>
                            {% endfor %}
                            <div class="form-check border p-3">
                                <input class="form-check-input" type="radio" name="address_id" id="addr_new" value="">
                                <label class="form-check-label small" for="addr_new">+ Другой адрес</label>
                            </div>
                        </div>
                        {% endif %}

                        {# Поля нового адреса #}
                        <div id="new-address-fields" class="{{ addresses|length > 0 ? 'd-none' : '' }}">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="label-caps">Получатель</label>
                                    <input name="full_name" class="form-control" placeholder="Имя Фамилия"
                                           value="{{ app.user.fullName ?? app.user.email ?? '' }}" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="label-caps">Телефон</label>
                                    <input name="phone" type="tel" class="form-control" placeholder="+7 999 000 00 00" required>
                                </div>
                                <div class="col-md-8">
                                    <label class="label-caps">Город</label>
                                    <input name="city" class="form-control" placeholder="Москва" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="label-caps">Индекс</label>
                                    <input name="zip" class="form-control" placeholder="123456">
                                </div>
                                <div class="col-12">
                                    <label class="label-caps">Email</label>
                                    <input name="email" type="email" class="form-control"
                                           value="{{ app.user.email ?? '' }}" placeholder="example@mail.ru" required>
                                </div>
                                <div class="col-12">
                                    <label class="label-caps">Улица</label>
                                    <input name="street" class="form-control" placeholder="ул. Ленина" required>
                                </div>
                                <div class="col-4">
                                    <label class="label-caps">Дом</label>
                                    <input name="building" class="form-control" placeholder="42">
                                </div>
                                <div class="col-4">
                                    <label class="label-caps">Квартира</label>
                                    <input name="apartment" class="form-control" placeholder="15">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                        {# 2. Доставка #}
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                        <span>
                            <span class="badge bg-dark me-2" style="font-size:.7rem;border-radius:.3rem">2</span>Способ доставки
                        </span>
                        {# Выбор страны доставки #}
                        <select id="shipping-country" name="country" class="form-select form-select-sm w-auto"
                                style="max-width:180px;font-size:.8rem">
                            {% for country in countries %}
                                <option value="{{ country.code }}" {{ country.code == 'RU' ? 'selected' : '' }}>
                                    {{ country.flagEmoji }} {{ country.nameRu }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="card-body p-4">
                        <input type="hidden" name="shipping_rule_id" id="shipping-rule-id" value="">
                        <input type="hidden" id="cart-weight" value="{{ cartWeight is defined ? cartWeight : 0.5 }}">
                        <div id="shipping-options" class="d-flex flex-column gap-2">
                        {% for rule in shippingRules %}
                        <div class="form-check border p-3">
                            <input class="form-check-input shipping-radio" type="radio" name="delivery_method"
                                   id="del_{{ rule.id }}" value="{{ rule.carrier }}"
                                   data-price="{{ rule.priceRub }}"
                                   data-rule-id="{{ rule.id }}"
                                   data-free-from="{{ rule.freeFromRub }}"
                                   {{ loop.first ? 'checked' : '' }}>
                            <label class="form-check-label d-flex justify-content-between w-100" for="del_{{ rule.id }}">
                                <div>
                                    <div class="fw-semibold small">{{ rule.name }}</div>
                                    <div class="text-muted" style="font-size:.75rem">{{ rule.deliveryLabel }}
                                        {% if rule.freeFromRub %}
                                            · <span class="text-success">Бесплатно от {{ price(rule.freeFromRub) }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="fw-semibold small shipping-price-label">
                                    {{ rule.priceRub == '0.00' ? 'Бесплатно' : price(rule.priceRub) }}
                                </span>
                            </label>
                        </div>
                        {% else %}
                        <div class="text-muted small">Доставка в эту страну пока недоступна</div>
                        {% endfor %}
                        </div>
                    </div>
                </div>

                {# 3. Оплата #}
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">
                        <span class="badge bg-dark me-2" style="font-size:.7rem;border-radius:.3rem">3</span>Способ оплаты
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-2">
                        <div class="form-check border p-3">
                            <input class="form-check-input" type="radio" name="payment_method" id="pay_card" value="card_online" checked>
                            <label class="form-check-label small" for="pay_card">
                                <i class="fas fa-credit-card me-2 text-muted"></i><span class="fw-semibold">Карта онлайн</span>
                            </label>
                        </div>
                        <div class="form-check border p-3">
                            <input class="form-check-input" type="radio" name="payment_method" id="pay_sbp" value="sbp">
                            <label class="form-check-label small" for="pay_sbp">
                                <i class="fas fa-mobile-alt me-2 text-muted"></i><span class="fw-semibold">СБП</span>
                                <span class="text-muted ms-1">— Система быстрых платежей</span>
                            </label>
                        </div>
                        <div class="form-check border p-3">
                            <input class="form-check-input" type="radio" name="payment_method" id="pay_receipt" value="upon_receipt">
                            <label class="form-check-label small" for="pay_receipt">
                                <i class="fas fa-money-bill me-2 text-muted"></i><span class="fw-semibold">При получении</span>
                            </label>
                        </div>
                        </div>
                    </div>
                </div>

                {# Комментарий #}
                <div class="mb-3">
                    <label class="label-caps">Комментарий к заказу</label>
                    <textarea name="note" class="form-control" rows="2"
                              placeholder="Необязательно"></textarea>
                </div>

            </div>

            {# Итог #}
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm sticky-top" style="top:1rem">
                    <div class="card-header bg-white fw-semibold">Ваш заказ</div>
                    <div class="card-body p-4">
                        {% for group in groups %}
                            <span class="label-caps">{{ group.brand.title }}</span>
                            {% for item in group.items %}
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">{{ item.variant.product.title }} × {{ item.qty }}</span>
                                <span>{{ price(item.subtotal) }}</span>
                            </div>
                            {% endfor %}
                            {% if not loop.last %}<hr class="my-2">{% endif %}
                        {% endfor %}

                        {% set firstRule = shippingRules|first %}
                        {% if firstRule %}
                            {% set isFree = firstRule.priceRub == '0.00' or (firstRule.freeFromRub and cart.total >= firstRule.freeFromRub) %}
                            {% set initShipCost = isFree ? 0 : (firstRule.priceRub + 0) %}
                        {% else %}
                            {% set initShipCost = 350 %}
                        {% endif %}

                        <hr class="my-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Товары</span>
                            <span id="cart-subtotal">{{ price(cart.total) }}</span>
                        </div>
                        <div class="d-flex justify-content-between small mb-3">
                            <span class="text-muted">Доставка</span>
                            <span id="shipping-price">{{ initShipCost == 0 ? 'Бесплатно' : price(initShipCost) }}</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mb-4">
                            <span>Итого</span>
                            <span id="order-total">{{ price(cart.total + initShipCost) }}</span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 btn-lg fw-semibold">
                            Подтвердить заказ
                        </button>
                        <p class="text-center text-muted mt-2 mb-0" style="font-size:.75rem">
                            Нажимая кнопку, вы соглашаетесь с условиями оферты
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
// ── Адрес: показать/скрыть поля нового адреса ───────────────────────────────
document.querySelectorAll('[name="address_id"]').forEach(r => {
    r.addEventListener('change', () => {
        document.getElementById('new-address-fields').classList.toggle('d-none', r.value !== '');
    });
});

// ── Конфигурация ────────────────────────────────────────────────────────────
const cartTotalRub = {{ cart.total }};
const currencyCode = '{{ app_currency.code }}';

async function formatPrice(amountRub) {
    if (currencyCode === 'RUB') {
        return new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽';
    }
    try {
        const r = await fetch(`/currency/api/convert?amount=${amountRub}&from=RUB&to=${currencyCode}`);
        const d = await r.json();
        return d.formatted ?? (new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽');
    } catch {
        return new Intl.NumberFormat('ru-RU').format(Math.round(amountRub)) + ' ₽';
    }
}

// ── Обновить итог при выборе доставки ────────────────────────────────────────
async function updateTotals() {
    const checked = document.querySelector('.shipping-radio:checked');
    if (!checked) return;

    const priceRub    = parseFloat(checked.dataset.price || '0');
    const ruleId      = checked.dataset.ruleId || '';
    const freeFrom    = parseFloat(checked.dataset.freeFrom || '0');
    const effectiveCost = (freeFrom > 0 && cartTotalRub >= freeFrom) ? 0 : priceRub;

    document.getElementById('shipping-rule-id').value = ruleId;

    const shipLabel   = effectiveCost === 0 ? 'Бесплатно' : await formatPrice(effectiveCost);
    const totalFormatted = await formatPrice(cartTotalRub + effectiveCost);

    document.getElementById('shipping-price').textContent = shipLabel;
    document.getElementById('order-total').textContent    = totalFormatted;
}

document.querySelectorAll('.shipping-radio').forEach(r => {
    r.addEventListener('change', updateTotals);
});

// ── Смена страны → загрузить правила доставки ────────────────────────────────
document.getElementById('shipping-country')?.addEventListener('change', async function() {
    const countryCode  = this.value;
    const container    = document.getElementById('shipping-options');
    container.innerHTML = '<div class="text-muted small py-2"><i class="fas fa-spinner fa-spin me-2"></i>Загрузка вариантов доставки…</div>';

    try {
        const city   = document.querySelector('[name="city"]')?.value || 'Москва';
        const weight = document.getElementById('cart-weight')?.value || '0.5';
        const r = await fetch(`/checkout/shipping-rules?country=${countryCode}&city=${encodeURIComponent(city)}&weight=${weight}`);
        const d = await r.json();
        const rules = d.rules || [];

        if (rules.length === 0) {
            container.innerHTML = '<div class="text-muted small">Доставка в эту страну пока недоступна</div>';
            document.getElementById('shipping-price').textContent = '—';
            document.getElementById('order-total').textContent = await formatPrice(cartTotalRub);
            return;
        }

        container.innerHTML = rules.map((rule, i) => `
            <div class="form-check border p-3">
                <input class="form-check-input shipping-radio" type="radio"
                       name="delivery_method" id="del_dyn_${rule.id}"
                       value="${rule.carrier}"
                       data-price="${rule.priceRub}"
                       data-rule-id="${rule.id}"
                       data-free-from="${rule.freeFromRub ?? 0}"
                       ${i === 0 ? 'checked' : ''}>
                <label class="form-check-label d-flex justify-content-between w-100" for="del_dyn_${rule.id}">
                    <div>
                        <div class="fw-semibold small">${rule.name}${rule.is_live ? ' <span class="badge bg-info text-dark" style="font-size:.6rem">LIVE</span>' : ''}</div>
                        <div class="text-muted" style="font-size:.75rem">${rule.label}
                            ${rule.freeFromRub ? `· <span class="text-success">Бесплатно от ${new Intl.NumberFormat('ru-RU').format(rule.freeFromRub)} ₽</span>` : ''}
                        </div>
                    </div>
                    <span class="fw-semibold small">
                        ${rule.priceRub === 0 ? 'Бесплатно' : new Intl.NumberFormat('ru-RU').format(Math.round(rule.priceRub)) + ' ₽'}
                    </span>
                </label>
            </div>
        `).join('');

        // Переподвешиваем обработчики
        document.querySelectorAll('.shipping-radio').forEach(r => {
            r.addEventListener('change', updateTotals);
        });
        await updateTotals();
    } catch (e) {
        container.innerHTML = '<div class="text-danger small">Ошибка загрузки доставки</div>';
    }
});

// Инициализация при загрузке
updateTotals();
</script>
{% endblock %}
