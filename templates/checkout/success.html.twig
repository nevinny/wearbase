{% extends 'tailwind/app.html.twig' %}
{% block title %}Заказ оформлен — WEARBASE{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-16">
    <div class="mx-auto max-w-md text-center">

        <div class="mb-6">
            <div class="inline-flex h-[72px] w-[72px] items-center justify-center rounded-full bg-gray-900 text-2xl text-white">✓</div>
        </div>

        <h1 class="mb-2 text-2xl font-bold">Заказ оформлен!</h1>
        {% if order_number %}
            <p class="mb-1 text-gray-500">Номер заказа: <strong class="text-gray-900">#{{ order_number }}</strong></p>
        {% endif %}
        <p class="mb-6 text-sm text-gray-500">
            Мы отправили подтверждение на вашу почту.<br>
            Бренд получил уведомление и скоро свяжется с вами.
        </p>

        <div class="flex flex-wrap justify-center gap-2">
            {% if order_number %}
            <a href="{{ path('account_order_show', {number: order_number}) }}"
               class="rounded-xl bg-gray-900 px-6 py-3 text-sm font-semibold text-white hover:bg-black transition">Следить за заказом</a>
            {% endif %}
            <a href="{{ path('account_orders') }}"
               class="rounded-xl border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">Мои заказы</a>
            <a href="{{ path('catalog_index') }}"
               class="rounded-xl border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">Продолжить покупки</a>
        </div>

    </div>
</div>
{% endblock %}
