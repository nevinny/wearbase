<div class="card brand-list-item border-0 mb-4">
    <div class="row g-0">
        <!-- Логотип -->
        <div class="col-md-3">
            <div class="position-relative h-100 bg-light rounded-start">
                <img src="{{ brand.logo }}" class="img-fluid p-4 w-100" alt="{{ brand.title }}" style="object-fit: contain; height: 200px;">

                <!-- Бейджи -->
                <div class="position-absolute top-0 start-0 m-2">
                    <span class="badge bg-danger">
                        <i class="fas fa-map-marker-alt me-1"></i>Локальный
                    </span>
                </div>

{#                {% if brand.isSustainable %}#}
{#                    <div class="position-absolute top-0 end-0 m-2">#}
{#                    <span class="badge bg-success">#}
{#                        <i class="fas fa-leaf me-1"></i>Эко#}
{#                    </span>#}
{#                    </div>#}
{#                {% endif %}#}
            </div>
        </div>

        <!-- Информация -->
        <div class="col-md-6">
            <div class="card-body h-100 d-flex flex-column">
                <h5 class="card-title">{{ brand.title }}</h5>

                <p class="card-text text-muted flex-grow-1">
                    {{ brand.description }}
                </p>

                <!-- Категории -->
                <div class="mb-3">
{#                    {% for category in brand.categories %}#}
{#                        <span class="badge bg-light text-dark border me-1">{{ category }}</span>#}
{#                    {% endfor %}#}
                </div>

                <!-- Особенности -->
                <div class="small text-muted">
{#                    {% if brand.freeShipping %}#}
{#                        <span class="me-3"><i class="fas fa-shipping-fast me-1"></i>Бесплатная доставка</span>#}
{#                    {% endif %}#}
{#                    {% if brand.fastDelivery %}#}
{#                        <span><i class="fas fa-bolt me-1"></i>Быстрая доставка</span>#}
{#                    {% endif %}#}
                </div>
            </div>
        </div>

        <!-- Действия -->
        <div class="col-md-3">
            <div class="card-body h-100 d-flex flex-column justify-content-between">
                <!-- Рейтинг -->
                <div class="text-center mb-3">
                    <div class="text-warning mb-1">
{#                        {% for i in 1..5 %}#}
{#                            {% if i <= brand.rating %}#}
{#                                <i class="fas fa-star"></i>#}
{#                            {% else %}#}
{#                                <i class="far fa-star"></i>#}
{#                            {% endif %}#}
{#                        {% endfor %}#}
                    </div>
{#                    <small class="text-muted">({{ brand.reviewCount }} отзывов)</small>#}
                </div>

                <!-- Кнопки действий -->
                <div class="d-grid gap-2">
                    <a href="{{ brand.websiteUrl }}" class="btn btn-dark">Смотреть коллекцию</a>
                    <button class="btn btn-outline-dark">
                        <i class="far fa-heart me-1"></i>В избранное
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
