<div class="card mb-4">
    <div class="card-header bg-light">
        <h6 class="mb-0">Фильтры</h6>
    </div>
    <div class="card-body">
        <!-- Категории -->
        <div class="mb-4">
            <h6 class="fw-bold mb-3">Категории</h6>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-clothing">
                <label class="form-check-label small" for="filter-clothing">
                    Одежда
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-shoes">
                <label class="form-check-label small" for="filter-shoes">
                    Обувь
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-accessories">
                <label class="form-check-label small" for="filter-accessories">
                    Аксессуары
                </label>
            </div>
        </div>

        <!-- Устойчивость -->
        <div class="mb-4">
            <h6 class="fw-bold mb-3">Устойчивость</h6>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-sustainable">
                <label class="form-check-label small" for="filter-sustainable">
                    <i class="fas fa-leaf text-success me-1"></i>Эко-бренды
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-vegan">
                <label class="form-check-label small" for="filter-vegan">
                    Веганские бренды
                </label>
            </div>
        </div>

        <!-- Ценовой диапазон -->
        <div class="mb-4">
            <h6 class="fw-bold mb-3">Ценовой диапазон</h6>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="priceRange" id="price-all" checked>
                <label class="form-check-label small" for="price-all">
                    Любой
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="priceRange" id="price-budget">
                <label class="form-check-label small" for="price-budget">
                    Бюджетный (₽ - ₽₽)
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="priceRange" id="price-premium">
                <label class="form-check-label small" for="price-premium">
                    Премиум (₽₽₽)
                </label>
            </div>
        </div>

        <!-- Рейтинг -->
        <div class="mb-4">
            <h6 class="fw-bold mb-3">Рейтинг</h6>
            {% for i in 4..5 %}
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="rating-{{ i }}">
                    <label class="form-check-label small" for="rating-{{ i }}">
                        <div class="text-warning">
                            {% for star in 1..i %}
                                <i class="fas fa-star"></i>
                            {% endfor %}
                            {% for star in (i+1)..5 %}
                                <i class="far fa-star"></i>
                            {% endfor %}
                            и выше
                        </div>
                    </label>
                </div>
            {% endfor %}
        </div>

        <!-- Кнопки -->
        <button class="btn btn-dark w-100 mb-2">Применить фильтры</button>
        <button class="btn btn-outline-secondary w-100">Сбросить</button>
    </div>
</div>
