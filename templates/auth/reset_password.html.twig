{% extends 'tailwind/app.html.twig' %}
{% block title %}Новый пароль — WEARBASE{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
{% embed 'tailwind/auth/_shell.html.twig' %}
    {% block eyebrow %}Новый пароль{% endblock %}
    {% block heading %}Установите<br>новый пароль{% endblock %}

    {% block form %}
        <h1 class="text-xl font-bold mb-1">Новый пароль</h1>
        <p class="text-sm text-gray-500 mb-6">Придумайте новый пароль для входа.</p>

        {# Флеши уже показываются глобально в tailwind/app.html.twig #}

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
            <div class="mb-5">
                <label for="password" class="block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Новый пароль</label>
                <input type="password" id="password" name="password"
                       class="w-full rounded-xl bg-gray-100 px-4 py-3.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900"
                       placeholder="••••••••" minlength="8" required autofocus>
            </div>

            <button type="submit" class="w-full rounded-xl bg-gray-900 py-3.5 text-sm font-semibold text-white hover:bg-black transition">
                Сохранить пароль
            </button>
        </form>
    {% endblock %}
{% endembed %}
{% endblock %}
