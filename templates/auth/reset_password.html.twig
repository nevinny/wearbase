{% extends 'base.html.twig' %}
{% block title %}Новый пароль — WEARBASE{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex">
    <div class="d-none d-lg-flex flex-column justify-content-between text-white p-5"
         style="width:420px;min-width:420px;background:linear-gradient(160deg,#111 60%,#1c1c2e)">
        <a href="/" class="text-white text-decoration-none fw-bold fs-4">WEARBASE</a>
        <div>
            <p class="text-white-50 mb-1 small text-uppercase" style="letter-spacing:.1em">Новый пароль</p>
            <h2 class="fw-bold lh-sm mb-3" style="font-size:2rem">Установите<br>новый пароль</h2>
        </div>
        <p class="text-white-50 small mb-0">© {{ "now"|date("Y") }} WEARBASE</p>
    </div>

    <div class="flex-grow-1 d-flex align-items-center justify-content-center bg-white p-4">
        <div style="width:100%;max-width:400px">
            <div class="d-lg-none text-center mb-4">
                <a href="/" class="fw-bold fs-3 text-dark text-decoration-none">WEARBASE</a>
            </div>

            <h1 class="h4 fw-bold mb-1">Новый пароль</h1>
            <p class="text-muted mb-4 small">Придумайте новый пароль для входа.</p>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} py-2 small">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
                <div class="mb-4">
                    <label for="password" class="form-label small fw-semibold text-muted text-uppercase"
                           style="letter-spacing:.05em;font-size:.75rem">Новый пароль</label>
                    <input type="password" id="password" name="password"
                           class="form-control form-control-lg border-0 rounded-3"
                           placeholder="••••••••" minlength="8" required autofocus>
                </div>

                <button type="submit" class="btn btn-dark btn-lg w-100 fw-semibold rounded-3">
                    Сохранить пароль
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
