{% extends 'base.html.twig' %}
{% block title %}Восстановление пароля — WEARBASE{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex">

    {# ── Левая панель ── #}
    <div class="d-none d-lg-flex flex-column justify-content-between text-white p-5"
         style="width:420px;min-width:420px;background:linear-gradient(160deg,#111 60%,#1c1c2e)">

        <a href="/" class="text-white text-decoration-none fw-bold fs-4">WEARBASE</a>

        <div>
            <p class="text-white-50 mb-1 small text-uppercase" style="letter-spacing:.1em">Восстановление</p>
            <h2 class="fw-bold lh-sm mb-3" style="font-size:2rem">Забыли<br>пароль?</h2>
            <p class="text-white-50" style="font-size:.9rem;line-height:1.6">
                Введите email — мы пришлём<br>ссылку для входа.
            </p>
        </div>

        <p class="text-white-50 small mb-0">© {{ "now"|date("Y") }} WEARBASE</p>
    </div>

    {# ── Правая панель ── #}
    <div class="flex-grow-1 d-flex align-items-center justify-content-center bg-white p-4">
        <div style="width:100%;max-width:400px">

            <div class="d-lg-none text-center mb-4">
                <a href="/" class="fw-bold fs-3 text-dark text-decoration-none">WEARBASE</a>
            </div>

            {% if sent %}

                <div class="text-center py-4">
                    <div class="mb-4" style="font-size:3rem">✉️</div>
                    <h1 class="h4 fw-bold mb-2">Письмо отправлено</h1>
                    <p class="text-muted small mb-4">
                        Если аккаунт с таким email существует,<br>мы отправили инструкции по восстановлению.
                    </p>
                    <a href="{{ path('app_login') }}" class="btn btn-dark rounded-3 px-4">
                        ← Вернуться к входу
                    </a>
                </div>

            {% else %}

                <h1 class="h4 fw-bold mb-1">Восстановление пароля</h1>
                <p class="text-muted mb-4 small">
                    Вспомнили пароль?
                    <a href="{{ path('app_login') }}" class="text-dark fw-semibold">Войти</a>
                </p>

                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
                    <div class="mb-4">
                        <label for="email" class="form-label small fw-semibold text-muted text-uppercase"
                               style="letter-spacing:.05em;font-size:.75rem">Email</label>
                        <input type="email" id="email" name="email"
                               class="form-control form-control-lg border-0 rounded-3"
                               placeholder="you@example.com"
                               required autofocus>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 fw-semibold rounded-3">
                        Отправить ссылку
                    </button>
                </form>

            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
