{% extends 'tailwind/app.html.twig' %}
{% block title %}Восстановление пароля — WEARBASE{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
{% embed 'tailwind/auth/_shell.html.twig' %}
    {% block eyebrow %}Восстановление{% endblock %}
    {% block heading %}Забыли<br>пароль?{% endblock %}
    {% block panel_extra %}Введите email — мы пришлём<br>ссылку для входа.{% endblock %}

    {% block form %}
        {% if sent %}

            <div class="py-6 text-center">
                <div class="mb-4 text-5xl">✉️</div>
                <h1 class="text-xl font-bold mb-2">Письмо отправлено</h1>
                <p class="text-sm text-gray-500 mb-6">
                    Если аккаунт с таким email существует,<br>мы отправили инструкции по восстановлению.
                </p>
                <a href="{{ path('app_login') }}"
                   class="inline-block rounded-xl bg-gray-900 px-6 py-3 text-sm font-semibold text-white hover:bg-black transition">
                    ← Вернуться к входу
                </a>
            </div>

        {% else %}

            <h1 class="text-xl font-bold mb-1">Восстановление пароля</h1>
            <p class="text-sm text-gray-500 mb-6">
                Вспомнили пароль?
                <a href="{{ path('app_login') }}" class="font-semibold text-gray-900 hover:underline">Войти</a>
            </p>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
                <div class="mb-5">
                    <label for="email" class="block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Email</label>
                    <input type="email" id="email" name="email"
                           class="w-full rounded-xl bg-gray-100 px-4 py-3.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900"
                           placeholder="you@example.com"
                           required autofocus>
                </div>

                <button type="submit" class="w-full rounded-xl bg-gray-900 py-3.5 text-sm font-semibold text-white hover:bg-black transition">
                    Отправить ссылку
                </button>
            </form>

        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
