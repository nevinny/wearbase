{% extends 'tailwind/app.html.twig' %}
{% block title %}Регистрация — WEARBASE{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-xl bg-gray-100 px-4 py-3.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% embed 'tailwind/auth/_shell.html.twig' with {tw_label: tw_label, tw_input: tw_input} %}
    {% block eyebrow %}Присоединяйтесь{% endblock %}
    {% block heading %}Российские<br>бренды<br>в одном месте{% endblock %}
    {% block panel_extra %}Находите локальную одежду,<br>следите за любимыми брендами,<br>делайте заказы напрямую.{% endblock %}

    {% block form %}
        <h1 class="text-xl font-bold mb-1">Создать аккаунт</h1>
        <p class="text-sm text-gray-500 mb-6">
            Уже есть аккаунт?
            <a href="{{ path('app_login') }}" class="font-semibold text-gray-900 hover:underline">Войти</a>
        </p>

        {% for message in app.flashes('error') %}
            <div class="form-error mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {% if look_share_ref is defined and look_share_ref %}
                <input type="hidden" name="ref" value="{{ look_share_ref }}">
            {% endif %}
            {% if look_share_target is defined and look_share_target %}
                <input type="hidden" name="target" value="{{ look_share_target }}">
            {% endif %}

            <div class="mb-4">
                {{ form_label(form.firstName, null, {'label_attr': {'class': tw_label}}) }}
                {{ form_widget(form.firstName, {'attr': {'class': tw_input, 'placeholder': 'Ваше имя'}}) }}
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.firstName) }}</div>
            </div>

            <div class="mb-4">
                {{ form_label(form.email, null, {'label_attr': {'class': tw_label}}) }}
                {{ form_widget(form.email, {'attr': {'class': tw_input, 'placeholder': 'you@example.com'}}) }}
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.email) }}</div>
            </div>

            <div class="mb-4">
                {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': tw_label}}) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': tw_input, 'placeholder': '••••••••'}}) }}
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.plainPassword.first) }}</div>
            </div>

            <div class="mb-5">
                {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': tw_label}}) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': tw_input, 'placeholder': '••••••••'}}) }}
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.plainPassword.second) }}</div>
            </div>

            <div class="mb-4">
                <label class="flex items-start gap-2 text-sm text-gray-500" for="{{ form.agreeTerms.vars.id }}">
                    {{ form_widget(form.agreeTerms, {'attr': {'class': 'mt-0.5 h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900'}}) }}
                    <span>
                        Я принимаю <a href="{{ path('terms_of_use', {_locale: 'ru'}) }}" target="_blank" class="text-gray-900 underline">Пользовательское соглашение</a>
                        и даю <a href="{{ path('personal_data_consent', {_locale: 'ru'}) }}" target="_blank" class="text-gray-900 underline">согласие на обработку персональных данных</a>
                    </span>
                </label>
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.agreeTerms) }}</div>
            </div>

            <div class="mb-5">
                {{ form_widget(form.turnstile) }}
                <div class="mt-1 text-sm text-red-600">{{ form_errors(form.turnstile) }}</div>
            </div>

            <button type="submit" class="w-full rounded-xl bg-gray-900 py-3.5 text-sm font-semibold text-white hover:bg-black transition">
                Зарегистрироваться
            </button>

        {{ form_end(form) }}

        <p class="mt-6 text-center text-sm text-gray-500">
            Регистрируете бренд?
            <a href="{{ path('app_register', {brand: 1}) }}" class="font-semibold text-gray-900 hover:underline">Зарегистрировать бренд →</a>
        </p>
    {% endblock %}
{% endembed %}
{% endblock %}
