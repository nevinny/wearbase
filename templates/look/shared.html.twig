<!DOCTYPE html>
{# Гостевой лендинг лука «Поделиться луком» (спец §2). Стоячий шаблон, НЕ наследует layout ЛК.
   Приватность: noindex,follow (§5) + self-canonical без query + no-referrer (§4.3);
   Cache-Control: no-store / X-Robots-Tag ставит контроллер. Видно только разрешённый
   набор §4.4: title, explanation, фото обложки, категория/цвет. Бренды скрыты (PO №4),
   имён владельца/ребёнка, цен, размеров и прочего здесь нет по построению. #}
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ outfitTitle }} | WEARBASE</title>
    <meta name="robots" content="noindex, follow">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <meta name="referrer" content="no-referrer">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #fafaf9; color: #111827; min-height: 100vh; display: flex; flex-direction: column; }
        header { padding: 20px 24px; border-bottom: 1px solid #e5e7eb; font-weight: 800; letter-spacing: .08em; }
        main { flex: 1; width: 100%; max-width: 720px; margin: 0 auto; padding: 32px 24px 48px; }
        h1 { font-size: 22px; line-height: 1.3; }
        .explanation { margin-top: 10px; font-size: 15px; color: #4b5563; line-height: 1.6; white-space: pre-line; }
        .grid { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
        .card { background: #fff; border: 1px solid #f0f0ef; border-radius: 14px; overflow: hidden; }
        .photo { aspect-ratio: 1/1; background: #f3f4f6; display: flex; align-items: center; justify-content: center; font-size: 34px; opacity: .25; }
        .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .meta { padding: 10px 12px; font-size: 12.5px; color: #6b7280; }
        .meta b { display: block; color: #111827; font-weight: 600; text-transform: capitalize; }
        .cta { margin-top: 36px; background: #fff; border: 1px solid #f0f0ef; border-radius: 16px; padding: 22px; text-align: center; }
        .cta p { font-size: 14px; color: #4b5563; margin-bottom: 14px; }
        .btn { display: inline-block; background: #111827; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 26px; border-radius: 999px; }
        footer { padding: 18px 24px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af; text-align: center; }
    </style>
</head>
<body>
<header>WEARBASE</header>
<main>
    <h1>{{ outfitTitle }}</h1>
    {% if explanation %}<p class="explanation">{{ explanation }}</p>{% endif %}

    <div class="grid">
        {% for item in items %}
            <div class="card">
                <div class="photo">
                    {% if item.coverPhotoId %}
                        <img src="{{ path('look_shared_media', {token: token, photoId: item.coverPhotoId}) }}" alt="" loading="lazy">
                    {% else %}
                        👕
                    {% endif %}
                </div>
                <div class="meta">
                    <b>{{ item.category ?: 'Без категории' }}</b>
                    {{ item.color ?: '' }}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="cta">
        {% if isGuestLoggedIn %}
            <p>Это лук из WEARBASE — соберите свой гардероб из локальных брендов.</p>
            <a class="btn" href="{{ path('account_wardrobe_outfits') }}">Открыть свой гардероб</a>
        {% else %}
            <p>Это лук из WEARBASE — соберите свой из вещей локальных брендов.</p>
            <a class="btn" href="{{ path('app_register', {ref: token, target: sharePath}) }}">Собери свой</a>
        {% endif %}
    </div>
</main>
</body>
</html>
