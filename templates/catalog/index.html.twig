{% extends 'tailwind/base.html.twig' %}

{% block title %}
    {% if filters.gender %}{{ genderLabels[filters.gender] }} — каталог | WEARBASE
    {% elseif filters.sale %}Скидки — каталог | WEARBASE
    {% elseif filters.search %}Поиск: «{{ filters.search }}» | WEARBASE
    {% else %}Каталог товаров | WEARBASE{% endif %}
{% endblock %}

{% block meta_description %}
    {% if filters.gender %}Товары для {{ genderLabels[filters.gender]|lower }} от российских брендов. {{ total }} позиций.
    {% else %}Каталог товаров российских брендов одежды. {{ total }} позиций.{% endif %}
{% endblock %}

{% block meta_robots %}
{% if filters.search or filters.brand or filters.category or filters.style or filters.size or filters.min_price or filters.max_price or page > 1 %}
<meta name="robots" content="noindex, follow">
{% endif %}
{% endblock %}

{% block body %}
{% set page_locale = app.request.locale|default('ru') %}
<div class="container mx-auto px-4 py-8">

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebPage",
                "@id": "{{ url('catalog_index') }}#webpage",
                "url": "{{ url('catalog_index') }}",
                "name": "Каталог товаров | WEARBASE",
                "description": "Каталог товаров российских брендов одежды. {{ total }} позиций.",
                "isPartOf": {"@id": "#website"},
                "breadcrumb": {"@id": "{{ url('catalog_index') }}#breadcrumb"}
            },
            {% if page == 1 %}
            {
                "@type": "ItemList",
                "@id": "{{ url('catalog_index') }}#itemlist",
                "name": "Каталог товаров",
                "itemListOrder": "https://schema.org/ItemListUnordered",
                "numberOfItems": {{ total }},
                "itemListElement": [
                    {% for product in products %}
                    {
                        "@type": "ListItem",
                        "position": {{ loop.index }},
                        "url": "{{ url('product_show', {uuid: product.uuid}) }}",
                        "name": "{{ product.title }}"
                    }{{ loop.last ? '' : ',' }}
                    {% endfor %}
                ]
            },
            {% endif %}
            {
                "@type": "BreadcrumbList",
                "@id": "{{ url('catalog_index') }}#breadcrumb",
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: page_locale}) }}"},
                    {"@type": "ListItem", "position": 2, "name": "Каталог", "item": "{{ url('catalog_index') }}"}
                    {% if filters.gender %}
                    ,{"@type": "ListItem", "position": 3, "name": "{{ genderLabels[filters.gender] }}"}
                    {% endif %}
                ]
            }
        ]
    }
    </script>

    {# ── Хлебные крошки ─────────────────────────────────────────── #}
    <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
        <a href="{{ path('home_hub', {_locale: page_locale}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
        <span class="mx-2 text-gray-400">/</span>
        {% if filters.gender %}
            <a href="{{ path('catalog_index') }}" class="text-gray-500 hover:text-gray-900">Каталог</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">{{ genderLabels[filters.gender] }}</span>
        {% elseif filters.sale %}
            <a href="{{ path('catalog_index') }}" class="text-gray-500 hover:text-gray-900">Каталог</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-medium">Скидки</span>
        {% else %}
            <span class="text-gray-900 font-medium">Каталог</span>
        {% endif %}
    </nav>

    <div class="flex gap-8">

        {# ── Боковой фильтр ─────────────────────────────────────── #}
        <aside class="hidden lg:block w-52 flex-shrink-0">

            {# Пол #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Пол</div>
                <div class="space-y-1">
                    <a href="{{ path('catalog_index') }}"
                       class="flex justify-between items-center px-3 py-1.5 rounded-lg text-sm transition
                              {{ not filters.gender and not filters.sale ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                        Все товары
                    </a>
                    {% for code, label in genderLabels %}
                        <a href="{{ path('catalog_index', {gender: code}) }}"
                           class="flex justify-between items-center px-3 py-1.5 rounded-lg text-sm transition
                                  {{ filters.gender == code ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Категория #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Категория</div>
                <div class="space-y-1">
                    <a href="{{ path('catalog_index', filters|merge({category: null, page: null})) }}"
                       class="block px-3 py-1.5 rounded-lg text-sm transition
                              {{ not filters.category ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                        Все категории
                    </a>
                    {% for category in categories %}
                        <a href="{{ path('catalog_index', filters|merge({category: category.id, page: null})) }}"
                           class="block px-3 py-1.5 rounded-lg text-sm transition
                                  {{ filters.category == category.id ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                            {{ category.title }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Стиль #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Стиль</div>
                <div class="space-y-1">
                    <a href="{{ path('catalog_index', filters|merge({style: null, page: null})) }}"
                       class="block px-3 py-1.5 rounded-lg text-sm transition
                              {{ not filters.style ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                        Все стили
                    </a>
                    {% for style in styles %}
                        <a href="{{ path('catalog_index', filters|merge({style: style.id, page: null})) }}"
                           class="block px-3 py-1.5 rounded-lg text-sm transition
                                  {{ filters.style == style.id ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100' }}">
                            {{ style.title }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Скидки #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Акции</div>
                <a href="{{ path('catalog_index', filters.gender ? {gender: filters.gender, sale: filters.sale ? null : 1} : {sale: filters.sale ? null : 1}) }}"
                   class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition
                          {{ filters.sale ? 'bg-red-600 text-white' : 'text-gray-700 border border-red-200 hover:bg-red-50 hover:text-red-600' }}">
                    <span>🔥</span> Скидки
                </a>
            </div>

            {# Размер #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Размер</div>
                <div class="flex flex-wrap gap-1">
                    <a href="{{ path('catalog_index', filters|merge({size: null, page: null})) }}"
                       class="px-2 py-1 text-xs border rounded transition
                              {{ not filters.size ? 'bg-gray-900 text-white border-gray-900' : 'text-gray-600 border-gray-200 hover:border-gray-900' }}">
                        Все
                    </a>
                    {% for size in sizes %}
                        <a href="{{ path('catalog_index', filters|merge({size: size, page: null})) }}"
                           class="px-2 py-1 text-xs border rounded transition
                                  {{ filters.size == size ? 'bg-gray-900 text-white border-gray-900' : 'text-gray-600 border-gray-200 hover:border-gray-900' }}">
                            {{ size }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Цена #}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Цена</div>
                <form method="get" action="{{ path('catalog_index') }}">
                    {% for key, val in filters %}
                        {% if val is not null and val is not empty and key not in ['min_price', 'max_price', 'page'] %}
                            <input type="hidden" name="{{ key }}" value="{{ val }}">
                        {% endif %}
                    {% endfor %}
                    <div class="flex gap-2 items-center mb-2">
                        <input type="number" name="min_price" value="{{ filters.min_price }}"
                               placeholder="от" min="0" step="0.01"
                               class="w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-300">
                        <span class="text-gray-400 text-xs">—</span>
                        <input type="number" name="max_price" value="{{ filters.max_price }}"
                               placeholder="до" min="0" step="0.01"
                               class="w-full text-xs border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-300">
                    </div>
                    <button type="submit"
                            class="w-full text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 py-1.5 rounded-lg transition">
                        Применить
                    </button>
                </form>
            </div>

            {# Бренды #}
            {% if brands|length > 0 %}
            <div class="mb-6">
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Бренд</div>
                <form method="get" action="{{ path('catalog_index') }}" id="brand-filter-form">
                    {% if filters.gender %}<input type="hidden" name="gender" value="{{ filters.gender }}">{% endif %}
                    {% if filters.sale %}<input type="hidden" name="sale" value="1">{% endif %}
                    {% if filters.search %}<input type="hidden" name="q" value="{{ filters.search }}">{% endif %}
                    <select name="brand"
                            onchange="document.getElementById('brand-filter-form').submit()"
                            class="w-full text-sm border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-300">
                        <option value="">Все бренды</option>
                        {% for brand in brands %}
                            <option value="{{ brand.id }}" {{ filters.brand == brand.id ? 'selected' : '' }}>
                                {{ brand.title }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            </div>
            {% endif %}

            {# Сброс #}
            {% if filters.gender or filters.sale or filters.search or filters.brand or filters.category or filters.style or filters.size or filters.min_price or filters.max_price %}
            <a href="{{ path('catalog_index') }}"
               class="block text-center text-xs text-gray-500 hover:text-gray-900 underline underline-offset-2 mt-2">
                Сбросить фильтры
            </a>
            {% endif %}
        </aside>

        {# ── Основная область ───────────────────────────────────── #}
        <div class="flex-1 min-w-0">

            {# Шапка с заголовком, поиском, сортировкой #}
            <div class="flex flex-wrap items-center gap-3 mb-6">
                <h1 class="text-2xl font-bold mr-auto">
                    {% if filters.gender %}{{ genderLabels[filters.gender] }}
                    {% elseif filters.sale %}Скидки
                    {% elseif filters.search %}«{{ filters.search }}»
                    {% else %}Каталог{% endif %}
                    <span class="text-gray-400 font-normal text-lg ml-1">{{ total }}</span>
                </h1>

                {# Поиск #}
                <form method="get" action="{{ path('catalog_index') }}" class="flex">
                    {% if filters.gender %}<input type="hidden" name="gender" value="{{ filters.gender }}">{% endif %}
                    {% if filters.sale %}<input type="hidden" name="sale" value="1">{% endif %}
                    {% if filters.brand %}<input type="hidden" name="brand" value="{{ filters.brand }}">{% endif %}
                    <div class="flex rounded-lg border border-gray-200 overflow-hidden">
                        <input type="text" name="q" value="{{ filters.search }}"
                               placeholder="Поиск…"
                               class="text-sm px-3 py-1.5 outline-none bg-white w-40 focus:w-56 transition-all">
                        <button class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 transition text-gray-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </button>
                    </div>
                </form>

                {# Сортировка #}
                <div class="relative" id="sort-dropdown">
                    <button onclick="document.getElementById('sort-menu').classList.toggle('hidden')"
                            class="flex items-center gap-1 text-sm border border-gray-200 rounded-lg px-3 py-1.5 hover:border-gray-300 transition bg-white">
                        {{ sortLabels[currentSort] }}
                        <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div id="sort-menu" class="hidden absolute right-0 mt-1 w-40 bg-white border border-gray-100 rounded-lg shadow-lg z-10 py-1">
                        {% for code, label in sortLabels %}
                            <a href="{{ path('catalog_index', filters|merge({sort: code, page: null})) }}"
                               class="block px-3 py-2 text-sm hover:bg-gray-50 transition
                                      {{ currentSort == code ? 'font-semibold text-indigo-600' : 'text-gray-700' }}">
                                {{ label }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Сетка товаров #}
            {% if products|length == 0 %}
                <div class="text-center py-20">
                    <div class="text-6xl mb-4">🔍</div>
                    <p class="text-gray-500 text-lg">Товары не найдены</p>
                    {% if filters.gender or filters.sale or filters.search or filters.brand or filters.category or filters.style or filters.size or filters.min_price or filters.max_price %}
                        <a href="{{ path('catalog_index') }}"
                           class="inline-block mt-4 text-sm text-indigo-600 hover:text-indigo-800 underline">
                            Сбросить фильтры
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-4">
                    {% for product in products %}
                        {% set mainImage = product.mainImage %}
                        {% set minPrice = product.minPrice %}
                        {% set hasDiscount = false %}
                        {% set discCompare = null %}
                        {% set discPct = 0 %}
                        {% for variant in product.variants %}
                            {% if variant.comparePrice is not null and variant.comparePrice > variant.price %}
                                {% set hasDiscount = true %}
                                {% if variant.price == minPrice %}
                                    {% set discCompare = variant.comparePrice %}
                                    {% set discPct = variant.discountPercent %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}

                        <a href="{{ path('product_show', {uuid: product.uuid}) }}"
                           class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">

                            {# Изображение #}
                            <div class="relative overflow-hidden bg-gray-100" style="padding-top:125%">
                                {% if mainImage and (mainImage.preview or mainImage.image) %}
                                    <img src="{{ asset('images/products/' ~ (mainImage.preview ?? mainImage.image)) }}"
                                         alt="{{ product.title }}"
                                         class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                         loading="lazy">
                                {% else %}
                                    <div class="absolute inset-0 flex items-center justify-center text-4xl text-gray-300">👗</div>
                                {% endif %}

                                {% if hasDiscount %}
                                    <span class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded">СКИДКА</span>
                                {% endif %}
                                {% if product.gender %}
                                    <span class="absolute top-2 right-2 bg-black bg-opacity-40 text-white text-xs px-1.5 py-0.5 rounded">
                                        {{ product.gender == 'women' ? 'Ж' : (product.gender == 'men' ? 'М' : (product.gender == 'kids' ? 'Д' : 'U')) }}
                                    </span>
                                {% endif %}
                            </div>

                            {# Информация #}
                            <div class="p-3">
                                <div class="text-xs text-gray-500 mb-0.5 truncate">{{ product.brand.title }}</div>
                                <div class="text-sm font-medium leading-tight line-clamp-2">{{ product.title }}</div>
                                {% if minPrice %}
                                    <div class="mt-1.5 flex items-baseline gap-1.5 flex-wrap">
                                        <span class="text-sm font-semibold text-gray-900">{{ minPrice|price }}</span>
                                        {% if discCompare %}
                                            <span class="text-xs text-gray-400 line-through">{{ discCompare|price }}</span>
                                            <span class="text-xs font-bold text-red-500">−{{ discPct }}%</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>

                {# Пагинация #}
                {% if pages > 1 %}
                    <div class="flex justify-center gap-1 mt-10">
                        {% if page > 1 %}
                            <a href="{{ path('catalog_index', filters|merge({page: page - 1})) }}"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm hover:bg-gray-50 transition">‹</a>
                        {% endif %}

                        {% for p in 1..pages %}
                            {% if p == page %}
                                <span class="px-3 py-1.5 rounded-lg bg-gray-900 text-white text-sm font-medium">{{ p }}</span>
                            {% elseif p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
                                <a href="{{ path('catalog_index', filters|merge({page: p})) }}"
                                   class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm hover:bg-gray-50 transition">{{ p }}</a>
                            {% elseif p == page - 3 or p == page + 3 %}
                                <span class="px-3 py-1.5 text-gray-400 text-sm">…</span>
                            {% endif %}
                        {% endfor %}

                        {% if page < pages %}
                            <a href="{{ path('catalog_index', filters|merge({page: page + 1})) }}"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm hover:bg-gray-50 transition">›</a>
                        {% endif %}
                    </div>
                {% endif %}
            {% endif %}

        </div>{# /main area #}
    </div>{# /flex #}
</div>

<script>
// Закрыть дропдаун сортировки по клику вне
document.addEventListener('click', function(e) {
    var dd = document.getElementById('sort-dropdown');
    if (dd && !dd.contains(e.target)) {
        document.getElementById('sort-menu').classList.add('hidden');
    }
});
</script>
{% endblock %}
