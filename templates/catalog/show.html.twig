{% extends 'tailwind/base.html.twig' %}

{% block title %}{{ product.title }} — {{ product.brand.title }} — WEARBASE{% endblock %}

{% block meta_description %}{{ product.metaDescription ?: product.anons ?: product.title ~ ' — купить от ' ~ product.brand.title }}{% endblock %}

{% block body %}
{% set mainImage = product.mainImage %}
{% set minPrice = product.minPrice %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": "{{ url('product_show', {uuid: product.uuid}) }}#webpage",
            "url": "{{ url('product_show', {uuid: product.uuid}) }}",
            "name": "{{ product.title }} — {{ product.brand.title }}",
            "description": "{{ (product.metaDescription ?: product.anons ?: product.title)|escape('js') }}",
            "isPartOf": {"@id": "#website"},
            "breadcrumb": {"@id": "{{ url('product_show', {uuid: product.uuid}) }}#breadcrumb"}
        },
        {
            "@type": "BreadcrumbList",
            "@id": "{{ url('product_show', {uuid: product.uuid}) }}#breadcrumb",
            "itemListElement": [
                {"@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ url('home_hub', {_locale: 'ru'}) }}"},
                {"@type": "ListItem", "position": 2, "name": "Каталог", "item": "{{ url('catalog_index') }}"},
                {% if product.category %}
                {"@type": "ListItem", "position": 3, "name": "{{ product.category.title }}", "item": "{{ url('catalog_index', {gender: product.gender}) }}"},
                {"@type": "ListItem", "position": 4, "name": "{{ product.title }}"}
                {% else %}
                {"@type": "ListItem", "position": 3, "name": "{{ product.title }}"}
                {% endif %}
            ]
        },
        {
            "@type": "Product",
            "@id": "{{ url('product_show', {uuid: product.uuid}) }}#product",
            "name": "{{ product.title }}",
            "description": "{{ (product.description ?: product.anons ?: product.title)|escape('js') }}",
            "url": "{{ url('product_show', {uuid: product.uuid}) }}",
            "sku": "{{ product.slug }}",
            {% if product.gender %}
            "gender": "{{ product.gender == 'men' ? 'Male' : (product.gender == 'women' ? 'Female' : (product.gender == 'unisex' ? 'Unisex' : '')) }}",
            {% endif %}
            "brand": {
                "@type": "Brand",
                "name": "{{ product.brand.title }}",
                "url": "{{ url('brand_show', {slug: product.brand.slug}) }}"
            },
            {% if mainImage and product_image_url(mainImage) %}
            "image": "{{ absolute_url(product_image_url(mainImage)) }}",
            {% endif %}
            "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": "RUB",
                "lowPrice": "{{ minPrice }}",
                "highPrice": "{{ minPrice }}",
                "offerCount": "{{ product.variants|length }}",
                "availability": "{{ product.isInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock' }}"
            }
        }
    ]
}
</script>
<div class="container mx-auto px-4 py-8">

    {# Breadcrumbs #}
    <nav class="flex mb-6 text-sm" aria-label="Хлебные крошки">
        <a href="{{ path('home_hub', {_locale: 'ru'}) }}" class="text-gray-500 hover:text-gray-900">Главная</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href="{{ path('catalog_index') }}" class="text-gray-500 hover:text-gray-900">Каталог</a>
        {% if product.category %}
        <span class="mx-2 text-gray-400">/</span>
        <a href="{{ path('catalog_index', {gender: product.gender}) }}" class="text-gray-500 hover:text-gray-900">{{ product.category.title }}</a>
        {% endif %}
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-900 font-medium">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">

        {# ── Галерея ── #}
        <div>
            {% if product.productImages|length > 0 %}
                {% set mainImgSrc = product_image_url(product.mainImage, 'image') %}
                <div class="bg-white rounded-xl overflow-hidden shadow-sm mb-3 relative group cursor-pointer"
                     id="main-image-container">
                    <img id="main-image"
                         src="{{ mainImgSrc }}"
                         alt="{{ product.title }}"
                         class="w-full h-auto object-cover"
                         style="max-height:500px"
                         loading="lazy">
                </div>

                {% if product.productImages|length > 1 %}
                <div class="flex gap-2 overflow-x-auto pb-1" id="thumbnail-list">
                    {% for image in product.productImages %}
                    <button type="button"
                            class="thumbnail-btn w-20 h-20 rounded-lg overflow-hidden border-2 flex-shrink-0 transition cursor-pointer
                                   {{ image.isMain ? 'border-gray-900' : 'border-transparent hover:border-gray-400' }}"
                            data-src="{{ product_image_url(image, 'image') }}"
                            data-full="{{ product_image_url(image, 'image') }}">
                        <img src="{{ product_image_url(image) }}"
                             alt="" class="w-full h-full object-cover">
                    </button>
                    {% endfor %}
                </div>
                {% endif %}
            {% else %}
                <div class="bg-gray-100 rounded-xl flex items-center justify-center" style="height:400px">
                    <span class="text-6xl text-gray-300">👗</span>
                </div>
            {% endif %}
        </div>

        {# ── Информация о товаре ── #}
        <div>
            <a href="{{ path('brand_show', {slug: brand.slug, _locale: 'ru'}) }}"
               class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                {{ brand.title }}
            </a>

            <h1 class="text-2xl font-bold mt-1 mb-3">{{ product.title }}</h1>

            {# Price with discount #}
            {% set firstVar = product.variants|filter(v => v.isInStock and v.status == 'active')|first %}
            <div class="mb-4" id="price-display">
                {% if firstVar %}
                    <div class="flex items-center gap-3 flex-wrap">
                        {% if firstVar.comparePrice and firstVar.comparePrice > firstVar.price %}
                            <span class="text-2xl text-gray-400 line-through">{{ firstVar.comparePrice|price }}</span>
                            <span class="text-sm font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded">−{{ firstVar.discountPercent }}%</span>
                        {% endif %}
                        <span class="text-3xl font-bold" id="current-price">{{ firstVar.priceFloat|price }}</span>
                        {% if firstVar.comparePrice and firstVar.comparePrice > firstVar.price %}
                            <span class="text-sm font-semibold text-green-600">Вы экономите {{ (firstVar.comparePrice - firstVar.price)|price }}</span>
                        {% endif %}
                    </div>
                {% else %}
                    <span class="text-3xl font-bold">—</span>
                {% endif %}
            </div>

            {# ── Цвет ── #}
            {% set grouped = product.variants|filter(v => v.status == 'active' and v.isInStock) %}
            {% set uniqueColors = {} %}
            {% for v in grouped %}
                {% set key = v.color ~ '|' ~ v.colorHex %}
                {% if key not in uniqueColors|keys %}
                    {% set uniqueColors = uniqueColors|merge({(key): {'color': v.color, 'colorHex': v.colorHex}}) %}
                {% endif %}
            {% endfor %}

            {% if uniqueColors|length > 0 %}
            <div class="mb-4">
                <div class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Цвет</div>
                <div class="flex flex-wrap gap-2" id="color-swatches">
                    {% for key, colorData in uniqueColors %}
                    <button type="button"
                            class="color-swatch w-9 h-9 rounded-full border-2 transition cursor-pointer
                                   {{ loop.first ? 'border-gray-900' : 'border-gray-300 hover:border-gray-500' }}"
                            style="background-color: {{ colorData.colorHex ?: '#ccc' }}"
                            data-color="{{ colorData.color }}"
                            data-color-hex="{{ colorData.colorHex }}"
                            title="{{ colorData.color }}">
                    </button>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Variants #}
            {% if product.variants|length > 0 %}
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Размер</div>
                <div class="flex flex-wrap gap-2" id="size-selector">
                    {% for variant in product.variants %}
                        {% if variant.status == 'active' and variant.isInStock %}
                            <button type="button"
                                    class="size-btn px-4 py-2 border rounded-lg text-sm transition cursor-pointer
                                           {% if variant.comparePrice %}border-red-300{% else %}border-gray-300 hover:border-gray-900{% endif %}
                                           {{ loop.index == 1 ? 'ring-2 ring-gray-900 border-gray-900' : '' }}"
                                    data-variant-id="{{ variant.id }}"
                                    data-price="{{ variant.priceFloat }}"
                                    data-compare-price="{{ variant.comparePrice }}"
                                    data-color="{{ variant.color }}"
                                    data-color-hex="{{ variant.colorHex }}"
                                    data-stock="{{ variant.stockQty }}">
                                {{ variant.size ?: variant.sku }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Gender badge #}
            {% if product.gender %}
            <div class="mb-4">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Пол: </span>
                <span class="text-sm">{{ product.gender == 'women' ? 'Женский' : (product.gender == 'men' ? 'Мужской' : (product.gender == 'kids' ? 'Детский' : 'Унисекс')) }}</span>
            </div>
            {% endif %}

            {# Description #}
            {% if product.description %}
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Описание</div>
                <p class="text-gray-700 leading-relaxed">{{ product.description }}</p>
            </div>
            {% endif %}

            {# Styles #}
            {% if product.styles|length > 0 %}
            <div class="mb-6">
                <div class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Стили</div>
                <div class="flex flex-wrap gap-1">
                    {% for style in product.styles %}
                        <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded-full">{{ style.title }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# ── Количество ── #}
            {% set firstVar = product.variants|filter(v => v.isInStock and v.status == 'active')|first %}
            {% if firstVar %}
            <div class="mb-4" id="quantity-selector">
                <div class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Количество</div>
                <div class="flex items-center gap-0 border border-gray-300 rounded-lg w-fit">
                    <button type="button"
                            class="qty-btn px-3 py-2 text-lg font-medium text-gray-600 hover:bg-gray-100 transition disabled:opacity-30 rounded-l-lg border-r border-gray-300"
                            data-action="decrease" disabled>−</button>
                    <input type="number"
                           id="qty-input"
                           value="1"
                           min="1"
                           max="{{ firstVar.stockQty }}"
                           class="w-12 text-center py-2 text-sm [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                           readonly>
                    <button type="button"
                            class="qty-btn px-3 py-2 text-lg font-medium text-gray-600 hover:bg-gray-100 transition disabled:opacity-30 rounded-r-lg border-l border-gray-300"
                            data-action="increase">+</button>
                </div>
                <span class="text-xs text-gray-400 ml-2">{{ firstVar.stockQty }} шт. в наличии</span>
            </div>
            {% endif %}

            {# Add to cart button #}
            {% set firstVariant = product.variants|filter(v => v.isInStock and v.status == 'active')|first %}
            {% if not firstVariant %}
                <div class="mt-6 bg-gray-100 text-gray-500 py-3 px-6 rounded-xl text-center font-semibold">
                    Нет в наличии
                </div>
            {% elseif not brand_can_sell(product.brand) %}
                <form method="post" action="{{ path('product_intent_click', {uuid: product.uuid}) }}" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token('product_intent') }}">
                    <button type="submit" class="w-full bg-gray-900 text-white py-3 px-6 rounded-xl font-semibold hover:bg-gray-800 transition">
                        Хочу купить
                    </button>
                </form>
                <p class="mt-2 text-xs text-gray-500 text-center">
                    Бренд пока не принимает оплату на WEARBASE — оставьте сигнал, и мы попросим его подключить приём заказов.
                </p>
            {% else %}
            <form method="post" action="{{ path('cart_add', {variantId: firstVariant.id}) }}"
                  class="mt-6" id="add-to-cart-form">
                <button type="submit" class="w-full bg-gray-900 text-white py-3 px-6 rounded-xl font-semibold hover:bg-gray-800 transition">
                    В корзину
                </button>
            </form>
            {% endif %}
        </div>
    </div>

</div>

{# ── Характеристики ── #}
{% set chars = {
    'Материал': product.material,
    'Состав': product.composition,
    'Уход': product.careInstructions,
    'Страна производства': product.countryOfOrigin,
    'Производитель': product.manufacturer,
}|filter(v => v is not null) %}

{% if chars|length > 0 %}
<div class="mt-12 mx-auto px-4" style="max-width:1280px">
    <h2 class="text-xl font-bold mb-4">Характеристики</h2>
    <div class="border border-gray-200 rounded-xl overflow-hidden max-w-2xl">
        {% for label, value in chars %}
        <div class="flex border-b border-gray-100 last:border-b-0">
            <div class="w-48 px-4 py-3 bg-gray-50 text-sm font-medium text-gray-600">{{ label }}</div>
            <div class="flex-1 px-4 py-3 text-sm text-gray-900 break-words">{{ value }}</div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{# ── Блок бренда ── #}
<div class="mt-12 p-6 bg-white rounded-xl border border-gray-100 mx-auto px-4" style="max-width:1280px">
    <div class="flex items-start gap-4">
        {% if brand.logo %}
        <div class="w-20 h-20 rounded-lg overflow-hidden bg-gray-50 flex-shrink-0">
            <img src="{{ asset('images/logos/' ~ brand.logo) }}"
                 alt="{{ brand.title }}"
                 class="w-full h-full object-contain">
        </div>
        {% else %}
        <div class="w-20 h-20 rounded-lg bg-gray-100 flex items-center justify-center text-3xl flex-shrink-0">🏷️</div>
        {% endif %}
        <div class="flex-1 min-w-0">
            <a href="{{ path('brand_show', {slug: brand.slug}) }}"
               class="text-xl font-bold hover:text-indigo-600 transition">
                {{ brand.title }}
            </a>
            {% if brand.anons %}
            <p class="text-gray-600 mt-1 text-sm">{{ brand.anons }}</p>
            {% endif %}
            {% if brand.uniqueLinks|length > 0 %}
            <div class="flex flex-wrap gap-2 mt-3">
                {% for link in brand.uniqueLinks %}
                <a href="{{ path('brand_outbound_click', {id: link.id}) }}" target="_blank" rel="nofollow noopener"
                   class="inline-flex items-center gap-1 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full transition">
                    {% if link.linkType == 'website' %}🌐{% elseif link.linkType == 'instagram' %}📷{% elseif link.linkType == 'telegram' %}✈️{% elseif link.linkType == 'vk' %}💙{% elseif link.linkType == 'youtube' %}▶️{% elseif link.linkType == 'tiktok' %}🎵{% else %}🔗{% endif %}
                    {{ link.linkType|capitalize }}
                </a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</div>

{# ── Похожие товары ── #}
{% if similarProducts|length > 0 %}
<div class="mt-12 mx-auto px-4" style="max-width:1280px">
    <h2 class="text-2xl font-bold mb-6">Похожие товары</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {% for similar in similarProducts %}
        <a href="{{ path('product_show', {uuid: similar.uuid}) }}"
           class="group bg-white rounded-xl overflow-hidden border border-gray-100 hover:shadow-md transition">
            {% set simImg = similar.mainImage %}
            {% set simImgSrc = product_image_url(simImg) %}
            {% if simImgSrc %}
            <div class="aspect-[3/4] overflow-hidden bg-gray-50">
                <img src="{{ simImgSrc }}"
                     alt="{{ similar.title }}"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                     loading="lazy">
            </div>
            {% else %}
            <div class="aspect-[3/4] bg-gray-100 flex items-center justify-center text-4xl text-gray-300">👗</div>
            {% endif %}
            <div class="p-3">
                <p class="text-xs text-gray-500">{{ similar.brand.title }}</p>
                <p class="text-sm font-medium mt-0.5 line-clamp-2">{{ similar.title }}</p>
                <p class="text-sm font-bold mt-1">{{ similar.minPrice|price }}</p>
            </div>
        </a>
    {% endfor %}
    </div>
</div>
{% endif %}

<script>
(function() {
    var form = document.getElementById('add-to-cart-form');
    if (!form) return;

    var sizeBtns = document.querySelectorAll('#size-selector .size-btn');
    var selectedId = null;
    var priceDisplay = document.getElementById('price-display');
    var qtyInput = document.getElementById('qty-input');

    function updatePrice(btn) {
        var price = btn.getAttribute('data-price');
        var compare = btn.getAttribute('data-compare-price');
        var discountHtml = '';
        var savingsHtml = '';
        if (compare && parseFloat(compare) > parseFloat(price)) {
            var pct = Math.round((1 - price / compare) * 100);
            discountHtml = '<span class="text-2xl text-gray-400 line-through">' + parseFloat(compare).toLocaleString('ru-RU') + ' ₽</span> <span class="text-sm font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded">−' + pct + '%</span> ';
            savingsHtml = ' <span class="text-sm font-semibold text-green-600">Вы экономите ' + (parseFloat(compare) - parseFloat(price)).toLocaleString('ru-RU') + ' ₽</span>';
        }
        priceDisplay.innerHTML = '<div class="flex items-center gap-3 flex-wrap">' + discountHtml + '<span class="text-3xl font-bold" id="current-price">' + parseFloat(price).toLocaleString('ru-RU') + ' ₽</span>' + savingsHtml + '</div>';
    }

    // ── Color swatches ──
    var swatches = document.querySelectorAll('.color-swatch');
    swatches.forEach(function(sw) {
        sw.addEventListener('click', function() {
            var color = sw.getAttribute('data-color');
            swatches.forEach(function(s) {
                s.classList.remove('border-gray-900');
                s.classList.add('border-gray-300', 'hover:border-gray-500');
            });
            sw.classList.remove('border-gray-300', 'hover:border-gray-500');
            sw.classList.add('border-gray-900');

            sizeBtns.forEach(function(btn) {
                var btnColor = btn.getAttribute('data-color');
                if (!color || !btnColor || btnColor === color) {
                    btn.style.display = '';
                } else {
                    btn.style.display = 'none';
                }
            });

            var visible = Array.from(sizeBtns).filter(function(b) { return b.style.display !== 'none'; });
            sizeBtns.forEach(function(b) {
                b.classList.remove('ring-2', 'ring-gray-900', 'border-gray-900');
                b.classList.add('border-gray-300', 'hover:border-gray-900');
            });
            if (visible.length > 0) {
                visible[0].classList.add('ring-2', 'ring-gray-900', 'border-gray-900');
                visible[0].classList.remove('border-gray-300', 'hover:border-gray-900');
                updatePrice(visible[0]);
                selectedId = visible[0].getAttribute('data-variant-id');
                form.action = form.action.replace(/\/cart\/add\/\d+$/, '/cart/add/' + selectedId);
            }
        });
    });

    // ── Size selection ──
    sizeBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            sizeBtns.forEach(function(b) {
                b.classList.remove('ring-2', 'ring-gray-900', 'border-gray-900');
                b.classList.add('border-gray-300', 'hover:border-gray-900');
            });
            btn.classList.add('ring-2', 'ring-gray-900', 'border-gray-900');
            btn.classList.remove('border-gray-300', 'hover:border-gray-900');
            selectedId = btn.getAttribute('data-variant-id');
            form.action = form.action.replace(/\/cart\/add\/\d+$/, '/cart/add/' + selectedId);
            updatePrice(btn);
        });
    });

    // ── Gallery thumbnails ──
    var mainImg = document.getElementById('main-image');
    var thumbs = document.querySelectorAll('.thumbnail-btn');
    thumbs.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var src = btn.getAttribute('data-src');
            if (mainImg) mainImg.src = src;
            thumbs.forEach(function(t) { t.classList.remove('border-gray-900'); t.classList.add('border-transparent'); });
            btn.classList.remove('border-transparent');
            btn.classList.add('border-gray-900');
        });
    });

    // ── Lightbox ──
    var container = document.getElementById('main-image-container');
    if (container) {
        container.addEventListener('click', function() {
            var src = mainImg ? mainImg.src : '';
            if (!src) return;
            var overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.9);display:flex;align-items:center;justify-content:center;cursor:pointer';
            overlay.addEventListener('click', function() { document.body.removeChild(overlay); });
            var img = document.createElement('img');
            img.src = src;
            img.style.cssText = 'max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px';
            overlay.appendChild(img);
            document.body.appendChild(overlay);
        });
    }

    // ── Quantity selector ──
    var qtyBtns = document.querySelectorAll('.qty-btn');
    if (qtyInput) {
        function updateQtyBtns() {
            var val = parseInt(qtyInput.value) || 1;
            var max = parseInt(qtyInput.getAttribute('max'));
            qtyBtns.forEach(function(btn) {
                var action = btn.getAttribute('data-action');
                btn.disabled = (action === 'decrease' && val <= 1) || (action === 'increase' && val >= max);
            });
        }
        qtyBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var val = parseInt(qtyInput.value) || 1;
                var max = parseInt(qtyInput.getAttribute('max'));
                if (btn.getAttribute('data-action') === 'decrease' && val > 1) qtyInput.value = val - 1;
                if (btn.getAttribute('data-action') === 'increase' && val < max) qtyInput.value = val + 1;
                updateQtyBtns();
            });
        });
        updateQtyBtns();
    }

    // ── AJAX submit ──
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var orig = btn.textContent;
        btn.textContent = '…';
        btn.disabled = true;

        var qty = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

        fetch(form.action, {
            method: 'POST',
            headers: {'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': '{{ csrf_token('cart') }}'},
            body: new URLSearchParams({qty: qty})
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.error) { alert(data.error); return; }
                if (window.updateCartBadge) window.updateCartBadge(data.count);
                btn.textContent = '✓ В корзине';
                setTimeout(function() {
                    btn.textContent = orig;
                    btn.disabled = false;
                }, 1500);
            })
            .catch(function() {
                btn.textContent = 'Ошибка';
                btn.disabled = false;
            });
    });
})();
</script>
{% endblock %}
