<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Локальные бренды | WEARBASE{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* ── Бренд-карточки ── */
        .brand-card { transition: transform .3s ease, box-shadow .3s ease; border: none; height: 100%; }
        .brand-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,.15); }
        .brand-logo { height: 120px; object-fit: contain; padding: 1rem; }
        .local-badge { background: linear-gradient(45deg, #ff6b6b, #ee5a24); font-size: .8rem; }
        .filter-btn.active { background-color: #000; color: #fff; border-color: #000; }
        .category-tag { background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 20px; padding: .25rem .75rem; font-size: .8rem; margin: .1rem; }

        /* ── Глобальные стили форм ── */
        .form-control,
        .form-select {
            background-color: #f4f4f5 !important;
            border: 1.5px solid transparent;
            border-radius: .5rem;
            transition: background-color .15s, box-shadow .15s;
        }
        .form-control:focus,
        .form-select:focus {
            background-color: #ececed !important;
            border-color: transparent;
            box-shadow: 0 0 0 3px rgba(0,0,0,.07);
        }
        .form-control::placeholder { color: #adb5bd; }
        textarea.form-control { resize: vertical; min-height: 80px; }

        /* ── Кнопки ── */
        .btn { border-radius: .5rem; font-weight: 500; }
        .btn-lg { border-radius: .6rem; }
        .btn-sm { border-radius: .4rem; }
        .btn-dark { background-color: #111; border-color: #111; }
        .btn-dark:hover { background-color: #2d2d2d; border-color: #2d2d2d; }
        .btn-outline-secondary { border-color: #e0e0e0; color: #555; }
        .btn-outline-secondary:hover { background-color: #f4f4f5; border-color: #ccc; color: #111; }

        /* ── Карточки ── */
        .card { border-radius: .75rem !important; overflow: hidden; }
        .card-header {
            border-bottom: 1px solid #f0f0f0 !important;
            padding: .85rem 1.25rem;
            font-size: .875rem;
        }
        .card.border-0.shadow-sm { box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 2px 12px rgba(0,0,0,.04) !important; }

        /* ── Caps-лейблы форм ── */
        .label-caps,
        .form-section-label {
            font-size: .72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #888;
            margin-bottom: .35rem;
            display: block;
        }

        /* ── Таблицы ── */
        .table thead th {
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #6c757d;
            border-bottom-width: 1px;
        }
        .table-hover tbody tr:hover td { background-color: #fafafa; }

        /* ── Form-check карточки (чекаут, доставка, оплата) ── */
        .form-check.border {
            border-color: #e8e8e8 !important;
            border-radius: .5rem !important;
            transition: border-color .15s, background .15s;
            cursor: pointer;
        }
        .form-check.border:has(:checked) {
            border-color: #111 !important;
            background-color: #fafafa;
        }

        /* ── List-group ── */
        .list-group-item { border-color: #f0f0f0; }

        /* ── Badge ── */
        .badge { border-radius: .35rem; font-weight: 500; letter-spacing: .01em; }

        /* ── Сайдбар аккаунта ── */
        .account-nav .nav-link {
            color: #444;
            padding: .45rem .75rem;
            border-radius: .45rem;
            font-size: .875rem;
            transition: background .15s, color .15s;
        }
        .account-nav .nav-link:hover { background: #f4f4f5; color: #111; }
        .account-nav .nav-link.active { background: #111; color: #fff !important; }
        .account-nav .nav-link i { width: 16px; }
    </style>
    {% include 'tailwind/_yandex_metrika.html.twig' %}
</head>
<body>

{# ── Баннер режима просмотра от имени пользователя ── #}
{% if app.session.get('_impersonating') %}
    {% set imp = app.session.get('_impersonating') %}
    <div style="background:#7c3aed;color:#fff;font-size:.82rem;padding:.5rem 1rem;
                display:flex;align-items:center;justify-content:space-between;gap:1rem;z-index:9999">
        <span>
            <i class="fas fa-eye me-2"></i>
            <strong>Режим просмотра</strong> — вы видите сайт как
            <strong>{{ imp.email }}</strong>
        </span>
        <a href="{{ path('impersonate_exit') }}"
           style="color:#fff;text-decoration:underline;white-space:nowrap">
            <i class="fas fa-times me-1"></i>Выйти из режима
        </a>
    </div>
{% endif %}

{% block body %}
{% include 'components/header.html.twig' %}

<main class="px-0">
    {% block content %}{% endblock %}
</main>

{% include 'components/footer.html.twig' %}
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Фильтрация брендов
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.filter-btn');
        const brandCards = document.querySelectorAll('.brand-card');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                const filter = this.getAttribute('data-filter');

                // Активный класс для кнопок
                filterButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');

                // Фильтрация карточек
                brandCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    });
</script>
{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}
{% include 'components/cookie_banner.html.twig' %}
</body>
</html>
