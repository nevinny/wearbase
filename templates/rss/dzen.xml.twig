{% autoescape 'html' %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:media="http://search.yahoo.com/mrss/">
    <channel>
        <title>{{ siteTitle }}</title>
        <link>{{ siteLink }}</link>
        <description>{{ siteTitle }}</description>
        <language>ru</language>
        {% for item in items %}
        <item>
            <title>{{ item.title }}</title>
            <link>{{ item.link }}</link>
            <guid isPermaLink="true">{{ item.link }}</guid>
            <pubDate>{{ item.pubDate }}</pubDate>
            {% if item.excerpt %}
            <description><![CDATA[{{ item.excerpt|raw }}]]></description>
            {% endif %}
            <content:encoded><![CDATA[{{ item.content|raw }}]]></content:encoded>
            <category>native-draft</category>
            <media:rating scheme="urn:simple">nonadult</media:rating>
            {% if item.author %}
            <dc:creator>{{ item.author }}</dc:creator>
            {% endif %}
        </item>
        {% endfor %}
    </channel>
</rss>
{% endautoescape %}
