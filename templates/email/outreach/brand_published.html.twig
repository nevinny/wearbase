{# Activation-письмо (cold B2B, ФЗ-38: уведомление БЕЗ продажи — никаких цен/подписок!).
   Табличная вёрстка ≤600px, инлайн-стили, текст-лого (картинки у холодных заблокированы). #}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    {# Тёмная тема (Apple Mail и др.): без этих правил клиент инвертирует фон, но оставляет
       inline-цвета → тёмный текст на тёмном (слепое письмо). Классы дублируют inline-стили. #}
    <style>
        @media (prefers-color-scheme: dark) {
            .em-page   { background: #18181b !important; }
            .em-panel  { background: #27272a !important; }
            .em-card   { background: #3f3f46 !important; }
            .em-strong { color: #fafafa !important; }
            .em-txt    { color: #d4d4d8 !important; }
            .em-dim    { color: #a1a1aa !important; }
            .em-btn    { background: #4f46e5 !important; }
            .em-border { border-top-color: #3f3f46 !important; }
        }
    </style>
</head>
<body class="em-page" style="margin:0;padding:0;background:#f4f4f5;">
{# Прехедер: виден в превью списка писем, скрыт в теле #}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
    Страница {{ brand.title }} уже в каталоге WEARBASE — проверьте данные&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="em-page" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" class="em-panel" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;">

        {# Шапка: ТЕКСТ-лого #}
        <tr><td style="padding:24px 32px 8px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
            <span style="font-size:20px;font-weight:800;letter-spacing:2px;color:#111827;" class="em-strong">WEARBASE</span>
            <span style="font-size:12px;color:#9ca3af;" class="em-dim">&nbsp;·&nbsp;каталог российских брендов одежды</span>
        </td></tr>

        {# Заголовок + суть #}
        <tr><td style="padding:16px 32px 0;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
            <h1 style="margin:0 0 12px;font-size:20px;line-height:1.35;color:#111827;" class="em-strong">
                «{{ brand.title }}» уже в каталоге Wearbase
            </h1>
            <p style="margin:0 0 16px;font-size:15px;line-height:1.55;color:#374151;" class="em-txt">
                Здравствуйте! Мы собираем сильные российские бренды одежды — и обратили внимание на «{{ brand.title }}».
                Подготовили вашу страницу в Wearbase, её уже видят покупатели.
            </p>
        </td></tr>

        {# Динамический крючок «что знаем» — показываем то, что реально есть #}
        {% set has_card = channels|length > 0 or categories|length > 0 or brand.city or stores|length > 0 %}
        {% if has_card %}
        <tr><td style="padding:0 32px 16px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="em-card" style="background:#f9fafb;border-radius:6px;">
                <tr><td style="padding:14px 18px;font-size:14px;line-height:1.7;color:#374151;" class="em-txt">
                    <strong style="color:#111827;" class="em-strong">Что мы о вас уже знаем:</strong><br>
                    {% if channels|length %}&bull;&nbsp;Каналы: {{ channels|join(' · ') }}<br>{% endif %}
                    {% if categories|length %}&bull;&nbsp;Ассортимент: {{ categories|join(' · ') }}<br>{% endif %}
                    {% if brand.city %}&bull;&nbsp;Город: {{ brand.city }}<br>{% endif %}
                    {% for store in stores %}&bull;&nbsp;Точка продаж: {{ store.address }}<br>{% endfor %}
                    <span style="color:#6b7280;" class="em-dim">Если что-то устарело или неверно — это правится на странице за пару минут.</span>
                </td></tr>
            </table>
        </td></tr>
        {% endif %}

        {# Блок ценности: зачем (бесплатная инфраструктура, без цен — ФЗ-38) #}
        <tr><td style="padding:4px 32px 8px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
            <p style="margin:0 0 14px;font-size:15px;line-height:1.55;color:#374151;" class="em-txt">
                Данные мы собрали из открытых источников, поэтому что-то может быть неточным. Было бы здорово, если бы мы <strong>вместе</strong> довели страницу до идеала — вы подтверждаете данные, добавляете фото и описание.
            </p>
            <p style="margin:0 0 10px;font-size:15px;font-weight:700;color:#111827;" class="em-strong">Что это даёт бренду</p>
            <p style="margin:0 0 8px;font-size:14px;line-height:1.55;color:#374151;" class="em-txt">
                &bull;&nbsp;<strong>Витрина, а не строка в выдаче.</strong> Покупатель приходит к бренду, а не к карточке среди тысяч чужих на маркетплейсе.
            </p>
            <p style="margin:0 0 8px;font-size:14px;line-height:1.55;color:#374151;" class="em-txt">
                &bull;&nbsp;<strong>Прямые продажи без комиссии маркетплейса.</strong> Деньги за заказ идут напрямую бренду — Wearbase не берёт комиссию с продаж.
            </p>
            <p style="margin:0 0 4px;font-size:14px;line-height:1.55;color:#374151;" class="em-txt">
                &bull;&nbsp;<strong>Данные под вашим контролем.</strong> Описание, фото, ссылки и ассортимент редактируете вы — страница принадлежит бренду.
            </p>
            <p style="margin:14px 0 0;font-size:14px;line-height:1.55;color:#374151;" class="em-txt">
                У нас общая цель — чтобы покупатель приходил к «{{ brand.title }}» напрямую, а не терялся среди чужих карточек. Уверены, вместе сделаем страницу, которая работает на бренд.
            </p>
        </td></tr>

        {# Одна CTA: bulletproof-кнопка #}
        <tr><td align="center" style="padding:12px 32px 12px;">
            <table role="presentation" cellpadding="0" cellspacing="0">
                <tr><td class="em-btn" style="background:#111827;border-radius:6px;">
                    <a href="{{ click_url }}" style="display:inline-block;padding:13px 36px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
                        Забрать управление страницей →
                    </a>
                </td></tr>
            </table>
        </td></tr>
        <tr><td align="center" style="padding:0 32px 24px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:12px;color:#9ca3af;" class="em-dim">
            Не открывается? Ссылка: {{ click_url }}
        </td></tr>

        {# Мы на связи: соцсети + контактный бот (главная ссылка блока) #}
        <tr><td style="padding:0 32px 20px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="em-card" style="background:#f9fafb;border-radius:6px;">
                <tr><td align="center" style="padding:18px 18px;font-size:14px;line-height:1.6;color:#374151;" class="em-txt">
                    <p style="margin:0 0 10px;font-size:14px;font-weight:700;color:#111827;" class="em-strong">Мы на связи</p>
                    <p style="margin:0 0 14px;font-size:14px;line-height:1.55;color:#374151;" class="em-txt">
                        Вопросы или хотите управлять своей карточкой — напишите нам в Telegram-бот, ответим быстро.
                    </p>
                    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 14px;">
                        <tr><td class="em-btn" style="background:#111827;border-radius:6px;">
                            <a href="https://t.me/wearbase_bot" style="display:inline-block;padding:11px 28px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">
                                Написать в Telegram-бот →
                            </a>
                        </td></tr>
                    </table>
                    <p style="margin:0;font-size:13px;color:#6b7280;" class="em-dim">
                        <a href="https://t.me/wearbaseru" style="color:#374151;text-decoration:underline;" class="em-txt">Канал WEARBASE</a>
                        &nbsp;·&nbsp;
                        <a href="https://vk.com/wearbase" style="color:#374151;text-decoration:underline;" class="em-txt">VK</a>
                        &nbsp;·&nbsp;
                        <a href="https://instagram.com/wearbaseru" style="color:#374151;text-decoration:underline;" class="em-txt">Instagram</a>
                    </p>
                </td></tr>
            </table>
        </td></tr>

        {# Подвал: кто/почему/отписка/юр #}
        <tr><td class="em-border em-dim" style="padding:16px 32px 24px;border-top:1px solid #e5e7eb;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:12px;line-height:1.6;color:#9ca3af;">
            WEARBASE — открытый каталог российских брендов одежды.<br>
            Вы получили это письмо, потому что мы добавили бренд «{{ brand.title }}» в каталог
            и хотим передать страницу его владельцу.<br>
            Не хотите, чтобы страница показывалась, или письма не нужны —
            <a href="{{ unsub_url }}" style="color:#6b7280;" class="em-dim">сообщите нам</a>.
        </td></tr>
    </table>
</td></tr>
</table>

<img src="{{ pixel_url }}" width="1" height="1" alt="" style="display:none;">
</body>
</html>
