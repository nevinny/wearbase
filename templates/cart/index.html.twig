{% extends 'tailwind/app.html.twig' %}
{% block title %}Корзина — WEARBASE{% endblock %}

{% block body %}
<div class="container mx-auto max-w-[960px] px-4 py-8">
    <h1 class="text-xl font-bold mb-6">Корзина</h1>

    {% if cart.empty %}
        <div class="rounded-2xl bg-white shadow-sm py-14 text-center text-gray-500">
            <div class="text-5xl mb-4 opacity-30">🛒</div>
            <p class="mb-5">В корзине пусто</p>
            <a href="{{ path('catalog_index') }}"
               class="inline-block rounded-xl bg-gray-900 px-6 py-3 text-sm font-semibold text-white hover:bg-black transition">Перейти в каталог</a>
        </div>
    {% else %}
    <div class="grid gap-6 lg:grid-cols-3">

        {# Товары #}
        <div class="lg:col-span-2 space-y-4">
            {% for group in groups %}
            <div class="rounded-2xl bg-white shadow-sm overflow-hidden">
                <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">
                    🏬 {{ group.brand.title }}
                </div>
                <div class="divide-y divide-gray-100">
                {% for item in group.items %}
                <div class="px-5 py-4" id="cart-item-{{ item.id }}">
                    <div class="flex items-center gap-4">

                        {# Фото #}
                        {% set img = item.variant.product.mainImage %}
                        {% if img and img.preview %}
                            <img src="{{ vich_uploader_asset(img, 'previewFile') }}"
                                 class="h-[68px] w-[68px] shrink-0 rounded-xl object-cover" alt="">
                        {% else %}
                            <div class="flex h-[68px] w-[68px] shrink-0 items-center justify-center rounded-xl bg-gray-100 text-gray-400">📷</div>
                        {% endif %}

                        {# Описание #}
                        <div class="min-w-0 flex-1">
                            <div class="truncate text-sm font-semibold">{{ item.variant.product.title }}</div>
                            <div class="text-xs text-gray-500">{{ item.variant.title }}</div>
                            <div class="mt-1 text-sm font-semibold">{{ price(item.variant.price) }}</div>
                        </div>

                        {# Количество #}
                        <div class="flex items-center gap-1">
                            <button class="qty-btn h-[30px] w-[30px] rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50"
                                    data-id="{{ item.id }}" data-delta="-1">−</button>
                            <span class="qty-val min-w-[28px] text-center text-sm font-semibold" data-id="{{ item.id }}">{{ item.qty }}</span>
                            <button class="qty-btn h-[30px] w-[30px] rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50"
                                    data-id="{{ item.id }}" data-delta="1">+</button>
                        </div>

                        {# Сумма + удаление #}
                        <div class="min-w-[90px] shrink-0 text-right">
                            <div class="text-sm font-bold" id="item-total-{{ item.id }}">
                                {{ price(item.subtotal) }}
                            </div>
                            <form method="post" action="{{ path('cart_remove', {itemId: item.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                                <button class="mt-1 text-xs text-gray-400 hover:text-gray-600 underline">удалить</button>
                            </form>
                        </div>

                    </div>
                </div>
                {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        {# Итог #}
        <div>
            <div class="sticky top-4 rounded-2xl bg-white p-6 shadow-sm">
                <h5 class="mb-4 text-xs font-bold uppercase tracking-wider text-gray-500">Итого</h5>
                <div class="mb-2 flex justify-between text-sm">
                    <span class="text-gray-500">Товары</span>
                    <span id="cart-total" class="font-semibold">{{ price(cart.total) }}</span>
                </div>
                {% if app_currency.code != 'RUB' %}
                <div class="mb-2 text-xs text-gray-400">
                    ≈ {{ cart.total|number_format(0, '.', ' ') }} ₽
                </div>
                {% endif %}
                <div class="mb-5 flex justify-between text-sm text-gray-500">
                    <span>Доставка</span>
                    <span>рассчитается при оформлении</span>
                </div>
                <a href="{{ path('checkout_index') }}"
                   class="block w-full rounded-xl bg-gray-900 py-3.5 text-center text-sm font-semibold text-white hover:bg-black transition">
                    Оформить заказ
                </a>
            </div>
        </div>

    </div>
    {% endif %}
</div>

<script>
// Код валюты и символ для обновления через JS (AJAX qty update)
const currencyCode = '{{ app_currency.code }}';
const currencySymbol = '{{ app_currency.symbol }}';
const currencyIsRub = currencyCode === 'RUB';
const cartCsrf = '{{ csrf_token('cart') }}';

document.querySelectorAll('.qty-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id    = btn.dataset.id;
        const delta = +btn.dataset.delta;
        const span  = document.querySelector(`.qty-val[data-id="${id}"]`);
        const newQty = Math.max(0, +span.textContent + delta);

        const fd = new FormData();
        fd.append('qty', newQty);
        const r = await fetch(`/cart/update/${id}`, { method:'POST', headers:{'X-CSRF-Token': cartCsrf}, body: fd });
        const data = await r.json();

        if (newQty === 0) {
            document.getElementById(`cart-item-${id}`)?.remove();
        } else {
            span.textContent = newQty;
        }

        // Обновляем итог — если не RUB, запрашиваем конвертированную сумму
        if (currencyIsRub) {
            document.getElementById('cart-total').textContent =
                data.total.toLocaleString('ru') + ' ₽';
        } else {
            fetch(`/currency/api/convert?amount=${data.total}&from=RUB&to=${currencyCode}`)
                .then(r => r.json())
                .then(c => {
                    document.getElementById('cart-total').textContent = c.formatted ?? c.result;
                });
        }
        window.updateCartBadge?.(data.count ?? 0);
    });
});
</script>
{% endblock %}
