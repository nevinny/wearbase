{% extends 'account/layout.html.twig' %}
{% block title %}Семья — WEARBASE{% endblock %}

{% block account_content %}
<div class="mb-5 flex items-center justify-between">
    <h1 class="text-lg font-bold">Семья</h1>
    <a href="{{ path('account_family_add') }}"
       class="rounded-xl bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-black transition">+ Добавить ребёнка</a>
</div>

{% if family is null %}

    {# ── Пустое состояние ── #}
    <div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
        <div class="mb-4 text-5xl opacity-30">👨‍👩‍👧</div>
        <p class="mb-1 font-semibold text-gray-700">Добавьте членов семьи</p>
        <p class="mb-5 text-sm">У каждого свой гардероб, вещи можно передавать</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="{{ path('account_family_add') }}"
               class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">+ Добавить ребёнка</a>
            <form method="post" action="{{ path('account_family_invite') }}" class="flex items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
                <select name="role"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                    <option value="parent">Родитель</option>
                    <option value="child">Ребёнок</option>
                </select>
                <button type="submit"
                        class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">Пригласить в семью</button>
            </form>
        </div>
    </div>

{% else %}

    {# ── Члены семьи ── #}
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
        {% for member in members %}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <div class="mb-2 flex items-start justify-between gap-2">
                <div class="text-sm font-semibold">{{ member.fullName }}</div>
                {% if member.familyRole == 'child' %}
                    <span class="rounded-full bg-sky-100 px-2.5 py-0.5 text-[11px] font-semibold text-sky-700">Ребёнок</span>
                {% else %}
                    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-semibold text-gray-600">Родитель</span>
                {% endif %}
            </div>
            <div class="mb-3 text-xs text-gray-500">{{ itemCounts[member.id] ?? 0 }} вещей</div>
            <a href="{{ path('account_wardrobe_index', {member: member.id}) }}"
               class="text-sm font-semibold underline decoration-gray-300 underline-offset-2 hover:decoration-gray-900">Гардероб →</a>

            {% if claimUrls[member.id] is defined %}
                <details class="mt-4 border-t border-gray-100 pt-3">
                    <summary class="cursor-pointer text-[11px] font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-900">Ссылка для входа ребёнка</summary>
                    <div class="mt-2 flex gap-2">
                        <input type="text" readonly id="claim-url-{{ member.id }}" value="{{ claimUrls[member.id] }}"
                               class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-600 focus:outline-none">
                        <button type="button" onclick="wbCopy(this, 'claim-url-{{ member.id }}')"
                                class="shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition">Скопировать</button>
                    </div>
                    <p class="mt-1.5 text-xs text-gray-400">Отправьте ребёнку — по ней он завершит настройку своего аккаунта</p>
                </details>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {# ── Приглашения ── #}
    <div class="rounded-2xl bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-bold">Приглашения</h2>

        <form method="post" action="{{ path('account_family_invite') }}" class="mb-4 flex flex-wrap items-center gap-2">
            <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
            <select name="role"
                    class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                <option value="parent">Родитель</option>
                <option value="child">Ребёнок</option>
            </select>
            <button type="submit"
                    class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Пригласить в семью</button>
        </form>

        {% if invites|length > 0 %}
            <div class="flex flex-col gap-3">
                {% for invite in invites %}
                <div class="rounded-xl border border-gray-100 p-4">
                    <div class="mb-2 flex items-center gap-2 text-xs text-gray-500">
                        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-semibold text-gray-600">{{ invite.role == 'child' ? 'Ребёнок' : 'Родитель' }}</span>
                        <span>от {{ invite.createdAt|date('d.m.Y') }}</span>
                    </div>
                    {% if inviteUrls[invite.id] is defined %}
                        <div class="flex gap-2">
                            <input type="text" readonly id="invite-url-{{ invite.id }}" value="{{ inviteUrls[invite.id] }}"
                                   class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-600 focus:outline-none">
                            <button type="button" onclick="wbCopy(this, 'invite-url-{{ invite.id }}')"
                                    class="shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition">Скопировать</button>
                        </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-sm text-gray-400">Активных приглашений нет</p>
        {% endif %}
    </div>

{% endif %}

<script>
function wbCopy(btn, inputId) {
    var input = document.getElementById(inputId);
    input.select();
    var done = function () {
        var original = btn.textContent;
        btn.textContent = 'Скопировано';
        setTimeout(function () { btn.textContent = original; }, 2000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(input.value).then(done);
    } else {
        document.execCommand('copy');
        done();
    }
}
</script>
{% endblock %}
