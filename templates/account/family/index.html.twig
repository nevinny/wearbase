{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block family_mobile_title %}Семья{% endblock %}

{% block family_mobile_content %}
{% set canManageFamily = family is null or app.user.familyRole == 'parent' %}
<div class="mb-5 flex items-center justify-between gap-3">
    <h1 class="text-xl font-black text-slate-950">Семья</h1>
    {% if canManageFamily %}
    <form method="post" action="{{ path('account_family_invite') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
        <input type="hidden" name="role" value="child">
        <button type="submit" class="rounded-xl bg-slate-900 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-black">+ Пригласить ребёнка</button>
    </form>
    {% endif %}
</div>

{% if family is null %}

    {# ── Пустое состояние ── #}
    <div class="rounded-2xl bg-white px-4 py-12 text-center text-gray-500 shadow-sm">
        <div class="mb-4 text-5xl opacity-30">👨‍👩‍👧</div>
        <p class="mb-1 font-semibold text-gray-700">Добавьте членов семьи</p>
        <p class="mb-5 text-sm">У каждого свой гардероб, вещи можно передавать</p>
        {% if canManageFamily %}<div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <form method="post" action="{{ path('account_family_invite') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
                <input type="hidden" name="role" value="child">
                <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">+ Пригласить ребёнка</button>
            </form>
            <a href="{{ path('account_family_add') }}"
               class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">Профиль без входа</a>
            <form method="post" action="{{ path('account_family_invite') }}" class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
                <input type="email" name="email" autocomplete="email" placeholder="Email (необязательно)"
                       class="min-h-11 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                <select name="role"
                        class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                    <option value="parent">Родитель</option>
                    <option value="child">Ребёнок</option>
                </select>
                <button type="submit"
                        class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">Пригласить в семью</button>
            </form>
        </div>{% endif %}
    </div>

{% else %}

    {# ── Члены семьи ── #}
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
        {% for member in members %}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <div class="mb-2 flex items-start justify-between gap-2">
                <div class="text-sm font-semibold">{{ member.fullName }}</div>
                {% if member.familyRole == 'child' %}
                    <span class="rounded-full bg-sky-100 px-2.5 py-0.5 text-[11px] font-semibold text-sky-700">Ребёнок</span>
                {% elseif member.familyRole == 'adult' %}
                    <span class="rounded-full bg-violet-100 px-2.5 py-0.5 text-[11px] font-semibold text-violet-700">Взрослый</span>
                {% else %}
                    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-semibold text-gray-600">{{ family.owner.id == member.id ? 'Владелец' : 'Родитель' }}</span>
                {% endif %}
            </div>
            {% if itemCounts[member.id] is defined %}
                <div class="mb-3 text-xs text-gray-500">{{ itemCounts[member.id] }} вещей</div>
                <a href="{{ path('account_wardrobe_index', {member: member.id}) }}"
                   class="text-sm font-semibold underline decoration-gray-300 underline-offset-2 hover:decoration-gray-900">Гардероб →</a>
            {% endif %}

            {% if claimUrls[member.id] is defined %}
                <details class="mt-4 border-t border-gray-100 pt-3">
                    <summary class="cursor-pointer text-[11px] font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-900">Ссылка для входа ребёнка</summary>
                    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                        <input type="text" readonly id="claim-url-{{ member.id }}" value="{{ claimUrls[member.id] }}"
                               class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-600 focus:outline-none">
                        <button type="button" onclick="wbCopy(this, 'claim-url-{{ member.id }}')"
                                class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-600 transition hover:bg-gray-50">Скопировать</button>
                    </div>
                    <p class="mt-1.5 text-xs text-gray-400">Действует до {{ member.familyClaimExpiresAt|date('d.m.Y H:i') }}</p>
                    <div class="mt-2 flex gap-4">
                        <form method="post" action="{{ path('account_family_child_access_renew', {id: member.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('family_child_access_renew_' ~ member.id) }}">
                            <button type="submit" class="min-h-11 text-xs font-semibold text-gray-600">Новая ссылка</button>
                        </form>
                        <form method="post" action="{{ path('account_family_child_access_revoke', {id: member.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('family_child_access_revoke_' ~ member.id) }}">
                            <button type="submit" class="min-h-11 text-xs font-semibold text-red-600">Отозвать</button>
                        </form>
                    </div>
                </details>
            {% elseif canManageFamily and member.managed %}
                <form method="post" action="{{ path('account_family_child_access_renew', {id: member.id}) }}" class="mt-4 border-t border-gray-100 pt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('family_child_access_renew_' ~ member.id) }}">
                    <button type="submit" class="min-h-11 text-xs font-semibold text-gray-700">Создать ссылку для входа</button>
                </form>
            {% endif %}

            {% if member.canBecomeFamilyAdult and (member.id == app.user.id or canManageFamily) %}
                <form method="post" action="{{ path('account_family_member_adulthood', {id: member.id}) }}" class="mt-4 border-t border-gray-100 pt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('family_adulthood_' ~ member.id) }}">
                    <p class="mb-2 text-xs text-gray-500">После 18 лет профиль может стать самостоятельным. Вещи и история сохранятся.</p>
                    <button type="submit" class="min-h-11 text-xs font-semibold text-violet-700">Сделать профиль самостоятельным</button>
                </form>
            {% endif %}

            {% if isOwner and member.id != app.user.id %}
                <div class="mt-4 flex flex-wrap gap-4 border-t border-gray-100 pt-3">
                    {% if member.familyRole == 'parent' %}
                        <form method="post" action="{{ path('account_family_member_owner', {id: member.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('family_owner_' ~ member.id) }}">
                            <button type="submit" class="min-h-11 text-xs font-semibold text-gray-700">Передать права владельца</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('account_family_member_remove', {id: member.id}) }}" onsubmit="return confirm('Удалить участника из семьи? Его гардероб останется в личном профиле.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('family_remove_' ~ member.id) }}">
                        <button type="submit" class="min-h-11 text-xs font-semibold text-red-600">Удалить из семьи</button>
                    </form>
                </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {# ── Приглашения ── #}
    {% if canManageFamily %}<div class="rounded-2xl bg-white p-5 shadow-sm sm:p-6">
        <h2 class="mb-4 text-sm font-bold">Приглашения</h2>

        <form method="post" action="{{ path('account_family_invite') }}" class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
            <input type="email" name="email" autocomplete="email" placeholder="Email (необязательно)"
                   class="min-h-11 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
            <select name="role"
                    class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                <option value="parent">Родитель</option>
                <option value="child">Ребёнок</option>
            </select>
            <button type="submit"
                    class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Пригласить в семью</button>
        </form>

        {% if invites|length > 0 %}
            <div class="flex flex-col gap-3">
                {% for invite in invites %}
                <div class="rounded-xl border border-gray-100 p-4">
                    <div class="mb-2 flex items-center gap-2 text-xs text-gray-500">
                        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-semibold text-gray-600">{{ invite.role == 'child' ? 'Ребёнок' : 'Родитель' }}</span>
                        <span>от {{ invite.createdAt|date('d.m.Y') }}</span>
                        <span>до {{ invite.expiresAt|date('d.m.Y H:i') }}</span>
                    </div>
                    {% if invite.intendedEmail %}<p class="mb-2 text-xs text-gray-500">Для {{ invite.intendedEmail }}</p>{% endif %}
                    {% if inviteUrls[invite.id] is defined %}
                        <div class="flex flex-col gap-2 sm:flex-row">
                            <input type="text" readonly id="invite-url-{{ invite.id }}" value="{{ inviteUrls[invite.id] }}"
                                   class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-600 focus:outline-none">
                            <button type="button" onclick="wbCopy(this, 'invite-url-{{ invite.id }}')"
                                    class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-600 transition hover:bg-gray-50">Скопировать</button>
                        </div>
                    {% endif %}
                    <div class="mt-2 flex gap-4">
                        <form method="post" action="{{ path('account_family_invite_renew', {id: invite.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('family_invite_renew_' ~ invite.id) }}">
                            <button type="submit" class="min-h-11 text-xs font-semibold text-gray-600 hover:text-gray-900">Новая ссылка</button>
                        </form>
                        <form method="post" action="{{ path('account_family_invite_revoke', {id: invite.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('family_invite_revoke_' ~ invite.id) }}">
                            <button type="submit" class="min-h-11 text-xs font-semibold text-red-600 hover:text-red-800">Отозвать приглашение</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-sm text-gray-400">Активных приглашений нет</p>
        {% endif %}
    </div>{% endif %}

    {% if not isOwner %}
        <form method="post" action="{{ path('account_family_leave') }}" class="mt-4 text-center" onsubmit="return confirm('Выйти из семьи? Ваш гардероб останется у вас.')">
            <input type="hidden" name="_token" value="{{ csrf_token('family_leave') }}">
            <button type="submit" class="min-h-11 text-sm font-semibold text-red-600">Выйти из семьи</button>
        </form>
    {% endif %}

{% endif %}
{% endblock %}

{% block family_mobile_javascripts %}
<script>
function wbCopy(btn, inputId) {
    var input = document.getElementById(inputId);
    input.select();
    var done = function () {
        var original = btn.textContent;
        btn.textContent = 'Скопировано';
        setTimeout(function () { btn.textContent = original; }, 2000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(input.value).then(done);
    } else {
        document.execCommand('copy');
        done();
    }
}
</script>
{% endblock %}
