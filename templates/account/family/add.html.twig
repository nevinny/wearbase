{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block family_mobile_title %}Добавить ребёнка{% endblock %}

{% macro err(field) %}
    {% if field.vars.errors|length > 0 %}
        <div class="form-error mt-1 text-sm text-red-600">{{ form_errors(field) }}</div>
    {% endif %}
{% endmacro %}

{% block family_mobile_content %}
{% import _self as f %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}

<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('account_family_index') }}"
       class="flex min-h-11 items-center rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-600 transition hover:bg-gray-50">← Назад</a>
    <h1 class="text-xl font-black text-slate-950">Добавить ребёнка</h1>
</div>

{{ form_start(form) }}

<div class="mb-4 rounded-2xl bg-white p-5 shadow-sm sm:p-6">
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Имя <span class="text-red-600">*</span></label>
            {{ form_widget(form.firstName, {'attr': {'class': tw_input, 'placeholder': 'Имя ребёнка'}}) }}
            {{ f.err(form.firstName) }}
        </div>
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Дата рождения</label>
            {{ form_widget(form.birthDate, {'attr': {'class': tw_input}}) }}
            {{ f.err(form.birthDate) }}
        </div>
    </div>
    <p class="mt-3 text-xs text-gray-400">У ребёнка появится свой гардероб. Позже можно дать ему собственный доступ по ссылке.</p>
</div>

<div class="mt-6 flex flex-col gap-2 sm:flex-row">
    <button type="submit" class="min-h-11 rounded-xl bg-gray-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-black">Сохранить</button>
    <a href="{{ path('account_family_index') }}"
       class="min-h-11 rounded-xl border border-gray-300 px-5 py-2.5 text-center text-sm font-semibold text-gray-600 transition hover:bg-gray-50">Отмена</a>
</div>

{{ form_end(form) }}
{% endblock %}
