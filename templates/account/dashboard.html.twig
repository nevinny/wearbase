{% extends 'account/layout.html.twig' %}
{% block title %}Личный кабинет — WEARBASE{% endblock %}

{% block account_content %}
<h1 class="mb-5 text-lg font-bold">Добро пожаловать, {{ app.user.firstName ?: app.user.email }}!</h1>

{# Точка входа для брендов #}
{% if is_granted('ROLE_BRAND_MANAGER') %}
<div class="mb-5 flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-white p-5 shadow-sm">
    <div>
        <div class="font-semibold">Кабинет бренда</div>
        <div class="text-sm text-gray-500">Управляйте товарами, заказами, командой и тарифом.</div>
    </div>
    <a href="{{ path('brand_dashboard') }}"
       class="rounded-xl bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-black transition">Перейти в ЛК бренда →</a>
</div>
{% else %}
<div class="mb-5 flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-gray-100 p-5">
    <div>
        <div class="font-semibold">Представляете бренд?</div>
        <div class="text-sm text-gray-500">Найдите свой бренд в каталоге и нажмите «Я владелец», чтобы заявить права и получить кабинет.</div>
    </div>
    <a href="{{ path('brand_index') }}"
       class="rounded-xl border border-gray-900 px-4 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-900 hover:text-white transition">Найти свой бренд</a>
</div>
{% endif %}

<div class="mb-5 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl bg-white py-6 text-center shadow-sm">
        <div class="text-3xl font-bold">{{ stats.totalOrders }}</div>
        <div class="text-sm text-gray-500">Всего заказов</div>
    </div>
    <div class="rounded-2xl bg-white py-6 text-center shadow-sm">
        <div class="text-3xl font-bold">{{ stats.activeOrders }}</div>
        <div class="text-sm text-gray-500">Активных</div>
    </div>
    <div class="rounded-2xl bg-white py-6 text-center shadow-sm">
        <div class="text-3xl font-bold">{{ price(stats.totalSpent) }}</div>
        <div class="text-sm text-gray-500">Потрачено</div>
    </div>
</div>

{# Блок «Приглашай подруг» (спец §4): только покупателям; ссылка = последний активный токен лука #}
{% if is_granted('ROLE_CUSTOMER') and referral %}
<section class="mb-5 rounded-2xl bg-white p-5 shadow-sm">
    <h2 class="font-bold">Приглашай подруг</h2>
    <p class="mt-1 text-sm text-gray-500">Поделись ссылкой на свой лук: подруга зарегистрируется — вы обе получите бонус к AI-подсказкам.</p>

    <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <div>
            {% if referral.shareToken %}
            <label class="text-[11px] font-semibold uppercase tracking-wider text-gray-500" for="referral-link">Персональная ссылка</label>
            <input id="referral-link" readonly value="{{ url('look_shared_show', {token: referral.shareToken}) }}"
                   onclick="this.select()"
                   class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-500 focus:ring-2 focus:ring-gray-900" />
            {% else %}
            <div class="text-sm text-gray-600">
                Персональная ссылка появится, когда поделитесь первым луком.
                <a href="{{ path('account_wardrobe_outfits') }}" class="font-semibold text-gray-900 underline">Поделиться луком →</a>
            </div>
            {% endif %}
        </div>
        <div class="flex flex-col gap-2 text-sm">
            <div>Подруг приглашено: <span class="font-bold">{{ referral.invitedCount }}</span></div>
            {% if referral.dailyBonus > 0 %}
            <div>Бонус: <span class="font-bold">+{{ referral.dailyBonus }} подсказок/день</span>{% if referral.bonusUntil %} до {{ referral.bonusUntil|date('d.m.Y') }}{% endif %}</div>
            {% endif %}
            {% if referral.badgeNext %}
            <div class="text-gray-600">
                До бейджа «{{ referral.badgeNext.target }} подруг»: {{ referral.badgeNext.current }} из {{ referral.badgeNext.target }}
            </div>
            {% elseif referral.badgeEarned %}
            <div class="text-green-700 font-semibold">Все бейджи приглашающей получены</div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}


{% if recentOrders|length > 0 %}
<div class="overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3 text-sm font-semibold">
        Последние заказы
        <a href="{{ path('account_orders') }}"
           class="rounded-lg border border-gray-900 px-3 py-1.5 text-sm font-semibold text-gray-900 hover:bg-gray-900 hover:text-white transition">Все заказы</a>
    </div>
    <div class="divide-y divide-gray-100">
        {% for order in recentOrders %}
        {% set statusClasses = {
            'new': 'bg-gray-100 text-gray-700', 'shipped': 'bg-sky-100 text-sky-800',
            'delivered': 'bg-green-100 text-green-800', 'completed': 'bg-green-100 text-green-800',
            'cancelled': 'bg-red-100 text-red-800'
        } %}
        <a href="{{ path('account_order_show', {number: order.orderNumber}) }}"
           class="block px-5 py-4 hover:bg-gray-50 transition">
            <div class="flex items-start justify-between">
                <div>
                    <div class="text-sm font-semibold">#{{ order.orderNumber }}</div>
                    <div class="text-xs text-gray-500">{{ order.brand.title }} · {{ order.createdAt|date('d.m.Y') }}</div>
                </div>
                <div class="text-right">
                    <div class="text-sm font-semibold">{{ price(order.totalAmount) }}</div>
                    {% set statusLabels = order.getStatusLabels() %}
                    <span class="rounded px-2 py-0.5 text-xs font-semibold {{ statusClasses[order.status] ?? 'bg-indigo-100 text-indigo-800' }}">
                        {{ statusLabels[order.status] ?? order.status }}
                    </span>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
    <div class="mb-4 text-5xl opacity-30">📦</div>
    <p class="mb-4">У вас пока нет заказов</p>
    <a href="{{ path('catalog_index') }}"
       class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Перейти в каталог</a>
</div>
{% endif %}
{% endblock %}
