{% extends 'account/layout.html.twig' %}

{% block title %}Настройки уведомлений — WEARBASE{% endblock %}

{% block account_content %}
<h4 class="mb-2 text-lg font-bold">Настройки уведомлений</h4>
<p class="mb-4 text-sm text-gray-500">Выберите каналы, по которым вы хотите получать уведомления.</p>

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('notification_settings') }}">
    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                <tr>
                    <th class="w-2/5 px-5 py-3">Событие</th>
                    <th class="px-5 py-3 text-center">Email</th>
                    <th class="px-5 py-3 text-center">В приложении</th>
                    <th class="px-5 py-3 text-center">Telegram</th>
                    <th class="px-5 py-3 text-center">Push</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for eventType, label in eventTypes %}
                    {% set s = settings[eventType] ?? null %}
                    <tr>
                        <td class="px-5 py-3">{{ label }}</td>
                        {% for channel in channels %}
                            {% set checked = s ? attribute(s, 'channel' ~ channel|slice(7)) : false %}
                            <td class="px-5 py-3 text-center">
                                {% if channel != 'channelInapp' and eventType in inappOnlyTypes %}
                                    <span class="text-gray-300">—</span>
                                {% else %}
                                    <input type="hidden" name="settings[{{ eventType }}][{{ channel }}]" value="0">
                                    <input class="h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900" type="checkbox"
                                           name="settings[{{ eventType }}][{{ channel }}]" value="1"
                                           {{ checked ? 'checked' : '' }}>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <button type="submit" class="mt-4 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить настройки</button>
</form>

<section class="mt-6 rounded-2xl bg-white p-5 shadow-sm" data-web-push-settings
         data-public-key="{{ webPushPublicKey }}" data-csrf="{{ csrf_token('web_push_subscription') }}"
         data-subscribe-url="{{ path('account_notification_push_subscribe') }}">
    <h5 class="font-semibold">Push на этом устройстве</h5>
    <p class="mt-1 text-sm text-gray-500">Опционально. Разрешение браузера запрашивается только после нажатия.</p>
    <button type="button" data-web-push-enable class="mt-3 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Включить push</button>
    <p class="mt-2 text-sm" data-web-push-status aria-live="polite"></p>
    {% if pushSubscriptions %}
        <ul class="mt-4 space-y-2">
            {% for subscription in pushSubscriptions %}
                <li class="flex items-center justify-between text-sm" data-web-push-row>
                    <span>Подключённое устройство</span>
                    <button type="button" class="text-red-600" data-web-push-revoke
                            data-url="{{ path('account_notification_push_unsubscribe', {id: subscription.id}) }}">Отключить</button>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
<script src="/push-settings.js" defer></script>
{% endblock %}
