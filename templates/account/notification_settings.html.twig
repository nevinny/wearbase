{% extends 'account/layout.html.twig' %}

{% block title %}Настройки уведомлений — WEARBASE{% endblock %}

{% block account_content %}
<h4 class="mb-2 text-lg font-bold">Настройки уведомлений</h4>
<p class="mb-4 text-sm text-gray-500">Выберите каналы, по которым вы хотите получать уведомления.</p>

<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('notification_settings') }}">
    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">
                <tr>
                    <th class="w-2/5 px-5 py-3">Событие</th>
                    <th class="px-5 py-3 text-center">Email</th>
                    <th class="px-5 py-3 text-center">В приложении</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for eventType, label in eventTypes %}
                    {% set s = settings[eventType] ?? null %}
                    <tr>
                        <td class="px-5 py-3">{{ label }}</td>
                        {% for channel in channels %}
                            {% set checked = s ? attribute(s, 'channel' ~ channel|slice(7)) : false %}
                            <td class="px-5 py-3 text-center">
                                <input type="hidden" name="settings[{{ eventType }}][{{ channel }}]" value="0">
                                <input class="h-[18px] w-[18px] rounded border-gray-300 text-gray-900 focus:ring-gray-900" type="checkbox"
                                       name="settings[{{ eventType }}][{{ channel }}]" value="1"
                                       {{ checked ? 'checked' : '' }}>
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <button type="submit" class="mt-4 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить настройки</button>
</form>
{% endblock %}
