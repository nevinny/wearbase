{% extends 'account/layout.html.twig' %}
{% block title %}Адреса доставки — WEARBASE{% endblock %}

{% block account_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 fw-bold mb-0">Адреса доставки</h1>
    <a href="{{ path('account_address_new') }}" class="btn btn-dark">
        <i class="fas fa-plus me-1"></i>Добавить адрес
    </a>
</div>

{% if addresses|length == 0 %}
<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5 text-muted">
        <i class="fas fa-map-marker-alt fa-3x mb-3 opacity-25 d-block"></i>
        <p>Нет сохранённых адресов</p>
        <a href="{{ path('account_address_new') }}" class="btn btn-dark">Добавить адрес</a>
    </div>
</div>
{% else %}
<div class="row g-3">
    {% for address in addresses %}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100 {{ address.isDefault ? 'border-dark border' : '' }}">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        {% if address.label %}
                            <div class="fw-bold">{{ address.label }}</div>
                        {% endif %}
                        <div class="fw-semibold {{ address.label ? '' : 'mb-0' }}">{{ address.fullName }}</div>
                    </div>
                    {% if address.isDefault %}
                        <span class="badge bg-dark">По умолчанию</span>
                    {% endif %}
                </div>
                <div class="text-muted small mb-1">{{ address.phone }}</div>
                <div class="text-muted small">{{ address.fullAddress }}</div>

                <div class="d-flex gap-2 mt-3">
                    <a href="{{ path('account_address_edit', {id: address.id}) }}"
                       class="btn btn-sm btn-outline-secondary">Изменить</a>
                    {% if not address.isDefault %}
                    <form method="post" action="{{ path('account_address_default', {id: address.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('set_default_address') }}">
                        <button type="submit" class="btn btn-sm btn-outline-dark">По умолчанию</button>
                    </form>
                    <form method="post" action="{{ path('account_address_delete', {id: address.id}) }}"
                          onsubmit="return confirm('Удалить адрес?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_address') }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
