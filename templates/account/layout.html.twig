{% extends 'tailwind/app.html.twig' %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="grid gap-6 md:grid-cols-12">

        {# ── Боковое меню ── #}
        <div class="md:col-span-3 lg:col-span-2">
            <div class="rounded-2xl bg-white p-4 shadow-sm">
                {% set u = app.user %}
                <div class="mb-4 flex items-center gap-2 px-1">
                    {% if u.avatar %}
                        <img src="{{ vich_uploader_asset(u, 'avatarFile') }}"
                             class="h-9 w-9 shrink-0 rounded-full object-cover" alt="">
                    {% else %}
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gray-900 text-sm text-white">
                            {{ (u.firstName ?: u.email)|first|upper }}
                        </div>
                    {% endif %}
                    <div class="truncate text-sm font-semibold leading-tight">{{ u.fullName }}</div>
                </div>

                {% set route = app.request.attributes.get('_route') %}
                {% set nav_item = 'flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition' %}
                {% set nav_active = 'flex items-center justify-between rounded-lg px-3 py-2 text-sm bg-gray-900 text-white font-semibold' %}
                <nav class="account-nav flex flex-col gap-1">
                    <a class="{{ route == 'account_dashboard' ? nav_active : nav_item }}"
                       href="{{ path('account_dashboard') }}">Главная</a>
                    <a class="{{ route starts with 'account_notification' and route != 'account_notification_settings' ? nav_active : nav_item }}"
                       href="{{ path('account_notification_index') }}">
                        Уведомления
                        <span class="ml-2 rounded-full bg-red-600 px-1.5 text-[10px] font-semibold text-white" id="notification-count">{{ unreadCount|default(0) }}</span>
                    </a>
                    <a class="{{ route == 'account_notification_settings' ? nav_active : nav_item }}"
                       href="{{ path('account_notification_settings') }}">Настройки уведомлений</a>
                    <a class="{{ route starts with 'account_order' ? nav_active : nav_item }}"
                       href="{{ path('account_orders') }}">Мои заказы</a>
                    <a class="{{ route == 'account_favorites' ? nav_active : nav_item }}"
                       href="{{ path('account_favorites') }}">Избранное</a>
                    <a class="{{ route starts with 'account_address' ? nav_active : nav_item }}"
                       href="{{ path('account_addresses') }}">Адреса</a>
                    <a class="{{ route == 'account_profile' ? nav_active : nav_item }}"
                       href="{{ path('account_profile') }}">Профиль</a>
                    <a class="{{ route == 'account_security' ? nav_active : nav_item }}"
                       href="{{ path('account_security') }}">Безопасность</a>
                    <hr class="my-2 border-gray-100">
                    <a class="{{ nav_item }} text-gray-400" href="{{ path('app_logout') }}">Выйти</a>
                </nav>
            </div>
        </div>

        {# ── Основной контент ── #}
        <div class="md:col-span-9 lg:col-span-10">
            {# Флеши показываются глобально в tailwind/app.html.twig #}
            {% block account_content %}{% endblock %}
        </div>

    </div>
</div>
{% endblock %}
