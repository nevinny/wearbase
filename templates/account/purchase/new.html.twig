{% extends 'account/family_wardrobe/layout.html.twig' %}

{% block family_mobile_title %}Хочу купить{% endblock %}

{% block family_mobile_content %}
    <div class="flex items-center gap-3">
        <a href="{{ path('account_purchase_index') }}"
           class="flex min-h-11 items-center rounded-xl border border-slate-300 bg-white px-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
            ← Назад
        </a>
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-700">Новый запрос</p>
            <h1 class="mt-1 text-xl font-black text-slate-950">Хочу купить</h1>
        </div>
    </div>

    <p class="mt-4 text-sm leading-6 text-slate-600">
        Вставьте одну или несколько ссылок на товары из любого магазина и расскажите, почему выбрали эти вещи.
    </p>

    {{ form_start(form, {'attr': {'class': 'mt-5'}}) }}
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            {% if form_errors(form) %}
                <div class="mb-4 rounded-xl bg-rose-50 p-3 text-sm text-rose-700" role="alert">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="space-y-5">
                {% for field in form %}
                    {% if field.vars.name != '_token' %}
                        <div>
                            {{ form_label(field, null, {'label_attr': {'class': 'mb-1.5 block text-sm font-bold text-slate-800'}}) }}
                            {{ form_widget(field, {'attr': {
                                'class': 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base text-slate-950 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200'
                            }}) }}
                            {% if field.vars.help %}
                                <p class="mt-1.5 text-xs leading-5 text-slate-500">{{ field.vars.help|trans }}</p>
                            {% endif %}
                            <div class="mt-1 text-sm text-rose-600">{{ form_errors(field) }}</div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="mt-5 rounded-xl bg-indigo-50 p-3 text-xs leading-5 text-indigo-800">
                Магазин может быть любым: неизвестные ссылки сохраняются вручную и никогда не скачиваются автоматически.
                Если shared cart не поддерживается, вставьте отдельные ссылки — по одной на строку.
            </div>
        </div>

        <div class="sticky bottom-[calc(4.75rem+env(safe-area-inset-bottom,0px))] z-30 -mx-4 mt-6 border-t border-slate-200 bg-slate-50/95 px-4 py-3 backdrop-blur md:static md:mx-0 md:border-0 md:bg-transparent md:px-0">
            <button type="submit"
                    class="min-h-12 w-full rounded-xl bg-indigo-600 px-5 py-3 text-base font-bold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                Отправить родителю
            </button>
        </div>
    {{ form_end(form) }}
{% endblock %}
