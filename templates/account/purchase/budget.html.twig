{% extends 'account/family_wardrobe/layout.html.twig' %}

{% block family_mobile_title %}Бюджет покупок{% endblock %}

{% block family_mobile_content %}
    <div class="flex items-center gap-3">
        <a href="{{ path('account_purchase_index') }}"
           class="flex min-h-11 items-center rounded-xl border border-slate-300 bg-white px-3 text-sm font-semibold text-slate-600">← Назад</a>
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-700">Семейные покупки</p>
            <h1 class="text-xl font-black text-slate-950">Бюджет на месяц</h1>
        </div>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {% for item in summaries %}
            <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <p class="font-bold text-slate-950">{{ item.subject.fullName }}</p>
                {% if item.summary %}
                    <p class="mt-3 text-2xl font-black">{{ item.summary.remaining|number_format(2, ',', ' ') }} ₽</p>
                    <p class="mt-1 text-xs text-slate-500">
                        осталось из {{ item.summary.limit|number_format(2, ',', ' ') }} ₽ ·
                        одобрено {{ item.summary.approved|number_format(2, ',', ' ') }} ₽
                    </p>
                {% else %}
                    <p class="mt-3 text-sm text-slate-500">Лимит пока не установлен</p>
                {% endif %}
            </article>
        {% endfor %}
    </div>

    {{ form_start(form, {attr: {class: 'mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm'}}) }}
        <h2 class="text-lg font-black text-slate-950">Установить лимит</h2>
        {% for field in form %}
            {% if field.vars.name != '_token' %}
                <div class="mt-4">
                    {{ form_label(field, null, {label_attr: {class: 'mb-1.5 block text-sm font-bold text-slate-800'}}) }}
                    {{ form_widget(field, {attr: {class: 'min-h-12 w-full rounded-xl border border-slate-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-indigo-200'}}) }}
                    <div class="mt-1 text-sm text-rose-600">{{ form_errors(field) }}</div>
                </div>
            {% endif %}
        {% endfor %}
        <button type="submit" class="mt-5 min-h-12 w-full rounded-xl bg-indigo-600 px-5 py-3 font-bold text-white">Сохранить бюджет</button>
    {{ form_end(form) }}
{% endblock %}
