{% extends 'account/family_wardrobe/layout.html.twig' %}

{% block family_mobile_title %}Покупки{% endblock %}

{% block family_mobile_header_actions %}
    <div class="flex gap-2">
        {% if actor.familyParent %}
            <a href="{{ path('account_purchase_budget') }}"
               class="flex min-h-11 items-center rounded-xl border border-indigo-200 bg-white px-3 text-sm font-semibold text-indigo-700">Бюджет</a>
        {% endif %}
        <a href="{{ path('account_purchase_new') }}"
           class="flex min-h-11 items-center rounded-xl bg-indigo-600 px-3 text-sm font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
            + Запрос
        </a>
    </div>
{% endblock %}

{% block family_mobile_content %}
    {% set isParent = actor.familyParent %}
    {% set statusLabels = {
        draft: 'Черновик',
        pending: 'Ждёт решения',
        approved: 'Одобрено',
        rejected: 'Отклонено',
        partial: 'Частично'
    } %}
    {% set statusClasses = {
        draft: 'bg-slate-100 text-slate-600',
        pending: 'bg-amber-100 text-amber-800',
        approved: 'bg-emerald-100 text-emerald-800',
        rejected: 'bg-rose-100 text-rose-800',
        partial: 'bg-violet-100 text-violet-800'
    } %}

    <section aria-labelledby="purchase-list-title">
        <p class="text-sm font-semibold text-indigo-700">{{ isParent ? 'Запросы семьи' : 'Мои покупки' }}</p>
        <h1 id="purchase-list-title" class="mt-1 text-2xl font-black tracking-tight text-slate-950">
            {{ isParent ? 'Что хотят купить' : 'Хочу купить' }}
        </h1>
        <p class="mt-2 text-sm leading-6 text-slate-500">
            {{ isParent
                ? 'Откройте запрос, чтобы посмотреть ссылку и принять решение.'
                : 'Отправьте родителю ссылку на товар из любого магазина.' }}
        </p>
    </section>

    {% if isParent and budgetSummaries|length > 0 %}
        <section class="mt-5 grid gap-3 sm:grid-cols-2" aria-label="Бюджеты детей">
            {% for item in budgetSummaries %}
                {% if item.summary %}
                    <div class="rounded-2xl bg-indigo-50 p-4">
                        <p class="text-xs font-bold uppercase tracking-wider text-indigo-700">{{ item.subject.fullName }}</p>
                        <p class="mt-2 text-2xl font-black text-indigo-950">{{ item.summary.remaining|number_format(2, ',', ' ') }} ₽</p>
                        <p class="mt-1 text-xs text-indigo-700">из {{ item.summary.limit|number_format(2, ',', ' ') }} ₽ в этом месяце</p>
                    </div>
                {% endif %}
            {% endfor %}
        </section>
    {% endif %}

    {% if requests|length > 0 %}
        <div class="mt-6 grid gap-3">
            {% for purchaseRequest in requests %}
                <a href="{{ path('account_purchase_show', {id: purchaseRequest.id}) }}"
                   class="block rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-200 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate text-sm font-bold text-slate-950">
                                {% if isParent %}
                                    {{ purchaseRequest.subject.fullName }}
                                {% else %}
                                    Запрос на покупку
                                {% endif %}
                            </p>
                            <p class="mt-1 text-xs text-slate-500">{{ purchaseRequest.createdAt|date('d.m.Y, H:i') }}</p>
                        </div>
                        <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold {{ statusClasses[purchaseRequest.status]|default('bg-slate-100 text-slate-600') }}">
                            {{ statusLabels[purchaseRequest.status]|default(purchaseRequest.status) }}
                        </span>
                    </div>
                    <p class="mt-3 truncate text-sm text-indigo-700">{{ purchaseRequest.items|length }} {{ purchaseRequest.items|length == 1 ? 'вещь' : 'вещи' }} · {{ purchaseRequest.productUrl }}</p>
                    {% if purchaseRequest.estimatedPrice %}
                        <p class="mt-2 text-lg font-black text-slate-900">{{ purchaseRequest.estimatedPrice|number_format(2, ',', ' ') }} ₽</p>
                    {% endif %}
                    {% if purchaseRequest.comment %}
                        <p class="mt-2 line-clamp-2 text-sm leading-5 text-slate-600">{{ purchaseRequest.comment }}</p>
                    {% endif %}
                    <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
                        <span>Отправил(а): {{ purchaseRequest.createdBy.fullName }}</span>
                        <span class="text-lg" aria-hidden="true">›</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center">
            <div class="text-4xl" aria-hidden="true">🛍️</div>
            <p class="mt-3 font-bold text-slate-900">Запросов пока нет</p>
            <p class="mt-1 text-sm text-slate-500">
                {{ isParent ? 'Когда член семьи попросит что-то купить, запрос появится здесь.' : 'Вставьте ссылку на понравившуюся вещь.' }}
            </p>
            <a href="{{ path('account_purchase_new') }}"
               class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                Создать запрос
            </a>
        </div>
    {% endif %}
{% endblock %}
