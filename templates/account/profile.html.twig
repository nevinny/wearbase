{% extends 'account/layout.html.twig' %}
{% block title %}Профиль — WEARBASE{% endblock %}

{% block account_content %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}
{% set section = 'block text-xs font-bold uppercase tracking-wider text-gray-500 mb-3' %}

<h1 class="mb-5 text-lg font-bold">Профиль</h1>

<div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <div class="rounded-2xl bg-white p-6 shadow-sm">
            {{ form_start(form) }}

            {# Аватар #}
            <div class="mb-6 flex items-center gap-4 border-b border-gray-100 pb-6">
                {% set u = app.user %}
                {% if u.avatar %}
                    <img src="{{ vich_uploader_asset(u, 'avatarFile') }}"
                         class="h-16 w-16 shrink-0 rounded-full object-cover" alt="">
                {% else %}
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gray-900 text-2xl text-white">
                        {{ (u.firstName ?: u.email)|first|upper }}
                    </div>
                {% endif %}
                <div>
                    <div class="mb-1 text-sm font-semibold">Фото профиля</div>
                    {{ form_widget(form.avatarFile, {'attr': {'class': 'text-sm'}}) }}
                    <div class="form-error mt-1 text-sm text-red-600">{{ form_errors(form.avatarFile) }}</div>
                    <div class="text-xs text-gray-400">JPG, PNG — не более 2 МБ</div>
                </div>
            </div>

            <span class="{{ section }}">Фото для ИИ-примерки</span>
            <p class="mb-4 text-sm text-gray-500">Сохраним их в профиле: при создании новых образов загружать фотографии заново не придётся.</p>
            <div class="mb-4 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-gray-200 p-4">
                    <div class="mb-3 aspect-square overflow-hidden rounded-xl bg-gray-100">
                        {% if user.tryonSelfie %}
                            <img src="{{ path('account_tryon_photo', {id: user.id, kind: 'selfie'}) }}" class="h-full w-full object-cover" alt="Селфи для ИИ-примерки">
                        {% else %}
                            <div class="flex h-full items-center justify-center px-5 text-center text-sm text-gray-400">Лицо анфас, дневной свет, без фильтров</div>
                        {% endif %}
                    </div>
                    <div class="mb-2 text-sm font-semibold">Селфи</div>
                    {{ form_widget(form.tryonSelfieFile, {'attr': {'class': 'w-full text-xs', 'accept': 'image/jpeg,image/png,image/webp'}}) }}
                    <div class="mt-1 text-sm text-red-600">{{ form_errors(form.tryonSelfieFile) }}</div>
                </div>
                <div class="rounded-2xl border border-gray-200 p-4">
                    <div class="mb-3 aspect-[3/4] overflow-hidden rounded-xl bg-gray-100">
                        {% if user.tryonFullBodyPhoto %}
                            <img src="{{ path('account_tryon_photo', {id: user.id, kind: 'full-body'}) }}" class="h-full w-full object-contain" alt="Фото в полный рост для ИИ-примерки">
                        {% else %}
                            <div class="flex h-full items-center justify-center px-5 text-center text-sm text-gray-400">В полный рост, анфас, руки не закрывают корпус</div>
                        {% endif %}
                    </div>
                    <div class="mb-2 text-sm font-semibold">Фото в полный рост</div>
                    {{ form_widget(form.tryonFullBodyPhotoFile, {'attr': {'class': 'w-full text-xs', 'accept': 'image/jpeg,image/png,image/webp'}}) }}
                    <div class="mt-1 text-sm text-red-600">{{ form_errors(form.tryonFullBodyPhotoFile) }}</div>
                </div>
            </div>
            <label class="mb-6 flex items-start gap-3 rounded-xl bg-indigo-50 p-4 text-sm text-indigo-950">
                {{ form_widget(form.tryonPhotoConsent, {'attr': {'class': 'mt-0.5 h-4 w-4 rounded border-indigo-300'}}) }}
                <span>{{ form.tryonPhotoConsent.vars.label }}. Фото используются только в личной ИИ-примерочной и доступны вам и членам семьи с правом управления профилем.</span>
            </label>

            {# Личные данные #}
            <span class="{{ section }}">Личные данные</span>
            <div class="mb-6 grid gap-4 md:grid-cols-2">
                <div>
                    <label class="{{ tw_label }}">Имя</label>
                    {{ form_widget(form.firstName, {'attr': {'class': tw_input, 'placeholder': 'Иван'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>
                <div>
                    <label class="{{ tw_label }}">Фамилия</label>
                    {{ form_widget(form.lastName, {'attr': {'class': tw_input, 'placeholder': 'Иванов'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
                <div>
                    <label class="{{ tw_label }}">Email</label>
                    {{ form_widget(form.email, {'attr': {'class': tw_input}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div>
                    <label class="{{ tw_label }}">Телефон</label>
                    {{ form_widget(form.phone, {'attr': {'class': tw_input, 'placeholder': '+7 999 000 00 00'}}) }}
                    {{ form_errors(form.phone) }}
                </div>
            </div>

            {# Смена пароля #}
            <span class="{{ section }} border-t border-gray-100 pt-6">Смена пароля</span>
            <div class="mb-6 grid gap-4 md:grid-cols-2">
                <div>
                    <label class="{{ tw_label }}">Новый пароль</label>
                    {{ form_widget(form.newPassword, {'attr': {'class': tw_input, 'placeholder': 'Оставьте пустым, чтобы не менять'}}) }}
                    {{ form_errors(form.newPassword) }}
                </div>
            </div>

            <button type="submit" class="rounded-xl bg-gray-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить изменения</button>

            {{ form_end(form) }}
        </div>
    </div>

    <div class="flex flex-col gap-4">

        {# Telegram #}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <span class="{{ section }} mb-2">Telegram-уведомления</span>
            {% if app.user.telegramChatId %}
                <div class="flex items-center gap-2 text-sm font-semibold text-green-600">
                    ✈️ Подключён
                </div>
            {% else %}
                <p class="mb-3 text-sm text-gray-500">Получайте уведомления о заказах в Telegram.</p>
                <a href="https://t.me/wearbase_bot?start={{ app.user.id }}"
                   class="block w-full rounded-xl border border-gray-300 py-2 text-center text-sm font-semibold text-gray-600 hover:bg-gray-50 transition" target="_blank">
                    ✈️ Подключить Telegram
                </a>
            {% endif %}
        </div>

        {# Email статус #}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <span class="{{ section }} mb-2">Email</span>
            <div class="text-sm text-gray-500">{{ app.user.email }}</div>
            {% if not app.user.emailVerifiedAt %}
                <div class="mt-1 text-sm text-amber-600">⚠️ Не подтверждён</div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
