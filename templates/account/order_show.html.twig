{% extends 'account/layout.html.twig' %}
{% block title %}Заказ #{{ order.orderNumber }} — WEARBASE{% endblock %}

{% block account_content %}
<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('account_orders') }}"
       class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">← Назад</a>
    <h1 class="text-lg font-bold">Заказ #{{ order.orderNumber }}</h1>
</div>

{# Прогресс статуса #}
{% set statuses = ['new','confirmed','processing','shipped','delivered','completed'] %}
{% set statusLabels = order.getStatusLabels() %}
{% set currentIdx = 0 %}
{% for s in statuses %}{% if s == order.status %}{% set currentIdx = loop.index0 %}{% endif %}{% endfor %}
{% if order.status not in ['cancelled','returned','refunded'] %}
<div class="mb-5 rounded-2xl bg-white px-5 py-4 shadow-sm">
    <div class="relative flex justify-between">
        <div class="absolute inset-x-0 top-[14px] border-t border-gray-200"></div>
        {% for s in statuses %}
        {% set isPast = loop.index0 <= currentIdx %}
        {% set isActive = order.status == s %}
        <div class="relative z-10 flex-1 text-center">
            <div class="mx-auto mb-1 flex h-7 w-7 items-center justify-center rounded-full text-xs
                {{ isPast ? 'bg-gray-900 text-white' : 'border border-gray-200 bg-white' }}">
                {{ isPast ? '✓' : '' }}
            </div>
            <div class="text-[11px] {{ isActive ? 'font-semibold' : 'text-gray-500' }}">
                {{ statusLabels[s] ?? s }}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="mb-5 rounded-xl px-4 py-3 text-sm {{ order.status == 'cancelled' ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700' }}">
    Статус заказа: <strong>{{ statusLabels[order.status] ?? order.status }}</strong>
</div>
{% endif %}

<div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">

        {# Товары #}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">Товары</div>
            <div class="divide-y divide-gray-100">
                {% for item in order.orderItems %}
                <div class="px-5 py-4">
                    <div class="flex justify-between">
                        <div>
                            <div class="text-sm font-semibold">{{ item.productTitle }}</div>
                            <div class="text-xs text-gray-500">{{ item.variantTitle }}</div>
                            {% if item.sku %}
                                <div class="text-xs text-gray-500">Арт.: {{ item.sku }}</div>
                            {% endif %}
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-semibold">{{ price(item.total) }}</div>
                            <div class="text-xs text-gray-500">{{ price(item.price) }} × {{ item.qty }}</div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# История статусов #}
        {% if order.statusHistory|length > 0 %}
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            <div class="border-b border-gray-100 px-5 py-3 text-sm font-semibold">История статусов</div>
            <div class="divide-y divide-gray-100">
                {% for h in order.statusHistory|reverse %}
                <div class="px-5 py-2.5 text-sm">
                    <div class="flex justify-between">
                        <span>
                            {% if h.fromStatus %}
                                {{ statusLabels[h.fromStatus] ?? h.fromStatus }} →
                            {% endif %}
                            <strong>{{ statusLabels[h.toStatus] ?? h.toStatus }}</strong>
                            {% if h.comment %} — {{ h.comment }}{% endif %}
                        </span>
                        <span class="text-gray-400">{{ h.createdAt|date('d.m.Y H:i') }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>

    <div class="space-y-4">

        {# Итог #}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <h6 class="mb-3 font-bold">Итого</h6>
            <div class="mb-1 flex justify-between text-sm">
                <span class="text-gray-500">Товары</span>
                <span>{{ price(order.subtotal) }}</span>
            </div>
            <div class="mb-2 flex justify-between text-sm">
                <span class="text-gray-500">Доставка</span>
                <span>{{ order.shippingCost == '0' ? 'Бесплатно' : price(order.shippingCost) }}</span>
            </div>
            <hr class="my-3 border-gray-100">
            <div class="flex justify-between font-bold">
                <span>Итого</span>
                <span>{{ price(order.totalAmount) }}</span>
            </div>
        </div>

        {# Доставка #}
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <h6 class="mb-3 font-bold">Доставка</h6>
            {% set deliveryLabels = {
                'courier': 'Курьер',
                'cdek': 'СДЭК',
                'boxberry': 'Boxberry',
                'pochta': 'Почта России',
                'pickup': 'Самовывоз'
            } %}
            <div class="mb-2 text-sm">
                🚚 {{ deliveryLabels[order.deliveryMethod] ?? order.deliveryMethod }}
            </div>
            {% if order.trackingNumber %}
            <div class="text-sm">
                Трек: <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs">{{ order.trackingNumber }}</code>
                {% set trackingUrls = {
                    'cdek': 'https://www.cdek.ru/ru/tracking?order_id=%s',
                    'boxberry': 'https://boxberry.ru/tracking/?tracking_id=%s',
                    'pochta': 'https://www.pochta.ru/tracking#%s',
                } %}
                {% if trackingUrls[order.deliveryMethod] is defined %}
                · <a href="{{ trackingUrls[order.deliveryMethod]|replace({'%s': order.trackingNumber}) }}" target="_blank" class="underline">отследить</a>
                {% endif %}
            </div>
            {% endif %}
            <hr class="my-3 border-gray-100">
            <div class="text-sm">
                {% set addr = order.shippingAddress %}
                <div class="font-semibold">{{ addr.fullName }}</div>
                <div class="text-gray-500">{{ addr.phone }}</div>
                <div class="text-gray-500">{{ addr.zip ? addr.zip ~ ', ' : '' }}{{ addr.city }}, {{ addr.street }}, д. {{ addr.building }}{{ addr.apartment ? ', кв. ' ~ addr.apartment : '' }}</div>
            </div>
        </div>

        {# Оплата #}
        <div class="rounded-2xl bg-white p-5 text-sm shadow-sm">
            <h6 class="mb-2 font-bold">Оплата</h6>
            {% set payLabels = {'card_online': 'Карта онлайн', 'sbp': 'СБП', 'upon_receipt': 'При получении'} %}
            {{ payLabels[order.paymentMethod] ?? order.paymentMethod }}
        </div>

        {# Отмена #}
        {% if order.canBeCancelledByCustomer() %}
        <form method="post" action="{{ path('account_order_cancel', {number: order.orderNumber}) }}"
              onsubmit="return confirm('Отменить заказ?')">
            <input type="hidden" name="_token" value="{{ csrf_token('cancel_order') }}">
            <button type="submit"
                    class="w-full rounded-xl border border-red-300 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition">
                ✕ Отменить заказ
            </button>
        </form>
        {% endif %}

    </div>
</div>
{% endblock %}
