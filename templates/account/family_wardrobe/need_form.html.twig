{% extends 'account/family_wardrobe/layout.html.twig' %}

{% block family_mobile_title %}{{ need ? 'Изменить потребность' : 'Запланировать покупку' }}{% endblock %}

{% block family_mobile_content %}
    <a href="{{ path('account_family_matrix', returnSeason ? {season: returnSeason} : {}) }}" class="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-slate-600 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-600">← К матрице</a>
    <h1 class="mt-4 text-2xl font-bold text-slate-950">{{ need ? 'Изменить потребность' : 'Запланировать покупку' }}</h1>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-slate-600">Укажите, что нужно ребёнку. Конкретный товар можно выбрать позже.</p>

    {{ form_start(form, {'attr': {'class': 'mt-5'}}) }}
        <input type="hidden" name="returnSeason" value="{{ returnSeason }}">
        <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-5">
            {% if form_errors(form) %}<div class="rounded-xl bg-rose-50 p-3 text-sm text-rose-700" role="alert">{{ form_errors(form) }}</div>{% endif %}
            {% for field in form %}
                {% if field.vars.name != '_token' %}
                    <div>
                        {{ form_label(field, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-800'}}) }}
                        {{ form_widget(field, {'attr': {'class': 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-base text-slate-950 focus:outline-none focus:ring-2 focus:ring-indigo-600'}}) }}
                        {% if field.vars.help %}<p class="mt-2 text-sm text-slate-600">{{ field.vars.help|trans }}</p>{% endif %}
                        <div class="mt-1 text-sm text-rose-700">{{ form_errors(field) }}</div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
            <button type="submit" class="min-h-12 rounded-xl bg-indigo-600 px-5 py-3 text-base font-semibold text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">Сохранить потребность</button>
            <a href="{{ path('account_family_matrix', returnSeason ? {season: returnSeason} : {}) }}" class="inline-flex min-h-12 items-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-600">Отмена</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
