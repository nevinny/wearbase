{% extends 'account/family_wardrobe/layout.html.twig' %}

{% block family_mobile_title %}Гардеробы{% endblock %}

{% block family_mobile_header_actions %}
    {% set headerMemberParam = currentMember is defined and currentMember.id != app.user.id ? {member: currentMember.id} : {} %}
    <a href="{{ path('account_wardrobe_new', headerMemberParam) }}"
       class="flex min-h-11 items-center rounded-xl bg-indigo-600 px-3 text-sm font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
        + Вещь
    </a>
{% endblock %}

{% block family_mobile_content %}
{% if onboarding.completed %}<section class="mb-5 overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-600 p-5 text-white shadow-lg" data-testid="wear-loop-card">
    <div class="flex items-start justify-between gap-4">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-100">Сегодня</p>
            <h2 class="mt-1 text-xl font-black">Снять образ за минуту</h2>
            <p class="mt-2 text-sm text-indigo-100">AI найдёт вещи на фото, а ты только подтвердишь.</p>
        </div>
        {% if engagement.streak > 0 %}<span class="shrink-0 rounded-full bg-white/15 px-3 py-2 text-xs font-bold">🔥 {{ engagement.streak }}</span>{% endif %}
    </div>
    <a href="{{ familyCaptureUrl }}" class="mt-4 flex min-h-12 items-center justify-center rounded-xl bg-white px-5 text-sm font-black text-indigo-700">📸 Что на мне сегодня</a>
    {% if engagement.earned %}
        <div class="mt-4 flex gap-2 overflow-x-auto">
            {% for badge in engagement.earned %}<span class="whitespace-nowrap rounded-full bg-white/15 px-3 py-2 text-xs font-semibold">{{ badge.icon }} {{ badge.title }}</span>{% endfor %}
        </div>
    {% elseif engagement.next %}
        <p class="mt-3 text-xs text-indigo-100">Следующая коллекция: {{ engagement.next.title }} · {{ engagement.next.current }}/{{ engagement.next.target }}</p>
    {% endif %}
</section>{% endif %}
    {% set memberParam = currentMember.id == app.user.id ? {} : {member: currentMember.id} %}
    <section aria-labelledby="wardrobe-app-title">
        <p class="text-sm font-semibold text-indigo-700">Личный и семейный гардероб</p>
        <h1 id="wardrobe-app-title" class="mt-1 text-2xl font-black tracking-tight text-slate-950">Что хотите сделать?</h1>

        <div class="mt-5 grid grid-cols-2 gap-3">
            {% if app.user.familyRole == 'child' %}
            <a href="{{ path('account_purchase_new') }}"
               class="rounded-2xl bg-rose-500 p-4 text-white shadow-sm transition hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">♡</span>
                <span class="mt-5 block text-sm font-bold">Хочу купить</span>
                <span class="mt-1 block text-xs text-rose-100">Отправить ссылку родителю</span>
            </a>
            {% else %}
            <a href="{{ path('account_purchase_index') }}"
               class="rounded-2xl bg-rose-500 p-4 text-white shadow-sm transition hover:bg-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">♡</span>
                <span class="mt-5 block text-sm font-bold">Запросы покупок</span>
                <span class="mt-1 block text-xs text-rose-100">
                    {{ pendingPurchaseCount > 0 ? pendingPurchaseCount ~ ' ждут решения' : 'Решения для детей' }}
                </span>
            </a>
            {% endif %}
            <a href="{{ path('account_wardrobe_new', memberParam) }}"
               class="rounded-2xl bg-indigo-600 p-4 text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">＋</span>
                <span class="mt-5 block text-sm font-bold">Добавить вещь</span>
                <span class="mt-1 block text-xs text-indigo-100">Фото и карточка вещи</span>
            </a>
            <a href="{{ path('account_wardrobe_outfits', memberParam) }}"
               class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 shadow-sm transition hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">✦</span>
                <span class="mt-5 block text-sm font-bold">Собрать образ</span>
                <span class="mt-1 block text-xs text-slate-500">Из вещей гардероба</span>
            </a>
            <a href="{{ path('account_wardrobe_statistics', memberParam) }}"
               class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 shadow-sm transition hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">↗</span>
                <span class="mt-5 block text-sm font-bold">Статистика</span>
                <span class="mt-1 block text-xs text-slate-500">Состав и ценность вещей</span>
            </a>
            <a href="#family-members"
               class="rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 shadow-sm transition hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                <span class="block text-2xl" aria-hidden="true">⌂</span>
                <span class="mt-5 block text-sm font-bold">Моя семья</span>
                <span class="mt-1 block text-xs text-slate-500">Все участники семьи</span>
            </a>
        </div>
    </section>

    {% if not onboarding.completed %}
        <section class="mt-5 rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-700 p-5 text-white shadow-lg" aria-labelledby="wardrobe-onboarding-title">
            {% if onboarding.skipped %}
                <p class="text-xs font-bold uppercase tracking-wider text-indigo-100">Можно продолжить позже</p>
                <h2 id="wardrobe-onboarding-title" class="mt-2 text-xl font-black">Настроить гардероб {{ currentMember.id == app.user.id ? '' : currentMember.firstName }}</h2>
                <p class="mt-2 text-sm text-indigo-100">Стилист уже знает {{ onboarding.itemCount }} вещей. Продолжим с сохранённого места.</p>
                <form method="post" action="{{ path('account_wardrobe_app_onboarding') }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_onboarding_' ~ currentMember.id) }}">
                    <input type="hidden" name="member" value="{{ currentMember.id }}">
                    <input type="hidden" name="action" value="resume">
                    <button class="min-h-12 w-full rounded-xl bg-white px-4 py-3 text-sm font-bold text-indigo-700">Продолжить настройку</button>
                </form>
            {% elseif onboarding.nextAction in ['resume_batch', 'review_batch'] %}
                {% set batchCounts = onboarding.batchCounts %}
                <p class="text-xs font-bold uppercase tracking-wider text-indigo-100">Первая мини-капсула</p>
                <h2 id="wardrobe-onboarding-title" class="mt-2 text-xl font-black">{{ batchCounts.pending > 0 ? 'Фото распознаются' : 'Проверьте вещи' }}</h2>
                <p class="mt-2 text-sm text-indigo-100">{{ batchCounts.total }} в работе · {{ onboarding.itemCount }} уже в гардеробе</p>
                <a href="{{ path('account_wardrobe_ingest_review', {batch: onboarding.activeBatchId}|merge(memberParam)) }}"
                   class="mt-4 flex min-h-12 items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-bold text-indigo-700">Открыть загрузку</a>
            {% elseif onboarding.nextAction == 'create_outfit' %}
                <p class="text-xs font-bold uppercase tracking-wider text-indigo-100">Вещи готовы</p>
                <h2 id="wardrobe-onboarding-title" class="mt-2 text-xl font-black">Соберите первый образ</h2>
                <p class="mt-2 text-sm text-indigo-100">AI-стилист использует только {{ onboarding.itemCount }} подтверждённых вещей.</p>
                <a href="{{ path('account_wardrobe_outfits', memberParam) }}"
                   class="mt-4 flex min-h-12 items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-bold text-indigo-700">Собрать образ</a>
            {% else %}
                <p class="text-xs font-bold uppercase tracking-wider text-indigo-100">Начнём без длинной анкеты</p>
                <h2 id="wardrobe-onboarding-title" class="mt-2 text-xl font-black">Добавьте первые 5 вещей</h2>
                <p class="mt-2 text-sm text-indigo-100">Сфотографируйте несколько вещей пачкой — AI заполнит черновики, а вы только проверите.</p>
                <div class="mt-4 grid gap-2 sm:grid-cols-2">
                    <a href="{{ path('account_wardrobe_index', memberParam) }}#wardrobe-ingest-panel"
                       class="flex min-h-12 items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-bold text-indigo-700">Загрузить пачкой</a>
                    <a href="{{ path('account_wardrobe_new', memberParam) }}"
                       class="flex min-h-12 items-center justify-center rounded-xl border border-white/40 px-4 py-3 text-sm font-bold text-white">Добавить одну</a>
                </div>
                <form method="post" action="{{ path('account_wardrobe_app_onboarding') }}" class="mt-3 text-center">
                    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_onboarding_' ~ currentMember.id) }}">
                    <input type="hidden" name="member" value="{{ currentMember.id }}">
                    <input type="hidden" name="action" value="skip">
                    <button class="min-h-11 px-4 text-sm font-semibold text-indigo-100 underline-offset-4 hover:underline">Настроить позже</button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    <section id="family-members" class="mt-8" aria-labelledby="family-members-title">
        <div class="flex items-end justify-between gap-3">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Личный и семейный гардероб</p>
                <h2 id="family-members-title" class="mt-1 text-xl font-black text-slate-950">Состав семьи</h2>
            </div>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {% for familyMember in familyMembers %}
                {% set cardContent %}
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full {{ familyMember.isOwn ? 'bg-indigo-100 text-indigo-700' : 'bg-sky-100 text-sky-700' }} text-lg font-black">
                        {{ (familyMember.member.firstName ?: familyMember.member.email)|first|upper }}
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-bold text-slate-950">{{ familyMember.isOwn ? 'Мой гардероб' : familyMember.member.fullName }}</span>
                        <span class="mt-1 block text-xs font-semibold text-slate-500">{{ familyMember.member.familyRole == 'child' ? 'Ребёнок' : 'Родитель' }}</span>
                        {% if familyMember.canManage %}
                            <span class="mt-1 block text-sm text-slate-500">{{ familyMember.itemCount }} вещей</span>
                        {% endif %}
                    </span>
                    {% if familyMember.canManage %}<span class="text-xl text-slate-400" aria-hidden="true">›</span>{% endif %}
                {% endset %}

                {% if familyMember.canManage %}
                    <a href="{{ path('account_wardrobe_app', {member: familyMember.member.id}) }}"
                       class="flex min-h-24 items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-200 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                        {{ cardContent }}
                    </a>
                {% else %}
                    <div class="flex min-h-24 items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                        {{ cardContent }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% if canManageFamily %}
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <form method="post" action="{{ path('account_family_invite') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
                    <input type="hidden" name="role" value="child">
                    <button type="submit" class="min-h-12 w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-black focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                        Пригласить ребёнка
                    </button>
                </form>
                <form method="post" action="{{ path('account_family_invite') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('family_invite') }}">
                    <input type="hidden" name="role" value="parent">
                    <button type="submit"
                            class="min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
                        Пригласить взрослого
                    </button>
                </form>
            </div>
        {% elseif app.user.familyRole == 'child' %}
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <a href="{{ path('account_family_profile') }}"
                   class="flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-800">
                    Заполнить мою анкету
                </a>
                <button type="button" id="share-wardrobe-app"
                        data-share-url="{{ url('landing_wardrobe', {_locale: 'ru'}) }}"
                        class="min-h-12 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-800">
                    Поделиться с друзьями
                </button>
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block family_mobile_javascripts %}
<script>
(function () {
    var button = document.getElementById('share-wardrobe-app');
    if (!button) return;

    button.addEventListener('click', function () {
        var url = button.dataset.shareUrl;
        var done = function () {
            button.textContent = 'Ссылка скопирована';
            setTimeout(function () { button.textContent = 'Поделиться с друзьями'; }, 2000);
        };

        if (navigator.share) {
            navigator.share({title: 'WEARBASE Гардероб', text: 'Попробуй цифровой гардероб', url: url}).catch(function () {});
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done);
        }
    });
})();
</script>
{% endblock %}
