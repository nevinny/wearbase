{% extends 'account/layout.html.twig' %}
{% block title %}{{ title }} — WEARBASE{% endblock %}

{% block account_content %}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('account_addresses') }}" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Назад
    </a>
    <h1 class="h5 fw-bold mb-0">{{ title }}</h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        {{ form_start(form) }}

        <div class="row g-3">
            <div class="col-12">
                <label class="label-caps">Название адреса <span class="text-muted fw-normal">(необязательно)</span></label>
                {{ form_widget(form.label, {'attr': {'class': 'form-control', 'placeholder': 'Например: Дом, Работа'}}) }}
                {{ form_errors(form.label) }}
            </div>

            <div class="col-md-6">
                <label class="label-caps">Получатель <span class="text-danger">*</span></label>
                {{ form_widget(form.fullName, {'attr': {'class': 'form-control', 'placeholder': 'Имя Фамилия'}}) }}
                {{ form_errors(form.fullName) }}
            </div>
            <div class="col-md-6">
                <label class="label-caps">Телефон <span class="text-danger">*</span></label>
                {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': '+7 999 000 00 00'}}) }}
                {{ form_errors(form.phone) }}
            </div>

            <div class="col-md-8">
                <label class="label-caps">Город <span class="text-danger">*</span></label>
                {{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': 'Москва'}}) }}
                {{ form_errors(form.city) }}
            </div>
            <div class="col-md-4">
                <label class="label-caps">Индекс</label>
                {{ form_widget(form.zip, {'attr': {'class': 'form-control', 'placeholder': '123456'}}) }}
                {{ form_errors(form.zip) }}
            </div>

            <div class="col-12">
                <label class="label-caps">Улица <span class="text-danger">*</span></label>
                {{ form_widget(form.street, {'attr': {'class': 'form-control', 'placeholder': 'ул. Ленина'}}) }}
                {{ form_errors(form.street) }}
            </div>

            <div class="col-4">
                <label class="label-caps">Дом</label>
                {{ form_widget(form.building, {'attr': {'class': 'form-control', 'placeholder': '42'}}) }}
                {{ form_errors(form.building) }}
            </div>
            <div class="col-4">
                <label class="label-caps">Квартира</label>
                {{ form_widget(form.apartment, {'attr': {'class': 'form-control', 'placeholder': '15'}}) }}
                {{ form_errors(form.apartment) }}
            </div>

            <div class="col-12">
                <div class="form-check d-flex align-items-center gap-2" style="padding-left:0">
                    {{ form_widget(form.isDefault, {'attr': {'class': 'form-check-input m-0', 'style': 'width:18px;height:18px'}}) }}
                    <label class="form-check-label small">Использовать по умолчанию</label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark px-4">Сохранить</button>
            <a href="{{ path('account_addresses') }}" class="btn btn-outline-secondary">Отмена</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
