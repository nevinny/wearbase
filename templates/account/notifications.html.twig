{% extends 'account/layout.html.twig' %}

{% block title %}Уведомления — WEARBASE{% endblock %}

{% block account_content %}
<div class="mb-4 flex items-center justify-between">
    <h4 class="text-lg font-bold">Уведомления</h4>
    {% if unreadCount > 0 %}
        <form method="post" action="{{ path('account_notification_mark_all_read') }}" class="m-0">
            <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_all_read') }}">
            <button class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Прочитать все</button>
        </form>
    {% endif %}
</div>

{% if notifications|length == 0 %}
    <div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
        <div class="mb-4 text-5xl opacity-30">🔕</div>
        <p>У вас пока нет уведомлений</p>
    </div>
{% else %}
    <div class="divide-y divide-gray-100 overflow-hidden rounded-2xl bg-white shadow-sm">
        {% for notification in notifications %}
            <div class="flex gap-3 px-5 py-4 {{ not notification.isRead ? 'border-l-4 border-indigo-500 font-semibold' : '' }}">
                <div class="flex-1">
                    <div class="flex justify-between">
                        <span class="text-sm">{{ notification.title }}</span>
                        <small class="text-xs text-gray-400">{{ notification.createdAt|date('d.m.Y H:i') }}</small>
                    </div>
                    {% if notification.body %}
                        <p class="mb-0 mt-1 text-sm font-normal text-gray-500">{{ notification.body }}</p>
                    {% endif %}
                    {% if notification.safeAccountUrl %}
                        <a href="{{ notification.safeAccountUrl }}"
                           class="mt-2 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-800">Открыть →</a>
                    {% endif %}
                </div>
                {% if not notification.isRead %}
                    <form method="post" action="{{ path('account_notification_mark_read', {id: notification.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('notification_mark_read_' ~ notification.id) }}">
                        <button class="whitespace-nowrap text-sm text-gray-400 hover:text-gray-700" title="Отметить прочитанным">✓</button>
                    </form>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
