{% extends 'account/layout.html.twig' %}

{% block title %}Безопасность — WEARBASE{% endblock %}

{% block account_content %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}

<h4 class="mb-4 text-lg font-bold">Безопасность</h4>

<form method="post" class="rounded-2xl bg-white p-6 shadow-sm">
    <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label class="{{ tw_label }}">Текущий пароль</label>
            <input type="password" name="current_password" class="{{ tw_input }}" required>
        </div>

        <div>
            <label class="{{ tw_label }}">Новый пароль</label>
            <input type="password" name="new_password" class="{{ tw_input }}" required minlength="6">
        </div>
    </div>

    <hr class="my-6 border-gray-100">
    <h5 class="mb-1 font-semibold">Telegram-уведомления</h5>
    <p class="mb-3 text-sm text-gray-500">
        Получайте уведомления о заказах и других событиях в Telegram.
    </p>
    {% if user.telegramChatId %}
        <span class="inline-block rounded bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Telegram подключён</span>
        <p class="mt-2 text-sm text-gray-500">Chat ID: {{ user.telegramChatId }}</p>
        <input type="hidden" name="telegram_chat_id" value="{{ user.telegramChatId }}">
    {% elseif telegramLink %}
        <a href="{{ telegramLink }}" target="_blank"
           class="inline-block rounded-xl border border-sky-500 px-4 py-2 text-sm font-semibold text-sky-600 hover:bg-sky-50 transition">
            ✈️ Привязать Telegram
        </a>
        <p class="mt-2 text-sm text-gray-500">Ссылка действительна однократно. После отправки сообщения боту вернитесь на эту страницу.</p>
    {% endif %}

    <div class="mt-6">
        <button type="submit" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить</button>
    </div>
</form>
{% endblock %}
