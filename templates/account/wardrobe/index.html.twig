{% extends 'account/layout.html.twig' %}
{% block title %}Мой гардероб — WEARBASE{% endblock %}

{% block account_content %}
{# Гварды на переходный момент: контроллер может ещё не передавать family-переменные #}
{% set hasFamily = members is defined and currentMember is defined %}
{% set ownWardrobe = isOwnWardrobe is defined ? isOwnWardrobe : true %}
{% set memberParam = hasFamily ? {member: currentMember.id} : {} %}
{% set activeQuery = memberParam|merge(activeFilters) %}
{% if isArchiveView %}{% set activeQuery = activeQuery|merge({view: 'archive'}) %}{% endif %}
{% set seasonLabels = {'all': 'Всесезон', 'spring': 'Весна', 'summer': 'Лето', 'autumn': 'Осень', 'winter': 'Зима'} %}

<div class="mb-5 flex items-center justify-between">
    <h1 class="text-lg font-bold">
        {% if hasFamily and not ownWardrobe %}Гардероб: {{ currentMember.fullName }}{% else %}Мой гардероб{% endif %}
    </h1>
    <div class="flex items-center gap-2">
        <button type="button" id="wardrobe-ingest-toggle"
                class="rounded-xl border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">Загрузить пачкой</button>
        <a href="{{ path('account_wardrobe_new', memberParam) }}"
           class="rounded-xl bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-black transition">+ Добавить вещь</a>
    </div>
</div>

<div class="mb-6 flex gap-2">
    <a href="{{ path('account_wardrobe_index', memberParam|merge(activeFilters)) }}"
       class="rounded-full px-4 py-2 text-xs font-semibold {{ not isArchiveView ? 'bg-gray-900 text-white' : 'bg-white text-gray-600' }}">Вещи</a>
    <a href="{{ path('account_wardrobe_index', memberParam|merge(activeFilters)|merge({view: 'archive'})) }}"
       class="rounded-full px-4 py-2 text-xs font-semibold {{ isArchiveView ? 'bg-gray-900 text-white' : 'bg-white text-gray-600' }}">Архив</a>
    <a href="{{ path('account_wardrobe_statistics', memberParam) }}"
       class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-gray-600">Статистика</a>
</div>

{# ── Пакетная загрузка фото (сворачиваемая панель) ── #}
<div id="wardrobe-ingest-panel"
     class="mb-6 hidden rounded-2xl bg-white p-6 shadow-sm"
     data-csrf="{{ csrf_token('wardrobe_ingest') }}"
     data-upload-url="{{ path('account_wardrobe_ingest_upload') }}">
    <h2 class="mb-3 text-sm font-bold">Загрузить фото вещей</h2>
    <div id="ingest-panel-upload-area"
         class="cursor-pointer rounded-xl border-2 border-dashed border-gray-300 px-3 py-12 text-center text-gray-500 transition">
        <div class="mb-2 text-3xl">☁️</div>
        <div>Перетащите фото или <span class="font-semibold text-gray-900">выберите файлы</span></div>
        <div class="text-xs">JPG, PNG, WebP — можно сразу несколько</div>
        <input type="file" id="ingest-panel-file-input" multiple accept="image/*" class="hidden">
    </div>
    <div id="ingest-panel-progress" class="mt-3 hidden">
        <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100">
            <div id="ingest-panel-progress-bar" class="h-full bg-gray-900 transition-all" style="width:0%"></div>
        </div>
    </div>
    <div id="ingest-panel-error" class="form-error mt-2 hidden text-sm text-red-600"></div>
</div>

{# ── Члены семьи ── #}
{% if hasFamily and members|length > 1 %}
    <div class="mb-6 flex flex-wrap gap-2">
        {% for m in members %}
            <a href="{{ path('account_wardrobe_index', {member: m.id}) }}"
               class="rounded-full px-3.5 py-1.5 text-xs font-semibold shadow-sm transition {{ currentMember.id == m.id ? 'bg-gray-900 text-white' : 'bg-white text-gray-600 hover:text-gray-900' }}">
                {{ m.firstName ?: m.fullName }}
            </a>
        {% endfor %}
    </div>
{% endif %}

{# ── Поиск и фильтры ── #}
<form method="get" action="{{ path('account_wardrobe_index') }}" class="mb-6 rounded-2xl bg-white p-4 shadow-sm">
    {% if hasFamily %}<input type="hidden" name="member" value="{{ currentMember.id }}">{% endif %}
    {% if isArchiveView %}<input type="hidden" name="view" value="archive">{% endif %}
    <div class="grid gap-3 md:grid-cols-12">
        <div class="md:col-span-4">
            <label for="wardrobe-filter-q" class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Поиск</label>
            <input id="wardrobe-filter-q" type="search" name="q" value="{{ filters.q }}"
                   placeholder="Название, бренд или № вещи"
                   class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>
        <div class="md:col-span-2">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Категория</label>
            <select name="category" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Все</option>
                {% for value in filterOptions.categories %}<option value="{{ value }}" {{ filters.category == value ? 'selected' }}>{{ value }}</option>{% endfor %}
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Бренд</label>
            <select name="brand" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Все</option>
                {% for value in filterOptions.brands %}<option value="{{ value }}" {{ filters.brand == value ? 'selected' }}>{{ value }}</option>{% endfor %}
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Цвет</label>
            <select name="color" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Все</option>
                {% for value in filterOptions.colors %}<option value="{{ value }}" {{ filters.color == value ? 'selected' }}>{{ value }}</option>{% endfor %}
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Размер</label>
            <select name="size" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Все</option>
                {% for value in filterOptions.sizes %}<option value="{{ value }}" {{ filters.size == value ? 'selected' }}>{{ value }}</option>{% endfor %}
            </select>
        </div>
        <div class="md:col-span-3">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Сезон</label>
            <select name="season" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Все сезоны</option>
                {% for value in filterOptions.seasons %}<option value="{{ value }}" {{ filters.season == value ? 'selected' }}>{{ seasonLabels[value] ?? value }}</option>{% endfor %}
            </select>
        </div>
        <div class="md:col-span-3">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Заполнение</label>
            <select name="completion" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Любое</option>
                {% for value, label in constant('App\\Entity\\WardrobeItem::COMPLETION_LABELS') %}
                    <option value="{{ value }}" {{ filters.completion == value ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="md:col-span-3">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Состояние</label>
            <select name="status" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Любое</option>
                {% for value, label in constant('App\\Entity\\WardrobeItem::ITEM_LABELS') %}
                    {% if (isArchiveView and value == 'archived') or (not isArchiveView and value != 'archived') %}
                        <option value="{{ value }}" {{ filters.status == value ? 'selected' }}>{{ label }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
        {% if not isArchiveView %}
        <div class="md:col-span-3">
            <label class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-gray-500">Статус носки</label>
            <select name="wear" class="w-full rounded-lg border border-gray-200 px-2 py-2.5 text-sm">
                <option value="">Любой</option>
                {% for value, label in constant('App\\Entity\\WardrobeItem::WEAR_LABELS') %}
                    {% if value != 'given_away' %}<option value="{{ value }}" {{ filters.wear == value ? 'selected' }}>{{ label }}</option>{% endif %}
                {% endfor %}
            </select>
        </div>
        {% endif %}
        <div class="flex items-end gap-2 md:col-span-6">
            <button type="submit" class="rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black">Найти</button>
            {% if hasFilters %}
                <a href="{{ path('account_wardrobe_index', memberParam|merge(isArchiveView ? {view: 'archive'} : {})) }}"
                   class="rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50">Сбросить</a>
            {% endif %}
        </div>
    </div>
</form>

{% if items|length == 0 %}
    <div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
        <div class="mb-4 text-5xl opacity-30">👕</div>
        <p class="mb-1 font-semibold text-gray-700">{{ hasFilters ? 'Ничего не найдено' : (isArchiveView ? 'В архиве пока пусто' : 'В гардеробе пока пусто') }}</p>
        <p class="mb-4 text-sm">{{ hasFilters ? 'Попробуйте изменить или сбросить фильтры' : (isArchiveView ? 'Здесь появятся вещи, которые вы решите убрать из основного гардероба' : 'Добавьте первую вещь — и начните вести историю своих покупок') }}</p>
        {% if hasFilters %}
        <a href="{{ path('account_wardrobe_index', memberParam|merge(isArchiveView ? {view: 'archive'} : {})) }}"
           class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">Сбросить фильтры</a>
        {% elseif not isArchiveView %}
        <a href="{{ path('account_wardrobe_new', memberParam) }}"
           class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Добавить вещь</a>
        {% endif %}
    </div>
{% else %}

    {# ── Статистика ── #}
    {% if not isArchiveView %}
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">{{ hasFilters ? 'Найдено вещей' : 'Всего вещей' }}</div>
            <div class="mt-1 text-2xl font-bold">{{ totalCount }}</div>
        </div>
        <div class="rounded-2xl bg-white p-5 shadow-sm">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">Общая стоимость</div>
            <div class="mt-1 text-2xl font-bold">{{ totalSum|number_format(0, ',', ' ') }} ₽</div>
        </div>
    </div>
    {% endif %}

    {% if stats|length > 0 %}
    <div class="mb-6 flex flex-wrap gap-2">
        {% for s in stats %}
            <span class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 shadow-sm">{{ s.category }} — {{ s.cnt }}</span>
        {% endfor %}
    </div>
    {% endif %}

    {# ── Сетка вещей ── #}
    {% set wearLabels = constant('App\\Entity\\WardrobeItem::WEAR_LABELS') %}
    {% set wearChip = {
        'reserve':    'bg-sky-100 text-sky-700',
        'outgrown':   'bg-amber-100 text-amber-700',
        'given_away': 'bg-gray-100 text-gray-500',
    } %}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in items %}
        <div class="group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-md">
        <a href="{{ path('account_wardrobe_show', {id: item.id}|merge(activeQuery)) }}" class="block">
            <div class="relative aspect-square bg-gray-100">
                {% if item.coverPhoto %}
                    <img src="{{ vich_uploader_asset(item.coverPhoto, 'file') }}"
                         class="h-full w-full object-cover" alt="{{ item.name }}">
                {% elseif item.photo %}
                    <img src="{{ vich_uploader_asset(item, 'photoFile') }}"
                         class="h-full w-full object-cover" alt="{{ item.name }}">
                {% else %}
                    <div class="flex h-full w-full items-center justify-center text-5xl opacity-20">👕</div>
                {% endif %}
                {% if item.loveAtFirstSight == 'yes' %}
                    <span class="absolute right-2 top-2 rounded-full bg-white/90 px-2 py-1 text-sm shadow-sm" title="Любовь с первого взгляда">❤️</span>
                {% endif %}
                {% if item.wearStatus is defined and item.wearStatus != 'active' %}
                    <span class="absolute left-2 top-2 rounded-full px-2.5 py-1 text-[11px] font-semibold shadow-sm {{ wearChip[item.wearStatus] ?? 'bg-gray-100 text-gray-500' }}">
                        {{ wearLabels[item.wearStatus] ?? item.wearStatus }}
                    </span>
                {% endif %}
            </div>
            <div class="p-4">
                <div class="mb-1 flex items-center justify-between gap-2">
                    <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">{{ item.displayNumber }}</span>
                    {% if item.purchasedAt %}
                        <span class="text-xs text-gray-400">{{ item.purchasedAt|date('d.m.Y') }}</span>
                    {% endif %}
                </div>
                <div class="truncate text-sm font-semibold group-hover:text-black">{{ item.name ?: 'Черновик вещи' }}</div>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500">
                    <span>{{ item.category ?: 'Без категории' }}</span>
                    {% if item.size %}
                        <span class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold">{{ item.size }}</span>
                    {% endif %}
                    {% if isArchiveView %}
                        <span class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold text-gray-600">{{ item.itemStatusLabel }}</span>
                    {% else %}
                        <span class="rounded bg-amber-50 px-1.5 py-0.5 font-semibold text-amber-700">{{ item.completionStatusLabel }}</span>
                    {% endif %}
                </div>
                {% if item.price is not null %}
                    <div class="mt-2 text-sm font-bold">{{ item.price|number_format(0, ',', ' ') }} ₽</div>
                {% endif %}
            </div>
        </a>
        {# Терминальные статусы (sold/donated/lost) видны в архиве с ярлыком, но без
           кнопки «Вернуть» — их статус зафиксирован как факт, а не состояние видимости. #}
        {% if isArchiveView and item.itemStatus == constant('App\\Entity\\WardrobeItem::ITEM_ARCHIVED') %}
            <form method="post" action="{{ path('account_wardrobe_restore', {id: item.id}|merge(memberParam)) }}" class="border-t border-gray-100 p-3">
                <input type="hidden" name="_token" value="{{ csrf_token('restore_wardrobe_item_' ~ item.id) }}">
                <button type="submit" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50">Вернуть в гардероб</button>
            </form>
        {% endif %}
        </div>
        {% endfor %}
    </div>
{% endif %}

<script>
(function () {
    var toggleBtn = document.getElementById('wardrobe-ingest-toggle');
    var panel = document.getElementById('wardrobe-ingest-panel');
    if (toggleBtn && panel) {
        toggleBtn.addEventListener('click', function () {
            panel.classList.toggle('hidden');
        });
    }
    if (!panel) return;

    var CSRF_TOKEN = panel.dataset.csrf;
    var UPLOAD_URL = panel.dataset.uploadUrl;
    var area = document.getElementById('ingest-panel-upload-area');
    var fileInput = document.getElementById('ingest-panel-file-input');
    var progress = document.getElementById('ingest-panel-progress');
    var bar = document.getElementById('ingest-panel-progress-bar');
    var errorBox = document.getElementById('ingest-panel-error');

    area.addEventListener('click', function () { fileInput.click(); });
    area.addEventListener('dragover', function (e) { e.preventDefault(); area.classList.add('bg-gray-50'); });
    area.addEventListener('dragleave', function () { area.classList.remove('bg-gray-50'); });
    area.addEventListener('drop', function (e) {
        e.preventDefault();
        area.classList.remove('bg-gray-50');
        uploadFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', function () { uploadFiles(fileInput.files); });

    function uploadFiles(files) {
        if (!files || !files.length) return;

        var fd = new FormData();
        [].forEach.call(files, function (f) { fd.append('photos', f); });

        errorBox.classList.add('hidden');
        progress.classList.remove('hidden');
        bar.style.width = '0%';

        var xhr = new XMLHttpRequest();
        xhr.upload.onprogress = function (e) {
            if (e.lengthComputable) bar.style.width = Math.round(e.loaded / e.total * 100) + '%';
        };
        xhr.onload = function () {
            var data = {};
            try { data = JSON.parse(xhr.responseText); } catch (e) {}
            if (xhr.status === 200 && data.ok && data.reviewUrl) {
                window.location.href = data.reviewUrl;
                return;
            }
            progress.classList.add('hidden');
            errorBox.textContent = (data && data.error) ? data.error : 'Не удалось загрузить фото';
            errorBox.classList.remove('hidden');
        };
        xhr.onerror = function () {
            progress.classList.add('hidden');
            errorBox.textContent = 'Сеть недоступна, попробуйте ещё раз';
            errorBox.classList.remove('hidden');
        };
        xhr.open('POST', UPLOAD_URL);
        xhr.setRequestHeader('X-CSRF-Token', CSRF_TOKEN);
        xhr.send(fd);
    }
})();
</script>
{% endblock %}
