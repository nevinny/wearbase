{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block family_mobile_title %}Сегодняшний образ{% endblock %}

{% block family_mobile_content %}
<div class="mb-5">
    <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Быстрый дневник</p>
    <h1 class="mt-1 text-2xl font-black text-slate-950">Что на тебе сегодня?</h1>
    <p class="mt-2 text-sm text-slate-500">Фото предложит вещи из гардероба. Ты проверишь их — только потом носка попадёт в статистику.</p>
</div>

<form method="post" enctype="multipart/form-data" class="rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-600 p-5 text-white shadow-lg" data-testid="wear-capture-form">
    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_wear_new_' ~ currentMember.id) }}">
    <label for="wear-photo" class="flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/40 bg-white/10 px-4 text-center transition active:scale-[.99]">
        <span class="text-4xl">📸</span>
        <span class="mt-3 text-base font-bold">Снять или выбрать фото</span>
        <span class="mt-1 text-xs text-indigo-100">Лицо можно не включать в кадр</span>
    </label>
    <input id="wear-photo" type="file" name="photo" accept="image/jpeg,image/png,image/webp" capture="environment" class="sr-only">
    <div class="mt-4 grid grid-cols-2 gap-3">
        <label class="text-xs font-semibold text-indigo-100">Дата
            <input type="date" name="wornOn" value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" class="mt-1 min-h-11 w-full rounded-xl border-0 bg-white px-3 text-sm text-slate-900">
        </label>
        <button class="mt-5 min-h-11 rounded-xl bg-white px-4 text-sm font-black text-indigo-700">Распознать</button>
    </div>
    {% if not hasPhotoConsent %}
        <label class="mt-4 flex items-start gap-3 rounded-xl bg-black/15 p-3 text-xs leading-5">
            <input type="checkbox" name="photoConsent" value="1" class="mt-1 h-4 w-4 rounded">
            <span>Разрешаю приватно обработать это фото для подбора вещей. Фото не используется для общего обучения.</span>
        </label>
    {% endif %}
    <button name="manual" value="1" class="mt-3 min-h-11 w-full text-sm font-semibold text-white/90">Без фото — выбрать вещи вручную</button>
</form>

{% if statistics %}
<section class="mt-6">
    <h2 class="mb-3 text-sm font-black text-slate-900">Любимые в деле</h2>
    <div class="flex snap-x gap-3 overflow-x-auto pb-2">
        {% for item in items %}
            {% if statistics[item.id] is defined %}
            {% set stat = statistics[item.id] %}
            <a href="{{ path('account_wardrobe_show', {id: item.id, member: currentMember.id}) }}" class="min-w-36 snap-start rounded-2xl bg-white p-4 shadow-sm">
                <p class="truncate text-sm font-bold text-slate-900">{{ item.name ?: item.category ?: 'Вещь' }}</p>
                <p class="mt-2 text-2xl font-black text-indigo-600">{{ stat.wearCount }}</p>
                <p class="text-xs text-slate-500">{{ stat.wearCount == 1 ? 'носка' : 'носок' }}</p>
                {% if stat.costPerWear %}<p class="mt-2 text-xs font-semibold text-emerald-700">{{ stat.costPerWear|number_format(2, ',', ' ') }} ₽ / носку</p>{% endif %}
            </a>
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}

{% if events %}
<section class="mt-6 space-y-3">
    <h2 class="text-sm font-black text-slate-900">Недавние образы</h2>
    {% for event in events %}
        <article class="rounded-2xl bg-white p-4 shadow-sm">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="text-sm font-bold">{{ event.wornOn|date('d.m.Y') }} · {{ event.type == 'worn' ? 'Носила' : (event.type == 'fitting' ? 'Примерка' : 'План') }}</p>
                    <p class="mt-1 text-xs text-slate-500">{{ event.items|length }} вещей{% if event.occasion %} · {{ event.occasion }}{% endif %}</p>
                </div>
                {% if event.photo %}<img src="{{ path('account_wardrobe_media_wear', {id: event.id}) }}" alt="Фото образа" class="h-14 w-14 rounded-xl object-cover">{% endif %}
            </div>
            {% if event.type == 'worn' %}
            <details class="mt-3 border-t border-slate-100 pt-2" {{ event.feedbackAt ? '' : '' }}>
                <summary class="min-h-11 cursor-pointer py-3 text-xs font-bold text-indigo-700">{{ event.feedbackAt ? 'Изменить впечатление' : 'Как носился образ?' }}</summary>
                <form method="post" action="{{ path('account_wardrobe_wear_feedback', {id: event.id}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_wear_feedback_' ~ event.id) }}">
                    <div class="grid grid-cols-3 gap-2">
                        {% for value, label in {'comfortable':'Удобно','mixed':'По-разному','uncomfortable':'Неудобно'} %}
                            <label class="cursor-pointer rounded-xl border p-2 text-center text-xs has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                                <input type="radio" name="comfort" value="{{ value }}" {{ event.comfort == value ? 'checked' : '' }} required class="sr-only">{{ label }}
                            </label>
                        {% endfor %}
                    </div>
                    <div class="flex gap-4 text-xs">
                        <label class="flex min-h-11 items-center gap-2"><input type="radio" name="repeat" value="1" {{ event.wantsRepeat is same as(true) ? 'checked' : '' }} class="h-5 w-5"> Хочу повторить</label>
                        <label class="flex min-h-11 items-center gap-2"><input type="radio" name="repeat" value="0" {{ event.wantsRepeat is same as(false) ? 'checked' : '' }} class="h-5 w-5"> Не повторять</label>
                    </div>
                    <input name="comment" maxlength="1000" value="{{ event.comment }}" placeholder="Что заменить или с чем сочеталось" class="min-h-11 w-full rounded-xl border border-slate-200 px-3 text-xs">
                    <button class="min-h-11 w-full rounded-xl bg-slate-900 text-xs font-bold text-white">Сохранить впечатление</button>
                </form>
            </details>
            {% endif %}
            <div class="mt-2 flex gap-4 border-t border-slate-100 pt-2">
                <a href="{{ path('account_wardrobe_wear_review', {id: event.id}) }}" class="flex min-h-11 items-center text-xs font-semibold text-slate-600">Исправить вещи</a>
                <form method="post" action="{{ path('account_wardrobe_wear_delete', {id: event.id}) }}" onsubmit="return confirm('Удалить событие и пересчитать носки?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_wear_delete_' ~ event.id) }}">
                    <button class="min-h-11 text-xs font-semibold text-red-600">Удалить</button>
                </form>
            </div>
        </article>
    {% endfor %}
</section>
{% endif %}
{% endblock %}
