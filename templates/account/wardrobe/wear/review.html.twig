{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block family_mobile_title %}Проверить образ{% endblock %}

{% block family_mobile_content %}
<div class="mb-5 flex items-start gap-4">
    {% if event.photo %}<img src="{{ path('account_wardrobe_media_wear', {id: event.id}) }}" alt="Загруженный образ" class="h-24 w-20 rounded-2xl object-cover shadow-sm">{% endif %}
    <div>
        <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">AI предложил — решаешь ты</p>
        <h1 class="mt-1 text-xl font-black">Проверь вещи</h1>
        <p class="mt-1 text-sm text-slate-500">Сними лишние галочки и добавь то, что распознавание пропустило.</p>
    </div>
</div>

<form method="post" action="{{ path('account_wardrobe_wear_confirm', {id: event.id}) }}" class="space-y-5" data-testid="wear-review-form">
    <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_wear_confirm_' ~ event.id) }}">
    {% set suggestedIds = event.items|map(eventItem => eventItem.item.id) %}
    <div class="grid grid-cols-2 gap-3">
        {% for item in items %}
            {% set suggested = item.id in suggestedIds %}
            {% if suggested %}<label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-2xl border p-3 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50" data-kind="suggested">
                <input type="checkbox" name="items[]" value="{{ item.id }}" {{ suggested ? 'checked' : '' }} class="h-5 w-5 rounded border-slate-300 text-indigo-600">
                <span class="min-w-0 text-sm font-bold">{{ item.name ?: item.category ?: 'Вещь №' ~ item.itemNo }}</span>
            </label>{% endif %}
        {% endfor %}
    </div>

    <details class="rounded-2xl bg-white p-4 shadow-sm" {{ suggestedIds is empty ? 'open' : '' }}>
        <summary class="min-h-11 cursor-pointer py-3 text-sm font-bold">+ Добавить пропущенную вещь</summary>
        <div class="mt-2 grid grid-cols-2 gap-3">
            {% for item in items %}
                {% if item.id not in suggestedIds %}
                <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border p-3 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                    <input type="checkbox" name="items[]" value="{{ item.id }}" class="h-5 w-5 rounded border-slate-300 text-indigo-600">
                    <span class="min-w-0 text-xs font-bold">{{ item.name ?: item.category ?: 'Вещь №' ~ item.itemNo }}</span>
                </label>
                {% endif %}
            {% endfor %}
        </div>
    </details>

    <div class="rounded-2xl bg-white p-4 shadow-sm">
        <label class="block text-sm font-bold">Что это было?
            <select name="type" class="mt-2 min-h-11 w-full rounded-xl border border-slate-200 px-3">
                <option value="worn" {{ event.type == 'worn' ? 'selected' : '' }}>Носила сегодня — учесть носку</option>
                <option value="fitting" {{ event.type == 'fitting' ? 'selected' : '' }}>Только примеряла — не считать</option>
                <option value="planned" {{ event.type == 'planned' ? 'selected' : '' }}>Планирую — не считать</option>
            </select>
        </label>
        <label class="mt-4 block text-sm font-bold">Куда ходила? <span class="font-normal text-slate-400">необязательно</span>
            <input name="occasion" maxlength="255" placeholder="Школа, прогулка, праздник" class="mt-2 min-h-11 w-full rounded-xl border border-slate-200 px-3">
        </label>
        <label class="mt-4 block text-sm font-bold">Как было? <span class="font-normal text-slate-400">необязательно</span>
            <textarea name="comment" maxlength="1000" rows="2" placeholder="Удобно, хочется повторить, что заменить" class="mt-2 w-full rounded-xl border border-slate-200 p-3"></textarea>
        </label>
    </div>

    <div class="sticky bottom-20 z-20 rounded-2xl bg-white/95 p-3 shadow-xl backdrop-blur md:bottom-4">
        <button class="min-h-12 w-full rounded-xl bg-indigo-600 px-5 text-sm font-black text-white">Подтвердить образ</button>
    </div>
</form>
{% endblock %}
