{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block title %}Кружки — WEARBASE{% endblock %}

{% block family_mobile_content %}
<div class="mb-5">
    <h1 class="text-lg font-bold">Кружки</h1>
    <p class="mt-1 text-sm text-gray-500">Маленькие круги доверия: луки видят только участники кружка, которому вы их явно показали.</p>
</div>

{# Pending-карточки родителя (§3.1): подросток вступил сам — нужен аппрув #}
{% if pendingForParent %}
    <section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="font-bold">Ждут вашего подтверждения</h2>
        <ul class="mt-3 space-y-3">
            {% for membership in pendingForParent %}
                <li class="rounded-xl border border-amber-100 bg-amber-50/50 p-3 text-sm">
                    <span class="font-semibold">{{ membership.user.firstName }}</span> хочет вступить в кружок
                    «{{ membership.circle.title }}».
                    <div class="mt-2 flex gap-2">
                        <form method="post" action="{{ path('account_circles_member_confirm', {id: membership.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('circle_member_confirm_' ~ membership.id) }}">
                            <input type="hidden" name="action" value="approve">
                            <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50">Подтвердить</button>
                        </form>
                        <form method="post" action="{{ path('account_circles_member_confirm', {id: membership.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('circle_member_confirm_' ~ membership.id) }}">
                            <input type="hidden" name="action" value="reject">
                            <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Отклонить</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

{# Мои кружки #}
<section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
    <h2 class="font-bold">Мои кружки</h2>
    {% if memberships %}
        <ul class="mt-3 space-y-3">
            {% for entry in memberships %}
                {% set m = entry.membership %}
                <li class="rounded-xl border border-gray-100 p-3 text-sm">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="min-w-0">
                            <a href="{{ path('account_circles_feed', {id: m.circle.id}) }}" class="truncate font-semibold hover:underline">{{ m.circle.title }}</a>
                            <div class="mt-0.5 text-xs text-gray-500">
                                {% if m.isPendingParent %}
                                    <span class="font-semibold text-amber-700">Ожидает подтверждения родителя</span>
                                {% else %}
                                    {{ m.role == 'owner' ? 'Вы владелец' : (m.role == 'moderator' ? 'Вы модератор' : 'Вы участник') }}
                                {% endif %}
                            </div>
                        </div>
                        {% if not m.isPendingParent %}
                            <a href="{{ path('account_circles_feed', {id: m.circle.id}) }}" class="min-h-11 rounded-full bg-gray-900 px-5 py-2.5 text-xs font-semibold text-white hover:bg-black">Лента</a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="mt-2 text-sm text-gray-500">Пока ни одного кружка.</p>
    {% endif %}

    <form method="post" class="mt-4 flex flex-col gap-2 border-t border-gray-100 pt-4 sm:flex-row sm:items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('circle_create') }}">
        <label class="flex-1 text-xs text-gray-500">
            Название нового кружка (до 80 символов)
            <input type="text" name="title" required maxlength="80"
                   class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2 text-sm" placeholder="Например: Школа 42">
        </label>
        <button class="min-h-11 rounded-full bg-gray-900 px-5 py-2.5 text-xs font-semibold text-white hover:bg-black">Создать кружок</button>
    </form>
</section>

{# Отзыв родительского согласия на кружковые публикации детских луков (§3.1) #}
{% if managedChildren %}
    <section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="font-bold">Публикации детских луков</h2>
        <p class="mt-1 text-xs text-gray-500">Отзыв согласия сразу скрывает все кружковые ссылки на луки ребёнка.</p>
        <ul class="mt-3 space-y-2">
            {% for child in managedChildren %}
                <li class="flex items-center justify-between rounded-xl border border-gray-100 p-3 text-sm">
                    <span class="font-semibold">{{ child.firstName }}</span>
                    <form method="post" action="{{ path('account_circles_child_shares_revoke', {userId: child.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('circle_child_shares_' ~ child.id) }}">
                        <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Отозвать ссылки</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
{% endblock %}
