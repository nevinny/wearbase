{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block title %}{{ item.displayNumber }} {{ item.name }} — Мой гардероб — WEARBASE{% endblock %}

{% block family_mobile_content %}
{# Гварды на переходный момент: контроллер может ещё не передавать family-переменные #}
{% set memberParam = currentMember is defined ? {member: currentMember.id} : {} %}
{% set backQuery = app.request.query.all %}
{% set mayManage = canManage is defined and canManage %}
{% set wearLabels = constant('App\\Entity\\WardrobeItem::WEAR_LABELS') %}
{% set wearChip = {
    'reserve':    'bg-sky-100 text-sky-700',
    'outgrown':   'bg-amber-100 text-amber-700',
    'given_away': 'bg-gray-100 text-gray-500',
} %}

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
        <a href="{{ path('account_wardrobe_index', backQuery) }}"
           class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">← Назад</a>
        <h1 class="text-lg font-bold">
            <span class="text-gray-400">{{ item.displayNumber }}</span>
            {{ item.name ?: 'Черновик вещи' }}
        </h1>
    </div>
    <div class="flex gap-2">
        <a href="{{ path('account_wardrobe_edit', {id: item.id}|merge(memberParam)) }}"
           class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Редактировать</a>
        {# «В архив» — из active/repair/transferred (гварда WardrobeManager::archive);
           «Вернуть» — только из archived; терминальные статусы (sold/donated/lost) не
           показывают ни ту, ни другую кнопку — статус виден чипом ниже, менять его
           обратно можно только осознанно через форму. #}
        {% if item.itemStatus == constant('App\\Entity\\WardrobeItem::ITEM_ARCHIVED') %}
            <form method="post" action="{{ path('account_wardrobe_restore', {id: item.id}|merge(memberParam)) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('restore_wardrobe_item_' ~ item.id) }}">
                <button type="submit" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Вернуть в гардероб</button>
            </form>
        {% elseif item.itemStatus in [
            constant('App\\Entity\\WardrobeItem::ITEM_ACTIVE'),
            constant('App\\Entity\\WardrobeItem::ITEM_REPAIR'),
            constant('App\\Entity\\WardrobeItem::ITEM_TRANSFERRED'),
        ] %}
            <form method="post" action="{{ path('account_wardrobe_archive', {id: item.id}|merge(memberParam)) }}"
                  onsubmit="return confirm('Переместить вещь в архив?')">
                <input type="hidden" name="_token" value="{{ csrf_token('archive_wardrobe_item_' ~ item.id) }}">
                <button type="submit" class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">В архив</button>
            </form>
        {% endif %}
        <form method="post" action="{{ path('account_wardrobe_delete', {id: item.id}|merge(memberParam)) }}"
              onsubmit="return confirm('Удалить вещь без возможности восстановления из интерфейса?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_wardrobe_item') }}">
            <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 transition">Удалить</button>
        </form>
    </div>
</div>

<div class="mb-4 flex flex-wrap gap-2">
    <span class="rounded-full bg-gray-900 px-3 py-1 text-xs font-semibold text-white">{{ item.category ?: 'Без категории' }}</span>
    <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">{{ item.completionStatusLabel }}</span>
    {% if item.itemStatus != constant('App\\Entity\\WardrobeItem::ITEM_ACTIVE') %}
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600 shadow-sm">{{ item.itemStatusLabel }}</span>
    {% endif %}
    {% if item.size %}
        <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-gray-600 shadow-sm">Размер {{ item.size }}</span>
    {% endif %}
    {% if item.wearStatus is defined and item.wearStatus != 'active' %}
        <span class="rounded-full px-3 py-1 text-xs font-semibold shadow-sm {{ wearChip[item.wearStatus] ?? 'bg-gray-100 text-gray-500' }}">
            {{ wearLabels[item.wearStatus] ?? item.wearStatus }}
        </span>
    {% endif %}
</div>

{% if wearStatistic %}
<div class="mb-4 grid grid-cols-3 gap-3 rounded-2xl bg-gradient-to-r from-indigo-50 to-violet-50 p-4">
    <div><p class="text-xl font-black text-indigo-700">{{ wearStatistic.wearCount }}</p><p class="text-xs text-slate-500">носок</p></div>
    <div><p class="text-sm font-black text-slate-800">{{ wearStatistic.lastWorn|date('d.m.Y') }}</p><p class="text-xs text-slate-500">последний раз</p></div>
    <div>{% if wearStatistic.costPerWear %}<p class="text-sm font-black text-emerald-700">{{ wearStatistic.costPerWear|number_format(2, ',', ' ') }} ₽</p><p class="text-xs text-slate-500">за носку</p>{% else %}<p class="text-xs text-slate-400">Добавьте цену</p>{% endif %}</div>
</div>
{% endif %}

<div class="grid gap-4 md:grid-cols-12">

    {# ── Фото ── #}
    <div class="md:col-span-5">
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
            {% if item.coverPhoto %}
                <img data-rotate-cover="1"
                     src="{{ path('account_wardrobe_media_photo', {id: item.coverPhoto.id}) }}"
                     class="aspect-square w-full object-cover" alt="{{ item.name }}">
            {% elseif item.photo %}
                <img src="{{ path('account_wardrobe_media_item', {id: item.id}) }}"
                     class="aspect-square w-full object-cover" alt="{{ item.name }}">
            {% else %}
                <div class="flex aspect-square w-full items-center justify-center bg-gray-100 text-6xl opacity-20">👕</div>
            {% endif %}
        </div>
        {% if mayManage and item.coverPhoto %}
        <div class="mt-1 flex justify-center gap-1">
            <button type="button" data-rotate-btn="{{ item.coverPhoto.id }}" data-degrees="90" data-url="{{ path('account_wardrobe_photo_rotate', {id: item.id, photoId: item.coverPhoto.id}|merge(memberParam)) }}" data-token="{{ csrf_token('wardrobe_photo_' ~ item.coverPhoto.id) }}" class="rounded px-3 py-1 text-xs font-semibold text-gray-500 hover:text-gray-900 transition">↻ Вправо</button>
            <button type="button" data-rotate-btn="{{ item.coverPhoto.id }}" data-degrees="-90" data-url="{{ path('account_wardrobe_photo_rotate', {id: item.id, photoId: item.coverPhoto.id}|merge(memberParam)) }}" data-token="{{ csrf_token('wardrobe_photo_' ~ item.coverPhoto.id) }}" class="rounded px-3 py-1 text-xs font-semibold text-gray-500 hover:text-gray-900 transition">↺ Влево</button>
        </div>
        {% endif %}

        {% if item.activePhotos|length > 0 %}
        <div class="mt-3 grid grid-cols-3 gap-2">
            {% for photo in item.activePhotos %}
            <div class="overflow-hidden rounded-xl bg-white p-1.5 shadow-sm">
                <img data-rotate-target="{{ photo.id }}"
                     src="{{ path('account_wardrobe_media_photo', {id: photo.id}) }}" class="aspect-square w-full rounded-lg object-cover" alt="">
                {% if mayManage %}
                <div class="mt-1 flex gap-0.5">
                    <button type="button" data-rotate-btn="{{ photo.id }}" data-degrees="90" data-url="{{ path('account_wardrobe_photo_rotate', {id: item.id, photoId: photo.id}|merge(memberParam)) }}" data-token="{{ csrf_token('wardrobe_photo_' ~ photo.id) }}" class="flex-1 px-1 py-1 text-[10px] font-semibold text-gray-500 hover:text-gray-900 transition">↻</button>
                    <button type="button" data-rotate-btn="{{ photo.id }}" data-degrees="-90" data-url="{{ path('account_wardrobe_photo_rotate', {id: item.id, photoId: photo.id}|merge(memberParam)) }}" data-token="{{ csrf_token('wardrobe_photo_' ~ photo.id) }}" class="flex-1 px-1 py-1 text-[10px] font-semibold text-gray-500 hover:text-gray-900 transition">↺</button>
                    {% if photo.cover %}
                        <span class="flex-1 px-1 py-1 text-center text-[10px] font-semibold text-emerald-700">Обложка</span>
                    {% else %}
                        <form method="post" action="{{ path('account_wardrobe_photo_cover', {id: item.id, photoId: photo.id}|merge(memberParam)) }}" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_photo_' ~ photo.id) }}">
                            <button class="w-full px-1 py-1 text-[10px] font-semibold text-gray-600">На обложку</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('account_wardrobe_photo_delete', {id: item.id, photoId: photo.id}|merge(memberParam)) }}"
                          onsubmit="return confirm('Убрать фотографию?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_photo_' ~ photo.id) }}">
                        <button class="px-1 py-1 text-[10px] text-red-500" aria-label="Убрать фото">×</button>
                    </form>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if mayManage %}
        <form method="post" enctype="multipart/form-data"
              action="{{ path('account_wardrobe_photos_upload', {id: item.id}|merge(memberParam)) }}"
              class="mt-3 rounded-2xl bg-white p-4 shadow-sm">
            <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_photos_' ~ item.id) }}">
            <label class="mb-2 block text-xs font-semibold text-gray-700">Добавить фотографии</label>
            <input type="file" name="photos[]" multiple required accept="image/jpeg,image/png,image/webp"
                   class="block w-full text-xs text-gray-500">
            <div class="mt-3 flex gap-2">
                <select name="photo_type" class="min-w-0 flex-1 rounded-lg border border-gray-200 px-2 py-2 text-xs">
                    <option value="product">Общий вид</option>
                    <option value="back">Вид сзади</option>
                    <option value="detail">Деталь</option>
                    <option value="label">Бирка</option>
                    <option value="care">Уход</option>
                    <option value="receipt">Чек</option>
                </select>
                <button class="rounded-lg bg-gray-900 px-3 py-2 text-xs font-semibold text-white">Загрузить</button>
            </div>
            <p class="mt-2 text-[10px] text-gray-400">До 8 файлов: JPG, PNG или WebP, каждый до 10 МБ</p>
        </form>
        {% endif %}
    </div>

    <div class="md:col-span-7">
        {# ── Факты ── #}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-sm font-bold">Факты</h2>
            <dl class="grid gap-3 text-sm">
                {% if item.styles|length > 0 %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Стиль</dt>
                    <dd class="flex flex-wrap justify-end gap-1">
                        {% for style in item.styles %}
                            <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold">{{ style.title }}</span>
                        {% endfor %}
                    </dd>
                </div>
                {% endif %}
                {% if item.price is not null %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Цена</dt>
                    <dd class="font-bold">{{ item.price|number_format(0, ',', ' ') }} ₽</dd>
                </div>
                {% endif %}
                {% if item.purchasedAt %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Дата покупки</dt>
                    <dd class="font-semibold">{{ item.purchasedAt|date('d.m.Y') }}</dd>
                </div>
                {% endif %}
                {% if item.productUrl %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Товар</dt>
                    <dd><a href="{{ item.productUrl }}" target="_blank" rel="noopener"
                           class="font-semibold underline decoration-gray-300 underline-offset-2 hover:decoration-gray-900">Ссылка на товар ↗</a></dd>
                </div>
                {% endif %}
                {% if item.loveAtFirstSight %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Любовь с первого взгляда</dt>
                    <dd class="font-semibold">
                        {%- if item.loveAtFirstSight == 'yes' -%}❤️ Да
                        {%- elseif item.loveAtFirstSight == 'no' -%}Нет
                        {%- elseif item.loveAtFirstSight == 'unknown' -%}Пока не знаю
                        {%- endif -%}
                    </dd>
                </div>
                {% endif %}
                <div class="flex justify-between gap-4">
                    <dt class="text-gray-500">Добавлено</dt>
                    <dd class="text-gray-500">{{ item.createdAt|date('d.m.Y') }}</dd>
                </div>
            </dl>
        </div>

        {# ── Статус ── #}
        {% if mayManage and item.wearStatus is defined %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-sm font-bold">Статус</h2>
            <div class="flex flex-wrap gap-2">
                {% for status, label in wearLabels %}
                    <form method="post" action="{{ path('account_wardrobe_status', {id: item.id}|merge(memberParam)) }}">
                        <input type="hidden" name="wear_status" value="{{ status }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('status_wardrobe_item') }}">
                        {% if item.wearStatus == status %}
                            <button type="submit" disabled
                                    class="rounded-full bg-gray-900 px-3.5 py-1.5 text-xs font-semibold text-white">{{ label }}</button>
                        {% else %}
                            <button type="submit"
                                    class="rounded-full border border-gray-200 px-3.5 py-1.5 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition">{{ label }}</button>
                        {% endif %}
                    </form>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if mayManage %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-2 text-sm font-bold">Чистота и доступность</h2>
            <p class="mb-4 text-xs text-gray-500">Грязные вещи и вещи в стирке не участвуют в подборе образов.</p>
            <div class="flex flex-wrap gap-2">{% for status, label in constant('App\\Entity\\WardrobeItem::CLEANLINESS_LABELS') %}
                <form method="post" action="{{ path('account_wardrobe_cleanliness', {id: item.id}|merge(memberParam)) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cleanliness_wardrobe_item_' ~ item.id) }}"><input type="hidden" name="cleanliness_status" value="{{ status }}">
                    <button{{ item.cleanlinessStatus == status ? ' disabled' : '' }} class="min-h-11 rounded-full {{ item.cleanlinessStatus == status ? 'bg-gray-900 text-white' : 'border border-gray-200 text-gray-600' }} px-4 text-xs font-semibold">{{ label }}</button>
                </form>
            {% endfor %}</div>
        </div>
        {% endif %}

        {# ── Уход и ремонт ── #}
        {% if mayManage and item.itemStatus == constant('App\\Entity\\WardrobeItem::ITEM_ACTIVE') %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-2 text-sm font-bold">Уход и ремонт</h2>
            <p class="mb-4 text-xs text-gray-500">Химчистка, подшив, молния или подошва останутся в истории вещи.</p>
            <form method="post" action="{{ path('account_wardrobe_lifecycle_create', {id: item.id}|merge(memberParam)) }}" class="grid grid-cols-12 gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_lifecycle_' ~ item.id) }}">
                <select name="type" required class="col-span-12 min-h-11 rounded-xl border border-gray-200 bg-white px-3 text-sm md:col-span-6">
                    <option value="dry_cleaning">Химчистка</option><option value="cleaning">Чистка/стирка</option><option value="repair_hem">Подшив</option><option value="repair_zipper">Ремонт молнии</option><option value="repair_sole">Ремонт подошвы</option><option value="repair_other">Другой ремонт</option>
                </select>
                <input name="provider" maxlength="255" placeholder="Ателье или химчистка" class="col-span-12 min-h-11 rounded-xl border border-gray-200 px-3 text-sm md:col-span-6">
                <input name="cost" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Стоимость" class="col-span-5 min-h-11 rounded-xl border border-gray-200 px-3 text-sm">
                <input name="note" maxlength="2000" placeholder="Что нужно сделать" class="col-span-7 min-h-11 rounded-xl border border-gray-200 px-3 text-sm">
                <button class="col-span-12 min-h-11 rounded-xl bg-gray-900 px-4 font-semibold text-white">Отправить</button>
            </form>
        </div>
        {% endif %}

        {% if lifecycleEvents is defined and lifecycleEvents|length > 0 %}
        {% set lifecycleLabels = {dry_cleaning: 'Химчистка', cleaning: 'Чистка', repair_hem: 'Подшив', repair_zipper: 'Молния', repair_sole: 'Подошва', repair_other: 'Ремонт', transfer_external: 'Передача вне семьи'} %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-sm font-bold">История ухода</h2>
            <div class="space-y-3">
                {% for event in lifecycleEvents %}<div class="rounded-xl bg-gray-50 p-3 text-sm">
                    <div class="flex justify-between gap-3"><strong>{{ lifecycleLabels[event.type]|default(event.type) }}</strong><span class="text-gray-400">{{ event.createdAt|date('d.m.Y') }}</span></div>
                    {% if event.provider %}<p class="mt-1 text-gray-600">{{ event.provider }}</p>{% endif %}{% if event.note %}<p class="mt-1 text-gray-500">{{ event.note }}</p>{% endif %}
                    {% if event.status == 'open' %}<form method="post" action="{{ path('account_wardrobe_lifecycle_complete', {id: item.id, eventId: event.id}|merge(memberParam)) }}" class="mt-2"><input type="hidden" name="_token" value="{{ csrf_token('wardrobe_lifecycle_complete_' ~ event.id) }}"><button class="min-h-11 rounded-xl bg-emerald-600 px-4 font-semibold text-white">Готово, вернуть в гардероб</button></form>{% endif %}
                </div>{% endfor %}
            </div>
        </div>
        {% endif %}

        {# ── Передать вещь ── #}
        {% if transferTargets is defined and transferTargets|length > 0 %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-sm font-bold">Передать вещь</h2>
            <form method="post" action="{{ path('account_wardrobe_transfer', {id: item.id}|merge(memberParam)) }}"
                  onsubmit="return confirm('Передать вещь в другой гардероб?')"
                  class="grid grid-cols-12 gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('transfer_wardrobe_item') }}">
                <div class="col-span-12 md:col-span-5">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Кому</label>
                    <select name="to_user"
                            class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
                        {% for target in transferTargets %}
                            <option value="{{ target.id }}">{{ target.fullName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Заметка</label>
                    <input type="text" name="note" placeholder="например: перешло от старшей"
                           class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900">
                </div>
                <div class="col-span-12">
                    <button type="submit"
                            class="rounded-xl bg-gray-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Передать</button>
                </div>
            </form>
        </div>
        {% endif %}

        {% if mayManage and (currentMember.familyRole != constant('App\\Entity\\User::FAMILY_ROLE_CHILD') or app.user.familyParent) %}
        <div class="mb-4 rounded-2xl border border-amber-200 bg-white p-6 shadow-sm">
            <h2 class="mb-2 text-sm font-bold">Передать вне семьи</h2>
            <form method="post" action="{{ path('account_wardrobe_lifecycle_create', {id: item.id}|merge(memberParam)) }}" onsubmit="return confirm('Вещь исчезнет из активного гардероба. Продолжить?')" class="grid gap-3 md:grid-cols-2">
                <input type="hidden" name="_token" value="{{ csrf_token('wardrobe_lifecycle_' ~ item.id) }}"><input type="hidden" name="type" value="transfer_external">
                <input name="provider" maxlength="255" placeholder="Кому или куда" class="min-h-11 rounded-xl border border-gray-200 px-3 text-sm"><input name="note" maxlength="2000" placeholder="Заметка" class="min-h-11 rounded-xl border border-gray-200 px-3 text-sm">
                <button class="min-h-11 rounded-xl border border-amber-300 px-4 font-semibold text-amber-800 md:col-span-2">Передать наружу</button>
            </form>
        </div>
        {% endif %}

        {# ── Текстовые блоки ── #}
        {% set text_blocks = [
            {title: 'Причина покупки', value: item.purchaseReason},
            {title: 'Характеристики', value: item.notes},
            {title: 'Плюсы', value: item.pros},
            {title: 'Минусы', value: item.cons},
            {title: 'Вердикт', value: item.verdict},
        ] %}
        {% for tb in text_blocks %}
            {% if tb.value %}
            <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
                <h2 class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-500">{{ tb.title }}</h2>
                <div class="text-sm leading-relaxed text-gray-700">{{ tb.value|nl2br }}</div>
            </div>
            {% endif %}
        {% endfor %}

        {# ── История передач ── #}
        {% if transfers is defined and transfers|length > 0 %}
        <div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-sm font-bold">История передач</h2>
            <div class="flex flex-col gap-3 text-sm">
                {% for t in transfers %}
                <div>
                    <div class="font-semibold">
                        <span class="text-gray-400">{{ t.transferredAt|date('d.m.Y') }}</span>
                        — {{ t.fromUser.fullName }} → {{ t.toUser.fullName }}
                    </div>
                    {% if t.note %}
                        <div class="mt-0.5 text-xs text-gray-400">{{ t.note }}</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
<script>
(function () {
    document.querySelectorAll('[data-rotate-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-rotate-btn');
            var degrees = btn.getAttribute('data-degrees');
            var url = btn.getAttribute('data-url');
            var token = btn.getAttribute('data-token');
            btn.disabled = true;
            fetch(url, {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest'},
                body: '_token=' + encodeURIComponent(token) + '&degrees=' + degrees
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (data.ok) {
                    document.querySelectorAll('[data-rotate-target="' + id + '"]').forEach(function (img) {
                        img.src = data.uri;
                    });
                    if (document.querySelector('[data-rotate-cover="1"]')) {
                        document.querySelector('[data-rotate-cover="1"]').src = data.uri;
                    }
                } else {
                    alert(data.error || 'Ошибка поворота');
                }
            })['catch'](function () {
                alert('Сеть недоступна');
            })['finally'](function () {
                btn.disabled = false;
            });
        });
    });
})();
</script>
{% endblock %}
