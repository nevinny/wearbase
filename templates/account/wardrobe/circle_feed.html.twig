{% extends 'account/family_wardrobe/layout.html.twig' %}
{% block title %}{{ circle.title }} — кружок — WEARBASE{% endblock %}

{% block family_mobile_content %}
<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-lg font-bold">{{ circle.title }}</h1>
        <p class="mt-1 text-sm text-gray-500">Лента кружка: только луки, которые авторы показали именно этому кружку.</p>
    </div>
    <a href="{{ path('account_circles') }}" class="text-sm font-semibold text-gray-600">← К кружкам</a>
</div>

{# Инвайт-ссылка: owner/moderator (роль moderator в MVP не выдаётся) #}
{% if activeInvites %}
    <section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="font-bold">Пригласить подругу</h2>
        {% for invite in activeInvites %}
            <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-center">
                <input readonly value="{{ url('account_circle_join', {token: invite.token}) }}" onclick="this.select()"
                       class="w-full rounded-lg border border-gray-200 px-3 py-2 text-xs text-gray-500 sm:w-auto sm:max-w-[320px]" />
                <form method="post" action="{{ path('account_circles_invite_revoke', {id: invite.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('circle_invite_revoke_' ~ invite.id) }}">
                    <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50">Отозвать</button>
                </form>
            </div>
            <p class="mt-1 text-[11px] text-gray-400">Ссылка действует до {{ invite.expiresAt|date('d.m.Y') }}; любой вступивший по ней станет участником.</p>
        {% endfor %}
        <form method="post" action="{{ path('account_circles_invite_create', {id: circle.id}) }}" class="mt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('circle_invite_' ~ circle.id) }}">
            <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50">Новая ссылка</button>
        </form>
    </section>
{% elseif membership and membership.role == 'owner' %}
    <section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
        <form method="post" action="{{ path('account_circles_invite_create', {id: circle.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('circle_invite_' ~ circle.id) }}">
            <button class="min-h-11 rounded-full bg-gray-900 px-5 py-2.5 text-xs font-semibold text-white hover:bg-black">Пригласить подругу</button>
        </form>
    </section>
{% endif %}

{# Лента: title / explanation / фото обложек / категория / цвет / firstName автора / дата.
   Никогда: email, бренды, размеры, цены, история носок, другие луки. #}
<section class="mb-6 space-y-4">
    {% for card in cards %}
        <article class="rounded-2xl bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="font-bold">{{ card.title }}</h2>
                <time class="text-xs text-gray-400" datetime="{{ card.grantedAt|date('c') }}">{{ card.grantedAt|date('d.m.Y') }}</time>
            </div>
            {% if card.authorFirstName %}
                <p class="mt-0.5 text-xs text-gray-500">Автор: {{ card.authorFirstName }}</p>
            {% endif %}
            {% if card.explanation %}
                <p class="mt-2 text-sm text-gray-600">{{ card.explanation }}</p>
            {% endif %}
            <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {% for item in card.items %}
                    <li class="rounded-xl border border-gray-100 p-2">
                        {% if item.coverPhotoId %}
                            <img src="{{ path('account_circles_media_photo', {id: item.coverPhotoId}) }}" alt=""
                                 loading="lazy" class="aspect-square w-full rounded-lg object-cover">
                        {% else %}
                            <div class="aspect-square w-full rounded-lg bg-gray-50"></div>
                        {% endif %}
                        <p class="mt-1 truncate text-[11px] text-gray-500">{{ item.category }}{% if item.color %} · {{ item.color }}{% endif %}</p>
                    </li>
                {% endfor %}
            </ul>
            {# «Огонь» (docs/ratings-spec.md §3): positive-only, повтор = no-op,
               «забрать назад» нельзя. Автору — сумма без кнопки (self-feedback запрещён). #}
            <div class="mt-3">
                {% if card.canReact %}
                    <button type="button" data-react-url="{{ path('account_circles_share_react', {circleId: circle.id, shareId: card.id}) }}"
                            data-token="{{ csrf_token('circle_react_' ~ circle.id ~ '_' ~ card.id) }}"
                            class="js-fire min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-orange-50">
                        🔥 <span class="js-fire-count">{{ card.fires }}</span>
                    </button>
                {% else %}
                    <span class="inline-block rounded-full bg-gray-50 px-4 py-2 text-xs font-semibold text-gray-500">🔥 {{ card.fires }}</span>
                {% endif %}
            </div>
        </article>
    {% else %}
        <p class="rounded-2xl bg-white p-5 text-sm text-gray-500 shadow-sm">Пока никто ничего не показал этому кружку.</p>
    {% endfor %}
</section>

{# Оптимистичный счётчик: инкремент сразу, ответ сервера — истина; повторный клик no-op. #}
<script>
    document.querySelectorAll('.js-fire').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (btn.dataset.done === '1') { return; } // идемпотентность на клиенте
            btn.dataset.done = '1';
            const counter = btn.querySelector('.js-fire-count');
            const before = Number(counter.textContent);
            counter.textContent = String(before + 1); // оптимистичный инкремент
            const body = new FormData();
            body.append('_token', btn.dataset.token);
            fetch(btn.dataset.reactUrl, { method: 'POST', body, headers: { Accept: 'application/json' } })
                .then((res) => res.ok ? res.json() : Promise.reject(res.status))
                .then((data) => { if (!data.ok) { throw new Error('react failed'); } counter.textContent = String(data.count); })
                .catch(() => {
                    counter.textContent = String(before); // откат при ошибке
                    delete btn.dataset.done;
                });
        });
    });
</script>

{# Участники #}
<section class="mb-6 rounded-2xl bg-white p-5 shadow-sm">
    <h2 class="font-bold">Участники ({{ participants|length }} из {{ constant('App\\Entity\\WardrobeCircle::MEMBER_CAP') }})</h2>
    <ul class="mt-3 space-y-2">
        {% for p in participants %}
            <li class="flex items-center justify-between gap-2 rounded-xl border border-gray-100 p-3 text-sm">
                <span>
                    {{ p.user.firstName }}
                    {% if p.role == 'owner' %}<span class="ml-1 text-xs text-gray-400">владелец</span>{% endif %}
                    {% if p.isPendingParent %}<span class="ml-1 text-xs font-semibold text-amber-700">ждёт подтверждения родителя</span>{% endif %}
                </span>
                {% if canKick and p.role != 'owner' and membership and p.user.id != membership.user.id %}
                    <form method="post" action="{{ path('account_circles_kick', {id: circle.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('circle_kick_' ~ circle.id) }}">
                        <input type="hidden" name="member" value="{{ p.id }}">
                        <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Исключить</button>
                    </form>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {# Выход; владелец обязан выбрать преемника (решение PO №5) #}
    <form method="post" action="{{ path('account_circles_leave', {id: circle.id}) }}" class="mt-4 flex flex-col gap-2 border-t border-gray-100 pt-4 sm:flex-row sm:items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('circle_leave_' ~ circle.id) }}">
        {% if membership and membership.role == 'owner' %}
            <label class="flex-1 text-xs text-gray-500">
                Преемник (обязательно для владельца)
                <select name="successor" required class="mt-1 block w-full rounded-xl border border-gray-200 px-3 py-2 text-sm">
                    <option value="">— выберите участника —</option>
                        {% for p in participants|filter(p => p.role != 'owner' and not p.isPendingParent and p.user.id != membership.user.id) %}
                        <option value="{{ p.id }}">{{ p.user.firstName }}</option>
                    {% endfor %}
                </select>
            </label>
        {% else %}
            <span class="flex-1"></span>
        {% endif %}
        <button class="min-h-11 rounded-full border border-gray-200 px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-50">Выйти из кружка</button>
    </form>
</section>
{% endblock %}
