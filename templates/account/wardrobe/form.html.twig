{% extends 'account/layout.html.twig' %}
{% block title %}{{ item.id ? 'Редактировать вещь' : 'Новая вещь' }} — WEARBASE{% endblock %}

{% macro err(field) %}
    {% if field.vars.errors|length > 0 %}
        <div class="form-error mt-1 text-sm text-red-600">{{ form_errors(field) }}</div>
    {% endif %}
{% endmacro %}

{% block account_content %}
{% import _self as f %}
{% set tw_label = 'block text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1' %}
{% set tw_input = 'w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900' %}

<div class="mb-5 flex items-center gap-3">
    <a href="{{ path('account_wardrobe_index') }}"
       class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">← Назад</a>
    <h1 class="text-lg font-bold">{{ item.id ? 'Редактировать вещь' : 'Новая вещь' }}</h1>
</div>

{{ form_start(form) }}
{{ form_widget(form.remotePhotoUrl) }}

{# ── Основное ── #}
<div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-sm font-bold">{{ fullMode ? 'Полная карточка' : 'Быстрое добавление' }}</h2>
        {% if item.id %}
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">{{ item.completionStatusLabel }}</span>
        {% endif %}
    </div>
    <div class="grid grid-cols-12 gap-4">
        {% if fullMode %}
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Категория</label>
            {{ form_widget(form.categoryRef, {'attr': {'class': tw_input}}) }}
            {{ f.err(form.categoryRef) }}
        </div>
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Название</label>
            {{ form_widget(form.name, {'attr': {'class': tw_input, 'placeholder': 'Белая футболка oversize'}}) }}
            {{ f.err(form.name) }}
        </div>
        {% endif %}
        <div class="col-span-4">
            <label class="{{ tw_label }}">Размер</label>
            {{ form_widget(form.size, {'attr': {'class': tw_input, 'placeholder': 'M'}}) }}
            {{ f.err(form.size) }}
        </div>
        <div class="col-span-8 md:col-span-4">
            <label class="{{ tw_label }}">Цена, ₽</label>
            {{ form_widget(form.price, {'attr': {'class': tw_input, 'placeholder': '2990'}}) }}
            {{ f.err(form.price) }}
        </div>
        <div class="col-span-12 md:col-span-4">
            <label class="{{ tw_label }}">Дата покупки</label>
            {{ form_widget(form.purchasedAt, {'attr': {'class': tw_input}}) }}
            {{ f.err(form.purchasedAt) }}
        </div>
        <div class="col-span-12">
            <label class="{{ tw_label }}">Ссылка на товар</label>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
                <div class="flex-1">
                    {{ form_widget(form.productUrl, {'attr': {'class': tw_input, 'placeholder': 'https://…'}}) }}
                </div>
                <button type="button" id="wardrobe-ai-url-btn"
                        class="shrink-0 whitespace-nowrap rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition disabled:opacity-50">✨ Подтянуть из ссылки</button>
            </div>
            {{ f.err(form.productUrl) }}
            <div id="wardrobe-ai-url-status" class="mt-1 hidden text-xs"></div>
            <div id="wardrobe-ai-url-preview" class="mt-2 hidden"></div>
        </div>
    </div>
    {% if not fullMode %}
        <p class="mt-4 text-xs text-gray-500">Этого достаточно для черновика. Название, категорию, состав и уход можно добавить позже.</p>
    {% endif %}
</div>

{# ── Фото ── #}
<div class="mb-4 rounded-2xl bg-white p-6 shadow-sm" id="wardrobe-photo-section">
    <h2 class="mb-4 text-sm font-bold">Фото</h2>
    {% if item.photo %}
        <div class="mb-3">
            <img src="{{ vich_uploader_asset(item, 'photoFile') }}"
                 class="h-32 w-32 rounded-xl object-cover" alt="{{ item.name }}">
            <div class="mt-1 text-xs text-gray-400">Текущее фото — загрузите новое, чтобы заменить</div>
            {% if item.id %}
                <button type="button" id="wardrobe-ai-rerun-btn"
                        class="mt-2 rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition disabled:opacity-50">✨ AI-подсказки по фото</button>
            {% endif %}
        </div>
    {% endif %}
    {{ form_widget(form.photoFile, {'attr': {'class': 'block w-full text-sm text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-black'}}) }}
    {{ f.err(form.photoFile) }}
    <div id="wardrobe-ai-photo-status" class="mt-2 hidden text-xs"></div>
    <div id="wardrobe-ai-photo-diff" class="mt-2 hidden"></div>
</div>

{# ── История ── #}
<div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-sm font-bold">История</h2>
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12">
            <label class="{{ tw_label }}">Причина покупки</label>
            {{ form_widget(form.purchaseReason, {'attr': {'class': tw_input, 'rows': 2, 'placeholder': 'Почему купили эту вещь?'}}) }}
            {{ f.err(form.purchaseReason) }}
        </div>
        {% if fullMode %}
        <div class="col-span-12">
            <label class="{{ tw_label }}">Характеристики</label>
            {{ form_widget(form.notes, {'attr': {'class': tw_input, 'rows': 3, 'placeholder': 'Состав, уход, особенности…'}}) }}
            {{ f.err(form.notes) }}
        </div>
        {% endif %}
    </div>
</div>

{% if fullMode %}
{# ── Характеристики полной карточки ── #}
<div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-sm font-bold">Характеристики и уход</h2>
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Бренд</label>{{ form_widget(form.customBrandName, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Цвет</label>{{ form_widget(form.colorName, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Состав / материал</label>{{ form_widget(form.materialText, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Уход</label>{{ form_widget(form.careText, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Сезон</label>{{ form_widget(form.season, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12 md:col-span-6"><label class="{{ tw_label }}">Страна производства</label>{{ form_widget(form.countryOfOrigin, {'attr': {'class': tw_input}}) }}</div>
        <div class="col-span-12"><label class="{{ tw_label }}">Статус вещи</label>{{ form_widget(form.itemStatus, {'attr': {'class': tw_input}}) }}</div>
    </div>
</div>

{# ── Оценка ── #}
<div class="mb-4 rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-sm font-bold">Оценка</h2>
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Плюсы</label>
            {{ form_widget(form.pros, {'attr': {'class': tw_input, 'rows': 3, 'placeholder': 'Что нравится'}}) }}
            {{ f.err(form.pros) }}
        </div>
        <div class="col-span-12 md:col-span-6">
            <label class="{{ tw_label }}">Минусы</label>
            {{ form_widget(form.cons, {'attr': {'class': tw_input, 'rows': 3, 'placeholder': 'Что не нравится'}}) }}
            {{ f.err(form.cons) }}
        </div>
        <div class="col-span-12">
            <label class="{{ tw_label }}">Вердикт</label>
            {{ form_widget(form.verdict, {'attr': {'class': tw_input, 'rows': 2, 'placeholder': 'Итоговое мнение о вещи'}}) }}
            {{ f.err(form.verdict) }}
        </div>
    </div>
</div>
{% endif %}

<div class="mt-6 flex gap-2">
    <button type="submit" class="rounded-xl bg-gray-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Сохранить</button>
    {% if not fullMode %}
        <button type="submit" name="save_and_add" value="1" class="rounded-xl border border-gray-900 px-5 py-2.5 text-sm font-semibold text-gray-900 hover:bg-gray-50 transition">Сохранить и добавить следующую</button>
    {% endif %}
    <a href="{{ path('account_wardrobe_index') }}"
       class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition">Отмена</a>
</div>

{{ form_end(form) }}

<script>
(function () {
    var CSRF_TOKEN = '{{ csrf_token('wardrobe_ai') }}';
    var PHOTO_URL = '{{ path('account_wardrobe_ai_photo') }}';
    var URL_URL = '{{ path('account_wardrobe_ai_url') }}';
    var TOKEN_URL = '{{ path('account_wardrobe_ai_token') }}';

    // Session-based CSRF-токен из HTML может «осиротеть» (GC сессии на shared-хостинге) —
    // берём свежий прямо перед запросом; при сбое остаёмся на запечённом.
    function refreshToken() {
        return fetch(TOKEN_URL, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { if (d && d.token) { CSRF_TOKEN = d.token; } })
            .catch(function () {});
    }
    var SPINNER = '<svg class="inline h-3.5 w-3.5 animate-spin align-[-2px]" viewBox="0 0 24 24" fill="none">' +
        '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
        '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>';

    // ── Общий хелпер: заполнить только пустые поля формы ──
    function fillEmpty(map) {
        Object.keys(map || {}).forEach(function (key) {
            var val = map[key];
            if (val === undefined || val === null || val === '') return;
            var el = document.getElementById('wardrobe_item_form_' + key);
            if (!el) return;
            if (el.value && el.value.trim() !== '') return;
            el.value = val;
            el.classList.add('bg-amber-50', 'transition-colors', 'duration-1000');
            setTimeout(function () { el.classList.remove('bg-amber-50'); }, 1500);
        });
    }

    function hideAfter(el, ms) {
        setTimeout(function () {
            el.classList.add('hidden');
            el.innerHTML = '';
        }, ms);
    }

    function readJson(response) {
        return response.json().then(function (data) {
            return { status: response.status, data: data };
        });
    }

    // ── Фото-флоу ──
    var photoInput = document.querySelector('#wardrobe-photo-section input[type="file"]');
    var photoStatus = document.getElementById('wardrobe-ai-photo-status');

    if (photoInput && photoStatus) {
        photoInput.addEventListener('change', function () {
            var file = photoInput.files && photoInput.files[0];
            if (!file || file.type.indexOf('image/') !== 0) return;

            photoStatus.classList.remove('hidden', 'text-green-600', 'text-gray-400');
            photoStatus.classList.add('text-gray-500');
            photoStatus.innerHTML = SPINNER + ' <span class="ml-1">✨ AI подсказывает поля…</span>';

            var controller = new AbortController();
            var timeout = setTimeout(function () { controller.abort(); }, 25000);

            refreshToken().then(function () {
            var fd = new FormData();
            fd.append('photo', file);
            fd.append('_token', CSRF_TOKEN);

            fetch(PHOTO_URL, { method: 'POST', body: fd, credentials: 'same-origin', signal: controller.signal })
                .then(readJson)
                .then(function (res) {
                    clearTimeout(timeout);
                    photoStatus.classList.remove('text-gray-500');
                    if (res.data && res.data.ok) {
                        fillEmpty(res.data.fields || {});
                        photoStatus.classList.add('text-green-600');
                        photoStatus.innerHTML = '✨ Поля заполнены по фото — проверьте';
                    } else {
                        photoStatus.classList.add('text-gray-400');
                        photoStatus.innerHTML = (res.data && res.data.error) ? res.data.error : 'AI-подсказка недоступна';
                    }
                    hideAfter(photoStatus, 5000);
                })
                .catch(function () {
                    clearTimeout(timeout);
                    photoStatus.classList.remove('text-gray-500', 'text-green-600');
                    photoStatus.classList.add('text-gray-400');
                    photoStatus.innerHTML = 'AI-подсказка недоступна';
                    hideAfter(photoStatus, 5000);
                });
            });
        });
    }

    // ── Пере-запрос AI-подсказок по сохранённому фото (edit-режим) ──
    var rerunBtn = document.getElementById('wardrobe-ai-rerun-btn');
    var photoDiff = document.getElementById('wardrobe-ai-photo-diff');
    var ITEM_ID = '{{ item.id }}';
    var AI_FIELD_LABELS = { category: 'Категория', name: 'Название', size: 'Размер', notes: 'Характеристики' };

    function escapeHtml(str) {
        return String(str).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
    }

    // ── Общий хелпер запроса к AI-подсказке (файл ИЛИ сохранённое фото по item_id) ──
    function requestAiPhoto(body, headers) {
        var controller = new AbortController();
        var timeout = setTimeout(function () { controller.abort(); }, 25000);
        var opts = { method: 'POST', body: body, signal: controller.signal };
        if (headers) opts.headers = headers;
        return fetch(PHOTO_URL, opts)
            .then(readJson)
            .then(function (res) { clearTimeout(timeout); return res; })
            .catch(function (err) { clearTimeout(timeout); throw err; });
    }

    function markFilled(el, val) {
        el.value = val;
        el.classList.add('bg-amber-50', 'transition-colors', 'duration-1000');
        setTimeout(function () { el.classList.remove('bg-amber-50'); }, 1500);
    }

    function showPhotoStatusDone() {
        photoStatus.classList.remove('hidden', 'text-gray-500', 'text-gray-400');
        photoStatus.classList.add('text-green-600');
        photoStatus.innerHTML = '✨ Подсказки получены';
        hideAfter(photoStatus, 5000);
    }

    function showPhotoDiff(diffs) {
        if (!photoDiff) { showPhotoStatusDone(); return; }

        photoStatus.classList.remove('hidden', 'text-gray-500', 'text-green-600');
        photoStatus.classList.add('text-gray-400');
        photoStatus.innerHTML = '✨ AI предлагает изменить заполненные поля';

        var parts = Object.keys(diffs).map(function (key) {
            return '<b>' + AI_FIELD_LABELS[key] + '</b>: «' + escapeHtml(diffs[key]) + '»';
        });

        photoDiff.innerHTML =
            '<div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-gray-700">' +
            '<div class="mb-1.5">AI предлагает: ' + parts.join(' · ') + '</div>' +
            '<div class="flex gap-2">' +
            '<button type="button" id="wardrobe-ai-photo-diff-apply" class="rounded-md bg-gray-900 px-2.5 py-1 text-xs font-semibold text-white hover:bg-black transition">Применить</button>' +
            '<button type="button" id="wardrobe-ai-photo-diff-dismiss" class="rounded-md border border-gray-300 px-2.5 py-1 text-xs text-gray-600 hover:bg-gray-50 transition">✕</button>' +
            '</div></div>';
        photoDiff.classList.remove('hidden');

        document.getElementById('wardrobe-ai-photo-diff-apply').addEventListener('click', function () {
            Object.keys(diffs).forEach(function (key) {
                var el = document.getElementById('wardrobe_item_form_' + key);
                if (el) markFilled(el, diffs[key]);
            });
            photoDiff.classList.add('hidden');
            photoDiff.innerHTML = '';
            showPhotoStatusDone();
        });

        document.getElementById('wardrobe-ai-photo-diff-dismiss').addEventListener('click', function () {
            photoDiff.classList.add('hidden');
            photoDiff.innerHTML = '';
            photoStatus.classList.add('hidden');
            photoStatus.innerHTML = '';
        });
    }

    // Применение подсказок: пустые поля — сразу, непустые отличающиеся — в diff-блок на подтверждение
    function applyAiSuggestions(fields) {
        var diffs = {};
        Object.keys(AI_FIELD_LABELS).forEach(function (key) {
            var val = fields[key];
            if (val === undefined || val === null || val === '') return;
            var el = document.getElementById('wardrobe_item_form_' + key);
            if (!el) return;
            var current = el.value ? el.value.trim() : '';
            if (current === '') {
                markFilled(el, val);
            } else if (current !== val) {
                diffs[key] = val;
            }
        });

        if (Object.keys(diffs).length === 0) {
            showPhotoStatusDone();
        } else {
            showPhotoDiff(diffs);
        }
    }

    if (rerunBtn && photoStatus) {
        var rerunDefaultHtml = rerunBtn.innerHTML;

        rerunBtn.addEventListener('click', function () {
          refreshToken().then(function () {
            var file = photoInput && photoInput.files && photoInput.files[0];
            var reqPromise;

            if (file) {
                var fd = new FormData();
                fd.append('photo', file);
                fd.append('_token', CSRF_TOKEN);
                reqPromise = requestAiPhoto(fd);
            } else {
                reqPromise = requestAiPhoto(
                    new URLSearchParams({ item_id: ITEM_ID, _token: CSRF_TOKEN }),
                    { 'Content-Type': 'application/x-www-form-urlencoded' }
                );
            }

            rerunBtn.disabled = true;
            rerunBtn.innerHTML = SPINNER + ' Спрашиваем AI…';
            if (photoDiff) { photoDiff.classList.add('hidden'); photoDiff.innerHTML = ''; }

            photoStatus.classList.remove('hidden', 'text-green-600', 'text-gray-400');
            photoStatus.classList.add('text-gray-500');
            photoStatus.innerHTML = SPINNER + ' <span class="ml-1">✨ AI подсказывает поля…</span>';

            reqPromise
                .then(function (res) {
                    rerunBtn.disabled = false;
                    rerunBtn.innerHTML = rerunDefaultHtml;
                    photoStatus.classList.remove('text-gray-500');

                    if (res.data && res.data.ok) {
                        applyAiSuggestions(res.data.fields || {});
                    } else {
                        photoStatus.classList.add('text-gray-400');
                        photoStatus.innerHTML = (res.data && res.data.error) ? res.data.error : 'AI-подсказка недоступна';
                        hideAfter(photoStatus, 5000);
                    }
                })
                .catch(function () {
                    rerunBtn.disabled = false;
                    rerunBtn.innerHTML = rerunDefaultHtml;
                    photoStatus.classList.remove('text-gray-500', 'text-green-600');
                    photoStatus.classList.add('text-gray-400');
                    photoStatus.innerHTML = 'AI-подсказка недоступна';
                    hideAfter(photoStatus, 5000);
                });
          });
        });
    }

    // ── Ссылка-флоу ──
    var urlInput = document.getElementById('wardrobe_item_form_productUrl');
    var urlButton = document.getElementById('wardrobe-ai-url-btn');
    var urlStatus = document.getElementById('wardrobe-ai-url-status');
    var urlPreview = document.getElementById('wardrobe-ai-url-preview');

    if (urlButton && urlInput) {
        var urlButtonDefaultHtml = urlButton.innerHTML;

        urlButton.addEventListener('click', function () {
            var url = urlInput.value.trim();
            if (!url) {
                urlInput.focus();
                return;
            }

            urlButton.disabled = true;
            urlButton.innerHTML = SPINNER + ' Загружаем…';
            if (urlStatus) {
                urlStatus.classList.add('hidden');
                urlStatus.innerHTML = '';
            }

            var controller = new AbortController();
            var timeout = setTimeout(function () { controller.abort(); }, 25000);

            refreshToken().then(function () {
            fetch(URL_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ url: url, _token: CSRF_TOKEN }),
                credentials: 'same-origin',
                signal: controller.signal
            })
                .then(readJson)
                .then(function (res) {
                    clearTimeout(timeout);
                    urlButton.disabled = false;
                    urlButton.innerHTML = urlButtonDefaultHtml;

                    if (res.data && res.data.ok) {
                        fillEmpty(res.data.fields || {});
                        if (res.data.imageUrl && urlPreview && photoInput && (!photoInput.files || !photoInput.files.length)) {
                            var remotePhotoInput = document.getElementById('wardrobe_item_form_remotePhotoUrl');
                            if (remotePhotoInput) remotePhotoInput.value = res.data.imageUrl;
                            urlPreview.innerHTML =
                                '<img src="' + res.data.imageUrl + '" alt="Фото из магазина" class="max-h-40 rounded-lg border border-gray-200">' +
                                '<div class="mt-1 text-xs text-green-600">Фото из Wildberries сохранится вместе с карточкой</div>';
                            urlPreview.classList.remove('hidden');
                        }
                        if (urlStatus) {
                            urlStatus.classList.remove('hidden', 'text-gray-400');
                            urlStatus.classList.add('text-green-600');
                            urlStatus.innerHTML = '✨ Поля заполнены по ссылке — проверьте';
                            hideAfter(urlStatus, 5000);
                        }
                    } else if (urlStatus) {
                        urlStatus.classList.remove('hidden', 'text-green-600');
                        urlStatus.classList.add('text-gray-400');
                        urlStatus.innerHTML = (res.data && res.data.error) ? res.data.error : 'AI-подсказка недоступна';
                        hideAfter(urlStatus, 5000);
                    }
                })
                .catch(function () {
                    clearTimeout(timeout);
                    urlButton.disabled = false;
                    urlButton.innerHTML = urlButtonDefaultHtml;
                    if (urlStatus) {
                        urlStatus.classList.remove('hidden', 'text-green-600');
                        urlStatus.classList.add('text-gray-400');
                        urlStatus.innerHTML = 'AI-подсказка недоступна';
                        hideAfter(urlStatus, 5000);
                    }
                });
            });
        });
    }
})();
</script>
{% endblock %}
