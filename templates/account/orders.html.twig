{% extends 'account/layout.html.twig' %}
{% block title %}Мои заказы — WEARBASE{% endblock %}

{% block account_content %}
<h2 class="mb-5 text-lg font-bold">Мои заказы</h2>

{% if orders|length == 0 %}
    <div class="rounded-2xl bg-white py-14 text-center text-gray-500 shadow-sm">
        <div class="mb-4 text-5xl opacity-30">📦</div>
        <p class="mb-4">Заказов пока нет</p>
        <a href="{{ path('catalog_index') }}"
           class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-black transition">Перейти в каталог</a>
    </div>
{% else %}
<div class="flex flex-col gap-4">
{% for order in orders %}
    {% set steps = ['new', 'confirmed', 'processing', 'shipped', 'delivered', 'completed'] %}
    {% set currentStep = 0 %}
    {% for s in steps %}{% if s == order.status %}{% set currentStep = loop.index0 %}{% endif %}{% endfor %}

    {% set statusClasses = {
        'new': 'bg-gray-100 text-gray-700', 'confirmed': 'bg-indigo-100 text-indigo-800', 'processing': 'bg-indigo-100 text-indigo-800',
        'shipped': 'bg-sky-100 text-sky-800', 'delivered': 'bg-green-100 text-green-800', 'completed': 'bg-green-100 text-green-800',
        'cancelled': 'bg-red-100 text-red-800', 'returned': 'bg-amber-100 text-amber-800', 'refunded': 'bg-amber-100 text-amber-800'
    } %}

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-3">
            <div>
                <span class="text-sm font-semibold">#{{ order.orderNumber }}</span>
                <span class="ml-2 text-xs text-gray-500">от {{ order.createdAt|date('d.m.Y') }}</span>
            </div>
            <span class="rounded px-2 py-1 text-xs font-semibold {{ statusClasses[order.status] ?? 'bg-gray-100 text-gray-700' }}">
                {{ order.statusLabel ?? order.status }}
            </span>
        </div>
        <div class="p-5">

            {# Прогресс-бар #}
            {% if order.status not in ['cancelled', 'returned', 'refunded'] %}
            <div class="mb-4 flex gap-1">
                {% for s in steps %}
                <div class="h-[3px] flex-1 rounded-sm {{ loop.index0 <= currentStep ? 'bg-gray-900' : 'bg-gray-200' }}"></div>
                {% endfor %}
            </div>
            {% endif %}

            {# Товары #}
            <div class="text-sm">
                {% for item in order.orderItems %}
                <div class="flex justify-between border-b border-gray-100 py-1.5">
                    <span class="text-gray-500">
                        {{ item.productTitle }}
                        {% if item.variantTitle %}({{ item.variantTitle }}){% endif %}
                        × {{ item.qty }}
                    </span>
                    <span class="font-semibold">{{ price(item.total) }}</span>
                </div>
                {% endfor %}
            </div>

            <div class="mt-4 flex items-center justify-between">
                <div class="text-sm font-bold">Итого: {{ price(order.totalAmount) }}</div>
                <a href="{{ path('account_order_show', {number: order.orderNumber}) }}"
                   class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 transition">Подробнее →</a>
            </div>
        </div>
    </div>
{% endfor %}
</div>
{% endif %}
{% endblock %}
